+unsafe extern "C" fn read_file(
+    file: *mut c_void,
+    offset: u64,
+    out: *mut u8,
+    len: usize,
+    bytes_read: *mut usize,
+    error: *mut *const c_char,
+) -> i32 {
+    let file = unsafe { &*file.cast::<OpenFile>() };
+    // Shared metadata reads may continue, but a denied query buffer must never
+    // reach the actual file callback under that failed allocation account.
+    if lance_core::utils::memory::check_current().is_err() {
+        file.storage.forbidden_reads.fetch_add(1, Ordering::SeqCst);
+    }
+    file.storage.reads.fetch_add(1, Ordering::SeqCst);
+    match file
+        .file
+        .read_at(unsafe { std::slice::from_raw_parts_mut(out, len) }, offset)
+    {
+        Ok(n) => {
+            unsafe { *bytes_read = n };
+            0
+        }
+        Err(_) => {
+            unsafe { *error = c"fixture range read failed".as_ptr() };
+            2
+        }
+    }
+}
+unsafe extern "C" fn close_file(file: *mut c_void) {
+    let file = unsafe { Box::from_raw(file.cast::<OpenFile>()) };
+    file.storage.closes.fetch_add(1, Ordering::SeqCst);
