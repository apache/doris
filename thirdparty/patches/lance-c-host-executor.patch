+#[test]
+fn host_memory_accounts_follow_real_reads() {
+    const CHILD: &str = "LANCE_HOST_MEMORY_CASE";
+    let Ok(case) = std::env::var(CHILD) else {
+        for case in [
+            "descriptor",
+            "read_release",
+            "io_limit",
+            "check_limits",
+            "shared_cache",
+            "fts_cache",
+            "concurrent",
+            "nested",
+            "early_close",
+        ] {
+            let mut command = std::process::Command::new(std::env::current_exe().unwrap());
+            command
+                .args([
+                    "--exact",
+                    "host_memory_accounts_follow_real_reads",
+                    "--nocapture",
+                ])
+                .env(CHILD, case);
+            assert!(
+                common::run(command),
+                "host memory subprocess failed: {case}"
+            );
+        }
+        return;
+    };
+    let old = vec![7_u8; 8192];
+    let host = Host::new();
+    let (_directory, storage) = fixture(case == "fts_cache");
+    let services = Services::new();
+    if case == "descriptor" {
+        descriptors(&host, &services, old);
+    } else {
+        assert_eq!(
+            unsafe { lance_runtime_install_memory_services_v1(&services.options()) },
+            0
+        );
+        drop(old);
+        match case.as_str() {
+            "read_release" => read_release(&host, &storage),
+            "io_limit" => io_limit(&host, &storage),
+            "check_limits" => check_limits(&host, &storage),
+            "shared_cache" => shared_cache(&host, &storage, &services),
+            "fts_cache" => fts_cache(&host, &storage, &services),
+            "concurrent" => concurrent(&host, &storage),
+            "nested" => nested(&host),
+            "early_close" => early_close(&host, &storage),
+            _ => panic!("unknown memory test case"),
+        }
+    }
+    drop(host);
+    assert_eq!(
+        storage.opens.load(Ordering::SeqCst),
+        storage.closes.load(Ordering::SeqCst)
+    );
+    assert_eq!(
+        Arc::strong_count(&storage),
+        1,
+        "host file context survived all readers"
+    );
+    for account in [&services.background, &services.index, &services.metadata] {
+        assert!(!account.underflow.load(Ordering::SeqCst));
+    }
+}
