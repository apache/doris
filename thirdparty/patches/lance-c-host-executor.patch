+struct DeltaBucket {
+    size: AtomicUsize,
+    balance: AtomicI64,
+}
+
+struct Account {
+    current: AtomicI64,
+    peak: AtomicI64,
+    charged: AtomicUsize,
+    released: AtomicUsize,
+    retains: AtomicUsize,
+    drops: AtomicUsize,
+    reservations: AtomicUsize,
+    rejected: AtomicUsize,
+    rolled_back: AtomicUsize,
+    reserve_limit: AtomicUsize,
+    limit_code: AtomicI32,
+    checks: AtomicUsize,
+    underflow: AtomicBool,
+    delta_buckets: [DeltaBucket; DELTA_BUCKETS],
+    delta_overflow: AtomicBool,
+}
+impl Account {
+    fn new() -> Arc<Self> {
+        Arc::new(Self {
+            current: AtomicI64::new(0),
+            peak: AtomicI64::new(0),
+            charged: AtomicUsize::new(0),
+            released: AtomicUsize::new(0),
+            retains: AtomicUsize::new(0),
+            drops: AtomicUsize::new(0),
+            reservations: AtomicUsize::new(0),
+            rejected: AtomicUsize::new(0),
+            rolled_back: AtomicUsize::new(0),
+            reserve_limit: AtomicUsize::new(usize::MAX),
+            limit_code: AtomicI32::new(0),
+            checks: AtomicUsize::new(0),
+            underflow: AtomicBool::new(false),
+            delta_buckets: std::array::from_fn(|_| DeltaBucket {
+                size: AtomicUsize::new(0),
+                balance: AtomicI64::new(0),
+            }),
+            delta_overflow: AtomicBool::new(false),
+        })
+    }
+
+    fn options(self: &Arc<Self>) -> LanceHostMemoryAccountOptionsV1 {
+        LanceHostMemoryAccountOptionsV1 {
+            abi_version: 1,
+            struct_size: std::mem::size_of::<LanceHostMemoryAccountOptionsV1>() as u32,
+            context: Arc::as_ptr(self).cast_mut().cast(),
+            retain_context: Some(retain_account),
+            release_context: Some(release_account),
+            record: Some(record),
+            reserve: Some(reserve),
+            finish_reserve: Some(finish_reserve),
+            check: Some(check),
+        }
+    }
+
+    fn bytes(&self) -> i64 {
+        self.current.load(Ordering::SeqCst)
+    }
+
+    fn settled_bytes(&self) -> i64 {
+        let deadline = Instant::now() + Duration::from_secs(5);
+        let mut previous = self.bytes();
+        let mut stable_since = Instant::now();
+        loop {
+            std::thread::sleep(Duration::from_millis(5));
+            let current = self.bytes();
+            if current != previous {
+                previous = current;
+                stable_since = Instant::now();
+            }
+            if stable_since.elapsed() >= Duration::from_millis(100) {
+                return current;
+            }
+            assert!(Instant::now() < deadline, "memory ownership did not settle");
+        }
+    }
+
+    fn assert_released(self: &Arc<Self>) {
+        let deadline = Instant::now() + Duration::from_secs(5);
+        while (self.bytes() != 0 || Arc::strong_count(self) != 1) && Instant::now() < deadline {
+            std::thread::sleep(Duration::from_millis(5));
+        }
+        if self.bytes() != 0
+            || Arc::strong_count(self) != 1
+            || self.underflow.load(Ordering::SeqCst)
+        {
+            self.report_record_deltas();
+        }
+        assert!(
+            !self.underflow.load(Ordering::SeqCst),
+            "memory account underflowed"
+        );
+        assert_eq!(self.bytes(), 0, "query still owns allocated bytes");
+        assert_eq!(
+            Arc::strong_count(self),
+            1,
+            "query context is retained after all output release"
+        );
+        assert_eq!(
+            self.retains.load(Ordering::SeqCst),
+            self.drops.load(Ordering::SeqCst)
+        );
+        assert!(self.charged.load(Ordering::SeqCst) > 0);
+        assert_eq!(
+            self.charged.load(Ordering::SeqCst),
+            self.released.load(Ordering::SeqCst)
+        );
+    }
+
+    fn observe_record_delta(&self, delta: i64) {
+        let size = delta.unsigned_abs() as usize;
+        if size == 0 {
+            return;
+        }
+        for offset in 0..DELTA_BUCKETS {
+            let bucket = &self.delta_buckets[(size.wrapping_add(offset)) % DELTA_BUCKETS];
+            let key = bucket.size.load(Ordering::SeqCst);
+            let matching = if key == 0 {
+                match bucket
+                    .size
+                    .compare_exchange(0, size, Ordering::SeqCst, Ordering::SeqCst)
+                {
+                    Ok(_) => true,
+                    Err(existing) => existing == size,
+                }
+            } else {
+                key == size
+            };
+            if matching {
+                bucket.balance.fetch_add(delta.signum(), Ordering::SeqCst);
+                return;
+            }
+        }
+        self.delta_overflow.store(true, Ordering::SeqCst);
+    }
+
+    fn report_record_deltas(self: &Arc<Self>) {
+        // Collection and formatting happen only after the query scope has exited.
+        // Allocator callbacks themselves use the preallocated atomic table only.
+        let mut balances = self
+            .delta_buckets
+            .iter()
+            .filter_map(|bucket| {
+                let size = bucket.size.load(Ordering::SeqCst);
+                let count = bucket.balance.load(Ordering::SeqCst);
+                (count != 0).then_some((size, count, size as i128 * count as i128))
+            })
+            .collect::<Vec<_>>();
+        balances.sort_unstable_by_key(|entry| std::cmp::Reverse(entry.2.abs()));
+        eprintln!(
+            "memory diagnostics: current={} peak={} charged={} released={} refs={} retain={} release={} histogram_overflow={}",
+            self.bytes(),
+            self.peak.load(Ordering::SeqCst),
+            self.charged.load(Ordering::SeqCst),
+            self.released.load(Ordering::SeqCst),
+            Arc::strong_count(self),
+            self.retains.load(Ordering::SeqCst),
+            self.drops.load(Ordering::SeqCst),
+            self.delta_overflow.load(Ordering::SeqCst),
+        );
+        // Realloc reports its size difference, so these are unmatched record
+        // deltas grouped by magnitude, not a definitive live-allocation census.
+        for (size, count, balance) in balances.into_iter().take(24) {
+            eprintln!("record_delta_size={size} balance_count={count} balance_bytes={balance}");
+        }
+    }
+}
+unsafe extern "C" fn retain_account(context: *mut c_void) {
+    let account = unsafe { &*context.cast::<Account>() };
+    account.retains.fetch_add(1, Ordering::SeqCst);
+    unsafe { Arc::increment_strong_count(context.cast::<Account>()) };
+}
+unsafe extern "C" fn release_account(context: *mut c_void) {
+    let account = unsafe { &*context.cast::<Account>() };
+    account.drops.fetch_add(1, Ordering::SeqCst);
+    unsafe { Arc::decrement_strong_count(context.cast::<Account>()) };
+}
+unsafe extern "C" fn record(context: *mut c_void, delta: i64) {
+    let account = unsafe { &*context.cast::<Account>() };
+    account.observe_record_delta(delta);
+    let now = account.current.fetch_add(delta, Ordering::SeqCst) + delta;
+    account.peak.fetch_max(now, Ordering::SeqCst);
+    if delta >= 0 {
+        account.charged.fetch_add(delta as usize, Ordering::SeqCst);
+    } else {
+        account
+            .released
+            .fetch_add((-delta) as usize, Ordering::SeqCst);
+    }
+    if now < 0 {
+        account.underflow.store(true, Ordering::SeqCst);
+    }
+}
+unsafe extern "C" fn reserve(context: *mut c_void, bytes: usize) -> i32 {
+    let account = unsafe { &*context.cast::<Account>() };
+    account.reservations.fetch_add(1, Ordering::SeqCst);
+    if bytes > account.reserve_limit.load(Ordering::SeqCst) {
+        account.rejected.fetch_add(1, Ordering::SeqCst);
+        account.limit_code.store(1, Ordering::SeqCst);
+        1
+    } else {
+        // A nonzero reserve result must leave the ledger unchanged; finish is
+        // only called after a successful admission and an allocation attempt.
+        unsafe { record(context, bytes as i64) };
+        0
+    }
+}
+unsafe extern "C" fn finish_reserve(context: *mut c_void, bytes: usize, allocated: bool) {
+    if !allocated {
+        let account = unsafe { &*context.cast::<Account>() };
+        account.rolled_back.fetch_add(1, Ordering::SeqCst);
+        unsafe { record(context, -(bytes as i64)) };
+    }
+}
+unsafe extern "C" fn check(context: *mut c_void) -> i32 {
+    let account = unsafe { &*context.cast::<Account>() };
+    account.checks.fetch_add(1, Ordering::SeqCst);
+    account.limit_code.load(Ordering::SeqCst)
+}
