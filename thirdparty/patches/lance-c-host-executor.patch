+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::sync::atomic::{AtomicUsize, Ordering};
+
+    #[test]
+    fn cooperative_host_executes_nested_tasks_without_worker_threads() {
+        let runtime = HostRuntime::new(LanceHostExecutorOptionsV1::default());
+        let host_thread = std::thread::current().id();
+        let result = runtime.block_on(async move {
+            lance_core::utils::task_executor::spawn(async move {
+                lance_core::utils::task_executor::spawn_blocking(TaskKind::Cpu, move || {
+                    std::thread::current().id()
+                })
+                .await
+                .unwrap()
+            })
+            .await
+            .unwrap()
+        });
+        assert_eq!(result, host_thread);
+        assert_eq!(runtime.run(0, 16), 0);
+    }
+
+    #[test]
+    fn lance_cpu_helper_uses_host_instead_of_global_cpu_runtime() {
+        let runtime = HostRuntime::new(LanceHostExecutorOptionsV1::default());
+        let host_thread = std::thread::current().id();
+        let actual = runtime.block_on(async {
+            lance_core::utils::tokio::spawn_cpu(|| {
+                Ok::<_, std::io::Error>(std::thread::current().id())
+            })
+            .await
+            .unwrap()
+        });
+        assert_eq!(actual, host_thread);
+    }
+
+    #[test]
+    fn ffi_scopes_restore_the_previous_executor() {
+        unsafe {
+            let options = LanceHostExecutorOptionsV1::default();
+            let first = lance_host_executor_new_v1(&options);
+            let second = lance_host_executor_new_v1(&options);
+            assert!(!first.is_null() && !second.is_null());
+            let outer = lance_host_executor_enter(first);
+            assert!(Arc::ptr_eq(&current().unwrap(), &(*first).inner));
+            let inner = lance_host_executor_enter(second);
+            assert!(Arc::ptr_eq(&current().unwrap(), &(*second).inner));
+            assert_eq!(lance_host_executor_leave(inner), 0);
+            assert!(Arc::ptr_eq(&current().unwrap(), &(*first).inner));
+            assert_eq!(lance_host_executor_leave(outer), 0);
+            assert!(current().is_none());
+            lance_host_executor_free(second);
+            lance_host_executor_free(first);
+        }
+    }
+
+    #[test]
+    fn ready_callback_and_host_run_drive_detached_work() {
+        unsafe extern "C" fn notify(context: *mut c_void, _queue: u32) {
+            unsafe { &*context.cast::<AtomicUsize>() }.fetch_add(1, Ordering::SeqCst);
+        }
+        let notifications = AtomicUsize::new(0);
+        let options = LanceHostExecutorOptionsV1 {
+            context: &notifications as *const _ as *mut _,
+            notify_ready: Some(notify),
+            ..Default::default()
+        };
+        unsafe {
+            let executor = lance_host_executor_new_v1(&options);
+            let scope = lance_host_executor_enter(executor);
+            let handle = task_executor::spawn(async { 42 });
+            assert_eq!(lance_host_executor_leave(scope), 0);
+            assert!(notifications.load(Ordering::SeqCst) > 0);
+            assert_eq!(lance_host_executor_run(executor, 0, 1), 1);
+            assert_eq!(RT.block_on(handle).unwrap(), 42);
+            lance_host_executor_free(executor);
+        }
+    }
+
+    #[test]
+    fn invalid_abi_and_queue_are_rejected() {
+        unsafe {
+            assert!(lance_host_executor_new_v1(std::ptr::null()).is_null());
+            let mut options = LanceHostExecutorOptionsV1::default();
+            options.abi_version = 2;
+            assert!(lance_host_executor_new_v1(&options).is_null());
+            options.abi_version = 1;
+            options.struct_size = 8;
+            assert!(lance_host_executor_new_v1(&options).is_null());
+            options.struct_size = std::mem::size_of::<LanceHostExecutorOptionsV1>() as u32;
+            let runtime = lance_host_executor_new_v1(&options);
+            assert!(!runtime.is_null());
+            assert_eq!(lance_host_executor_run(runtime, 2, 16), -1);
+            lance_host_executor_free(runtime);
+        }
+    }
+
+    #[test]
+    fn callback_context_has_one_balanced_reference() {
+        struct Counts {
+            retained: AtomicUsize,
+            released: AtomicUsize,
+        }
+        unsafe extern "C" fn retain(ctx: *mut std::ffi::c_void) {
+            unsafe { &*ctx.cast::<Counts>() }
+                .retained
+                .fetch_add(1, Ordering::SeqCst);
+        }
+        unsafe extern "C" fn release(ctx: *mut std::ffi::c_void) {
+            unsafe { &*ctx.cast::<Counts>() }
+                .released
+                .fetch_add(1, Ordering::SeqCst);
+        }
+        let counts = Arc::new(Counts {
+            retained: AtomicUsize::new(0),
+            released: AtomicUsize::new(0),
+        });
+        let options = LanceHostExecutorOptionsV1 {
+            context: Arc::as_ptr(&counts) as *mut _,
+            retain_context: Some(retain),
+            release_context: Some(release),
+            ..Default::default()
+        };
+        unsafe {
+            let runtime = lance_host_executor_new_v1(&options);
+            assert_eq!(counts.retained.load(Ordering::SeqCst), 1);
+            lance_host_executor_free(runtime);
+        }
+        let deadline = std::time::Instant::now() + std::time::Duration::from_secs(2);
+        while counts.released.load(Ordering::SeqCst) == 0 {
+            assert!(std::time::Instant::now() < deadline);
+            std::thread::yield_now();
+        }
+        assert_eq!(counts.released.load(Ordering::SeqCst), 1);
+    }
+}
