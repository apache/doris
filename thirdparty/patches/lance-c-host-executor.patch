+                    let file = dir.path().join("data.bin");
+                    let bytes = vec![37_u8; 1 << 20];
+                    std::fs::write(&file, &bytes).unwrap();
+                    let (store, path) = lance_io::object_store::ObjectStore::from_uri(&format!(
+                        "file+uring://{}",
+                        file.display()
+                    ))
+                    .await
+                    .unwrap();
+                    let reader = store.open(&path).await.unwrap();
+                    assert_eq!(
+                        reader.get_range(0..bytes.len()).await.unwrap().as_ref(),
+                        &bytes
+                    );
+                    let reader = store.open_with_size(&path, bytes.len()).await.unwrap();
+                    assert_eq!(
+                        reader.get_range(0..bytes.len()).await.unwrap().as_ref(),
+                        &bytes
+                    );
+                    assert_eq!(
+                        before,
+                        threads(),
+                        "local read started a dedicated uring worker"
+                    );
+                }
+                "goosefs" => {
+                    use goosefs_sdk::cache::{
+                        CacheManager, CacheManagerOptions, LocalCacheManager, PageId,
+                    };
+                    let dir = tempfile::tempdir().unwrap();
+                    let mut options = CacheManagerOptions::from_config(
+                        &goosefs_sdk::config::GoosefsConfig::default(),
+                    );
+                    options.dirs = vec![dir.path().to_owned()];
+                    options.dir_capacity = 8 << 20;
+                    options.uring_enabled = true;
+                    options.uring_thread_count = 2;
+                    options.async_write_enabled = false;
+                    let cache = LocalCacheManager::create(options).await.unwrap();
+                    let id = PageId::new("example-file", 0);
+                    assert!(cache.put(&id, bytes::Bytes::from_static(b"example")).await);
+                    let mut output = [0_u8; 7];
+                    assert_eq!(cache.get(&id, 0, &mut output).await, 7);
+                    assert_eq!(&output, b"example");
+                    assert_eq!(
+                        before,
+                        threads(),
+                        "GooseFS page cache started a uring worker"
+                    );
+                    cache.close().await;
+                }
+                "rayon" => {
+                    let options = LanceHostExecutorOptionsV1 {
+                        max_cpu_drivers: 4,
+                        max_io_drivers: 4,
+                        context: &*sender as *const _ as *mut c_void,
+                        submit_task: Some(submit),
+                        ..Default::default()
+                    };
+                    let executor = unsafe { lance_host_executor_new_v1(&options) };
+                    let scope = unsafe { lance_host_executor_enter(executor) };
+                    assert!(!scope.is_null());
+                    let hashes: Vec<_> = (0..200_u64).collect();
+                    let actual = lance_linalg::distance::pairwise_hamming_distance_parallel(
+                        &hashes,
+                        None,
+                        Some(1),
+                    );
+                    let expected =
+                        lance_linalg::distance::pairwise_hamming_distance(&hashes, None, Some(1));
+                    assert_eq!(format!("{actual:?}"), format!("{expected:?}"));
+                    let binary = lance_linalg::distance::BinaryHashValues::try_new(
+                        hashes
+                            .iter()
+                            .copied()
+                            .chain(hashes.iter().copied())
+                            .collect(),
+                        200,
+                        16,
+                    )
+                    .unwrap();
+                    let actual = lance_linalg::distance::pairwise_hamming_distance_binary_parallel(
+                        &binary,
+                        None,
+                        Some(1),
+                    );
+                    let expected = lance_linalg::distance::pairwise_hamming_distance_binary(
+                        &binary,
+                        None,
+                        Some(1),
+                    );
+                    assert_eq!(format!("{actual:?}"), format!("{expected:?}"));
+                    assert_eq!(
+                        before,
+                        threads(),
+                        "distance computation started a Rayon pool"
+                    );
+                    assert_eq!(unsafe { lance_host_executor_leave(scope) }, 0);
+                    unsafe { lance_host_executor_free(executor) };
+                }
+                _ => unreachable!(),
+            }
+        })
+    }));
+    lance_runtime_stop();
+    reactor.join().unwrap();
+    for _ in &workers {
+        let _ = sender.send(None);
+    }
+    for worker in workers {
+        worker.join().unwrap();
+    }
+    drop(sender);
+    if let Err(panic) = outcome {
+        std::panic::resume_unwind(panic);
+    }
+    println!("{case}: SDK work stayed on the fixed host threads");
+}
