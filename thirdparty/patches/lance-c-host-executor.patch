+#[cfg(target_os = "linux")]
+#[test]
+fn test_host_services_never_create_sdk_threads() {
+    const CHILD: &str = "LANCE_HOST_SERVICES_TEST_CHILD";
+    if std::env::var_os(CHILD).is_none() {
+        let status = std::process::Command::new(std::env::current_exe().unwrap())
+            .args([
+                "--exact",
+                "test_host_services_never_create_sdk_threads",
+                "--nocapture",
+            ])
+            .env(CHILD, "1")
+            .status()
+            .unwrap();
+        assert!(status.success());
+        return;
+    }
+    struct Job {
+        run: RunTask,
+        discard: RunTask,
+        context: usize,
+    }
+    impl Job {
+        fn execute(mut self) {
+            let context = std::mem::replace(&mut self.context, 0);
+            unsafe { (self.run)(context as *mut c_void) };
+        }
+    }
+    impl Drop for Job {
+        fn drop(&mut self) {
+            if self.context != 0 {
+                unsafe { (self.discard)(self.context as *mut c_void) };
+            }
+        }
+    }
+    unsafe extern "C" fn submit(
+        context: *mut c_void,
+        _queue: u32,
+        run: RunTask,
+        discard: RunTask,
+        task: *mut c_void,
+    ) {
+        let sender = unsafe { &*context.cast::<std::sync::mpsc::Sender<Option<Job>>>() };
+        let _ = sender.send(Some(Job {
+            run,
+            discard,
+            context: task as usize,
+        }));
+    }
+    let (sender, receiver) = std::sync::mpsc::channel::<Option<Job>>();
+    let sender = Box::new(sender);
+    let receiver = Arc::new(Mutex::new(receiver));
+    let mut workers = Vec::new();
+    for _ in 0..4 {
+        let receiver = receiver.clone();
+        workers.push(std::thread::spawn(move || {
+            loop {
+                let job = receiver.lock().unwrap().recv();
+                match job {
+                    Ok(Some(job)) => job.execute(),
+                    Ok(None) | Err(_) => break,
+                }
+            }
+        }));
+    }
+    let options = LanceHostServicesOptionsV1 {
+        abi_version: 1,
+        struct_size: std::mem::size_of::<LanceHostServicesOptionsV1>() as u32,
+        context: &*sender as *const _ as *mut c_void,
+        submit: Some(submit),
+    };
+    assert_eq!(
+        unsafe { lance_runtime_install_host_services_v1(&options) },
+        0
+    );
+    let driver = std::thread::spawn(|| assert_eq!(lance_runtime_drive(), 0));
+    let http = std::net::TcpListener::bind("127.0.0.1:0").unwrap();
+    let address = http.local_addr().unwrap();
+    let server_done = Arc::new(std::sync::Barrier::new(2));
+    let done = server_done.clone();
+    let server = std::thread::spawn(move || {
+        use std::io::{BufRead, Write};
+        let (mut socket, _) = http.accept().unwrap();
+        socket
+            .set_read_timeout(Some(std::time::Duration::from_secs(10)))
+            .unwrap();
+        {
+            let mut input = std::io::BufReader::new(&mut socket);
+            loop {
+                let mut line = String::new();
+                input.read_line(&mut line).unwrap();
+                if line == "\r\n" || line.is_empty() {
+                    break;
+                }
+            }
+        }
+        socket.write_all(b"HTTP/1.1 206 Partial Content\r\nContent-Length: 3\r\nContent-Range: bytes 2-4/6\r\nETag: \"sample\"\r\nConnection: close\r\n\r\ncde").unwrap();
+        done.wait();
+    });
+    let count_threads = || std::fs::read_dir("/proc/self/task").unwrap().count();
+    let before = count_threads();
+    test_host_executor_scan_take_search_and_early_close();
+    // Exercise the SDK's real HTTP/DNS stack on the threadless host reactor as well.
+    lance_c::runtime::block_on(async {
+        use object_store::ObjectStoreExt;
+        let store = object_store::aws::AmazonS3Builder::new()
+            .with_bucket_name("example-bucket")
+            .with_region("us-east-1")
+            .with_endpoint(format!("http://localhost:{}", address.port()))
+            .with_allow_http(true)
+            .with_skip_signature(true)
+            .with_proxy_url("http://127.0.0.1:1")
+            .with_proxy_excludes("localhost")
+            .build()
+            .unwrap();
+        let bytes = store
+            .get_range(&object_store::path::Path::from("sample.lance"), 2..5)
+            .await
+            .unwrap();
+        assert_eq!(bytes.as_ref(), b"cde");
+    });
+    // The scope above closes all SDK objects before stopping host execution resources.
+    let after = count_threads();
+    server_done.wait();
+    server.join().unwrap();
+    lance_runtime_stop();
+    driver.join().unwrap();
+    for _ in &workers {
+        let _ = sender.send(None);
+    }
+    for worker in workers {
+        worker.join().unwrap();
+    }
+    drop(receiver);
+    drop(sender);
+    println!("host services: threads {before}->{after}");
+    assert_eq!(
+        before, after,
+        "the SDK created a worker thread instead of using the host"
+    );
+}
