+#[test]
+fn test_host_executor_scan_take_search_and_early_close() {
+    struct HostScope(*mut LanceHostExecutor, *mut LanceHostExecutorScope);
+    impl Drop for HostScope {
+        fn drop(&mut self) {
+            unsafe {
+                assert_eq!(lance_host_executor_leave(self.1), 0);
+                lance_host_executor_free(self.0);
+            }
+        }
+    }
+    let executor = unsafe { lance_host_executor_new_v1(&LanceHostExecutorOptionsV1::default()) };
+    assert!(!executor.is_null());
+    let scope = unsafe { lance_host_executor_enter(executor) };
+    assert!(!scope.is_null());
+    let _host = HostScope(executor, scope);
+    // Exercise the same result and ownership contracts under an injected executor.
+    test_scanner_full_scan();
+    test_scanner_to_arrow_stream();
+    test_scanner_with_filter();
+    test_dataset_take();
+    test_scanner_nearest_brute_force();
+    test_scanner_full_text_search();
+    test_scanner_statistics_callback_not_called_on_early_scanner_close();
+    assert!(unsafe { lance_host_executor_completed_tasks(executor) } > 0);
