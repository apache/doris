+    use super::*;
+
+    unsafe extern "C" fn retain(_: *mut c_void) {}
+    unsafe extern "C" fn release(_: *mut c_void) {}
+    unsafe extern "C" fn read(
+        _: *mut c_void,
+        _: u64,
+        _: *mut u8,
+        _: usize,
+        count: *mut usize,
+        _: *mut *const c_char,
+    ) -> i32 {
+        unsafe { *count = 0 };
+        0
+    }
+    unsafe extern "C" fn close(_: *mut c_void) {}
+
+    fn storage() -> Arc<HostStorage> {
+        Arc::new(HostStorage {
+            namespace: "unit-storage".into(),
+            callbacks: LanceHostStorageOptionsV1 {
+                abi_version: 1,
+                struct_size: std::mem::size_of::<LanceHostStorageOptionsV1>() as u32,
+                context: std::ptr::null_mut(),
+                retain_context: Some(retain),
+                release_context: Some(release),
+                cache_namespace: std::ptr::null(),
+                open: None,
+                read_at: Some(read),
+                close: Some(close),
+                list: None,
+            },
+        })
+    }
+
+    #[test]
+    fn object_names_round_trip_reserved_characters() {
+        let store = HostObjectStore {
+            storage: storage(),
+            base: Url::parse("s3://example-bucket/dataset").unwrap(),
+        };
+        let path = Path::parse("dataset/data/a +%2F?#\\.lance").unwrap();
+        let uri = Url::parse(&store.uri(&path)).unwrap();
+        assert_eq!(Path::from_url_path(uri.path()).unwrap(), path);
+        assert!(uri.query().is_none() && uri.fragment().is_none());
+    }
+
+    #[test]
+    fn short_reads_are_errors_instead_of_zero_filled_data() {
+        let file = Arc::new(HostFile {
+            storage: storage(),
+            handle: 0,
+            meta: LanceHostFileMeta {
+                size: 10,
+                modified_seconds: 0,
+            },
+        });
+        let error = block_on(file.read(0, 5)).unwrap_err();
+        assert!(error.to_string().contains("fewer bytes"));
+    }
+    #[test]
+    fn host_storage_accepts_explicit_io_parallelism_and_rejects_invalid_limits() {
+        use lance_io::object_store::{ObjectStoreParams, storage_options::StorageOptionsAccessor};
+        use std::collections::HashMap;
+        let provider = HostProvider { storage: storage() };
+        for value in ["7", "0", "-1", "invalid", "4294967296"] {
+            let params = ObjectStoreParams {
+                storage_options_accessor: Some(Arc::new(
+                    StorageOptionsAccessor::with_static_options(HashMap::from([(
+                        "io_parallelism".into(),
+                        value.into(),
+                    )])),
+                )),
+                ..Default::default()
+            };
+            let result = block_on(
+                provider.new_store(Url::parse("s3://example-bucket/dataset").unwrap(), &params),
+            );
+            if value == "7" {
+                assert_eq!(result.unwrap().io_parallelism(), 7);
+            } else {
+                assert!(result.is_err(), "accepted invalid io_parallelism={value}");
+            }
+        }
+    }
+}
