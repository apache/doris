+    invalid.abi_version = 2;
+    assert_eq!(
+        unsafe { lance_runtime_install_memory_services_v1(&invalid) },
+        -1
+    );
+    invalid = services.options();
+    invalid.struct_size = 8;
+    assert_eq!(
+        unsafe { lance_runtime_install_memory_services_v1(&invalid) },
+        -1
+    );
+    invalid = services.options();
+    invalid.metadata_cache.record = None;
+    assert_eq!(
+        unsafe { lance_runtime_install_memory_services_v1(&invalid) },
+        -1
+    );
+    assert_eq!(
+        services.background.retains.load(Ordering::SeqCst),
+        services.background.drops.load(Ordering::SeqCst)
+    );
+    assert_eq!(
+        services.metadata.retains.load(Ordering::SeqCst),
+        services.metadata.drops.load(Ordering::SeqCst)
+    );
+    assert_eq!(
+        unsafe { lance_runtime_install_memory_services_v1(&services.options()) },
+        0
+    );
+    assert!(!services.background.underflow.load(Ordering::SeqCst));
+    let query = Query::new(host.context());
+    let account = query.account.clone();
+    assert_eq!(
+        unsafe { lance_host_executor_set_memory_v1(ptr::null(), &account.options()) },
+        -1
+    );
+    assert_eq!(
+        unsafe { lance_host_executor_set_memory_v1(query.executor, ptr::null()) },
+        -1
+    );
+    for field in 0..4 {
+        let mut invalid = account.options();
+        match field {
+            0 => invalid.abi_version = 2,
+            1 => invalid.struct_size = 8,
+            2 => invalid.reserve = None,
+            _ => invalid.release_context = None,
+        }
+        assert_eq!(
+            unsafe { lance_host_executor_set_memory_v1(query.executor, &invalid) },
+            -1
+        );
+    }
+    let retained = account.retains.load(Ordering::SeqCst);
+    {
+        let _scope = query.enter();
+        // A dedicated scope excludes unrelated process-service bookkeeping.
+        let before = account.bytes();
+        drop(old);
+        assert_eq!(
+            account.bytes(),
+            before,
+            "pre-registration allocation acquired a retroactive owner"
+        );
+        assert!(Vec::<u8>::new().is_empty());
+        let buffer = vec![19_u8; 32 << 10];
+        assert!(account.bytes() >= buffer.len() as i64);
+        drop(buffer);
+    }
+    assert_eq!(account.retains.load(Ordering::SeqCst), retained);
+    drop(query);
+    clear_error();
+    account.assert_released();
+}
+
+fn read_release(host: &Host, storage: &Arc<Storage>) {
+    let session = Session::new(0);
+    let query = Query::new(host.context());
+    let account = query.account.clone();
+    let full = scan(&query, storage, &session, None);
+    assert_eq!(ids(&full), (0..ROWS).collect::<Vec<_>>());
+    let filtered = scan(&query, storage, &session, Some(c"id >= 700"));
+    assert_eq!(ids(&filtered), (700..ROWS).collect::<Vec<_>>());
+    drop(filtered);
+    {
+        let _scope = query.enter();
+        let dataset = storage.open(&session);
+        let indices = [0_u64, 257, 767];
+        let mut stream = FFI_ArrowArrayStream::empty();
+        assert_eq!(
+            unsafe {
+                lance_dataset_take(
+                    dataset,
+                    indices.as_ptr(),
+                    indices.len(),
+                    ptr::null(),
+                    &mut stream,
+                )
+            },
+            0
+        );
+        let reader = unsafe { ArrowArrayStreamReader::from_raw(&mut stream) }.unwrap();
+        let taken = reader.map(Result::unwrap).collect::<Vec<_>>();
+        assert_eq!(ids(&taken), vec![0, 257, 767]);
+        unsafe { lance_dataset_close(dataset) };
+    }
+    assert!(account.peak.load(Ordering::SeqCst) >= (256 << 10));
+    assert!(
+        account.reservations.load(Ordering::SeqCst) > 0,
+        "host reads did not reserve memory"
+    );
+    drop(query);
+    drop(session);
+    assert!(
+        account.bytes() >= (256 << 10),
+        "exported Arrow output lost its allocation owner"
+    );
+    assert!(
+        Arc::strong_count(&account) > 1,
+        "output did not retain the query ledger"
+    );
+    std::thread::spawn(move || {
+        assert_eq!(ids(&full), (0..ROWS).collect::<Vec<_>>());
+        drop(full);
+    })
+    .join()
+    .unwrap();
+    clear_error();
+    account.assert_released();
+}
+
+fn io_limit(host: &Host, storage: &Arc<Storage>) {
+    let session = Session::new(0);
+    let query = Query::new(host.context());
+    let account = query.account.clone();
+    {
+        let _scope = query.enter();
+        let dataset = storage.open(&session);
+        let scanner = unsafe { lance_scanner_new(dataset, ptr::null(), ptr::null()) };
+        assert!(!scanner.is_null());
+        // Deny after manifest setup, so the failure exercises fallible data-range allocation.
+        account.reserve_limit.store(0, Ordering::SeqCst);
+        let mut batch = ptr::null_mut();
+        assert_eq!(unsafe { lance_scanner_next(scanner, &mut batch) }, -1);
+        assert!(batch.is_null());
+        assert_eq!(lance_last_error_code() as i32, 10);
+        assert!(account.rejected.load(Ordering::SeqCst) > 0);
+        unsafe {
+            lance_scanner_close(scanner);
+            lance_dataset_close(dataset);
+        }
+    }
+    drop(query);
+    clear_error();
+    let healthy = Query::new(host.context());
+    let healthy_account = healthy.account.clone();
+    assert_eq!(
+        ids(&scan(&healthy, storage, &session, None)),
+        (0..ROWS).collect::<Vec<_>>()
+    );
+    drop(healthy);
+    drop(session);
+    clear_error();
+    account.assert_released();
+    healthy_account.assert_released();
+    assert_eq!(account.rolled_back.load(Ordering::SeqCst), 0);
+    assert_eq!(
+        storage.forbidden_reads.load(Ordering::SeqCst),
+        0,
+        "denied query range still reached the file callback"
+    );
+}
+
+fn nested(host: &Host) {
+    let first = Query::new(host.context());
+    let second = Query::new(host.context());
+    let first_account = first.account.clone();
+    let second_account = second.account.clone();
+    {
+        let _outer = first.enter();
+        let second_before = second_account.bytes();
+        let first_before = first_account.bytes();
+        let outer_buffer = std::hint::black_box(vec![17_u8; 64 << 10]);
+        assert!(first_account.bytes() >= first_before + outer_buffer.len() as i64);
+        assert_eq!(second_account.bytes(), second_before);
+        let (inner_buffer, inner_charge) = {
+            let _inner = second.enter();
+            let first_before = first_account.bytes();
+            let second_before = second_account.bytes();
+            let buffer = std::hint::black_box(vec![29_u8; 96 << 10]);
+            assert!(second_account.bytes() >= second_before + buffer.len() as i64);
+            assert_eq!(first_account.bytes(), first_before);
+            let charged = second_account.bytes() - second_before;
+            (buffer, charged)
+        };
+        let first_before = first_account.bytes();
+        let second_before = second_account.bytes();
+        // Leaving Q2 must restore Q1 even though Q2 still owns a live buffer.
+        let restored_buffer = std::hint::black_box(vec![43_u8; 128 << 10]);
+        assert!(first_account.bytes() >= first_before + restored_buffer.len() as i64);
+        assert_eq!(second_account.bytes(), second_before);
+        let first_before = first_account.bytes();
+        assert_eq!(inner_buffer[inner_buffer.len() - 1], 29);
+        drop(inner_buffer);
+        assert_eq!(first_account.bytes(), first_before);
+        assert_eq!(second_account.bytes(), second_before - inner_charge);
+        assert_eq!(outer_buffer[outer_buffer.len() - 1], 17);
+        assert_eq!(restored_buffer[restored_buffer.len() - 1], 43);
+    }
+    drop(second);
+    drop(first);
+    clear_error();
+    first_account.assert_released();
+    second_account.assert_released();
+}
+
+fn check_limits(host: &Host, storage: &Arc<Storage>) {
+    let session = Session::new(0);
+    let mut accounts = Vec::new();
+    for code in 1..=3 {
+        let query = Query::new(host.context());
+        accounts.push(query.account.clone());
+        {
+            let _scope = query.enter();
+            let dataset = storage.open(&session);
+            let scanner = unsafe { lance_scanner_new(dataset, ptr::null(), ptr::null()) };
+            assert!(!scanner.is_null());
+            query.account.limit_code.store(code, Ordering::SeqCst);
+            // Infallible Rust allocation still succeeds after a policy limit; the next
+            // fallible scanner boundary must report the original policy category.
+            let ordinary = vec![23_u8; 64 << 10];
+            assert_eq!(ordinary[ordinary.len() - 1], 23);
+            assert!(query.account.bytes() >= ordinary.len() as i64);
+            drop(ordinary);
+            let mut batch = ptr::null_mut();
+            assert_eq!(unsafe { lance_scanner_next(scanner, &mut batch) }, -1);
+            assert!(batch.is_null());
+            assert_eq!(
+                lance_last_error_code() as i32,
+                9 + code,
+                "limit category {code} escaped the memory error mapping"
+            );
+            assert!(query.account.checks.load(Ordering::SeqCst) > 0);
+            unsafe {
+                lance_scanner_close(scanner);
+                lance_dataset_close(dataset);
+            }
+        }
+        drop(query);
+        clear_error();
+    }
+    drop(session);
+    for account in accounts {
+        account.assert_released();
+    }
+}
+
+fn shared_cache(host: &Host, storage: &Arc<Storage>, services: &Services) {
+    let baseline = services.metadata.settled_bytes();
+    let first = Query::new(host.context());
+    let first_account = first.account.clone();
+    let session = {
+        // A BE session may first be constructed by a query, but must outlive it
+        // without retaining that query's allocation owner.
+        let _scope = first.enter();
+        Session::new(32 << 20)
+    };
+    drop(scan(&first, storage, &session, None));
+    drop(first);
+    clear_error();
+    let warmed = session.stats();
+    assert!(warmed.metadata_cache_entries > 0);
+    assert!(
+        services.metadata.bytes() > 0,
+        "metadata cache was not charged to its explicit account"
+    );
+    first_account.assert_released();
+    let cache_bytes = services.metadata.settled_bytes();
+    let second = Query::new(host.context());
+    let second_account = second.account.clone();
+    assert_eq!(
+        ids(&scan(&second, storage, &session, None)),
+        (0..ROWS).collect::<Vec<_>>()
+    );
+    drop(second);
+    clear_error();
+    let hit = session.stats();
+    assert!(hit.metadata_cache_hits > warmed.metadata_cache_hits);
+    assert_eq!(hit.metadata_cache_entries, warmed.metadata_cache_entries);
+    assert_eq!(
+        hit.metadata_cache_size_bytes,
+        warmed.metadata_cache_size_bytes
+    );
+    assert!(
+        services.metadata.settled_bytes() <= cache_bytes,
+        "warm cache objects were charged again to the second query"
+    );
+    second_account.assert_released();
+    drop(session);
+    let deadline = Instant::now() + Duration::from_secs(5);
+    while services.metadata.bytes() > baseline && Instant::now() < deadline {
+        std::thread::sleep(Duration::from_millis(5));
+    }
+    assert!(
+        services.metadata.bytes() <= baseline,
+        "session close retained shared metadata cache allocations: baseline={baseline}, current={}, refs={}",
+        services.metadata.bytes(),
+        Arc::strong_count(&services.metadata),
+    );
+    assert!(!services.metadata.underflow.load(Ordering::SeqCst));
+}
+
+fn concurrent(host: &Host, storage: &Arc<Storage>) {
+    let barrier = Arc::new(Barrier::new(2));
+    let context = host.context() as usize;
+    let handles = (0..2)
+        .map(|number| {
+            let storage = storage.clone();
+            let barrier = barrier.clone();
+            std::thread::spawn(move || {
+                let session = Session::new(0);
+                let query = Query::new(context as *mut c_void);
+                let account = query.account.clone();
+                barrier.wait();
+                let batches = scan(
+                    &query,
+                    &storage,
+                    &session,
+                    Some(if number == 0 {
+                        c"id < 384"
+                    } else {
+                        c"id >= 384"
+                    }),
+                );
+                drop(query);
+                drop(session);
+                (account, batches)
+            })
+        })
+        .collect::<Vec<_>>();
+    let mut results = handles
+        .into_iter()
+        .map(|handle| handle.join().unwrap())
+        .collect::<Vec<_>>();
+    let (second_account, second_output) = results.pop().unwrap();
+    let (first_account, first_output) = results.pop().unwrap();
+    assert_eq!(ids(&first_output), (0..384).collect::<Vec<_>>());
+    assert_eq!(ids(&second_output), (384..ROWS).collect::<Vec<_>>());
+    let second_bytes = second_account.settled_bytes();
+    assert!(second_bytes >= (256 << 10));
+    std::thread::spawn(move || drop(first_output))
+        .join()
+        .unwrap();
+    first_account.assert_released();
+    assert_eq!(
+        second_account.settled_bytes(),
+        second_bytes,
+        "freeing query A changed query B's ledger"
+    );
+    std::thread::spawn(move || drop(second_output))
+        .join()
+        .unwrap();
+    second_account.assert_released();
+}
+
+fn fts_cache(host: &Host, storage: &Arc<Storage>, services: &Services) {
+    let baseline = services.index.settled_bytes();
+    let expected = (0..ROWS).filter(|id| id % 3 == 0).collect::<Vec<_>>();
+    let first = Query::new(host.context());
+    let first_account = first.account.clone();
+    let session = {
+        let _scope = first.enter();
+        Session::new(32 << 20)
+    };
+    assert_eq!(ids(&scan_fts(&first, storage, &session)), expected);
+    drop(first);
+    clear_error();
+    let warmed = session.stats();
+    assert!(warmed.index_cache_entries > 0);
+    assert!(warmed.index_cache_size_bytes > 0);
+    assert!(
+        services.index.bytes() > baseline,
+        "FTS index bypassed its cache account"
+    );
+    first_account.assert_released();
+    let resident = services.index.settled_bytes();
+    let second = Query::new(host.context());
+    let second_account = second.account.clone();
+    assert_eq!(ids(&scan_fts(&second, storage, &session)), expected);
+    drop(second);
+    clear_error();
+    let hit = session.stats();
+    assert!(hit.index_cache_hits > warmed.index_cache_hits);
+    assert_eq!(hit.index_cache_entries, warmed.index_cache_entries);
+    assert_eq!(hit.index_cache_size_bytes, warmed.index_cache_size_bytes);
+    assert!(
+        services.index.settled_bytes() <= resident,
+        "warm FTS cache was charged twice"
+    );
+    second_account.assert_released();
+    drop(session);
+    let deadline = Instant::now() + Duration::from_secs(5);
+    while services.index.bytes() > baseline && Instant::now() < deadline {
+        std::thread::sleep(Duration::from_millis(5));
+    }
+    assert!(
+        services.index.bytes() <= baseline,
+        "session close retained FTS index cache allocations: baseline={baseline}, current={}, refs={}",
+        services.index.bytes(),
+        Arc::strong_count(&services.index),
+    );
+    assert!(!services.index.underflow.load(Ordering::SeqCst));
+}
+
+fn early_close(host: &Host, storage: &Arc<Storage>) {
+    let mut accounts = Vec::new();
+    for arrow_stream in [false, true] {
+        for _ in 0..8 {
+            let session = Session::new(0);
+            let query = Query::new(host.context());
+            accounts.push(query.account.clone());
+            {
+                let _scope = query.enter();
+                let dataset = storage.open(&session);
+                let scanner = unsafe { lance_scanner_new(dataset, ptr::null(), ptr::null()) };
+                assert!(!scanner.is_null());
+                assert_eq!(unsafe { lance_scanner_set_batch_size(scanner, 32) }, 0);
+                if arrow_stream {
+                    let mut stream = FFI_ArrowArrayStream::empty();
+                    assert_eq!(
+                        unsafe { lance_scanner_to_arrow_stream(scanner, &mut stream) },
+                        0
+                    );
+                    let mut reader =
+                        unsafe { ArrowArrayStreamReader::from_raw(&mut stream) }.unwrap();
+                    assert_eq!(reader.next().unwrap().unwrap().num_rows(), 32);
+                    drop(reader);
+                } else {
+                    let mut batch = ptr::null_mut();
+                    assert_eq!(unsafe { lance_scanner_next(scanner, &mut batch) }, 0);
+                    assert_eq!(export_batch(batch).num_rows(), 32);
+                }
+                unsafe {
+                    lance_scanner_close(scanner);
+                    lance_dataset_close(dataset);
+                }
+            }
+            drop(query);
+            drop(session);
+        }
+    }
+    clear_error();
+    for account in accounts {
+        account.assert_released();
+    }
+}
