diff --git a/include/lance/host_executor.hpp b/include/lance/host_executor.hpp
--- /dev/null
+++ b/include/lance/host_executor.hpp
@@ -0,0 +1,51 @@
+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright The Lance Authors
+#pragma once
+
+#include <stdexcept>
+#include <utility>
+
+#include "lance.h"
+
+namespace lance {
+/// Thread-bound injection scope. Destroy before closing the executor; do not cross await points.
+class HostExecutorScope {
+public:
+    explicit HostExecutorScope(const LanceHostExecutor* executor)
+            : scope_(lance_host_executor_enter(executor)) {
+        if (!scope_) throw std::runtime_error(lance_last_error_message());
+    }
+    ~HostExecutorScope() { lance_host_executor_leave(scope_); }
+    HostExecutorScope(const HostExecutorScope&) = delete;
+    HostExecutorScope& operator=(const HostExecutorScope&) = delete;
+    HostExecutorScope(HostExecutorScope&&) = delete;
+    HostExecutorScope& operator=(HostExecutorScope&&) = delete;
+
+private:
+    LanceHostExecutorScope* scope_;
+};
+
+/// Queue owner for an operation. A null notifier enables cooperative execution on the caller.
+class HostExecutor {
+public:
+    explicit HostExecutor(const LanceHostExecutorOptionsV1& options)
+            : executor_(lance_host_executor_new_v1(&options)) {
+        if (!executor_) throw std::runtime_error(lance_last_error_message());
+    }
+    ~HostExecutor() {
+        if (executor_) lance_host_executor_free(executor_);
+    }
+    HostExecutor(const HostExecutor&) = delete;
+    HostExecutor& operator=(const HostExecutor&) = delete;
+    HostExecutor(HostExecutor&& other) noexcept
+            : executor_(std::exchange(other.executor_, nullptr)) {}
+    HostExecutor& operator=(HostExecutor&&) = delete;
+    [[nodiscard]] LanceHostExecutor* get() const { return executor_; }
+    int64_t run(uint32_t queue, uint32_t max_tasks) const {
+        return lance_host_executor_run(executor_, queue, max_tasks);
+    }
+
+private:
+    LanceHostExecutor* executor_;
+};
+} // namespace lance
diff --git a/include/lance/lance.h b/include/lance/lance.h
--- a/include/lance/lance.h
+++ b/include/lance/lance.h
@@ -187,6 +187,52 @@

 typedef struct LanceDataset  LanceDataset;
 typedef struct LanceScanner  LanceScanner;
+
+/** Host-driven task queues. These handles do not create worker threads.
+ * Tokio remains responsible for network readiness, timers, join notifications and shared I/O services.
+ * Operation-owned scan/decoder tasks and spawn_cpu use the injected executor.
+ */
+typedef struct LanceHostExecutor LanceHostExecutor;
+typedef struct LanceHostExecutorScope LanceHostExecutorScope;
+
+typedef struct LanceHostExecutorOptionsV1 {
+    uint32_t abi_version;  /* Must be 1. */
+    uint32_t struct_size;  /* Must be at least sizeof(LanceHostExecutorOptionsV1). */
+    void* context;
+    void (*retain_context)(void* context);
+    void (*release_context)(void* context);
+    /* Called on any thread after enqueueing. Never block, reenter, or run tasks inline here.
+     * Schedule lance_host_executor_run on a host worker. NULL enables caller-only execution.
+     * queue: 0 = CPU, 1 = blocking I/O. Worker concurrency and scheduling are the host's responsibility.
+     */
+    void (*notify_ready)(void* context, uint32_t queue);
+} LanceHostExecutorOptionsV1;
+
+/** Copies the descriptor and retains context once. Retain/release must both be set or both NULL.
+ * Callbacks must be thread-safe and must not unwind exceptions across the C boundary.
+ * NULL context callbacks require the caller to keep context alive until all executor work is gone.
+ */
+LanceHostExecutor* lance_host_executor_new_v1(const LanceHostExecutorOptionsV1* options);
+/** Enter before Dataset open, Scanner calls and Arrow stream consumption.
+ * Leave on the same thread in strict LIFO order. Never hold a scope across an async suspension.
+ * Objects/streams created under a scope must not outlive their executor.
+ * Keep the same executor when operating on a live scanner or exported stream.
+ */
+LanceHostExecutorScope* lance_host_executor_enter(const LanceHostExecutor* executor);
+int32_t lance_host_executor_leave(LanceHostExecutorScope* scope);
+/** Runs up to max_tasks tasks on the calling thread. max_tasks must be positive.
+ * Returns count or -1 on error. Concurrent workers may drive the same queue.
+ * A single task/poll cannot be preempted. Blocking I/O occupies its worker until it returns.
+ */
+int64_t lance_host_executor_run(const LanceHostExecutor* executor, uint32_t queue, uint32_t max_tasks);
+/** Close SDK objects first and wait for all active scopes/run calls before freeing.
+ * Retires pending work; callback context release can occur later on the control runtime.
+ */
+void lance_host_executor_free(LanceHostExecutor* executor);
+/** Cumulative task poll count, for host-side profiling. */
+uint64_t lance_host_executor_completed_tasks(const LanceHostExecutor* executor);
+
+
 typedef struct LanceBatch    LanceBatch;
 typedef struct LanceSession  LanceSession;
 typedef struct LanceVersions LanceVersions;
diff --git a/src/host_executor.rs b/src/host_executor.rs
--- /dev/null
+++ b/src/host_executor.rs
@@ -0,0 +1,485 @@
+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright The Lance Authors
+
+//! Host-driven operation queues; Tokio is retained for I/O readiness and join notifications.
+
+use std::cell::RefCell;
+use std::collections::VecDeque;
+use std::ffi::c_void;
+use std::future::Future;
+use std::panic::{AssertUnwindSafe, catch_unwind};
+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+use std::sync::{Arc, Mutex};
+use std::task::{Context, Poll};
+use std::thread::{Thread, ThreadId};
+
+use futures::task::{ArcWake, waker};
+use lance_core::utils::task_executor::{self, Executor, ExecutorGuard, Task, TaskKind};
+
+use crate::error::{LanceErrorCode, clear_last_error, set_last_error};
+use crate::runtime::RT;
+
+/// Versioned callbacks. Context callbacks must be paired; notify only schedules asynchronous work.
+#[repr(C)]
+#[derive(Clone, Copy)]
+pub struct LanceHostExecutorOptionsV1 {
+    pub abi_version: u32,
+    pub struct_size: u32,
+    pub context: *mut c_void,
+    pub retain_context: Option<unsafe extern "C" fn(*mut c_void)>,
+    pub release_context: Option<unsafe extern "C" fn(*mut c_void)>,
+    pub notify_ready: Option<unsafe extern "C" fn(*mut c_void, u32)>,
+}
+impl Default for LanceHostExecutorOptionsV1 {
+    fn default() -> Self {
+        Self {
+            abi_version: 1,
+            struct_size: std::mem::size_of::<Self>() as u32,
+            context: std::ptr::null_mut(),
+            retain_context: None,
+            release_context: None,
+            notify_ready: None,
+        }
+    }
+}
+
+/// Opaque executor. It owns queues, not worker threads.
+pub struct LanceHostExecutor {
+    inner: Arc<HostRuntime>,
+}
+
+pub(crate) struct HostRuntime {
+    queues: [Mutex<VecDeque<Task>>; 2],
+    context: usize,
+    release_context: Option<unsafe extern "C" fn(*mut c_void)>,
+    notify_ready: Option<unsafe extern "C" fn(*mut c_void, u32)>,
+    parked: Mutex<Vec<(u64, Thread)>>,
+    next_id: AtomicU64,
+    closed: AtomicBool,
+    completed: AtomicU64,
+}
+impl HostRuntime {
+    fn new(options: LanceHostExecutorOptionsV1) -> Arc<Self> {
+        if let Some(retain) = options.retain_context {
+            unsafe { retain(options.context) };
+        }
+        Arc::new(Self {
+            queues: std::array::from_fn(|_| Mutex::new(VecDeque::new())),
+            context: options.context as usize,
+            release_context: options.release_context,
+            notify_ready: options.notify_ready,
+            parked: Mutex::new(Vec::new()),
+            next_id: AtomicU64::new(0),
+            closed: AtomicBool::new(false),
+            completed: AtomicU64::new(0),
+        })
+    }
+    fn run(&self, queue: usize, max_tasks: u32) -> u32 {
+        let mut count = 0;
+        while count < max_tasks {
+            let task = self.queues[queue]
+                .lock()
+                .unwrap_or_else(|e| e.into_inner())
+                .pop_front();
+            let Some(task) = task else {
+                break;
+            };
+            task();
+            self.completed.fetch_add(1, Ordering::Relaxed);
+            count += 1;
+        }
+        count
+    }
+    pub(crate) fn block_on<F: Future>(self: &Arc<Self>, future: F) -> F::Output {
+        let _reactor = RT.enter();
+        let executor: Arc<dyn Executor> = self.clone();
+        let future = task_executor::scope(executor, future);
+        let mut future = std::pin::pin!(future);
+        let id = self.next_id.fetch_add(1, Ordering::Relaxed);
+        self.parked
+            .lock()
+            .unwrap_or_else(|e| e.into_inner())
+            .push((id, std::thread::current()));
+        let _registration = ParkedRegistration { runtime: self, id };
+        let wake = waker(Arc::new(ThreadWake(std::thread::current())));
+        let mut cx = Context::from_waker(&wake);
+        loop {
+            if let Poll::Ready(value) = future.as_mut().poll(&mut cx) {
+                return value;
+            }
+            // The caller helps its own children while waiting. Saturating the host pool with
+            // synchronous readers must not leave all child tasks waiting for those same slots.
+            let cpu = self.run(0, 1);
+            let io = self.run(1, 1);
+            if cpu == 0 && io == 0 {
+                std::thread::park();
+            }
+        }
+    }
+    fn retire(&self) {
+        self.closed.store(true, Ordering::Release);
+        let tasks: Vec<_> = self
+            .queues
+            .iter()
+            .flat_map(|queue| {
+                queue
+                    .lock()
+                    .unwrap_or_else(|e| e.into_inner())
+                    .drain(..)
+                    .collect::<Vec<_>>()
+            })
+            .collect();
+        // Destructors may acquire SDK locks, so they run after queue locks are released.
+        drop(tasks);
+    }
+}
+impl Executor for HostRuntime {
+    fn schedule(&self, kind: TaskKind, task: Task) {
+        let queue = match kind {
+            TaskKind::Cpu => 0,
+            TaskKind::Io => 1,
+        };
+        {
+            let mut tasks = self.queues[queue].lock().unwrap_or_else(|e| e.into_inner());
+            if self.closed.load(Ordering::Acquire) {
+                // Cancellation can wake a task while holding a library lock.
+                RT.spawn(async move {
+                    drop(task);
+                });
+                return;
+            }
+            tasks.push_back(task);
+        }
+        for (_, thread) in self.parked.lock().unwrap_or_else(|e| e.into_inner()).iter() {
+            thread.unpark();
+        }
+        if let Some(notify) = self.notify_ready {
+            unsafe { notify(self.context as *mut c_void, queue as u32) };
+        }
+    }
+}
+impl Drop for HostRuntime {
+    fn drop(&mut self) {
+        // The last reference can disappear inside a wake callback. Defer both queued future
+        // destruction and the foreign context release until that callback has returned.
+        let tasks: Vec<_> = self
+            .queues
+            .iter_mut()
+            .flat_map(|queue| std::mem::take(queue.get_mut().unwrap_or_else(|e| e.into_inner())))
+            .collect();
+        let context = self.context;
+        let release = self.release_context;
+        RT.spawn(async move {
+            drop(tasks);
+            if let Some(release) = release {
+                unsafe { release(context as *mut c_void) };
+            }
+        });
+    }
+}
+struct ParkedRegistration<'a> {
+    runtime: &'a HostRuntime,
+    id: u64,
+}
+impl Drop for ParkedRegistration<'_> {
+    fn drop(&mut self) {
+        self.runtime
+            .parked
+            .lock()
+            .unwrap_or_else(|e| e.into_inner())
+            .retain(|(id, _)| *id != self.id);
+    }
+}
+struct ThreadWake(Thread);
+impl ArcWake for ThreadWake {
+    fn wake_by_ref(this: &Arc<Self>) {
+        this.0.unpark();
+    }
+}
+
+thread_local! {
+    static CURRENT: RefCell<Option<Arc<HostRuntime>>> = const { RefCell::new(None) };
+}
+pub(crate) fn current() -> Option<Arc<HostRuntime>> {
+    CURRENT.with(|current| current.borrow().clone())
+}
+
+/// Thread-bound, LIFO scope for synchronous C API calls. Never move it across threads.
+pub struct LanceHostExecutorScope {
+    previous: Option<Arc<HostRuntime>>,
+    thread: ThreadId,
+    _executor: ExecutorGuard,
+    _reactor: tokio::runtime::EnterGuard<'static>,
+}
+impl Drop for LanceHostExecutorScope {
+    fn drop(&mut self) {
+        CURRENT.with(|current| current.replace(self.previous.take()));
+    }
+}
+
+fn ffi<T>(fallback: T, operation: impl FnOnce() -> Result<T, String>) -> T {
+    match catch_unwind(AssertUnwindSafe(operation)) {
+        Ok(Ok(value)) => {
+            clear_last_error();
+            value
+        }
+        Ok(Err(error)) => {
+            set_last_error(LanceErrorCode::InvalidArgument, error);
+            fallback
+        }
+        Err(_) => {
+            set_last_error(LanceErrorCode::Panic, "panic in host executor API");
+            fallback
+        }
+    }
+}
+
+/// Create an executor, retaining the callback context once. Null options are invalid.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn lance_host_executor_new_v1(
+    options: *const LanceHostExecutorOptionsV1,
+) -> *mut LanceHostExecutor {
+    ffi(std::ptr::null_mut(), || {
+        if options.is_null() {
+            return Err("host executor options must not be NULL".into());
+        }
+        // Read the fixed prefix before accessing v1 fields: an older/smaller descriptor must
+        // be rejected without reading past the memory the caller supplied.
+        let prefix = options.cast::<u32>();
+        let version = unsafe { prefix.read() };
+        let size = unsafe { prefix.add(1).read() };
+        if version != 1 || size < std::mem::size_of::<LanceHostExecutorOptionsV1>() as u32 {
+            return Err(format!(
+                "unsupported host executor ABI version {version}, struct_size {size}"
+            ));
+        }
+        let options = unsafe { options.read() };
+        if options.retain_context.is_some() != options.release_context.is_some() {
+            return Err(
+                "retain_context and release_context must both be set or both be NULL".into(),
+            );
+        }
+        Ok(Box::into_raw(Box::new(LanceHostExecutor {
+            inner: HostRuntime::new(options),
+        })))
+    })
+}
+
+/// Enter on this thread before any Dataset/Scanner/Arrow-stream operation. Nest in LIFO order.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn lance_host_executor_enter(
+    executor: *const LanceHostExecutor,
+) -> *mut LanceHostExecutorScope {
+    ffi(std::ptr::null_mut(), || {
+        if executor.is_null() {
+            return Err("host executor must not be NULL".into());
+        }
+        let runtime = Arc::clone(&unsafe { &*executor }.inner);
+        let reactor = RT.enter();
+        let executor: Arc<dyn Executor> = runtime.clone();
+        let guard = ExecutorGuard::enter(executor);
+        let previous = CURRENT.with(|current| current.replace(Some(runtime)));
+        Ok(Box::into_raw(Box::new(LanceHostExecutorScope {
+            previous,
+            thread: std::thread::current().id(),
+            _executor: guard,
+            _reactor: reactor,
+        })))
+    })
+}
+
+/// Leave on the entering thread. All nested scopes must already have been left.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn lance_host_executor_leave(scope: *mut LanceHostExecutorScope) -> i32 {
+    ffi(-1, || {
+        if scope.is_null() {
+            return Err("host executor scope must not be NULL".into());
+        }
+        if unsafe { &*scope }.thread != std::thread::current().id() {
+            return Err("host executor scope must be left on its entering thread".into());
+        }
+        unsafe { drop(Box::from_raw(scope)) };
+        Ok(0)
+    })
+}
+
+/// Run at most max_tasks polls of queue 0 (CPU) or 1 (blocking I/O) on this calling thread.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn lance_host_executor_run(
+    executor: *const LanceHostExecutor,
+    queue: u32,
+    max_tasks: u32,
+) -> i64 {
+    ffi(-1, || {
+        if executor.is_null() || queue > 1 || max_tasks == 0 {
+            return Err("host executor, queue 0/1 and positive max_tasks are required".into());
+        }
+        Ok(unsafe { &*executor }.inner.run(queue as usize, max_tasks) as i64)
+    })
+}
+
+/// Number of task polls completed by this executor, including cooperative caller polls.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn lance_host_executor_completed_tasks(
+    executor: *const LanceHostExecutor,
+) -> u64 {
+    if executor.is_null() {
+        return 0;
+    }
+    unsafe { &*executor }
+        .inner
+        .completed
+        .load(Ordering::Relaxed)
+}
+
+/// Retire queues after all operation scopes/calls and their SDK handles have been closed.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn lance_host_executor_free(executor: *mut LanceHostExecutor) {
+    ffi((), || {
+        if !executor.is_null() {
+            let executor = unsafe { Box::from_raw(executor) };
+            executor.inner.retire();
+            drop(executor);
+        }
+        Ok(())
+    });
+}
