+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright The Lance Authors
+
+#![cfg(unix)]
+
+use std::ffi::{CStr, CString, c_char, c_void};
+use std::fs::File;
+use std::os::unix::fs::FileExt;
+use std::path::PathBuf;
+use std::ptr;
+use std::sync::Arc;
+use std::sync::atomic::{AtomicUsize, Ordering};
+
+use arrow_array::{Int64Array, RecordBatch, RecordBatchIterator};
+use arrow_schema::{DataType, Field, Schema};
+use lance_c::*;
+
+struct Storage {
+    root: PathBuf,
+    opens: AtomicUsize,
+    reads: AtomicUsize,
+    closes: AtomicUsize,
+}
+
+impl Storage {
+    unsafe fn path(&self, uri: *const c_char) -> PathBuf {
+        let uri = unsafe { CStr::from_ptr(uri) }.to_str().unwrap();
+        self.root
+            .join(uri.strip_prefix("s3://example-bucket/dataset/").unwrap())
+    }
+}
+
+unsafe extern "C" fn retain(context: *mut c_void) {
+    unsafe { Arc::increment_strong_count(context.cast::<Storage>()) };
+}
+
+unsafe extern "C" fn release(context: *mut c_void) {
+    unsafe { Arc::decrement_strong_count(context.cast::<Storage>()) };
+}
+
+struct OpenFile {
+    file: File,
+    storage: Arc<Storage>,
+}
+
+unsafe extern "C" fn open(
+    context: *mut c_void,
+    uri: *const c_char,
+    out: *mut *mut c_void,
+    meta: *mut LanceHostFileMeta,
+    error: *mut *const c_char,
+) -> i32 {
+    let storage = unsafe { &*context.cast::<Storage>() };
+    let path = unsafe { storage.path(uri) };
+    match File::open(&path) {
+        Ok(file) => {
+            let metadata = file.metadata().unwrap();
+            unsafe { retain(context) };
+            let storage = unsafe { Arc::from_raw(context.cast::<Storage>()) };
+            storage.opens.fetch_add(1, Ordering::SeqCst);
+            unsafe {
+                *meta = LanceHostFileMeta {
+                    size: metadata.len(),
+                    modified_seconds: 0,
+                };
+                *out = Box::into_raw(Box::new(OpenFile { file, storage })).cast();
+            }
+            0
+        }
+        Err(err) => {
+            unsafe { *error = c"host open failed".as_ptr() };
+            if err.kind() == std::io::ErrorKind::NotFound {
+                1
+            } else {
+                2
+            }
+        }
+    }
+}
+
+unsafe extern "C" fn read_at(
+    file: *mut c_void,
+    offset: u64,
+    out: *mut u8,
+    len: usize,
+    bytes_read: *mut usize,
+    error: *mut *const c_char,
+) -> i32 {
+    let file = unsafe { &*file.cast::<OpenFile>() };
+    let buffer = unsafe { std::slice::from_raw_parts_mut(out, len) };
+    match file.file.read_at(buffer, offset) {
+        Ok(n) => {
+            file.storage.reads.fetch_add(1, Ordering::SeqCst);
+            unsafe { *bytes_read = n };
+            0
+        }
+        Err(_) => {
+            unsafe { *error = c"host read failed".as_ptr() };
+            2
+        }
+    }
+}
+
+unsafe extern "C" fn close(file: *mut c_void) {
+    let file = unsafe { Box::from_raw(file.cast::<OpenFile>()) };
+    file.storage.closes.fetch_add(1, Ordering::SeqCst);
+}
+
+unsafe extern "C" fn list(
+    context: *mut c_void,
+    uri: *const c_char,
+    emit: Option<LanceHostListEntry>,
+    emit_context: *mut c_void,
+    _: *mut *const c_char,
+) -> i32 {
+    let storage = unsafe { &*context.cast::<Storage>() };
+    let root = unsafe { storage.path(uri) };
+    if !root.exists() {
+        return 0;
+    }
+    let mut pending = vec![root];
+    while let Some(directory) = pending.pop() {
+        for entry in std::fs::read_dir(directory).unwrap() {
+            let entry = entry.unwrap();
+            if entry.file_type().unwrap().is_dir() {
+                pending.push(entry.path());
+                continue;
+            }
+            let name = entry.path();
+            let relative = name.strip_prefix(&storage.root).unwrap();
+            let uri = CString::new(format!(
+                "s3://example-bucket/dataset/{}",
+                relative.display()
+            ))
+            .unwrap();
+            let meta = LanceHostFileMeta {
+                size: entry.metadata().unwrap().len(),
+                modified_seconds: 0,
+            };
+            if unsafe { emit.unwrap()(emit_context, uri.as_ptr(), &meta) } != 0 {
+                return 2;
+            }
+        }
+    }
+    0
+}
+
+#[test]
+fn all_dataset_bytes_come_from_the_host_and_handles_outlive_open_options() {
+    let temp = tempfile::tempdir().unwrap();
+    let schema = Arc::new(Schema::new(vec![Field::new(
+        "value",
+        DataType::Int64,
+        false,
+    )]));
+    let batch = RecordBatch::try_new(
+        schema.clone(),
+        vec![Arc::new(Int64Array::from_iter_values(0..128))],
+    )
+    .unwrap();
+    let batches = RecordBatchIterator::new(vec![Ok(batch)], schema);
+    lance_c::runtime::block_on(async {
+        lance::Dataset::write(Box::new(batches), temp.path().to_str().unwrap(), None)
+            .await
+            .unwrap();
+    });
+    for version in [0, 1] {
+        let storage = Arc::new(Storage {
+            root: temp.path().to_path_buf(),
+            opens: AtomicUsize::new(0),
+            reads: AtomicUsize::new(0),
+            closes: AtomicUsize::new(0),
+        });
+        let namespace = CString::new("host-fixture").unwrap();
+        let options = LanceHostStorageOptionsV1 {
+            abi_version: 1,
+            struct_size: std::mem::size_of::<LanceHostStorageOptionsV1>() as u32,
+            context: Arc::as_ptr(&storage) as *mut c_void,
+            retain_context: Some(retain),
+            release_context: Some(release),
+            cache_namespace: namespace.as_ptr(),
+            open: Some(open),
+            read_at: Some(read_at),
+            close: Some(close),
+            list: Some(list),
+        };
+        let uri = CString::new("s3://example-bucket/dataset").unwrap();
+        let session = lance_session_new(0, 0);
+        let dataset = unsafe {
+            lance_dataset_open_with_storage_v1(
+                uri.as_ptr(),
+                ptr::null(),
+                version,
+                session,
+                &options,
+            )
+        };
+        if dataset.is_null() {
+            let error = lance_last_error_message();
+            let message = unsafe { CStr::from_ptr(error) }
+                .to_string_lossy()
+                .into_owned();
+            unsafe { lance_free_string(error) };
+            panic!("{message}");
+        }
+        drop(namespace);
+        unsafe { lance_session_close(session) };
+        let scanner = unsafe { lance_scanner_new(dataset, ptr::null(), ptr::null()) };
+        assert!(!scanner.is_null());
+        let mut rows = 0;
+        loop {
+            let mut batch = ptr::null_mut();
+            let status = unsafe { lance_scanner_next(scanner, &mut batch) };
+            if status == 1 {
+                break;
+            }
+            assert_eq!(status, 0);
+            let mut array = arrow::ffi::FFI_ArrowArray::empty();
+            let mut schema = arrow::ffi::FFI_ArrowSchema::empty();
+            assert_eq!(
+                unsafe { lance_batch_to_arrow(batch, &mut array, &mut schema) },
+                0
+            );
+            rows += unsafe { arrow::ffi::from_ffi(array, &schema) }
+                .unwrap()
+                .len();
+            unsafe { lance_batch_free(batch) };
+        }
+        assert_eq!(rows, 128);
+        unsafe {
+            lance_scanner_close(scanner);
+            lance_dataset_close(dataset);
+        }
+        assert!(storage.reads.load(Ordering::SeqCst) > 0);
+        assert_eq!(
+            storage.opens.load(Ordering::SeqCst),
+            storage.closes.load(Ordering::SeqCst)
+        );
+        assert_eq!(Arc::strong_count(&storage), 1);
+    }
+}
+
+#[test]
+fn invalid_storage_descriptors_fail_without_retaining_context() {
+    let uri = c"s3://example-bucket/dataset";
+    assert!(
+        unsafe {
