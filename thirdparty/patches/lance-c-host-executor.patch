+//! Retained host memory-account registration. Allocation failures never unwind across C.
+use crate::error::ffi_try;
+use crate::host_executor::LanceHostExecutor;
+use lance_core::utils::memory::{self, MemoryAccount};
+
+pub type LanceHostMemoryAccountOptionsV1 = memory::MemoryAccountOptions;
+
+#[repr(C)]
+#[derive(Clone, Copy)]
+pub struct LanceHostMemoryServicesOptionsV1 {
+    pub abi_version: u32,
+    pub struct_size: u32,
+    pub background: LanceHostMemoryAccountOptionsV1,
+    pub index_cache: LanceHostMemoryAccountOptionsV1,
+    pub metadata_cache: LanceHostMemoryAccountOptionsV1,
+}
+
+unsafe fn read_account(
+    options: *const LanceHostMemoryAccountOptionsV1,
+) -> lance_core::Result<LanceHostMemoryAccountOptionsV1> {
+    if options.is_null() {
+        return Err(lance_core::Error::invalid_input(
+            "host memory account must not be NULL",
+        ));
+    }
+    let prefix = options.cast::<u32>();
+    if unsafe { prefix.read() } != 1
+        || unsafe { prefix.add(1).read() }
+            < std::mem::size_of::<LanceHostMemoryAccountOptionsV1>() as u32
+    {
+        return Err(lance_core::Error::invalid_input(
+            "unsupported host memory account descriptor",
+        ));
+    }
+    let options = unsafe { options.read() };
+    if options.retain_context.is_some() != options.release_context.is_some() {
+        return Err(lance_core::Error::invalid_input(
+            "host memory context retain/release callbacks must be paired",
+        ));
+    }
+    Ok(options)
+}
+
+/// Install process-lifetime ledgers before opening SDK sessions and readers.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn lance_runtime_install_memory_services_v1(
+    options: *const LanceHostMemoryServicesOptionsV1,
+) -> i32 {
+    ffi_try!(
+        (|| {
+            if options.is_null() {
+                return Err(lance_core::Error::invalid_input(
+                    "host memory services must not be NULL",
+                ));
+            }
+            let prefix = options.cast::<u32>();
+            if unsafe { prefix.read() } != 1
+                || unsafe { prefix.add(1).read() }
+                    < std::mem::size_of::<LanceHostMemoryServicesOptionsV1>() as u32
+            {
+                return Err(lance_core::Error::invalid_input(
+                    "unsupported host memory services descriptor",
+                ));
+            }
+            let options = unsafe { &*options };
+            let background = unsafe { MemoryAccount::new(read_account(&options.background)?) }?;
+            let index = unsafe { MemoryAccount::new(read_account(&options.index_cache)?) }?;
+            let metadata = unsafe { MemoryAccount::new(read_account(&options.metadata_cache)?) }?;
+            memory::install_accounts(background, index, metadata)?;
+            Ok(0)
+        })(),
+        neg
+    )
+}
+
+/// Attach one query ledger before the executor is entered or any work is submitted.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn lance_host_executor_set_memory_v1(
+    executor: *const LanceHostExecutor,
+    options: *const LanceHostMemoryAccountOptionsV1,
+) -> i32 {
+    ffi_try!(
+        (|| {
+            if executor.is_null() {
+                return Err(lance_core::Error::invalid_input(
+                    "host executor must not be NULL",
+                ));
+            }
+            let account = unsafe { MemoryAccount::new(read_account(options)?) }?;
+            unsafe { &*executor }
+                .inner
+                .memory
+                .set(account)
+                .map_err(|_| {
+                    lance_core::Error::invalid_input("host executor memory account is already set")
+                })?;
+            Ok(0)
+        })(),
+        neg
+    )
+}
diff --git a/src/host_services.rs b/src/host_services.rs
--- /dev/null
+++ b/src/host_services.rs
@@ -0,0 +1,166 @@
+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright The Lance Authors
+
+//! Process services whose threads and shutdown are owned by the embedding host.
+
+use crate::error::{LanceErrorCode, set_last_error};
+use lance_core::utils::task_executor::{self, Executor, Task, TaskKind};
+use std::ffi::c_void;
+use std::panic::{AssertUnwindSafe, catch_unwind};
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::{Arc, OnceLock};
+
+pub type RunTask = unsafe extern "C" fn(*mut c_void);
+pub type SubmitTask = unsafe extern "C" fn(*mut c_void, u32, RunTask, RunTask, *mut c_void);
+
+/// A submit callback consumes each task and must eventually run or discard it exactly once.
+#[repr(C)]
+#[derive(Clone, Copy)]
+pub struct LanceHostServicesOptionsV1 {
+    pub abi_version: u32,
+    pub struct_size: u32,
+    pub context: *mut c_void,
+    pub submit: Option<SubmitTask>,
+}
+
+pub(crate) struct HostServices {
+    pub context: usize,
+    pub submit: SubmitTask,
+}
+pub(crate) static SERVICES: OnceLock<Arc<HostServices>> = OnceLock::new();
+static DRIVING: AtomicBool = AtomicBool::new(false);
+static STOPPING: std::sync::Mutex<()> = std::sync::Mutex::new(());
+static STOPPED: AtomicBool = AtomicBool::new(false);
+static STOP: tokio::sync::Notify = tokio::sync::Notify::const_new();
+
+struct NativeTask(Option<Task>);
+unsafe extern "C" fn run_task(context: *mut c_void) {
+    let _ = catch_unwind(AssertUnwindSafe(|| {
+        let mut task = unsafe { Box::from_raw(context.cast::<NativeTask>()) };
+        if let Some(task) = task.0.take() {
+            task();
+        }
+    }));
+}
+unsafe extern "C" fn discard_task(context: *mut c_void) {
+    let _ = catch_unwind(AssertUnwindSafe(|| {
+        let task = unsafe { Box::from_raw(context.cast::<NativeTask>()) };
+        // Rejection may occur inside a wake callback that holds an SDK lock. Future
+        // destruction is handed off to host cleanup workers, outside that callback stack.
+        task_executor::defer_drop(crate::runtime::RT.handle().clone(), task);
+    }));
+}
+
+pub(crate) fn submit(submit: SubmitTask, context: usize, kind: TaskKind, task: Task) {
+    let task = Box::into_raw(Box::new(NativeTask(Some(task))));
+    let queue = match kind {
+        TaskKind::Cpu => 0,
+        TaskKind::Io => 1,
+        TaskKind::Cleanup => 2,
+    };
+    unsafe {
+        submit(
+            context as *mut c_void,
+            queue,
+            run_task,
+            discard_task,
+            task.cast(),
+        )
+    };
+}
+impl Executor for HostServices {
+    fn schedule(&self, kind: TaskKind, task: Task) {
+        submit(self.submit, self.context, kind, task);
+    }
+}
+
+/// Install before the first Doris Lance call. Context must outlive all SDK calls and the driver.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn lance_runtime_install_host_services_v1(
+    options: *const LanceHostServicesOptionsV1,
+) -> i32 {
+    if options.is_null() {
+        return -1;
+    }
+    let prefix = options.cast::<u32>();
+    if unsafe { prefix.read() } != 1
+        || unsafe { prefix.add(1).read() }
+            < std::mem::size_of::<LanceHostServicesOptionsV1>() as u32
+    {
+        return -1;
+    }
+    let options = unsafe { &*options };
+    if options.abi_version != 1
+        || options.struct_size < std::mem::size_of::<LanceHostServicesOptionsV1>() as u32
+        || options.submit.is_none()
+    {
+        set_last_error(
+            LanceErrorCode::InvalidArgument,
+            "invalid host runtime services descriptor",
+        );
+        return -1;
+    }
+    let service = Arc::new(HostServices {
+        context: options.context as usize,
+        submit: options.submit.unwrap(),
+    });
+    if SERVICES.set(service.clone()).is_err() {
+        set_last_error(
+            LanceErrorCode::InvalidArgument,
+            "host runtime services already installed",
+        );
+        return -1;
+    }
+    task_executor::set_default_executor(service);
+    0
+}
+
+/// Drive the threadless Tokio reactor on a host-owned service thread until stop is requested.
+#[unsafe(no_mangle)]
+pub extern "C" fn lance_runtime_drive() -> i32 {
+    catch_unwind(AssertUnwindSafe(|| {
+        if SERVICES.get().is_none() {
+            return -1;
+        }
+        if DRIVING
+            .compare_exchange(false, true, Ordering::AcqRel, Ordering::Acquire)
+            .is_err()
+        {
+            return -1;
+        }
+        struct Driving;
+        impl Drop for Driving {
+            fn drop(&mut self) {
+                DRIVING.store(false, Ordering::Release);
+            }
+        }
+        let _driving = Driving;
+        crate::runtime::HOST_RT.block_on(async {
+            while !STOPPED.load(Ordering::Acquire) {
+                STOP.notified().await;
+            }
+        });
+        0
+    }))
+    .unwrap_or(-1)
+}
+
+/// Call after all sessions and readers are closed; keep the reactor driver alive until return.
+#[unsafe(no_mangle)]
+pub extern "C" fn lance_runtime_stop() {
+    let _stop = STOPPING.lock().unwrap_or_else(|error| error.into_inner());
+    if STOPPED.load(Ordering::Acquire) {
+        return;
+    }
+    // Rejected I/O jobs may still own callback completions on the live reactor.
+    // Finish those before stopping the driver that performs deferred destruction.
+    crate::async_dispatcher::drain_host_callbacks();
+    let (sender, receiver) = std::sync::mpsc::sync_channel(1);
+    crate::runtime::RT.spawn(async move {
+        task_executor::drain_deferred_drops().await;
+        let _ = sender.send(());
+    });
+    let _ = receiver.recv();
+    STOPPED.store(true, Ordering::Release);
+    STOP.notify_one();
+}
diff --git a/src/host_storage.rs b/src/host_storage.rs
--- /dev/null
+++ b/src/host_storage.rs
@@ -0,0 +1,705 @@
+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright The Lance Authors
+
+//! Read-only storage implemented by the embedding application's file readers.
+
+use std::ffi::{CStr, CString, c_char, c_void};
+use std::fmt::{Debug, Display, Formatter};
+use std::sync::Arc;
+
+use async_trait::async_trait;
+use bytes::Bytes;
+use chrono::{DateTime, Utc};
+use futures::stream::{self, BoxStream};
+use futures::{StreamExt, TryStreamExt};
+use lance::dataset::builder::DatasetBuilder;
+use lance::session::Session;
+use lance_core::utils::task_executor::{self, TaskKind};
+use lance_io::object_store::{
+    ObjectStore as LanceObjectStore, ObjectStoreParams, ObjectStoreProvider, ObjectStoreRegistry,
+    uri_to_url,
+};
+use object_store::path::Path;
+use object_store::{
+    CopyOptions, GetOptions, GetResult, GetResultPayload, ListResult, MultipartUpload, ObjectMeta,
+    ObjectStore, PutMultipartOptions, PutOptions, PutPayload, PutResult,
+};
+use url::Url;
+
+use crate::dataset::LanceDataset;
+use crate::error::ffi_try;
+use crate::helpers;
+use crate::runtime::block_on;
+use crate::session::LanceSession;
+
+#[repr(C)]
+#[derive(Clone, Copy)]
+pub struct LanceHostFileMeta {
+    pub size: u64,
+    pub modified_seconds: i64,
+}
+
+pub type LanceHostListEntry =
+    unsafe extern "C" fn(*mut c_void, *const c_char, *const LanceHostFileMeta) -> i32;
+
+/// Callbacks must be thread-safe. A successful open transfers one handle to close.
+/// Errors are 1 for not-found and 2 for other failures. Error text is copied before return.
+#[repr(C)]
+#[derive(Clone, Copy)]
+pub struct LanceHostStorageOptionsV1 {
+    pub abi_version: u32,
+    pub struct_size: u32,
+    pub context: *mut c_void,
+    pub retain_context: Option<unsafe extern "C" fn(*mut c_void)>,
+    pub release_context: Option<unsafe extern "C" fn(*mut c_void)>,
+    pub cache_namespace: *const c_char,
+    pub open: Option<
+        unsafe extern "C" fn(
+            *mut c_void,
+            *const c_char,
+            *mut *mut c_void,
+            *mut LanceHostFileMeta,
+            *mut *const c_char,
+        ) -> i32,
+    >,
+    pub read_at: Option<
+        unsafe extern "C" fn(
+            *mut c_void,
+            u64,
+            *mut u8,
+            usize,
+            *mut usize,
+            *mut *const c_char,
+        ) -> i32,
+    >,
+    pub close: Option<unsafe extern "C" fn(*mut c_void)>,
+    pub list: Option<
+        unsafe extern "C" fn(
+            *mut c_void,
+            *const c_char,
+            Option<LanceHostListEntry>,
+            *mut c_void,
+            *mut *const c_char,
+        ) -> i32,
+    >,
+}
+
+struct HostStorage {
+    callbacks: LanceHostStorageOptionsV1,
+    namespace: String,
+}
+
+// The C contract requires all callbacks and retained context to support concurrent calls.
+unsafe impl Send for HostStorage {}
+unsafe impl Sync for HostStorage {}
+
+impl Debug for HostStorage {
+    fn fmt(&self, f: &mut Formatter<'_>) -> std::fmt::Result {
+        f.write_str("HostStorage")
+    }
+}
+
+impl Drop for HostStorage {
+    fn drop(&mut self) {
+        unsafe { self.callbacks.release_context.unwrap()(self.callbacks.context) };
+    }
+}
+
+fn io_error(code: i32, path: &str, error: *const c_char) -> object_store::Error {
+    let message = if error.is_null() {
+        "host storage operation failed".into()
+    } else {
+        unsafe { CStr::from_ptr(error) }
+            .to_string_lossy()
+            .into_owned()
+    };
+    let source = Box::new(std::io::Error::other(message));
+    if code == 1 {
+        object_store::Error::NotFound {
+            path: path.into(),
+            source,
+        }
+    } else {
+        object_store::Error::Generic {
+            store: "host",
+            source,
+        }
+    }
+}
+
+fn read_only() -> object_store::Error {
+    object_store::Error::NotSupported {
+        source: Box::new(std::io::Error::other("host storage is read-only")),
+    }
+}
+
+async fn on_io<F, T>(function: F) -> object_store::Result<T>
+where
+    F: FnOnce() -> object_store::Result<T> + Send + 'static,
+    T: Send + 'static,
+{
+    task_executor::spawn_blocking(TaskKind::Io, function)
+        .await
+        .map_err(|error| object_store::Error::Generic {
+            store: "host",
+            source: Box::new(error),
+        })?
+}
+
+struct HostFile {
+    storage: Arc<HostStorage>,
+    handle: usize,
+    meta: LanceHostFileMeta,
+}
+
+impl Drop for HostFile {
+    fn drop(&mut self) {
+        unsafe { self.storage.callbacks.close.unwrap()(self.handle as *mut c_void) };
+    }
+}
+
+impl HostFile {
+    async fn open(storage: Arc<HostStorage>, uri: String) -> object_store::Result<Arc<Self>> {
+        on_io(move || {
+            let path = CString::new(uri.clone()).map_err(|error| object_store::Error::Generic {
+                store: "host",
+                source: Box::new(error),
+            })?;
+            let mut handle = std::ptr::null_mut();
+            let mut meta = LanceHostFileMeta {
+                size: 0,
+                modified_seconds: 0,
+            };
+            let mut error = std::ptr::null();
+            let code = unsafe {
+                storage.callbacks.open.unwrap()(
+                    storage.callbacks.context,
+                    path.as_ptr(),
+                    &mut handle,
+                    &mut meta,
+                    &mut error,
+                )
+            };
+            if code != 0 {
+                return Err(io_error(code, &uri, error));
+            }
+            if handle.is_null() {
+                return Err(io_error(2, &uri, std::ptr::null()));
+            }
+            Ok(Arc::new(Self {
+                storage,
+                handle: handle as usize,
+                meta,
+            }))
+        })
+        .await
+    }
+
+    async fn read(self: Arc<Self>, offset: u64, length: usize) -> object_store::Result<Bytes> {
+        on_io(move || {
+            // Admission precedes both allocation and read_at; a query cap must return
+            // an error instead of making Rust's infallible Vec allocation abort the BE.
+            let mut bytes =
+                lance_core::utils::memory::OwnedBuffer::try_zeroed(length).map_err(|source| {
+                    object_store::Error::Generic {
+                        store: "host",
+                        source: Box::new(source),
+                    }
+                })?;
+            let mut count = 0;
+            let mut error = std::ptr::null();
+            let code = unsafe {
+                self.storage.callbacks.read_at.unwrap()(
+                    self.handle as *mut c_void,
+                    offset,
+                    bytes.as_mut_ptr(),
+                    length,
+                    &mut count,
+                    &mut error,
+                )
+            };
+            if code != 0 {
+                return Err(io_error(code, "read_at", error));
+            }
+            if count != length {
+                return Err(object_store::Error::Generic {
+                    store: "host",
+                    source: Box::new(std::io::Error::new(
+                        std::io::ErrorKind::UnexpectedEof,
+                        "host read returned fewer bytes than requested",
+                    )),
+                });
+            }
+            Ok(Bytes::from_owner(bytes))
+        })
+        .await
+    }
+}
+
+#[derive(Debug)]
+struct HostProvider {
+    storage: Arc<HostStorage>,
+}
+
+#[async_trait]
+impl ObjectStoreProvider for HostProvider {
+    async fn new_store(
+        &self,
+        base: Url,
+        params: &ObjectStoreParams,
+    ) -> lance_core::Result<LanceObjectStore> {
+        let prefix = self.calculate_object_store_prefix(&base, None)?;
+        LanceObjectStore::with_host_store(
+            Arc::new(HostObjectStore {
+                storage: self.storage.clone(),
+                base,
+            }),
+            prefix,
+            params,
+        )
+    }
+
+    fn calculate_object_store_prefix(
+        &self,
+        url: &Url,
+        _: Option<&std::collections::HashMap<String, String>>,
+    ) -> lance_core::Result<String> {
+        Ok(format!(
+            "host${}${}${}",
+            self.storage.namespace,
+            url.scheme(),
+            url.authority()
+        ))
+    }
+}
+
+#[derive(Debug, Clone)]
+struct HostObjectStore {
+    storage: Arc<HostStorage>,
+    base: Url,
+}
+
+impl Display for HostObjectStore {
+    fn fmt(&self, f: &mut Formatter<'_>) -> std::fmt::Result {
+        f.write_str("HostObjectStore")
+    }
+}
+
+impl HostObjectStore {
+    fn uri(&self, path: &Path) -> String {
+        let mut url = self.base.clone();
+        // Segment encoding also escapes literal percent signs and backslashes in object keys.
+        url.path_segments_mut()
+            .expect("host stores have hierarchical URLs")
+            .clear()
+            .extend(path.as_ref().split('/'));
+        url.set_query(None);
+        url.set_fragment(None);
+        url.to_string()
+    }
+
+    fn metadata(path: Path, meta: LanceHostFileMeta) -> ObjectMeta {
+        ObjectMeta {
+            location: path,
+            size: meta.size,
+            last_modified: DateTime::<Utc>::from_timestamp(meta.modified_seconds, 0)
+                .unwrap_or_default(),
+            e_tag: None,
+            version: None,
+        }
+    }
+
+    async fn list_files(&self, prefix: Option<&Path>) -> object_store::Result<Vec<ObjectMeta>> {
+        struct Entries {
+            files: Vec<ObjectMeta>,
+            error: Option<object_store::Error>,
+        }
+        unsafe extern "C" fn entry(
+            context: *mut c_void,
+            uri: *const c_char,
+            meta: *const LanceHostFileMeta,
+        ) -> i32 {
+            let entries = unsafe { &mut *context.cast::<Entries>() };
+            let result = (|| {
+                let uri = unsafe { CStr::from_ptr(uri) }.to_str().map_err(|error| {
+                    object_store::Error::Generic {
+                        store: "host",
+                        source: Box::new(error),
+                    }
+                })?;
+                let url = Url::parse(uri).map_err(|error| object_store::Error::Generic {
+                    store: "host",
+                    source: Box::new(error),
+                })?;
+                let path = Path::from_url_path(url.path())?;
+                Ok(HostObjectStore::metadata(path, unsafe { *meta }))
+            })();
+            match result {
+                Ok(meta) => {
+                    entries.files.push(meta);
+                    0
+                }
+                Err(error) => {
+                    entries.error = Some(error);
+                    2
+                }
+            }
+        }
+        let this = self.clone();
+        let uri = this.uri(prefix.unwrap_or(&Path::default()));
+        on_io(move || {
+            let path = CString::new(uri.clone()).map_err(|error| object_store::Error::Generic {
+                store: "host",
+                source: Box::new(error),
+            })?;
+            let mut entries = Entries {
+                files: Vec::new(),
+                error: None,
+            };
+            let mut error = std::ptr::null();
+            let code = unsafe {
+                this.storage.callbacks.list.unwrap()(
+                    this.storage.callbacks.context,
+                    path.as_ptr(),
+                    Some(entry),
+                    (&mut entries as *mut Entries).cast(),
+                    &mut error,
+                )
+            };
+            if let Some(error) = entries.error {
+                return Err(error);
+            }
+            if code != 0 {
+                return Err(io_error(code, &uri, error));
+            }
+            entries.files.sort_by(|a, b| a.location.cmp(&b.location));
+            Ok(entries.files)
+        })
+        .await
+    }
+}
+
+#[async_trait]
+impl ObjectStore for HostObjectStore {
+    async fn put_opts(
+        &self,
+        _: &Path,
+        _: PutPayload,
+        _: PutOptions,
+    ) -> object_store::Result<PutResult> {
+        Err(read_only())
+    }
+    async fn put_multipart_opts(
+        &self,
+        _: &Path,
+        _: PutMultipartOptions,
+    ) -> object_store::Result<Box<dyn MultipartUpload>> {
+        Err(read_only())
+    }
+
+    async fn get_opts(
+        &self,
+        location: &Path,
+        options: GetOptions,
+    ) -> object_store::Result<GetResult> {
+        if options.version.is_some() {
+            return Err(read_only());
+        }
+        let file = HostFile::open(self.storage.clone(), self.uri(location)).await?;
+        let meta = Self::metadata(location.clone(), file.meta);
+        options.check_preconditions(&meta)?;
+        let range = match options.range {
+            Some(range) => {
+                range
+                    .as_range(meta.size)
+                    .map_err(|error| object_store::Error::Generic {
+                        store: "host",
+                        source: Box::new(error),
+                    })?
+            }
+            None => 0..meta.size,
+        };
+        let payload = if options.head {
+            stream::empty().boxed()
+        } else {
+            // Whole-object metadata reads remain streaming; never allocate the whole file here.
+            stream::try_unfold((file, range.clone()), |(file, range)| async move {
+                if range.is_empty() {
+                    return Ok(None);
+                }
+                let length = (range.end - range.start).min(1024 * 1024) as usize;
+                let bytes = file.clone().read(range.start, length).await?;
+                let next = range.start + length as u64..range.end;
+                Ok(Some((bytes, (file, next))))
+            })
+            .boxed()
+        };
+        Ok(GetResult {
+            payload: GetResultPayload::Stream(payload),
+            meta,
+            range,
+            attributes: Default::default(),
+            extensions: Default::default(),
+        })
+    }
+
+    fn delete_stream(
+        &self,
+        locations: BoxStream<'static, object_store::Result<Path>>,
+    ) -> BoxStream<'static, object_store::Result<Path>> {
+        locations.map(|_| Err(read_only())).boxed()
+    }
+
+    fn list(&self, prefix: Option<&Path>) -> BoxStream<'static, object_store::Result<ObjectMeta>> {
+        let this = self.clone();
+        let prefix = prefix.cloned();
+        stream::once(async move { this.list_files(prefix.as_ref()).await })
+            .map_ok(|files| stream::iter(files.into_iter().map(Ok)))
+            .try_flatten()
+            .boxed()
+    }
+
+    async fn list_with_delimiter(&self, prefix: Option<&Path>) -> object_store::Result<ListResult> {
+        let files = self.list_files(prefix).await?;
+        let prefix = prefix.map_or("", Path::as_ref).trim_end_matches('/');
+        let mut result = ListResult {
+            common_prefixes: Vec::new(),
+            objects: Vec::new(),
+            extensions: Default::default(),
+        };
+        let mut directories = std::collections::BTreeSet::new();
+        for meta in files {
+            let relative = meta
+                .location
+                .as_ref()
+                .strip_prefix(prefix)
+                .unwrap_or(meta.location.as_ref())
+                .trim_start_matches('/');
+            if let Some((directory, _)) = relative.split_once('/') {
+                directories.insert(Path::from(if prefix.is_empty() {
+                    directory.into()
+                } else {
+                    format!("{prefix}/{directory}")
+                }));
+            } else {
+                result.objects.push(meta);
+            }
+        }
+        result.common_prefixes.extend(directories);
+        Ok(result)
+    }
+
+    async fn copy_opts(&self, _: &Path, _: &Path, _: CopyOptions) -> object_store::Result<()> {
+        Err(read_only())
+    }
+}
+
+/// Open through host callbacks from the first manifest read; native storage is never a fallback.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn lance_dataset_open_with_storage_v1(
+    uri: *const c_char,
+    storage_options: *const *const c_char,
+    version: u64,
+    session: *const LanceSession,
+    options: *const LanceHostStorageOptionsV1,
+) -> *mut LanceDataset {
+    ffi_try!(
+        unsafe { open_inner(uri, storage_options, version, session, options) },
+        null
+    )
+}
+
+unsafe fn open_inner(
+    uri: *const c_char,
+    storage_options: *const *const c_char,
+    version: u64,
+    session: *const LanceSession,
+    options: *const LanceHostStorageOptionsV1,
+) -> lance_core::Result<*mut LanceDataset> {
+    let invalid = || lance_core::Error::invalid_input("invalid host storage descriptor");
+    if options.is_null() {
+        return Err(invalid());
+    }
+    let header = options.cast::<u32>();
+    if unsafe { header.read() } != 1
+        || unsafe { header.add(1).read() } < std::mem::size_of::<LanceHostStorageOptionsV1>() as u32
+    {
+        return Err(invalid());
+    }
+    let mut callbacks = unsafe { *options };
+    if callbacks.context.is_null()
+        || callbacks.retain_context.is_none()
+        || callbacks.release_context.is_none()
+        || callbacks.open.is_none()
+        || callbacks.read_at.is_none()
+        || callbacks.close.is_none()
+        || callbacks.list.is_none()
+    {
+        return Err(invalid());
+    }
+    lance_core::utils::memory::check_current()?;
+    // Cached indices can retain the store after this dataset/query closes. Its
+    // callbacks, namespace and object-store wrappers must share that lifetime's owner.
+    let owner = if session.is_null() {
+        lance_core::utils::memory::current_account()
+    } else {
+        unsafe { &*session }.inner.storage_memory_account()
+    };
+    let memory_scope = lance_core::utils::memory::MemoryGuard::enter(owner);
+    let namespace = unsafe { helpers::parse_c_string(callbacks.cache_namespace)? }
+        .filter(|s| !s.is_empty())
+        .ok_or_else(invalid)?
+        .to_owned();
+    let uri = unsafe { helpers::parse_c_string(uri)? }.ok_or_else(invalid)?;
+    let uri = uri_to_url(uri)?;
+    if uri.query().is_some()
+        || uri.fragment().is_some()
+        || !uri.username().is_empty()
+        || uri.password().is_some()
+    {
+        return Err(lance_core::Error::invalid_input(
+            "host storage does not support credentials or parameters embedded in the dataset URI",
+        ));
+    }
+    let uri = uri.to_string();
+    let settings = unsafe { helpers::parse_storage_options(storage_options)? };
+    // The descriptor and its strings may disappear immediately after this call returns.
+    callbacks.cache_namespace = std::ptr::null();
+    unsafe { callbacks.retain_context.unwrap()(callbacks.context) };
+    let storage = Arc::new(HostStorage {
+        callbacks,
+        namespace,
+    });
+    let registry = Arc::new(ObjectStoreRegistry::empty());
+    let provider = Arc::new(HostProvider {
+        storage: storage.clone(),
+    });
+    for scheme in [
+        "file",
+        "file+uring",
+        "s3",
+        "s3a",
+        "oss",
+        "hdfs",
+        "http",
+        "https",
+        "az",
+        "gs",
+        "hf",
+        "goosefs",
+        "tos",
+        "cos",
+        "memory",
+    ] {
+        registry.insert(scheme, provider.clone());
+    }
+    let base = if session.is_null() {
+        Arc::new(Session::new(0, 0, registry.clone()))
+    } else {
+        unsafe { &*session }.inner.clone()
+    };
+    let scoped = Arc::new(base.with_host_storage(registry, &storage.namespace));
+    let mut builder = DatasetBuilder::from_uri(&uri).with_session(scoped);
+    if !settings.is_empty() {
+        builder = builder.with_storage_options(settings);
+    }
+    if version != 0 {
+        builder = builder.with_version(version);
+    }
+    let dataset = block_on(builder.load())?;
+    lance_core::utils::memory::check_current()?;
+    drop(memory_scope);
+    lance_core::utils::memory::check_current()?;
+    Ok(Box::into_raw(Box::new(LanceDataset {
+        inner: std::sync::RwLock::new(Arc::new(dataset)),
+    })))
+}
