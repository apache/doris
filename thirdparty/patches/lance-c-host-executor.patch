+unsafe extern "C" fn open_file(
+    context: *mut c_void,
+    uri: *const c_char,
+    out: *mut *mut c_void,
+    meta: *mut LanceHostFileMeta,
+    error: *mut *const c_char,
+) -> i32 {
+    let storage = unsafe { &*context.cast::<Storage>() };
+    let uri = unsafe { CStr::from_ptr(uri) }.to_str().unwrap();
+    let path = storage
+        .root
+        .join(uri.strip_prefix("s3://memory-fixture/dataset/").unwrap());
+    match File::open(path) {
+        Ok(file) => {
+            let size = file.metadata().unwrap().len();
+            unsafe { retain_storage(context) };
+            let storage = unsafe { Arc::from_raw(context.cast::<Storage>()) };
+            storage.opens.fetch_add(1, Ordering::SeqCst);
+            unsafe {
+                *meta = LanceHostFileMeta {
+                    size,
+                    modified_seconds: 0,
+                };
+                *out = Box::into_raw(Box::new(OpenFile { file, storage })).cast();
+            }
+            0
+        }
+        Err(err) => {
+            unsafe { *error = c"fixture file open failed".as_ptr() };
+            if err.kind() == std::io::ErrorKind::NotFound {
+                1
+            } else {
+                2
+            }
+        }
+    }
