+fn fixture(with_fts: bool) -> (tempfile::TempDir, Arc<Storage>) {
+    use lance::dataset::{WriteMode, WriteParams};
+    let directory = tempfile::tempdir().unwrap();
+    let schema = Arc::new(Schema::new(vec![
+        Field::new("id", DataType::Int64, false),
+        Field::new("payload", DataType::Binary, false),
+        Field::new("body", DataType::Utf8, false),
+    ]));
+    for fragment in 0..3 {
+        let start = fragment * 256;
+        let payloads = (start..start + 256).map(|id| {
+            let mut seed = id as u64 + 1;
+            (0..1024)
+                .map(|_| {
+                    seed ^= seed << 13;
+                    seed ^= seed >> 7;
+                    seed ^= seed << 17;
+                    seed as u8
+                })
+                .collect::<Vec<_>>()
+        });
+        let batch = RecordBatch::try_new(
+            schema.clone(),
+            vec![
+                Arc::new(Int64Array::from_iter_values(start..start + 256)),
+                Arc::new(BinaryArray::from_iter_values(payloads)),
+                Arc::new(StringArray::from_iter_values((start..start + 256).map(
+                    |id| {
+                        if id % 3 == 0 {
+                            "needle shared allocation"
+                        } else {
+                            "ordinary text"
+                        }
+                    },
+                ))),
+            ],
+        )
+        .unwrap();
+        let batches = RecordBatchIterator::new(vec![Ok(batch)], schema.clone());
+        lance_c::runtime::block_on(async {
+            let dataset = lance::Dataset::write(
+                Box::new(batches),
+                directory.path().to_str().unwrap(),
+                Some(WriteParams {
+                    mode: if fragment == 0 {
+                        WriteMode::Create
+                    } else {
+                        WriteMode::Append
+                    },
+                    max_rows_per_file: 256,
+                    ..Default::default()
+                }),
+            )
+            .await
+            .unwrap();
+            assert_eq!(dataset.get_fragments().len(), fragment as usize + 1);
+        });
+    }
+    let version = if with_fts {
+        // Index construction is fixture setup, outside the accounted BE read path.
+        let uri = CString::new(directory.path().to_str().unwrap()).unwrap();
+        let dataset = unsafe { lance_dataset_open(uri.as_ptr(), ptr::null(), 0) };
+        assert!(!dataset.is_null());
+        assert_eq!(
+            unsafe {
+                lance_dataset_create_scalar_index(
+                    dataset,
+                    c"body".as_ptr(),
+                    c"body_fts".as_ptr(),
+                    LanceScalarIndexType::Inverted as i32,
+                    c"{\"base_tokenizer\":\"simple\",\"language\":\"English\"}".as_ptr(),
+                    false,
+                )
+            },
+            0
+        );
+        let version = unsafe { lance_dataset_version(dataset) };
+        unsafe { lance_dataset_close(dataset) };
+        version
+    } else {
+        3
+    };
+    let storage = Arc::new(Storage {
+        root: directory.path().to_path_buf(),
+        version,
+        opens: AtomicUsize::new(0),
+        reads: AtomicUsize::new(0),
+        forbidden_reads: AtomicUsize::new(0),
+        closes: AtomicUsize::new(0),
+    });
+    (directory, storage)
+}
