+    if std::env::var_os(CHILD).is_none() {
+        let status = std::process::Command::new(std::env::current_exe().unwrap())
+            .args([
+                "--exact",
+                "test_host_services_never_create_sdk_threads",
+                "--nocapture",
+            ])
+            .env(CHILD, "1")
+            .status()
+            .unwrap();
+        assert!(status.success());
+        return;
+    }
+    struct Job {
+        run: RunTask,
+        discard: RunTask,
+        context: usize,
+    }
+    impl Job {
+        fn execute(mut self) {
+            let context = std::mem::replace(&mut self.context, 0);
+            unsafe { (self.run)(context as *mut c_void) };
+        }
+    }
+    impl Drop for Job {
+        fn drop(&mut self) {
+            if self.context != 0 {
+                unsafe { (self.discard)(self.context as *mut c_void) };
+            }
+        }
+    }
+    unsafe extern "C" fn submit(
+        context: *mut c_void,
+        _queue: u32,
+        run: RunTask,
+        discard: RunTask,
+        task: *mut c_void,
+    ) {
+        let sender = unsafe { &*context.cast::<std::sync::mpsc::Sender<Option<Job>>>() };
+        let _ = sender.send(Some(Job {
+            run,
+            discard,
+            context: task as usize,
+        }));
+    }
+    let (sender, receiver) = std::sync::mpsc::channel::<Option<Job>>();
+    let sender = Box::new(sender);
+    let receiver = Arc::new(Mutex::new(receiver));
+    let mut workers = Vec::new();
+    for _ in 0..4 {
+        let receiver = receiver.clone();
+        workers.push(std::thread::spawn(move || {
+            loop {
+                let job = receiver.lock().unwrap().recv();
+                match job {
+                    Ok(Some(job)) => job.execute(),
+                    Ok(None) | Err(_) => break,
+                }
+            }
+        }));
+    }
+    let options = LanceHostServicesOptionsV1 {
+        abi_version: 1,
+        struct_size: std::mem::size_of::<LanceHostServicesOptionsV1>() as u32,
+        context: &*sender as *const _ as *mut c_void,
+        submit: Some(submit),
