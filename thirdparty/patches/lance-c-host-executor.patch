+mod common;
+use lance_c::*;
+use std::ffi::c_void;
+use std::sync::{Arc, Mutex, mpsc};
+
+type Job = Box<dyn FnOnce() + Send>;
+unsafe extern "C" fn submit(
+    context: *mut c_void,
+    _: u32,
+    run: unsafe extern "C" fn(*mut c_void),
+    discard: unsafe extern "C" fn(*mut c_void),
+    task: *mut c_void,
+) {
+    struct Pending(usize, unsafe extern "C" fn(*mut c_void));
+    impl Pending {
+        fn run(mut self, run: unsafe extern "C" fn(*mut c_void)) {
+            let context = std::mem::replace(&mut self.0, 0);
+            unsafe { run(context as *mut c_void) };
+        }
+    }
+    impl Drop for Pending {
+        fn drop(&mut self) {
+            if self.0 != 0 {
+                unsafe { (self.1)(self.0 as *mut c_void) };
+            }
+        }
+    }
+    let pending = Pending(task as usize, discard);
+    // Capture the entire guard: a Copy-field capture would discard the native task
+    // before the queued callback runs, leaving a dangling task pointer.
+    let job: Job = Box::new(move || pending.run(run));
+    let sender = unsafe { &*context.cast::<mpsc::Sender<Option<Job>>>() };
+    let _ = sender.send(Some(job));
+}
