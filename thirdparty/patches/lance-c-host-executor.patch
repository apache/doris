diff --git a/tests/host_memory_test.rs b/tests/host_memory_test.rs
--- /dev/null
+++ b/tests/host_memory_test.rs
@@ -0,0 +1,1277 @@
+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright The Lance Authors
+
+#![cfg(target_os = "linux")]
+
+mod common;
+
+use arrow::array::{BinaryArray, Int64Array, StringArray, StructArray};
+use arrow::datatypes::{DataType, Field, Schema};
+use arrow::ffi::{FFI_ArrowArray, FFI_ArrowSchema, from_ffi};
+use arrow::ffi_stream::{ArrowArrayStreamReader, FFI_ArrowArrayStream};
+use arrow::record_batch::{RecordBatch, RecordBatchIterator};
+use lance_c::*;
+use std::ffi::{CStr, CString, c_char, c_void};
+use std::fs::File;
+use std::os::unix::fs::FileExt;
+use std::path::PathBuf;
+use std::ptr;
+use std::sync::atomic::{AtomicBool, AtomicI32, AtomicI64, AtomicUsize, Ordering};
+use std::sync::{Arc, Barrier, Mutex, mpsc};
+use std::time::{Duration, Instant};
+
+const ROWS: i64 = 768;
+const DELTA_BUCKETS: usize = 1024;
+type Job = Box<dyn FnOnce() + Send>;
+type Run = unsafe extern "C" fn(*mut c_void);
+
+struct Pending(usize, Run);
+impl Pending {
+    fn run(mut self, run: Run) {
+        let context = std::mem::replace(&mut self.0, 0);
+        unsafe { run(context as *mut c_void) };
+    }
+}
+impl Drop for Pending {
+    fn drop(&mut self) {
+        if self.0 != 0 {
+            unsafe { (self.1)(self.0 as *mut c_void) };
+        }
+    }
+}
+unsafe extern "C" fn submit(
+    context: *mut c_void,
+    _: u32,
+    run: Run,
+    discard: Run,
+    task: *mut c_void,
+) {
+    let pending = Pending(task as usize, discard);
+    let sender = unsafe { &*context.cast::<mpsc::SyncSender<Option<Job>>>() };
+    // Capture the guard itself so a rejected enqueue discards the native task exactly once.
+    let _ = sender.send(Some(Box::new(move || pending.run(run))));
+}
+
+struct Host {
+    sender: Box<mpsc::SyncSender<Option<Job>>>,
+    workers: Vec<std::thread::JoinHandle<()>>,
+    reactor: Option<std::thread::JoinHandle<()>>,
+}
+impl Host {
+    fn new() -> Self {
+        // Preallocate the queue before registration; its persistent slots are not query buffers.
+        let (sender, receiver) = mpsc::sync_channel::<Option<Job>>(1024);
+        let sender = Box::new(sender);
+        let receiver = Arc::new(Mutex::new(receiver));
+        let workers = (0..4)
+            .map(|_| {
+                let receiver = receiver.clone();
+                std::thread::spawn(move || {
+                    loop {
+                        // Release the receiver lock before running nested SDK work.
+                        let job = receiver.lock().unwrap().recv();
+                        match job {
+                            Ok(Some(job)) => job(),
+                            Ok(None) | Err(_) => break,
+                        }
+                    }
+                })
+            })
+            .collect();
+        let options = LanceHostServicesOptionsV1 {
+            abi_version: 1,
+            struct_size: std::mem::size_of::<LanceHostServicesOptionsV1>() as u32,
+            context: (&*sender as *const mpsc::SyncSender<Option<Job>>)
+                .cast_mut()
+                .cast(),
+            submit: Some(submit),
+        };
+        assert_eq!(
+            unsafe { lance_runtime_install_host_services_v1(&options) },
+            0
+        );
+        let reactor = Some(std::thread::spawn(|| assert_eq!(lance_runtime_drive(), 0)));
+        Self {
+            sender,
+            workers,
+            reactor,
+        }
+    }
+
+    fn context(&self) -> *mut c_void {
+        (&*self.sender as *const mpsc::SyncSender<Option<Job>>)
+            .cast_mut()
+            .cast()
