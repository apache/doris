+impl Drop for Host {
+    fn drop(&mut self) {
+        lance_runtime_stop();
+        self.reactor.take().unwrap().join().unwrap();
+        for _ in &self.workers {
+            let _ = self.sender.send(None);
+        }
+        for worker in self.workers.drain(..) {
+            worker.join().unwrap();
+        }
+    }
