+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright The Lance Authors
+
+pub fn run(mut command: std::process::Command) -> bool {
+    let mut child = command.spawn().unwrap();
+    let deadline = std::time::Instant::now() + std::time::Duration::from_secs(60);
+    loop {
+        if let Some(status) = child.try_wait().unwrap() {
+            return status.success();
+        }
+        if std::time::Instant::now() >= deadline {
+            let _ = child.kill();
+            let _ = child.wait();
+            return false;
+        }
+        std::thread::sleep(std::time::Duration::from_millis(10));
+    }
+}
diff --git a/tests/host_callback_test.rs b/tests/host_callback_test.rs
--- /dev/null
+++ b/tests/host_callback_test.rs
@@ -0,0 +1,174 @@
+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright The Lance Authors
+
+#![cfg(target_os = "linux")]
+mod common;
+use lance_c::*;
+use std::ffi::c_void;
+use std::sync::atomic::{AtomicBool, AtomicUsize, Ordering};
+use std::sync::{Arc, Mutex, mpsc};
+
+type Job = Box<dyn FnOnce() + Send>;
+static REJECT: AtomicBool = AtomicBool::new(false);
+unsafe extern "C" fn submit(
+    context: *mut c_void,
+    queue: u32,
+    run: unsafe extern "C" fn(*mut c_void),
+    discard: unsafe extern "C" fn(*mut c_void),
+    task: *mut c_void,
+) {
+    if queue != 2 && REJECT.load(Ordering::Acquire) {
+        unsafe { discard(task) };
+    } else {
+        let sender = unsafe { &*context.cast::<mpsc::Sender<Option<Job>>>() };
+        let task = task as usize;
+        sender
+            .send(Some(Box::new(move || unsafe { run(task as *mut c_void) })))
+            .unwrap();
+    }
+}
+#[derive(Default)]
+struct Probe {
+    active: AtomicUsize,
+    concurrent: AtomicUsize,
+    done: AtomicUsize,
+    errors: AtomicUsize,
+    reactor: Option<std::thread::ThreadId>,
+}
+unsafe extern "C" fn observe(context: *mut c_void, status: i32, result: *mut c_void) {
+    let probe = unsafe { &*context.cast::<Probe>() };
+    if probe.reactor == Some(std::thread::current().id()) {
+        probe.errors.fetch_add(1, Ordering::SeqCst);
+    }
+    let active = probe.active.fetch_add(1, Ordering::SeqCst) + 1;
+    probe.concurrent.fetch_max(active, Ordering::SeqCst);
+    if status != -1 || !result.is_null() || lance_last_error_code() == LanceErrorCode::Ok {
+        probe.errors.fetch_add(1, Ordering::SeqCst);
+    }
+    std::thread::sleep(std::time::Duration::from_millis(1));
+    probe.active.fetch_sub(1, Ordering::SeqCst);
+    probe.done.fetch_add(1, Ordering::SeqCst);
+}
+#[test]
+fn callbacks_are_serial_and_drained_even_after_host_rejection() {
+    if std::env::var_os("LANCE_CALLBACK_CHILD").is_none() {
+        for reject in [false, true] {
+            let mut command = std::process::Command::new(std::env::current_exe().unwrap());
+            command
+                .args([
+                    "--exact",
+                    "callbacks_are_serial_and_drained_even_after_host_rejection",
+                    "--nocapture",
+                ])
+                .env("LANCE_CALLBACK_CHILD", "1");
+            if reject {
+                command.env("LANCE_CALLBACK_REJECT", "1");
+            }
+            assert!(common::run(command));
+        }
+        return;
+    }
+    let (sender, receiver) = mpsc::channel::<Option<Job>>();
+    let sender = Box::new(sender);
+    let receiver = Arc::new(Mutex::new(receiver));
+    let workers: Vec<_> = (0..4)
+        .map(|_| {
+            let receiver = receiver.clone();
+            std::thread::spawn(move || {
+                loop {
+                    let job = receiver.lock().unwrap().recv();
+                    match job {
+                        Ok(Some(job)) => job(),
+                        Ok(None) | Err(_) => break,
+                    }
+                }
+            })
+        })
+        .collect();
+    let options = LanceHostServicesOptionsV1 {
+        abi_version: 1,
+        struct_size: std::mem::size_of::<LanceHostServicesOptionsV1>() as u32,
+        context: &*sender as *const _ as *mut c_void,
+        submit: Some(submit),
+    };
+    assert_eq!(
+        unsafe { lance_runtime_install_host_services_v1(&options) },
+        0
+    );
+    let reactor = std::thread::spawn(|| assert_eq!(lance_runtime_drive(), 0));
+    let reject = std::env::var_os("LANCE_CALLBACK_REJECT").is_some();
+    let temp = tempfile::tempdir().unwrap();
+    let scanner = if reject {
+        use arrow::array::Int64Array;
+        use arrow::datatypes::{DataType, Field, Schema};
+        use arrow::record_batch::{RecordBatch, RecordBatchIterator};
+        let schema = Arc::new(Schema::new(vec![Field::new(
+            "value",
+            DataType::Int64,
+            false,
+        )]));
+        let batch = RecordBatch::try_new(
+            schema.clone(),
+            vec![Arc::new(Int64Array::from_iter_values(0..8))],
+        )
+        .unwrap();
+        lance_c::runtime::block_on(async {
+            lance::Dataset::write(
+                Box::new(RecordBatchIterator::new(vec![Ok(batch)], schema)),
+                temp.path().to_str().unwrap(),
+                None,
+            )
+            .await
+            .unwrap();
+        });
+        let uri = std::ffi::CString::new(temp.path().to_str().unwrap()).unwrap();
+        let dataset = unsafe { lance_dataset_open(uri.as_ptr(), std::ptr::null(), 0) };
+        assert!(!dataset.is_null());
+        let scanner = unsafe { lance_scanner_new(dataset, std::ptr::null(), std::ptr::null()) };
+        assert!(!scanner.is_null());
+        unsafe { lance_dataset_close(dataset) };
+        scanner
+    } else {
+        std::ptr::null_mut()
+    };
+    REJECT.store(reject, Ordering::Release);
+    let before = std::fs::read_dir("/proc/self/task").unwrap().count();
+    let probe = Box::new(Probe {
+        reactor: Some(reactor.thread().id()),
+        ..Default::default()
+    });
+    for _ in 0..64 {
+        unsafe {
+            lance_scanner_scan_async(
+                std::ptr::null_mut(),
+                Some(observe),
+                &*probe as *const _ as *mut c_void,
+            )
+        };
+    }
+    if reject {
+        // A valid scan accepted by the C API must also complete when its first poll is rejected.
+        unsafe {
+            lance_scanner_scan_async(scanner, Some(observe), &*probe as *const _ as *mut c_void)
+        };
+        unsafe { lance_scanner_close(scanner) };
+    }
+    lance_runtime_stop();
+    assert_eq!(probe.done.load(Ordering::SeqCst), 64 + usize::from(reject));
+    assert_eq!(probe.concurrent.load(Ordering::SeqCst), 1);
+    assert_eq!(probe.errors.load(Ordering::SeqCst), 0);
+    reactor.join().unwrap();
+    let after = std::fs::read_dir("/proc/self/task").unwrap().count();
+    assert_eq!(
+        before - 1,
+        after,
+        "callbacks created an SDK dispatcher thread"
+    );
+    for _ in &workers {
+        let _ = sender.send(None);
+    }
+    for worker in workers {
+        worker.join().unwrap();
+    }
+    drop(sender);
+}
