+                self.get_range(0..4)
+            }
+        }
+        let first = HostRuntime::new(Default::default());
+        let second = HostRuntime::new(Default::default());
+        let scheduler = first.block_on(async {
+            use lance_io::object_store::{
+                ObjectStoreParams, storage_options::StorageOptionsAccessor,
+            };
+            let params = ObjectStoreParams {
+                storage_options_accessor: Some(Arc::new(
+                    StorageOptionsAccessor::with_static_options(std::collections::HashMap::from([
+                        ("io_parallelism".into(), "2".into()),
+                    ])),
+                )),
+                ..Default::default()
+            };
+            let store = ObjectStore::with_host_store(
+                Arc::new(object_store::memory::InMemory::new()),
+                "probe".into(),
+                &params,
+            )
+            .unwrap();
+            ScanScheduler::new(Arc::new(store), SchedulerConfig::default_for_testing())
+        });
+        let reader = Arc::new(ProbeReader {
+            path: Path::from("probe"),
+            expected: Mutex::new(None),
+        });
+        let file = scheduler.open_reader(reader.clone());
+        for runtime in [&first, &second] {
+            let executor: Arc<dyn Executor> = (*runtime).clone();
+            *reader.expected.lock().unwrap() = Some(Arc::downgrade(&executor));
+            let bytes = runtime
+                .block_on(async {
+                    file.submit_request(std::iter::once(0..4).collect(), 0)
+                        .await
+                })
+                .unwrap();
+            assert_eq!(bytes[0].as_ref(), &[1; 4]);
+        }
+        // Retiring queued I/O must return the shared scheduler's slots to later queries.
+        let pending = first.block_on(async {
+            (0..2)
+                .map(|_| file.submit_request(std::iter::once(0..4).collect(), 0))
+                .collect::<Vec<_>>()
+        });
+        let deadline = std::time::Instant::now() + std::time::Duration::from_secs(2);
+        while first.queues[0].lock().unwrap().len() < 2 {
+            assert!(
+                std::time::Instant::now() < deadline,
+                "I/O loop did not dispatch queued requests"
+            );
+            std::thread::yield_now();
+        }
+        first.retire();
+        drop(pending);
+        let result = second.block_on(async {
+            tokio::time::timeout(
+                std::time::Duration::from_secs(2),
+                file.submit_request(std::iter::once(0..4).collect(), 0),
+            )
+            .await
+        });
+        assert!(result.is_ok(), "cancelled query leaked shared I/O capacity");
+        assert!(result.unwrap().is_ok());
+    }
