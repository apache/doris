+pub(crate) static HOST_RT: LazyLock<tokio::runtime::Runtime> = LazyLock::new(|| {
+    opendal::install_default();
+    tokio::runtime::Builder::new_current_thread()
+        .enable_all()
+        .blocking_task_executor(|task| {
+            // This also covers blocking operations hidden inside Tokio fs, DNS and caches.
+            // Every task has cancellation ownership even when the host rejects it.
+            task_executor::current_executor()
+                .expect("host executor installed")
+                .schedule(TaskKind::Io, task);
+        })
+        .build()
+        .unwrap()
 });

-/// Block the current thread on an async future using the global runtime.
-pub fn block_on<F: std::future::Future>(f: F) -> F::Output {
-    RT.block_on(f)
+pub struct RuntimeRouter;
+pub static RT: RuntimeRouter = RuntimeRouter;
+impl RuntimeRouter {
+    fn selected(&self) -> &'static tokio::runtime::Runtime {
+        if crate::host_services::SERVICES.get().is_some() {
+            &HOST_RT
+        } else {
+            &LEGACY_RT
+        }
+    }
+    pub fn handle(&self) -> &'static tokio::runtime::Handle {
+        self.selected().handle()
+    }
+    pub fn enter(&self) -> tokio::runtime::EnterGuard<'static> {
+        self.selected().enter()
+    }
+    pub fn spawn<F>(&self, future: F) -> tokio::task::JoinHandle<F::Output>
+    where
+        F: Future + Send + 'static,
+        F::Output: Send + 'static,
+    {
+        self.selected().spawn(future)
+    }
+    pub fn block_on<F: Future>(&self, future: F) -> F::Output {
+        if crate::host_services::SERVICES.get().is_some() {
+            let _runtime = self.enter();
+            futures::executor::block_on(future)
+        } else {
+            self.selected().block_on(future)
+        }
+    }
 }
+
+pub fn block_on<F: Future>(future: F) -> F::Output {
+    match crate::host_executor::current() {
+        Some(executor) => executor.block_on(future),
+        None => RT.block_on(future),
+    }
+}
