+//! Owned host context propagation across DataFusion's task boundaries.
+
+use std::any::Any;
+use std::future::Future;
+use std::pin::Pin;
+use std::sync::{Arc, OnceLock};
+use std::task::{Context, Poll};
+
+/// An owned host context safe to retain while a task is suspended or migrates.
+/// The returned guard may be thread-bound and exists only during a single poll.
+pub trait TaskScope: Send + Sync + 'static {
+    fn enter(&self) -> Box<dyn Any>;
+}
+
+/// Captures the submitting thread's optional owner before dispatch.
+pub type TaskScopeFactory = fn() -> Option<Arc<dyn TaskScope>>;
+static FACTORY: OnceLock<TaskScopeFactory> = OnceLock::new();
+
+/// Install the host context factory before creating DataFusion tasks.
+/// Installation is process-wide; a second independent installer is rejected.
+pub fn set_task_scope_factory(factory: TaskScopeFactory) -> Result<(), TaskScopeFactory> {
+    FACTORY.set(factory)
+}
+
+fn capture() -> Option<Arc<dyn TaskScope>> {
+    FACTORY.get().and_then(|factory| factory())
+}
+
+pub(crate) struct ScopedFuture<F> {
+    future: Pin<Box<F>>,
+    scope: Option<Arc<dyn TaskScope>>,
+}
+
+pub(crate) fn scope_future<F: Future>(future: F) -> ScopedFuture<F> {
+    ScopedFuture {
+        future: Box::pin(future),
+        scope: capture(),
+    }
+}
+
+impl<F: Future> Future for ScopedFuture<F> {
+    type Output = F::Output;
+    fn poll(mut self: Pin<&mut Self>, context: &mut Context<'_>) -> Poll<Self::Output> {
+        let _guard = self.scope.as_ref().map(|scope| scope.enter());
+        self.future.as_mut().poll(context)
+    }
+}
+
+pub(crate) fn scope_block<F: FnOnce() -> R, R>(function: F) -> impl FnOnce() -> R {
+    let scope = capture();
+    move || {
+        let _guard = scope.as_ref().map(|scope| scope.enter());
+        function()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::cell::Cell;
+    use std::sync::Once;
+
+    thread_local! { static CURRENT: Cell<usize> = const { Cell::new(0) }; }
+    struct Owner(usize);
+    struct Guard(usize);
+    impl Drop for Guard {
+        fn drop(&mut self) {
+            CURRENT.set(self.0);
+        }
+    }
+    impl TaskScope for Owner {
+        fn enter(&self) -> Box<dyn Any> {
+            Box::new(Guard(CURRENT.replace(self.0)))
+        }
+    }
+    fn factory() -> Option<Arc<dyn TaskScope>> {
+        let owner = CURRENT.get();
+        (owner != 0).then(|| Arc::new(Owner(owner)) as Arc<dyn TaskScope>)
+    }
+
+    #[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+    async fn spawned_descendants_and_blocking_work_keep_submission_scope() {
+        static INIT: Once = Once::new();
+        INIT.call_once(|| assert!(set_task_scope_factory(factory).is_ok()));
+        CURRENT.set(7);
+        let task = crate::SpawnedTask::spawn(async {
+            tokio::task::yield_now().await;
+            assert_eq!(CURRENT.get(), 7);
+            crate::SpawnedTask::spawn_blocking(|| CURRENT.get())
+                .await
+                .unwrap()
+        });
+        CURRENT.set(0);
+        assert_eq!(task.await.unwrap(), 7);
+        assert_eq!(CURRENT.get(), 0);
+        CURRENT.set(11);
+        let mut tasks = crate::JoinSet::new();
+        tasks.spawn(async {
+            tokio::task::yield_now().await;
+            CURRENT.get()
+        });
+        CURRENT.set(0);
+        assert_eq!(tasks.join_next().await.unwrap().unwrap(), 11);
+        assert_eq!(CURRENT.get(), 0);
+    }
+}
