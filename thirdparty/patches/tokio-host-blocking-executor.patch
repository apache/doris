+// A host can reject a task by dropping its callback. The join handle must still wake.
+struct ExternalTask {
+    task: Option<Task>,
+}
+impl Drop for ExternalTask {
+    fn drop(&mut self) {
+        if let Some(task) = self.task.take() {
+            task.task.shutdown();
+        }
+    }
