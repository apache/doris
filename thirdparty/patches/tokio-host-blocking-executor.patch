@@ -0,0 +1,48 @@
+#![cfg(feature = "rt")]
+mod tests {
+    use std::sync::{Arc, Mutex};
+    #[test]
+    fn ordinary_runtime_does_not_advertise_host_execution() {
+        let runtime = tokio::runtime::Builder::new_current_thread()
+            .build()
+            .unwrap();
+        assert!(!runtime.handle().has_host_blocking_executor());
+    }
+    #[test]
+    fn blocking_work_uses_host_without_creating_threads() {
+        let queue = Arc::new(Mutex::new(Vec::new()));
+        let queued = queue.clone();
+        let started = Arc::new(std::sync::atomic::AtomicUsize::new(0));
+        let count = started.clone();
+        let runtime = tokio::runtime::Builder::new_current_thread()
+            .on_thread_start(move || {
+                count.fetch_add(1, std::sync::atomic::Ordering::SeqCst);
+            })
+            .enable_all()
+            .blocking_task_executor(move |task| queued.lock().unwrap().push(task))
+            .build()
+            .unwrap();
+        assert!(runtime.handle().has_host_blocking_executor());
+        let handle = runtime
+            .handle()
+            .spawn_blocking(|| std::thread::current().id());
+        assert_eq!(queue.lock().unwrap().len(), 1);
+        (queue.lock().unwrap().pop().unwrap())();
+        assert_eq!(
+            runtime.block_on(handle).unwrap(),
+            std::thread::current().id()
+        );
+        assert_eq!(started.load(std::sync::atomic::Ordering::SeqCst), 0);
+    }
+    #[test]
+    fn rejected_host_work_cancels_the_join_handle() {
+        let runtime = tokio::runtime::Builder::new_current_thread()
+            .blocking_task_executor(drop)
+            .build()
+            .unwrap();
+        assert!(runtime
+            .block_on(runtime.handle().spawn_blocking(|| 42))
+            .unwrap_err()
+            .is_cancelled());
+    }
+}
