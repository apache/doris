+
+    /// Delegate blocking tasks to a host executor instead of creating blocking worker threads.
+    ///
+    /// The callback takes ownership of each task. It must enqueue it without blocking or
+    /// executing it inline, then either execute it once or drop it to cancel it. Dropping
+    /// a pending task completes its join handle with cancellation. Submitted tasks remain
+    /// part of runtime shutdown until the host has executed or dropped them.
+    pub fn blocking_task_executor<F>(&mut self, executor: F) -> &mut Self
+    where
+        F: Fn(Box<dyn FnOnce() + Send + 'static>) + Send + Sync + 'static,
+    {
+        self.blocking_task_executor = Some(std::sync::Arc::new(executor));
         self
     }

