                          PAIMON_EXTERNAL_ARROW_DATASET_LIB
                          PAIMON_EXTERNAL_ARROW_ACERO_LIB
                          PAIMON_EXTERNAL_PARQUET_LIB
@@ -1028,6 +1031,13 @@
                                          INTERFACE_INCLUDE_DIRECTORIES
                                          "${ARROW_INCLUDE_DIR}")

+        add_library(arrow_compute STATIC IMPORTED)
