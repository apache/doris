+/** Metadata-only base inspection contract; header/archive must both provide this API. */
+#define LANCE_STORAGE_BASES_JSON_VERSION 1
+
+/** Pre-open parsing contract for the default registry's local URI providers. */
+#define LANCE_LOCAL_URI_PATH_JSON_VERSION 1
+
+/**
+ * Parse a local-provider URI using the SDK URL parser and default registry.
+ * No store is constructed and no filesystem or manifest is accessed.
+ * Returns {"format_version":1,"scheme":"...","local_path":"/absolute/path"}.
+ * Non-local, invalid and NULL inputs fail. Free the result with lance_free_string().
+ */
+const char* lance_local_uri_path_json(const char* uri);
+
+/**
+ * Return the primary and all registered bases of the opened snapshot as JSON.
+ *
+ * This inspects SDK-decoded metadata and extracts paths using the SDK provider;
+ * it never constructs a base object store or reads any base object. It includes
+ * registrations regardless of the current projection or whether they are unused.
+ *
+ * JSON: {"format_version":1,"bases":[{"id":0,"primary":false,"uri":"...","scheme":"file",
+ * "is_local":true,"local_path":"/absolute/path","is_dataset_root":true}]}.
+ * Nonlocal entries have local_path:null. local_path is already decoded exactly as
+ * the SDK reader uses it; callers MUST NOT URI-decode it again. The entries are
+ * primary is first with id:null and primary:true; registrations follow sorted
+ * by id. This does not enumerate absolute blob URIs encoded inside data
+ * values, and is not a policy hook for blob payload materialization.
+ *
+ * @return Owned UTF-8 string, to be freed with lance_free_string(), or NULL on
+ *         error (use lance_last_error_code/message). Safe with shared sessions.
+ */
+const char* lance_dataset_storage_bases_json(const LanceDataset* dataset);
+
