+        let registry = Arc::new(ObjectStoreRegistry::default());
+        let base = BasePath::new(3, "s3://unreachable.invalid/clone-base".into(), None, true);
+        let value = storage_base_description(&base, registry).unwrap();
+        assert_eq!(value["is_local"], false);
+        assert_eq!(value["local_path"], serde_json::Value::Null);
+        assert_eq!(value["uri"], base.path);
+        assert_eq!(value["is_dataset_root"], true);
+    }
