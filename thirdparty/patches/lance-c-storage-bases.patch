+#[test]
+fn test_local_uri_path_json_contract() {
+    for (uri, path) in [
+        (
+            "file-object-store:///nonexistent/lance/a%20b",
+            "/nonexistent/lance/a b",
+        ),
+        (
+            "file-object-store://host/nonexistent/lance/a%2520b?q=x#tag",
+            "/nonexistent/lance/a%20b",
+        ),
+        (
+            "file:///nonexistent/lance/plus+name",
+            "/nonexistent/lance/plus+name",
+        ),
+    ] {
+        let uri = c_str(uri);
+        let raw = unsafe { lance_local_uri_path_json(uri.as_ptr()) };
+        assert!(!raw.is_null());
+        assert_eq!(lance_last_error_code(), LanceErrorCode::Ok);
+        let value: serde_json::Value =
+            serde_json::from_str(unsafe { std::ffi::CStr::from_ptr(raw) }.to_str().unwrap())
+                .unwrap();
+        unsafe { lance_free_string(raw) };
+        assert_eq!(value["format_version"], 1);
+        assert_eq!(value["local_path"], path);
+    }
+    for uri in ["", "s3://bucket/path"] {
+        let uri = c_str(uri);
+        assert!(unsafe { lance_local_uri_path_json(uri.as_ptr()) }.is_null());
+        assert_ne!(lance_last_error_code(), LanceErrorCode::Ok);
+    }
+    assert!(unsafe { lance_local_uri_path_json(ptr::null()) }.is_null());
+    assert_eq!(lance_last_error_code(), LanceErrorCode::InvalidArgument);
