+#[test]
+fn test_storage_bases_json_primary_snapshot_with_multiple_fragments() {
+    let tmp = tempfile::tempdir().unwrap();
+    let uri = tmp
+        .path()
+        .join("base metadata with spaces.lance")
+        .to_str()
+        .unwrap()
+        .to_string();
+    let schema = Arc::new(Schema::new(vec![Field::new("id", DataType::Int32, false)]));
+    for fragment in 0..2 {
+        let batch = RecordBatch::try_new(
+            schema.clone(),
+            vec![Arc::new(Int32Array::from(vec![fragment]))],
+        )
+        .unwrap();
+        let params = lance::dataset::WriteParams {
+            mode: if fragment == 0 {
+                lance::dataset::WriteMode::Create
+            } else {
+                lance::dataset::WriteMode::Append
+            },
+            ..Default::default()
+        };
+        lance_c::runtime::block_on(Dataset::write(
+            arrow::record_batch::RecordBatchIterator::new(vec![Ok(batch)], schema.clone()),
+            &uri,
+            Some(params),
+        ))
+        .unwrap();
+    }
+    let c_uri = c_str(&uri);
+    let dataset = unsafe { lance_dataset_open(c_uri.as_ptr(), ptr::null(), 0) };
+    assert!(!dataset.is_null());
+    assert_eq!(unsafe { lance_dataset_fragment_count(dataset) }, 2);
+    let raw = unsafe { lance_dataset_storage_bases_json(dataset) };
+    assert!(!raw.is_null());
+    assert_eq!(lance_last_error_code(), LanceErrorCode::Ok);
+    let value: serde_json::Value =
+        serde_json::from_str(unsafe { std::ffi::CStr::from_ptr(raw) }.to_str().unwrap()).unwrap();
+    unsafe { lance_free_string(raw) };
+    assert_eq!(value["format_version"], LANCE_STORAGE_BASES_JSON_VERSION);
+    let bases = value["bases"].as_array().unwrap();
+    assert_eq!(bases.len(), 1);
+    assert_eq!(bases[0]["primary"], true);
+    assert_eq!(bases[0]["id"], serde_json::Value::Null);
+    assert_eq!(bases[0]["is_local"], true);
+    assert_eq!(bases[0]["local_path"], uri);
+    assert_eq!(bases[0]["is_dataset_root"], true);
+    // Inspection does not consume or mutate the Dataset handle.
+    assert_eq!(unsafe { lance_dataset_fragment_count(dataset) }, 2);
+    unsafe { lance_dataset_close(dataset) };
