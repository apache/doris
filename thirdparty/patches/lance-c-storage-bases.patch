+#[cfg(test)]
+mod storage_base_metadata_tests {
+    use super::*;
+    use lance_io::object_store::ObjectStoreRegistry;
+    use lance_table::format::BasePath;
+
+    #[test]
+    fn base_inspection_uses_sdk_local_identity_without_opening_files() {
+        let registry = Arc::new(ObjectStoreRegistry::default());
+        for (uri, expected) in [
+            (
+                "file:///nonexistent/sdbsec/a%20b",
+                "/nonexistent/sdbsec/a b",
+            ),
+            (
+                "file:///nonexistent/sdbsec/a%2520b",
+                "/nonexistent/sdbsec/a%20b",
+            ),
+            (
+                "file-object-store:///nonexistent/sdbsec/a%20b",
+                "/nonexistent/sdbsec/a b",
+            ),
+        ] {
+            let base = BasePath::new(7, uri.into(), None, false);
+            let value = storage_base_description(&base, registry.clone()).unwrap();
+            assert_eq!(value["id"], 7);
+            assert_eq!(value["is_local"], true);
+            assert_eq!(value["local_path"], expected);
+            assert_eq!(value["is_dataset_root"], false);
+        }
+    }
+
+    #[test]
