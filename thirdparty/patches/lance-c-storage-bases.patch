+
+    #[test]
+    fn metadata_snapshot_contains_primary_and_every_registered_base() {
+        use arrow_array::{Int64Array, RecordBatch};
+        use arrow_schema::{DataType, Field, Schema};
+        let temp = tempfile::tempdir().unwrap();
+        let uri = temp.path().join("primary with spaces.lance");
+        let schema = Arc::new(Schema::new(vec![Field::new("id", DataType::Int64, false)]));
+        let batch = RecordBatch::try_new(schema.clone(), vec![Arc::new(Int64Array::from(vec![1]))])
+            .unwrap();
+        let mut dataset = block_on(Dataset::write(
+            arrow::record_batch::RecordBatchIterator::new(vec![Ok(batch)], schema),
+            uri.to_str().unwrap(),
+            None,
+        ))
+        .unwrap();
+        // Add unreferenced registrations in memory: listing every registered base
+        // must not instantiate the unreachable remote provider or open local data.
+        let manifest = Arc::make_mut(&mut dataset.manifest);
+        manifest.base_paths.insert(
+            9,
+            BasePath::new(9, "s3://unreachable.invalid/base".into(), None, true),
+        );
+        manifest.base_paths.insert(
+            4,
+            BasePath::new(
+                4,
+                "file:///nonexistent/sdbsec/base%20path".into(),
+                None,
+                false,
+            ),
+        );
+        let handle = LanceDataset {
+            inner: RwLock::new(Arc::new(dataset)),
+            data_cache: None,
+        };
+        let raw = unsafe { lance_dataset_storage_bases_json(&handle) };
+        assert!(!raw.is_null());
+        let value: serde_json::Value =
+            serde_json::from_str(unsafe { std::ffi::CStr::from_ptr(raw) }.to_str().unwrap())
+                .unwrap();
+        unsafe { crate::error::lance_free_string(raw) };
+        assert_eq!(value["format_version"], 1);
+        let entries = value["bases"].as_array().unwrap();
+        assert_eq!(entries.len(), 3);
+        assert_eq!(entries[0]["primary"], true);
+        assert_eq!(entries[0]["id"], serde_json::Value::Null);
+        assert_eq!(entries[0]["is_local"], true);
+        assert_eq!(entries[0]["local_path"], uri.to_str().unwrap());
+        assert_eq!(entries[1]["id"], 4);
+        assert_eq!(entries[1]["local_path"], "/nonexistent/sdbsec/base path");
+        assert_eq!(entries[2]["id"], 9);
+        assert_eq!(entries[2]["is_local"], false);
+    }
