+/// Inspect registered base metadata before any scanner/index/delegated reader runs.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn lance_dataset_storage_bases_json(
+    dataset: *const LanceDataset,
+) -> *const c_char {
+    ffi_try!(unsafe { storage_bases_json_inner(dataset) }, null)
+}
+
+/// Decode a local primary URI before the caller applies its filesystem policy.
+/// Registry path extraction does not construct a store or access a manifest.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn lance_local_uri_path_json(uri: *const c_char) -> *const c_char {
+    ffi_try!(unsafe { local_uri_path_json_inner(uri) }, null)
+}
+
+unsafe fn local_uri_path_json_inner(uri: *const c_char) -> Result<*const c_char> {
+    let uri = unsafe { helpers::parse_c_string(uri)? }
+        .ok_or_else(|| lance_core::Error::invalid_input_source("uri must not be NULL".into()))?;
+    if uri.is_empty() {
+        return Err(lance_core::Error::invalid_input_source(
+            "uri must not be empty".into(),
+        ));
+    }
+    let url = lance_io::object_store::uri_to_url(uri)?;
+    if !matches!(url.scheme(), "file" | "file-object-store" | "file+uring") {
+        return Err(lance_core::Error::invalid_input_source(
+            "URI is not a local provider".into(),
+        ));
+    }
+    let registry = Arc::new(lance_io::object_store::ObjectStoreRegistry::default());
+    let path = lance_io::object_store::ObjectStore::extract_path_from_uri(registry, uri)?;
+    let json = serde_json::json!({
+        "format_version": 1,
+        "scheme": url.scheme(),
+        "local_path": lance_io::local::to_local_path(&path),
+    })
+    .to_string();
+    let owned = std::ffi::CString::new(json).map_err(|_| {
+        lance_core::Error::invalid_input_source("local URI metadata contains NUL".into())
+    })?;
+    Ok(owned.into_raw())
+}
+
+fn storage_base_description(
+    base: &lance_table::format::BasePath,
+    registry: Arc<lance_io::object_store::ObjectStoreRegistry>,
+) -> Result<serde_json::Value> {
+    // These are the SDK's own parse/extract operations. Do not instantiate a
+    // provider merely to discover whether the manifest selected local storage.
+    let url = lance_io::object_store::uri_to_url(&base.path)?;
+    let path = lance_io::object_store::ObjectStore::extract_path_from_uri(registry, &base.path)?;
+    // The C session uses the pinned SDK's default registry, whose local aliases
+    // all resolve to FileStoreProvider. There is no C provider-registration API.
+    let is_local = matches!(url.scheme(), "file" | "file-object-store" | "file+uring");
+    let local_path = is_local.then(|| lance_io::local::to_local_path(&path));
+    Ok(serde_json::json!({
+        "id": base.id,
+        "primary": false,
+        "uri": base.path,
+        "scheme": url.scheme(),
+        "is_local": is_local,
+        "local_path": local_path,
+        "is_dataset_root": base.is_dataset_root,
+    }))
+}
+
+unsafe fn storage_bases_json_inner(dataset: *const LanceDataset) -> Result<*const c_char> {
+    if dataset.is_null() {
+        return Err(lance_core::Error::invalid_input_source(
+            "dataset is NULL".into(),
+        ));
+    }
+    let snapshot = unsafe { &*dataset }.snapshot();
+    let registry = snapshot.session().store_registry();
+    let mut bases = snapshot.manifest().base_paths.values().collect::<Vec<_>>();
+    bases.sort_unstable_by_key(|base| base.id);
+    let mut entries = bases
+        .into_iter()
+        .map(|base| storage_base_description(base, registry.clone()))
+        .collect::<Result<Vec<_>>>()?;
+    // object_store(None) returns the already-opened primary Arc; it never opens
+    // a delegated base. branch_location carries the actual parsed SDK base path.
+    let primary_store = block_on(snapshot.object_store(None))?;
+    let primary_path = snapshot.branch_location().path;
+    let primary_is_local = matches!(
+        primary_store.scheme(),
+        "file" | "file-object-store" | "file+uring"
+    );
+    entries.insert(
+        0,
+        serde_json::json!({
+            "id": serde_json::Value::Null,
+            "primary": true,
+            "uri": snapshot.uri(),
+            "scheme": primary_store.scheme(),
+            "is_local": primary_is_local,
+            "local_path": primary_is_local.then(|| lance_io::local::to_local_path(&primary_path)),
+            "is_dataset_root": true,
+        }),
+    );
+    let json = serde_json::json!({
+        "format_version": LANCE_STORAGE_BASES_JSON_VERSION,
+        "bases": entries,
+    })
+    .to_string();
+    let owned = std::ffi::CString::new(json).map_err(|_| {
+        lance_core::Error::invalid_input_source("storage base metadata contains NUL".into())
+    })?;
+    Ok(owned.into_raw() as *const c_char)
+}
