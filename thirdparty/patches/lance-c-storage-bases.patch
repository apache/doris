+#[cfg(test)]
+mod local_uri_path_tests {
+    use super::*;
+    use std::ffi::{CStr, CString};
+
+    #[test]
+    fn local_uri_metadata_is_sdk_decoded_without_opening_storage() {
+        for (input, expected) in [
+            (
+                "file-object-store:///nonexistent/sdbsec/a%20b",
+                "/nonexistent/sdbsec/a b",
+            ),
+            (
+                "file-object-store://host/nonexistent/a%2520b?q=x#tag",
+                "/nonexistent/a%20b",
+            ),
+            (
+                "FILE-OBJECT-STORE:///nonexistent/a/../plus+name",
+                "/nonexistent/plus+name",
+            ),
+            (
+                "file:///nonexistent/sdbsec/a%20b",
+                "/nonexistent/sdbsec/a b",
+            ),
+        ] {
+            let input = CString::new(input).unwrap();
+            let raw = unsafe { lance_local_uri_path_json(input.as_ptr()) };
+            assert!(!raw.is_null());
+            let value: serde_json::Value =
+                serde_json::from_str(unsafe { CStr::from_ptr(raw) }.to_str().unwrap()).unwrap();
+            assert_eq!(value["format_version"], 1);
+            assert_eq!(value["local_path"], expected);
+            unsafe { crate::error::lance_free_string(raw) };
+        }
+        let remote = CString::new("s3://bucket/data").unwrap();
+        assert!(unsafe { lance_local_uri_path_json(remote.as_ptr()) }.is_null());
+        assert!(unsafe { lance_local_uri_path_json(std::ptr::null()) }.is_null());
+    }
+}
