+
+#[cfg(test)]
+mod bounded_registry_tests {
+    use super::*;
+    #[test]
+    fn small_and_disabled_registries_preserve_keys_and_values() {
+        let entries =
+            [("alpha", 11), ("alphabet", 12), ("beta", 23), ("gamma", 34)];
+        for (table_size, mru_size) in [(0, 0), (1, 2), (10_000, 2)] {
+            let mut builder = MapBuilder::with_registry_capacity(
+                Vec::new(),
+                table_size,
+                mru_size,
+            )
+            .unwrap();
+            for (key, value) in entries {
+                builder.insert(key, value).unwrap();
+            }
+            let map = Map::new(builder.into_inner().unwrap()).unwrap();
+            assert_eq!(map.len(), entries.len());
+            for (key, value) in entries {
+                assert_eq!(map.get(key), Some(value));
+            }
+            assert_eq!(map.get("absent"), None);
+        }
+    }
+}
