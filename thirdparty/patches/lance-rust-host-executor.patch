--- /dev/null
+++ b/rust/lance-linalg/src/distance/hamming/host.rs
@@ -0,0 +1,105 @@
+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright The Lance Authors
+
+//! Bounded host fork/join for the synchronous pairwise API, without a nested worker pool.
+
+use std::sync::{Arc, mpsc};
+use std::thread::Thread;
+
+use lance_core::utils::task_executor::{Executor, ExecutorGuard, TaskKind};
+
+use super::{PairwiseResult, compute_balanced_chunks};
+
+struct Completion {
+    sender: Option<mpsc::SyncSender<PairwiseResult>>,
+    caller: Thread,
+}
+impl Completion {
+    fn finish(mut self, result: PairwiseResult) {
+        // Each slot has one producer and capacity one, so CPU workers never block on delivery.
+        let _ = self.sender.take().unwrap().try_send(result);
+    }
+}
+impl Drop for Completion {
+    fn drop(&mut self) {
+        // Disconnect before waking: otherwise a cancelled worker can wake the caller
+        // just before its slot disconnects, leaving the caller parked forever.
+        drop(self.sender.take());
+        self.caller.unpark();
+    }
+}
+
+pub(super) fn compute<T, F>(
+    executor: Arc<dyn Executor>,
+    hashes: T,
+    row_ids: Option<&[u64]>,
+    threshold: Option<u32>,
+    rows: usize,
+    kernel: F,
+) -> PairwiseResult
+where
+    T: Send + Sync + 'static,
+    F: Fn(&T, Option<&[u64]>, u32, usize, usize) -> PairwiseResult + Send + Sync + 'static,
+{
+    if rows < 2 {
+        return PairwiseResult::new();
+    }
+    let threshold = threshold.unwrap_or(u32::MAX);
+    let pairs = rows.saturating_mul(rows - 1) / 2;
+    let parallelism = executor.cpu_parallelism().max(1);
+    if parallelism == 1 || pairs < 10_000 {
+        return kernel(&hashes, row_ids, threshold, 0, rows);
+    }
+    let hashes = Arc::new(hashes);
+    let row_ids = row_ids.map(Arc::<[u64]>::from);
+    let kernel = Arc::new(kernel);
+    let chunks = compute_balanced_chunks(rows, pairs.div_ceil(parallelism));
+    let mut receivers = Vec::with_capacity(chunks.len());
+    for (start, end) in chunks {
+        let (sender, receiver) = mpsc::sync_channel(1);
+        let completion = Completion {
+            sender: Some(sender),
+            caller: std::thread::current(),
+        };
+        let hashes = hashes.clone();
+        let row_ids = row_ids.clone();
+        let kernel = kernel.clone();
+        let owner = executor.clone();
+        executor.schedule(
+            TaskKind::Cpu,
+            Box::new(move || {
+                let _scope = ExecutorGuard::enter(owner);
+                let result = kernel(&hashes, row_ids.as_deref(), threshold, start, end);
+                completion.finish(result);
+            }),
+        );
+        receivers.push(receiver);
+    }
+    // No Tokio bridge is needed to join. Helping children prevents starvation when
+    // every host worker is inside a synchronous reader waiting for its own children.
+    let mut results: Vec<Option<PairwiseResult>> = (0..receivers.len()).map(|_| None).collect();
+    let mut remaining = receivers.len();
+    while remaining != 0 {
+        for (receiver, result) in receivers.iter().zip(results.iter_mut()) {
+            if result.is_some() {
+                continue;
+            }
+            match receiver.try_recv() {
+                Ok(part) => {
+                    *result = Some(part);
+                    remaining -= 1;
+                }
+                Err(mpsc::TryRecvError::Empty) => {}
+                Err(mpsc::TryRecvError::Disconnected) => panic!("host Hamming task was cancelled"),
+            }
+        }
+        if remaining != 0 && !executor.run_cpu_task() {
+            std::thread::park();
+        }
+    }
+    let mut result = PairwiseResult::new();
+    for part in results {
+        result.extend(part.unwrap());
+    }
+    result
+}
