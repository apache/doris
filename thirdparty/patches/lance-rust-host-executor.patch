+    #[tokio::test(flavor = "current_thread")]
+    async fn nested_tasks_execute_on_host_and_restore_context() {
+        let executor = Arc::new(ManualExecutor::default());
+        let host_thread = std::thread::current().id();
+        let future = scope(executor.clone(), async move {
+            spawn(async move {
+                assert_eq!(std::thread::current().id(), host_thread);
+                spawn_blocking(TaskKind::Cpu, move || std::thread::current().id())
+                    .await
+                    .unwrap()
+            })
+            .await
+            .unwrap()
+        });
