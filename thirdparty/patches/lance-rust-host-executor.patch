@@ -0,0 +1,806 @@
+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright The Lance Authors
+
+//! Optional host accounting for Rust heap allocations and fallible read buffers.
+
+use std::alloc::{GlobalAlloc, Layout, System};
+use std::cell::{Cell, RefCell};
+use std::ffi::c_void;
+use std::future::Future;
+use std::pin::Pin;
+use std::ptr;
+use std::sync::{Arc, OnceLock};
+use std::task::{Context, Poll};
+
+use crate::{Error, Result};
+
+/// Retained host memory account. Callbacks must not unwind; recording must not deny allocation.
+#[repr(C)]
+#[derive(Clone, Copy)]
+pub struct MemoryAccountOptions {
+    pub abi_version: u32,
+    pub struct_size: u32,
+    pub context: *mut c_void,
+    pub retain_context: Option<unsafe extern "C" fn(*mut c_void)>,
+    pub release_context: Option<unsafe extern "C" fn(*mut c_void)>,
+    /// Records a completed allocation or release, including allocations above the query limit.
+    pub record: Option<unsafe extern "C" fn(*mut c_void, i64)>,
+    /// Precharges a fallible allocation: zero accepts, 1/2/3 reject query/group/process limits.
+    pub reserve: Option<unsafe extern "C" fn(*mut c_void, usize) -> i32>,
+    /// Converts a reservation into live bytes, or rolls it back if allocation failed.
+    pub finish_reserve: Option<unsafe extern "C" fn(*mut c_void, usize, bool)>,
+    /// Returns zero while work may continue, or a memory-limit category.
+    pub check: Option<unsafe extern "C" fn(*mut c_void) -> i32>,
+}
+
+/// A host ledger retained by allocation headers, independently of readers and query objects.
+pub struct MemoryAccount(MemoryAccountOptions);
+// The host contract permits callbacks and their retained context on any SDK execution thread.
+unsafe impl Send for MemoryAccount {}
+unsafe impl Sync for MemoryAccount {}
+impl MemoryAccount {
+    /// Retain a validated callback descriptor. Its context must remain valid until release.
+    ///
+    /// # Safety
+    /// Every callback must accept the retained context on arbitrary threads without unwinding.
+    pub unsafe fn new(options: MemoryAccountOptions) -> Result<Arc<Self>> {
+        if options.abi_version != 1
+            || options.struct_size < std::mem::size_of::<MemoryAccountOptions>() as u32
+            || options.record.is_none()
+            || options.reserve.is_none()
+            || options.finish_reserve.is_none()
+            || options.check.is_none()
+        {
+            return Err(Error::invalid_input(
+                "invalid host memory account descriptor",
+            ));
+        }
+        if let Some(retain) = options.retain_context {
+            unsafe { retain(options.context) };
+        }
+        Ok(Arc::new(Self(options)))
+    }
+    fn record(&self, bytes: i64) {
+        if let Some(record) = self.0.record {
+            unsafe { record(self.0.context, bytes) };
+        }
+    }
+    fn reserve(&self, bytes: usize) -> i32 {
+        self.0
+            .reserve
+            .map_or(0, |f| unsafe { f(self.0.context, bytes) })
+    }
+    fn finish(&self, bytes: usize, allocated: bool) {
+        if let Some(f) = self.0.finish_reserve {
+            unsafe { f(self.0.context, bytes, allocated) };
+        }
+    }
+    /// Check the host's current limit/cancellation state outside the allocator callback.
+    pub fn check(&self) -> Result<()> {
+        let code = self.0.check.map_or(0, |f| unsafe { f(self.0.context) });
+        if code == 0 {
+            Ok(())
+        } else {
+            Err(limit_error(code))
+        }
+    }
+}
+impl Drop for MemoryAccount {
+    fn drop(&mut self) {
+        if let Some(release) = self.0.release_context {
+            unsafe { release(self.0.context) };
+        }
+    }
+}
+
+/// A structured memory error survives wrappers without parsing diagnostic strings.
+#[derive(Debug)]
+pub struct MemoryLimit {
+    pub code: i32,
+}
+impl std::fmt::Display for MemoryLimit {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        write!(f, "host memory limit exceeded (category {})", self.code)
+    }
+}
+impl std::error::Error for MemoryLimit {}
+fn limit_error(code: i32) -> Error {
+    Error::wrapped(Box::new(MemoryLimit { code }))
+}
+
+struct ProcessAccounts {
+    background: Arc<MemoryAccount>,
+    index: Arc<MemoryAccount>,
+    metadata: Arc<MemoryAccount>,
+}
+/// Find a host limit category through nested storage, Arrow and SDK error sources.
+pub fn limit_code(error: &(dyn std::error::Error + 'static)) -> Option<i32> {
+    let mut error = Some(error);
+    while let Some(source) = error {
+        if let Some(limit) = source.downcast_ref::<MemoryLimit>() {
+            return Some(limit.code);
+        }
+        error = source.source();
+    }
+    None
+}
+static ACCOUNTS: OnceLock<ProcessAccounts> = OnceLock::new();
+/// Install process-lifetime accounts before opening SDK sessions/readers.
+pub fn install_accounts(
+    background: Arc<MemoryAccount>,
+    index: Arc<MemoryAccount>,
+    metadata: Arc<MemoryAccount>,
+) -> Result<()> {
+    ACCOUNTS
+        .set(ProcessAccounts {
+            background,
+            index,
+            metadata,
+        })
+        .map_err(|_| Error::invalid_input("host memory accounts already installed"))
+}
+/// Return the process account used by shared services and reactor bookkeeping.
+pub fn background_account() -> Option<Arc<MemoryAccount>> {
+    ACCOUNTS.get().map(|a| a.background.clone())
+}
+/// Return the account for shared index-cache construction.
+pub fn index_cache_account() -> Option<Arc<MemoryAccount>> {
+    ACCOUNTS.get().map(|a| a.index.clone())
+}
+/// Return the account for shared metadata-cache construction.
+pub fn metadata_cache_account() -> Option<Arc<MemoryAccount>> {
+    ACCOUNTS.get().map(|a| a.metadata.clone())
+}
+struct ScopeRecord {
+    account: Option<Arc<MemoryAccount>>,
+    active: bool,
+}
+
+struct ScopeStack {
+    records: Vec<ScopeRecord>,
+}
+
+impl ScopeStack {
+    fn enter(&mut self, account: Option<Arc<MemoryAccount>>) -> usize {
+        if self.records.len() == self.records.capacity() {
+            // The reused scope stack is thread bookkeeping, not a query payload.
+            // Clearing only the allocator's pointer attributes capacity growth to BG.
+            let previous = CURRENT.with(|current| current.replace(ptr::null()));
+            let _restore = CurrentRestore(previous);
+            self.records.reserve(1);
+        }
+        let token = self.records.len();
+        let account_ptr = account.as_ref().map_or(ptr::null(), Arc::as_ptr);
+        self.records.push(ScopeRecord {
+            account,
+            active: true,
+        });
+        CURRENT.with(|current| current.set(account_ptr));
+        token
+    }
+
+    fn leave(&mut self, token: usize) -> Option<Arc<MemoryAccount>> {
+        let record = self.records.get_mut(token)?;
+        record.active = false;
+        let account = record.account.take();
+        if token + 1 != self.records.len() {
+            return account;
+        }
+
+        // TLS owns every pointer exposed to the allocator. Out-of-order drops
+        // leave tombstones; restore only a still-live scope before releasing Arcs.
+        let account_ptr = self
+            .records
+            .iter()
+            .rev()
+            .find(|record| record.active)
+            .and_then(|record| record.account.as_ref())
+            .map_or(ptr::null(), Arc::as_ptr);
+        CURRENT.with(|current| current.set(account_ptr));
+        while self.records.last().is_some_and(|record| !record.active) {
+            // Accounts are detached on their guard's drop, so pruning tombstones
+            // cannot invoke foreign release callbacks while the stack is borrowed.
+            debug_assert!(self.records.last().unwrap().account.is_none());
+            self.records.pop();
+        }
+        account
+    }
+}
+
+impl Drop for ScopeStack {
+    fn drop(&mut self) {
+        // Forgotten guards may leave live records until thread shutdown. The
+        // allocator must stop borrowing their pointers before those Arcs drop.
+        let _ = CURRENT.try_with(|current| current.set(ptr::null()));
+    }
+}
+
+struct CurrentRestore(*const MemoryAccount);
+impl Drop for CurrentRestore {
+    fn drop(&mut self) {
+        let _ = CURRENT.try_with(|current| current.set(self.0));
+    }
+}
+
+thread_local! {
+    static CURRENT: Cell<*const MemoryAccount> = const { Cell::new(ptr::null()) };
+    static IN_ALLOCATOR: Cell<bool> = const { Cell::new(false) };
+    static SCOPES: RefCell<ScopeStack> = const {
+        RefCell::new(ScopeStack { records: Vec::new() })
+    };
+}
+/// An explicitly scoped account; unlike the default, it describes the current operation.
+pub fn explicit_account() -> Option<Arc<MemoryAccount>> {
+    let p = CURRENT.try_with(Cell::get).unwrap_or(ptr::null());
+    if p.is_null() {
+        None
+    } else {
+        unsafe {
+            Arc::increment_strong_count(p);
+            Some(Arc::from_raw(p))
+        }
+    }
+}
+/// The operation account, falling back to host process services.
+pub fn current_account() -> Option<Arc<MemoryAccount>> {
+    explicit_account().or_else(background_account)
+}
+thread_local! {
+    static PARKING_READY: Cell<bool> = const { Cell::new(false) };
+}
+
+fn initialize_thread_bookkeeping() {
+    let _ = PARKING_READY.try_with(|ready| {
+        if ready.get() {
+            return;
+        }
+        // parking_lot retains old process-wide bucket tables as threads arrive.
+        // Initialize this thread before entering QUERY/CACHE, including growth
+        // triggered by the first contended cache lock on a new host worker.
+        let previous = CURRENT.with(|current| current.replace(ptr::null()));
+        let _restore = CurrentRestore(previous);
+        static PARKING_KEY: u8 = 0;
+        // Validation always fails: initialize TLS/table state without enqueueing
+        // or sleeping. The private stable address cannot alias a live lock key.
+        unsafe {
+            parking_lot_core::park(
+                (&PARKING_KEY as *const u8) as usize,
+                || false,
+                || {},
+                |_, _| {},
+                parking_lot_core::ParkToken(0),
+                None,
+            );
+        }
+        ready.set(true);
+    });
