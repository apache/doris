+/// A thread-bound allocation scope. Async users must re-enter it for each future poll.
+pub struct MemoryGuard {
+    token: Option<usize>,
+    _thread_bound: std::marker::PhantomData<*const ()>,
+}
+impl MemoryGuard {
+    pub fn enter(account: Option<Arc<MemoryAccount>>) -> Self {
+        initialize_thread_bookkeeping();
+        // Foreign account destructors can re-enter during TLS shutdown. Once the
+        // stack is unavailable, keep the cleared pointer and process fallback.
+        let token = SCOPES
+            .try_with(|scopes| scopes.borrow_mut().enter(account))
+            .ok();
+        Self {
+            token,
+            _thread_bound: std::marker::PhantomData,
+        }
+    }
+}
+impl Drop for MemoryGuard {
+    fn drop(&mut self) {
+        if let Some(token) = self.token {
+            let account = SCOPES
+                .try_with(|scopes| scopes.borrow_mut().leave(token))
+                .ok()
+                .flatten();
+            // A foreign release callback may enter another scope. The old stack
+            // borrow must be gone before the final retained account is released.
+            drop(account);
+        }
+    }
+}
+/// Report a cooperative limit error at a fallible SDK boundary.
+pub fn check_current() -> Result<()> {
+    current_account().map_or(Ok(()), |a| a.check())
+}
+/// Poll a loader under its cache account while preserving the submitting query executor.
+pub fn scope<F: Future>(
+    account: Option<Arc<MemoryAccount>>,
+    future: F,
+) -> impl Future<Output = F::Output> {
+    MemoryFuture { account, future }
+}
+struct MemoryFuture<F> {
+    account: Option<Arc<MemoryAccount>>,
+    future: F,
+}
+impl<F: Future> Future for MemoryFuture<F> {
+    type Output = F::Output;
+    fn poll(self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Self::Output> {
+        // Pinning MemoryFuture pins its inline future; neither this projection nor Drop moves it.
+        let this = unsafe { self.get_unchecked_mut() };
+        let _scope = MemoryGuard::enter(this.account.clone());
+        unsafe { Pin::new_unchecked(&mut this.future) }.poll(cx)
+    }
+}
