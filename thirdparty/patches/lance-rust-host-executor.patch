+/// Allocation owner captured when a cache payload is constructed.
+///
+/// Retain this beside lazy cells so a later query initializes them under the
+/// original owner. Query-local values capture their query account in the same way.
+/// Cloning a view preserves ownership rather than capturing the viewing query.
+#[derive(Clone)]
+pub struct CacheMemoryOwner(Option<Arc<MemoryAccount>>);
+
+impl CacheMemoryOwner {
+    /// Capture the current allocation owner before publishing a shared object.
+    pub fn capture() -> Self {
+        Self(memory::current_account())
+    }
+
+    /// Enter this owner for a synchronous lazy initializer only.
+    pub fn enter(&self) -> MemoryGuard {
+        MemoryGuard::enter(self.0.clone())
+    }
+
+    /// Poll a lazy initializer under its retained owner, preserving its executor.
+    pub fn scope<F: Future>(&self, future: F) -> impl Future<Output = F::Output> {
+        memory::scope(self.0.clone(), future)
+    }
+}
+
+impl Default for CacheMemoryOwner {
+    fn default() -> Self {
+        Self::capture()
+    }
+}
+
+impl std::fmt::Debug for CacheMemoryOwner {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("CacheMemoryOwner").finish_non_exhaustive()
+    }
+}
+
+impl DeepSizeOf for CacheMemoryOwner {
+    fn deep_size_of_children(&self, _: &mut Context) -> usize {
+        // Host ledgers are shared process/query services, not another cache payload.
+        0
+    }
+}
