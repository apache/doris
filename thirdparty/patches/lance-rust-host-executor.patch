+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright The Lance Authors
+
+//! Keep an operation's executor across DataFusion's partition/stream task boundaries.
+
+use std::fmt;
+use std::sync::{Arc, Weak};
+
+use arrow_schema::SchemaRef;
+use datafusion::execution::TaskContext;
+use datafusion::physical_plan::{
+    DisplayAs, DisplayFormatType, ExecutionPlan, PlanProperties, SendableRecordBatchStream,
+    metrics::MetricsSet, stream::RecordBatchStreamAdapter,
+};
+use datafusion_common::{DataFusionError, Result};
+use lance_core::utils::task_executor::{self, Executor, ExecutorGuard};
+
+pub(crate) fn wrap(
+    plan: Arc<dyn ExecutionPlan>,
+    executor: Arc<dyn Executor>,
+) -> Result<Arc<dyn ExecutionPlan>> {
+    let children = plan.children();
+    let inner = if children.is_empty() {
+        plan
+    } else {
+        let children = children
+            .into_iter()
+            .map(|child| wrap(Arc::clone(child), Arc::clone(&executor)))
+            .collect::<Result<Vec<_>>>()?;
+        plan.with_new_children(children)?
+    };
+    Ok(Arc::new(HostExecutorExec {
+        inner,
+        executor: Arc::downgrade(&executor),
+    }))
+}
+
+struct HostExecutorExec {
+    inner: Arc<dyn ExecutionPlan>,
+    executor: Weak<dyn Executor>,
+}
+impl fmt::Debug for HostExecutorExec {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("HostExecutorExec")
+            .field("inner", &self.inner)
+            .finish()
+    }
+}
+impl DisplayAs for HostExecutorExec {
+    fn fmt_as(&self, format: DisplayFormatType, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        self.inner.fmt_as(format, f)
+    }
+}
+impl ExecutionPlan for HostExecutorExec {
+    fn name(&self) -> &str {
+        "HostExecutorExec"
+    }
+    fn schema(&self) -> SchemaRef {
+        self.inner.schema()
+    }
+    fn properties(&self) -> &Arc<PlanProperties> {
+        self.inner.properties()
+    }
+    fn children(&self) -> Vec<&Arc<dyn ExecutionPlan>> {
+        self.inner.children()
+    }
+    fn with_new_children(
+        self: Arc<Self>,
+        children: Vec<Arc<dyn ExecutionPlan>>,
+    ) -> Result<Arc<dyn ExecutionPlan>> {
+        Ok(Arc::new(Self {
+            inner: Arc::clone(&self.inner).with_new_children(children)?,
+            executor: self.executor.clone(),
+        }))
+    }
+    fn metrics(&self) -> Option<MetricsSet> {
+        self.inner.metrics()
+    }
+    fn execute(
+        &self,
+        partition: usize,
+        context: Arc<TaskContext>,
+    ) -> Result<SendableRecordBatchStream> {
+        let executor = self.executor.upgrade().ok_or_else(|| {
+            DataFusionError::Execution("Lance host executor has been closed".into())
+        })?;
+        let _scope = ExecutorGuard::enter(Arc::clone(&executor));
+        let stream = self.inner.execute(partition, context)?;
+        let schema = stream.schema();
+        Ok(Box::pin(RecordBatchStreamAdapter::new(
+            schema,
+            task_executor::scope_stream(executor, stream),
+        )))
+    }
+}
