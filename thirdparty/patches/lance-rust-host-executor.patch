+fn spawn_host<F>(executor: Arc<dyn Executor>, kind: TaskKind, future: F) -> JoinHandle<F::Output>
+where
+    F: Future + Send + 'static,
+    F::Output: Send + 'static,
+{
+    let reactor = Handle::current();
+    let weak = Arc::downgrade(&executor);
+    let wrapped = ScopedFuture {
+        future: Box::pin(future),
+        executor: weak.clone(),
+        reactor: reactor.clone(),
+        memory: memory::explicit_account().or_else(|| executor.memory_account()),
+    };
+    let cleanup_reactor = reactor.clone();
+    let schedule = move |runnable: async_task::Runnable| {
+        if let Some(executor) = weak.upgrade() {
+            executor.schedule(
+                kind,
+                Box::new(move || {
+                    runnable.run();
+                }),
+            );
+        } else {
+            // A wake may hold a channel lock. Drop a retired future on the control runtime,
+            // outside the wake callback, because its destructor can acquire that same lock.
+            defer_drop(cleanup_reactor.clone(), runnable);
+        }
+    };
+    let (runnable, task) = async_task::spawn(AssertUnwindSafe(wrapped).catch_unwind(), schedule);
+    runnable.schedule();
+    // Preserve Tokio JoinHandle's panic, abort, and detach semantics. This task only waits;
+    // the user future's polls execute on the host, including nested task submissions.
+    let (abort_sender, abort_receiver) = tokio::sync::oneshot::channel();
+    let join = reactor.spawn(async move {
+        let abort: tokio::task::AbortHandle = abort_receiver
+            .await
+            .expect("spawn_host always supplies its abort handle");
+        match task.fallible().await {
+            Some(Ok(value)) => value,
+            Some(Err(payload)) => resume_unwind(payload),
+            None => {
+                // Dropping a queued Runnable cancels async-task. Its infallible await would
+                // panic, so cancel the Tokio bridge and yield for a normal cancelled JoinError.
+                abort.abort();
+                std::future::pending().await
+            }
+        }
+    });
+    let _ = abort_sender.send(join.abort_handle());
+    join
+}
+
+/// Spawn an operation-owned future, using Tokio when no host executor is installed.
+pub fn spawn<F>(future: F) -> JoinHandle<F::Output>
+where
+    F: Future + Send + 'static,
+    F::Output: Send + 'static,
+{
+    spawn_with_executor(current_executor(), future)
+}
+
+/// Spawn with the executor captured when an operation was submitted.
+/// Shared schedulers must use the request owner, not the query that created the scheduler.
+pub fn spawn_with_executor<F>(
+    executor: Option<Arc<dyn Executor>>,
+    future: F,
+) -> JoinHandle<F::Output>
+where
+    F: Future + Send + 'static,
+    F::Output: Send + 'static,
+{
+    match executor {
+        Some(executor) => spawn_host(executor, TaskKind::Cpu, future),
+        None => tokio::spawn(future),
+    }
+}
+
+/// Dispatch a shared scheduler request with both its captured execution and allocation context.
+pub fn spawn_with_context<F>(
+    executor: Option<Arc<dyn Executor>>,
+    account: Option<Arc<MemoryAccount>>,
+    future: F,
+) -> JoinHandle<F::Output>
+where
+    F: Future + Send + 'static,
+    F::Output: Send + 'static,
+{
+    let _memory = MemoryGuard::enter(account);
+    spawn_with_executor(executor, future)
+}
+
+/// Spawn a process-scoped service without retaining its creator's query executor.
+pub fn spawn_background<F>(future: F) -> JoinHandle<F::Output>
+where
+    F: Future + Send + 'static,
+    F::Output: Send + 'static,
+{
+    let _memory = MemoryGuard::enter(memory::background_account());
+    spawn_with_executor(DEFAULT_EXECUTOR.get().cloned(), future)
+}
+
+/// Spawn one blocking operation. The host must keep blocking I/O separate from CPU work.
+pub fn spawn_blocking<F, T>(kind: TaskKind, function: F) -> JoinHandle<T>
+where
+    F: FnOnce() -> T + Send + 'static,
+    T: Send + 'static,
+{
+    match current_executor() {
+        Some(executor) => spawn_host(executor, kind, async move { function() }),
+        None => tokio::task::spawn_blocking(function),
+    }
+}
+
+/// A thread-bound scope for synchronous entry points. Do not hold it across `.await`.
+pub struct ExecutorGuard {
+    _context: ContextGuard,
+    _memory: MemoryGuard,
+    _owner: Arc<dyn Executor>,
+    _thread_bound: std::marker::PhantomData<*const ()>,
+}
+impl ExecutorGuard {
+    /// Install the executor until the guard is dropped on this same thread.
+    pub fn enter(executor: Arc<dyn Executor>) -> Self {
+        Self {
+            _context: ContextGuard::enter(Arc::downgrade(&executor)),
+            // Entering another query overrides the caller's prior query scope.
+            // Cache loaders use memory::scope directly and keep the executor unchanged.
+            _memory: MemoryGuard::enter(
+                executor.memory_account().or_else(memory::explicit_account),
+            ),
+            _owner: executor,
+            _thread_bound: std::marker::PhantomData,
+        }
+    }
+}
+
+/// Preserve the operation context when another task polls an execution-plan stream.
+pub fn scope_stream<S>(
+    executor: Arc<dyn Executor>,
+    stream: S,
+) -> impl futures::Stream<Item = S::Item>
+where
+    S: futures::Stream + Send + 'static,
+    S::Item: Send + 'static,
+{
+    use futures::{SinkExt, StreamExt};
+    let stream = ScopedStream {
+        stream: Box::pin(stream),
+        executor: Arc::downgrade(&executor),
+        reactor: Handle::current(),
+        memory: memory::explicit_account().or_else(|| executor.memory_account()),
+    };
+    let (mut sender, receiver) = futures::channel::mpsc::channel(1);
+    // DataFusion may consume a stream from a Tokio control task. Poll each plan node on
+    // the host instead, so filters/merges cannot turn the reactor into a hidden CPU pool.
+    let task = spawn_host(executor, TaskKind::Cpu, async move {
+        let mut stream = std::pin::pin!(stream);
+        while let Some(item) = stream.next().await {
+            if sender.send(item).await.is_err() {
+                break;
+            }
+        }
+    });
+    DrivenStream {
+        receiver,
+        task: Some(task),
+        finished: false,
+    }
+}
+
+struct DrivenStream<T> {
+    receiver: futures::channel::mpsc::Receiver<T>,
+    task: Option<JoinHandle<()>>,
+    finished: bool,
+}
+impl<T> futures::Stream for DrivenStream<T> {
+    type Item = T;
+    fn poll_next(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Option<T>> {
+        if self.finished {
+            return Poll::Ready(None);
+        }
+        match Pin::new(&mut self.receiver).poll_next(cx) {
+            Poll::Ready(None) => {
+                let Some(task) = self.task.as_mut() else {
+                    return Poll::Ready(None);
+                };
+                match Pin::new(task).poll(cx) {
+                    Poll::Pending => Poll::Pending,
+                    Poll::Ready(result) => {
+                        self.task = None;
+                        self.finished = true;
+                        if let Err(error) = result {
+                            if error.is_panic() {
+                                resume_unwind(error.into_panic());
+                            }
+                            panic!("host stream task was cancelled while still being consumed");
+                        }
+                        Poll::Ready(None)
+                    }
+                }
+            }
+            item => item,
+        }
+    }
+}
+impl<T> Drop for DrivenStream<T> {
+    fn drop(&mut self) {
+        if let Some(task) = self.task.take() {
+            task.abort();
+        }
+    }
+}
+
+struct ScopedStream<S> {
+    stream: Pin<Box<S>>,
+    memory: Option<Arc<MemoryAccount>>,
+    executor: Weak<dyn Executor>,
+    reactor: Handle,
+}
+impl<S: futures::Stream> futures::Stream for ScopedStream<S> {
+    type Item = S::Item;
+    fn poll_next(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Option<Self::Item>> {
+        let reactor = self.reactor.clone();
+        let _reactor = reactor.enter();
+        let _context = ContextGuard::enter(self.executor.clone());
+        let _memory = MemoryGuard::enter(self.memory.clone());
+        self.stream.as_mut().poll_next(cx)
+    }
+}
+
+/// Cancellation-safe operation task, matching DataFusion's abort-on-drop contract.
+pub struct SpawnedTask<T>(JoinHandle<T>);
+impl<T> std::fmt::Debug for SpawnedTask<T> {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("SpawnedTask").finish_non_exhaustive()
+    }
+}
+impl<T: Send + 'static> SpawnedTask<T> {
+    /// Submit through the operation's executor, retaining abort-on-drop behavior.
+    pub fn spawn<F: Future<Output = T> + Send + 'static>(future: F) -> Self {
+        Self(spawn(future))
+    }
+}
+impl<T> Future for SpawnedTask<T> {
+    type Output = Result<T, tokio::task::JoinError>;
+    fn poll(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Self::Output> {
+        Pin::new(&mut self.0).poll(cx)
+    }
+}
+impl<T> Drop for SpawnedTask<T> {
+    fn drop(&mut self) {
+        self.0.abort();
+    }
+}
