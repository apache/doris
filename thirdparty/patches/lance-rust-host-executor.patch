+    fn test_fullzip_wide_values_keep_the_fallibly_admitted_buffer() {
+        use lance_core::utils::memory::{self, MemoryAccount, MemoryAccountOptions, MemoryGuard};
+        use std::ffi::c_void;
+        use std::sync::atomic::{AtomicI64, AtomicUsize, Ordering};
+
+        struct Budget {
+            limit: AtomicUsize,
+            live: AtomicI64,
+            requests: AtomicUsize,
+        }
+        unsafe extern "C" fn record(context: *mut c_void, bytes: i64) {
+            unsafe { &*context.cast::<Budget>() }
+                .live
+                .fetch_add(bytes, Ordering::SeqCst);
+        }
+        unsafe extern "C" fn reserve(context: *mut c_void, bytes: usize) -> i32 {
+            let budget = unsafe { &*context.cast::<Budget>() };
+            budget.requests.fetch_add(1, Ordering::SeqCst);
+            if bytes > budget.limit.load(Ordering::SeqCst) {
+                1
+            } else {
+                unsafe { record(context, bytes as i64) };
+                0
+            }
+        }
+        unsafe extern "C" fn finish(context: *mut c_void, bytes: usize, allocated: bool) {
+            if !allocated {
+                unsafe { record(context, -(bytes as i64)) };
+            }
+        }
+        unsafe extern "C" fn check(_: *mut c_void) -> i32 {
+            0
+        }
+
+        for width in [128_usize, 256, 1024] {
+            let num_rows = 3;
+            let data_size = num_rows * 2 * width;
+            let mut zipped = Vec::new();
+            let mut expected = Vec::new();
+            for (row, validity) in [0b11, 0b01, 0b11].into_iter().enumerate() {
+                zipped.push(validity);
+                let values = vec![(row + 1) as u8; width * 2];
+                zipped.extend_from_slice(&values);
+                expected.extend_from_slice(&values);
+            }
+            let decompressor = ValueDecompressor {
+                bits_per_item: width as u64 * 8,
+                bits_per_value: (width as u64 * 2 + 1) * 8,
+                items_per_value: 2,
+                layers: vec![super::ValueFslDesc {
+                    dimension: 2,
+                    has_validity: true,
+                }],
+            };
+            let input = || crate::data::FixedWidthDataBlock {
+                bits_per_value: decompressor.bits_per_value,
+                num_values: num_rows as u64,
+                data: zipped.clone().into(),
+                block_info: crate::data::BlockInfo::new(),
+            };
+            let budget = Box::new(Budget {
+                // The old 64-byte-aligned output fits this budget, but cannot
+                // guarantee zero-copy conversion for these wider values.
+                limit: AtomicUsize::new(data_size + 64),
+                live: AtomicI64::new(0),
+                requests: AtomicUsize::new(0),
+            });
+            let account = unsafe {
+                MemoryAccount::new(MemoryAccountOptions {
+                    abi_version: 1,
+                    struct_size: std::mem::size_of::<MemoryAccountOptions>() as u32,
+                    context: (&*budget as *const Budget).cast_mut().cast(),
+                    retain_context: None,
+                    release_context: None,
+                    record: Some(record),
+                    reserve: Some(reserve),
+                    finish_reserve: Some(finish),
+                    check: Some(check),
+                })
+            }
+            .unwrap();
+            let _scope = MemoryGuard::enter(Some(account));
+            let denied =
+                FixedPerValueDecompressor::decompress(&decompressor, input(), num_rows as u64);
+            assert!(denied.is_err(), "wide aligned output bypassed its budget");
+            assert_eq!(memory::limit_code(&denied.err().unwrap()), Some(1));
+            assert_eq!(budget.live.load(Ordering::SeqCst), 0);
+
+            budget.limit.store(usize::MAX, Ordering::SeqCst);
+            let decoded =
+                FixedPerValueDecompressor::decompress(&decompressor, input(), num_rows as u64)
+                    .unwrap();
+            let DataBlock::FixedSizeList(list) = &decoded else {
+                panic!("expected fixed-size-list output");
+            };
+            let DataBlock::Nullable(nullable) = list.child.as_ref() else {
+                panic!("expected nullable inner values");
+            };
+            let DataBlock::FixedWidth(values) = nullable.data.as_ref() else {
+                panic!("expected fixed-width inner values");
+            };
+            assert_eq!(values.data.as_ref(), expected.as_slice());
+            assert_eq!(nullable.nulls.as_ref()[0] & 0x3f, 0b11_01_11);
+            assert_eq!(values.data.as_ref().as_ptr() as usize % width, 0);
+            // A fallback Vec copy would drop the admitted owner while output
+            // remained live, bypassing both fallible admission and this ledger.
+            assert!(budget.live.load(Ordering::SeqCst) >= data_size as i64);
+            assert_eq!(budget.requests.load(Ordering::SeqCst), 2);
+            drop(decoded);
+            assert_eq!(budget.live.load(Ordering::SeqCst), 0);
+        }
+    }
