+#[repr(C)]
+struct AllocationHeader {
+    account: *const MemoryAccount,
+    bytes: usize,
+}
+
+struct AllocatorGuard(bool);
+impl AllocatorGuard {
+    fn enter() -> Self {
+        Self(IN_ALLOCATOR.try_with(|c| c.replace(true)).unwrap_or(true))
+    }
+    fn account(&self) -> *const MemoryAccount {
+        if self.0 {
+            return ptr::null();
+        }
+        let p = CURRENT.try_with(Cell::get).unwrap_or(ptr::null());
+        if !p.is_null() {
+            p
+        } else {
+            ACCOUNTS
+                .get()
+                .map_or(ptr::null(), |a| Arc::as_ptr(&a.background))
+        }
+    }
+}
+impl Drop for AllocatorGuard {
+    fn drop(&mut self) {
+        let _ = IN_ALLOCATOR.try_with(|c| c.set(self.0));
+    }
+}
+
+fn allocation_layout(layout: Layout) -> Option<(Layout, usize)> {
+    Layout::new::<AllocationHeader>()
+        .extend(layout)
+        .ok()
+        .map(|(raw, offset)| (raw.pad_to_align(), offset))
+}
+
+/// Registered by the embedding C library; SDK-only users keep their chosen global allocator.
+/// Every block has a header, including blocks created before host registration.
+pub struct TrackedAllocator;
+unsafe impl GlobalAlloc for TrackedAllocator {
+    unsafe fn alloc(&self, layout: Layout) -> *mut u8 {
+        let guard = AllocatorGuard::enter();
+        let Some((raw, offset)) = allocation_layout(layout) else {
+            return ptr::null_mut();
+        };
+        let base = unsafe { System.alloc(raw) };
+        if base.is_null() {
+            return base;
+        }
+        let account = guard.account();
+        if !account.is_null() {
+            // Keep the ledger alive through delayed Arrow release and cross-thread cleanup.
+            unsafe {
+                Arc::increment_strong_count(account);
+                (*account).record(raw.size() as i64);
+            }
+        }
+        unsafe {
+            base.cast::<AllocationHeader>().write(AllocationHeader {
+                account,
+                bytes: raw.size(),
+            });
+            base.add(offset)
+        }
+    }
+    unsafe fn dealloc(&self, p: *mut u8, layout: Layout) {
+        let _guard = AllocatorGuard::enter();
+        if let Some((raw, offset)) = allocation_layout(layout) {
+            let base = unsafe { p.sub(offset) };
+            let header = unsafe { base.cast::<AllocationHeader>().read() };
+            unsafe {
+                System.dealloc(base, raw);
+            }
+            if !header.account.is_null() {
+                // Release to the allocation's owner, never the freeing thread's current query.
+                unsafe {
+                    (*header.account).record(-(header.bytes as i64));
+                    drop(Arc::from_raw(header.account));
+                }
+            }
+        }
+    }
+    unsafe fn realloc(&self, p: *mut u8, layout: Layout, new_size: usize) -> *mut u8 {
+        let _guard = AllocatorGuard::enter();
+        let Ok(new_layout) = Layout::from_size_align(new_size, layout.align()) else {
+            return ptr::null_mut();
+        };
+        let (Some((old_raw, offset)), Some((new_raw, new_offset))) =
+            (allocation_layout(layout), allocation_layout(new_layout))
+        else {
+            return ptr::null_mut();
+        };
+        debug_assert_eq!(offset, new_offset);
+        let base = unsafe { p.sub(offset) };
+        let account = unsafe { (*base.cast::<AllocationHeader>()).account };
+        let resized = unsafe { System.realloc(base, old_raw, new_raw.size()) };
+        if resized.is_null() {
+            return ptr::null_mut();
+        }
+        if !account.is_null() {
+            unsafe {
+                (*account).record(new_raw.size() as i64 - old_raw.size() as i64);
+            }
+        }
+        unsafe {
+            resized.cast::<AllocationHeader>().write(AllocationHeader {
+                account,
+                bytes: new_raw.size(),
+            });
+            resized.add(offset)
+        }
+    }
+}
+
+fn try_allocate(layout: Layout) -> Result<ptr::NonNull<u8>> {
+    let guard = AllocatorGuard::enter();
+    let (raw, offset) = allocation_layout(layout)
+        .ok_or_else(|| Error::invalid_input("host buffer allocation size overflow"))?;
+    let account = guard.account();
+    if !account.is_null() {
+        let code = unsafe { (*account).reserve(raw.size()) };
+        if code != 0 {
+            return Err(limit_error(code));
+        }
+    }
+    let base = unsafe { System.alloc_zeroed(raw) };
+    if !account.is_null() {
+        unsafe {
+            (*account).finish(raw.size(), !base.is_null());
+        }
+    }
+    let base = ptr::NonNull::new(base).ok_or_else(|| Error::io("host buffer allocation failed"))?;
+    if !account.is_null() {
+        unsafe {
+            Arc::increment_strong_count(account);
+        }
+    }
+    unsafe {
+        base.as_ptr()
+            .cast::<AllocationHeader>()
+            .write(AllocationHeader {
+                account,
+                bytes: raw.size(),
+            });
+        Ok(ptr::NonNull::new_unchecked(base.as_ptr().add(offset)))
+    }
+}
+/// An owned read buffer with a fallible admission/allocation path.
+pub struct OwnedBuffer {
+    ptr: ptr::NonNull<u8>,
+    len: usize,
+    layout: Layout,
+}
+unsafe impl Send for OwnedBuffer {}
+unsafe impl Sync for OwnedBuffer {}
+impl OwnedBuffer {
+    pub fn try_zeroed(len: usize) -> Result<Self> {
+        Self::try_zeroed_aligned(len, 64)
+    }
+    /// Allocate a fallible buffer with explicit alignment for Arrow's zero-copy decoding.
+    pub fn try_zeroed_aligned(len: usize, alignment: usize) -> Result<Self> {
+        let layout = Layout::from_size_align(len, alignment)
+            .map_err(|_| Error::invalid_input("host read buffer size or alignment overflow"))?;
+        if len == 0 {
+            return Ok(Self {
+                ptr: ptr::NonNull::dangling(),
+                len: 0,
+                layout,
+            });
+        }
+        let ptr = try_allocate(layout)?;
+        Ok(Self { ptr, len, layout })
+    }
+    pub fn as_mut_ptr(&mut self) -> *mut u8 {
+        self.ptr.as_ptr()
+    }
+}
+impl AsRef<[u8]> for OwnedBuffer {
+    fn as_ref(&self) -> &[u8] {
+        unsafe { std::slice::from_raw_parts(self.ptr.as_ptr(), self.len) }
+    }
+}
+impl AsMut<[u8]> for OwnedBuffer {
+    fn as_mut(&mut self) -> &mut [u8] {
+        unsafe { std::slice::from_raw_parts_mut(self.ptr.as_ptr(), self.len) }
+    }
+}
+impl Drop for OwnedBuffer {
+    fn drop(&mut self) {
+        if self.len == 0 {
+            return;
+        }
+        unsafe { TrackedAllocator.dealloc(self.ptr.as_ptr(), self.layout) }
+    }
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::sync::atomic::{AtomicI64, AtomicUsize, Ordering};
+    struct Counter {
+        bytes: AtomicI64,
+        peak: AtomicI64,
+        limit: i64,
+        released: AtomicUsize,
+    }
+    unsafe extern "C" fn record(ctx: *mut std::ffi::c_void, bytes: i64) {
+        let c = unsafe { &*ctx.cast::<Counter>() };
+        let now = c.bytes.fetch_add(bytes, Ordering::SeqCst) + bytes;
+        c.peak.fetch_max(now, Ordering::SeqCst);
+    }
+    unsafe extern "C" fn reserve(ctx: *mut std::ffi::c_void, bytes: usize) -> i32 {
+        let c = unsafe { &*ctx.cast::<Counter>() };
+        if c.bytes
+            .fetch_update(Ordering::SeqCst, Ordering::SeqCst, |v| {
+                (v + bytes as i64 <= c.limit).then_some(v + bytes as i64)
+            })
+            .is_err()
+        {
+            1
+        } else {
+            0
+        }
+    }
+    unsafe extern "C" fn finish(ctx: *mut std::ffi::c_void, bytes: usize, allocated: bool) {
+        if !allocated {
+            unsafe { record(ctx, -(bytes as i64)) };
+        }
+    }
+    unsafe extern "C" fn check(ctx: *mut std::ffi::c_void) -> i32 {
+        let c = unsafe { &*ctx.cast::<Counter>() };
+        i32::from(c.bytes.load(Ordering::SeqCst) > c.limit)
+    }
+    unsafe extern "C" fn release(ctx: *mut std::ffi::c_void) {
+        unsafe { &*ctx.cast::<Counter>() }
+            .released
+            .fetch_add(1, Ordering::SeqCst);
+    }
+    fn account(limit: i64) -> (Box<Counter>, Arc<MemoryAccount>) {
+        let c = Box::new(Counter {
+            bytes: AtomicI64::new(0),
+            peak: AtomicI64::new(0),
+            limit,
+            released: AtomicUsize::new(0),
+        });
+        let a = unsafe {
+            MemoryAccount::new(MemoryAccountOptions {
+                abi_version: 1,
+                struct_size: std::mem::size_of::<MemoryAccountOptions>() as u32,
+                context: (&*c as *const Counter).cast_mut().cast(),
+                retain_context: None,
+                release_context: Some(release),
+                record: Some(record),
+                reserve: Some(reserve),
+                finish_reserve: Some(finish),
+                check: Some(check),
+            })
+        }
+        .unwrap();
+        (c, a)
+    }
+    #[test]
+    fn heap_allocation_is_released_to_its_original_owner_on_another_thread() {
+        let (first, a) = account(1 << 20);
+        let (second, b) = account(1 << 20);
+        let layout = Layout::from_size_align(4096, 64).unwrap();
+        let ptr = {
+            let _scope = MemoryGuard::enter(Some(a.clone()));
+            unsafe { TrackedAllocator.alloc(layout) }
+        };
+        assert!(!ptr.is_null());
+        assert_eq!(ptr as usize % 64, 0);
+        assert!(first.bytes.load(Ordering::SeqCst) >= 4096);
+        let raw = ptr as usize;
+        std::thread::spawn(move || {
+            let _scope = MemoryGuard::enter(Some(b));
+            unsafe { TrackedAllocator.dealloc(raw as *mut u8, layout) };
