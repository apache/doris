+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright The Lance Authors
+
+//! Optional host scheduling for operation-owned tasks. Tokio remains the I/O reactor.
+
+use std::cell::RefCell;
+use std::future::Future;
+use std::panic::{AssertUnwindSafe, resume_unwind};
+use std::pin::Pin;
+use std::sync::{Arc, OnceLock, Weak};
+use std::task::{Context, Poll};
+
+use futures::FutureExt;
+use tokio::runtime::Handle;
+use tokio::task::JoinHandle;
+
+/// One nonblocking poll, or one blocking operation, scheduled by the host.
+pub type Task = Box<dyn FnOnce() + Send + 'static>;
+
+/// CPU polls and blocking I/O may use different host execution resources.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum TaskKind {
+    /// Async polls and CPU-intensive work.
+    Cpu,
+    /// Blocking file operations. A running operation must be allowed to finish.
+    Io,
+}
+
+/// The host must enqueue a task without blocking or executing it inline.
+pub trait Executor: Send + Sync + 'static {
+    /// Schedule exactly one execution of `task`, including during cancellation.
+    fn schedule(&self, kind: TaskKind, task: Task);
+}
+
+thread_local! {
+    static CURRENT_EXECUTOR: RefCell<Option<Weak<dyn Executor>>> = RefCell::new(None);
+}
+
+static DEFAULT_EXECUTOR: OnceLock<Arc<dyn Executor>> = OnceLock::new();
+
+/// Install process services for work that is not owned by a query.
+pub fn set_default_executor(executor: Arc<dyn Executor>) {
+    let _ = DEFAULT_EXECUTOR.set(executor);
+}
+
+/// Returns the operation executor, or the host-owned process services.
+pub fn current_executor() -> Option<Arc<dyn Executor>> {
+    CURRENT_EXECUTOR
+        .with(|current| current.borrow().as_ref().and_then(Weak::upgrade))
+        .or_else(|| DEFAULT_EXECUTOR.get().cloned())
+}
+
+struct ContextGuard(Option<Weak<dyn Executor>>);
+impl ContextGuard {
+    fn enter(executor: Weak<dyn Executor>) -> Self {
+        Self(CURRENT_EXECUTOR.with(|current| current.replace(Some(executor))))
+    }
+}
+impl Drop for ContextGuard {
+    fn drop(&mut self) {
+        CURRENT_EXECUTOR.with(|current| current.replace(self.0.take()));
+    }
+}
+
+/// A scoped future restores the previous executor after every poll and on panic.
+/// The caller must keep the executor alive until the operation has been cancelled or completed.
+pub fn scope<F: Future>(executor: Arc<dyn Executor>, future: F) -> impl Future<Output = F::Output> {
+    ScopedFuture {
+        future: Box::pin(future),
+        executor: Arc::downgrade(&executor),
+        reactor: Handle::current(),
+    }
+}
+
+struct ScopedFuture<F> {
+    future: Pin<Box<F>>,
+    executor: Weak<dyn Executor>,
+    reactor: Handle,
+}
+impl<F: Future> Future for ScopedFuture<F> {
+    type Output = F::Output;
+    fn poll(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Self::Output> {
+        let reactor = self.reactor.clone();
+        let _reactor = reactor.enter();
+        let _context = ContextGuard::enter(self.executor.clone());
+        self.future.as_mut().poll(cx)
+    }
+}
+
+fn spawn_host<F>(executor: Arc<dyn Executor>, kind: TaskKind, future: F) -> JoinHandle<F::Output>
+where
+    F: Future + Send + 'static,
+    F::Output: Send + 'static,
+{
+    let reactor = Handle::current();
+    let weak = Arc::downgrade(&executor);
+    let wrapped = ScopedFuture {
+        future: Box::pin(future),
+        executor: weak.clone(),
+        reactor: reactor.clone(),
+    };
+    let cleanup_reactor = reactor.clone();
+    let schedule = move |runnable: async_task::Runnable| {
+        if let Some(executor) = weak.upgrade() {
+            executor.schedule(
+                kind,
+                Box::new(move || {
+                    runnable.run();
+                }),
+            );
+        } else {
+            // A wake may hold a channel lock. Drop a retired future on the control runtime,
+            // outside the wake callback, because its destructor can acquire that same lock.
+            cleanup_reactor.spawn(async move {
+                drop(runnable);
+            });
+        }
+    };
+    let (runnable, task) = async_task::spawn(AssertUnwindSafe(wrapped).catch_unwind(), schedule);
+    runnable.schedule();
+    // Preserve Tokio JoinHandle's panic, abort, and detach semantics. This task only waits;
+    // the user future's polls execute on the host, including nested task submissions.
+    let (abort_sender, abort_receiver) = tokio::sync::oneshot::channel();
+    let join = reactor.spawn(async move {
+        let abort: tokio::task::AbortHandle = abort_receiver
+            .await
+            .expect("spawn_host always supplies its abort handle");
+        match task.fallible().await {
+            Some(Ok(value)) => value,
+            Some(Err(payload)) => resume_unwind(payload),
+            None => {
+                // Dropping a queued Runnable cancels async-task. Its infallible await would
+                // panic, so cancel the Tokio bridge and yield for a normal cancelled JoinError.
+                abort.abort();
+                std::future::pending().await
+            }
+        }
+    });
+    let _ = abort_sender.send(join.abort_handle());
+    join
+}
+
+/// Spawn an operation-owned future, using Tokio when no host executor is installed.
+pub fn spawn<F>(future: F) -> JoinHandle<F::Output>
+where
+    F: Future + Send + 'static,
+    F::Output: Send + 'static,
+{
+    match current_executor() {
+        Some(executor) => spawn_host(executor, TaskKind::Cpu, future),
+        None => tokio::spawn(future),
+    }
+}
+
+/// Spawn one blocking operation. The host must keep blocking I/O separate from CPU work.
+pub fn spawn_blocking<F, T>(kind: TaskKind, function: F) -> JoinHandle<T>
+where
+    F: FnOnce() -> T + Send + 'static,
+    T: Send + 'static,
+{
+    match current_executor() {
+        Some(executor) => spawn_host(executor, kind, async move { function() }),
+        None => tokio::task::spawn_blocking(function),
+    }
+}
+
+/// A thread-bound scope for synchronous entry points. Do not hold it across `.await`.
+pub struct ExecutorGuard {
+    _context: ContextGuard,
+    _owner: Arc<dyn Executor>,
+    _thread_bound: std::marker::PhantomData<*const ()>,
+}
+impl ExecutorGuard {
+    /// Install the executor until the guard is dropped on this same thread.
+    pub fn enter(executor: Arc<dyn Executor>) -> Self {
+        Self {
+            _context: ContextGuard::enter(Arc::downgrade(&executor)),
+            _owner: executor,
+            _thread_bound: std::marker::PhantomData,
+        }
+    }
+}
+
+/// Preserve the operation context when another task polls an execution-plan stream.
+pub fn scope_stream<S>(
+    executor: Arc<dyn Executor>,
+    stream: S,
+) -> impl futures::Stream<Item = S::Item>
+where
+    S: futures::Stream + Send + 'static,
+    S::Item: Send + 'static,
+{
+    use futures::{SinkExt, StreamExt};
+    let stream = ScopedStream {
+        stream: Box::pin(stream),
+        executor: Arc::downgrade(&executor),
+        reactor: Handle::current(),
+    };
+    let (mut sender, receiver) = futures::channel::mpsc::channel(1);
+    // DataFusion may consume a stream from a Tokio control task. Poll each plan node on
+    // the host instead, so filters/merges cannot turn the reactor into a hidden CPU pool.
+    let task = spawn_host(executor, TaskKind::Cpu, async move {
+        let mut stream = std::pin::pin!(stream);
+        while let Some(item) = stream.next().await {
+            if sender.send(item).await.is_err() {
+                break;
+            }
+        }
+    });
+    DrivenStream {
+        receiver,
+        task: Some(task),
+        finished: false,
+    }
+}
+
+struct DrivenStream<T> {
+    receiver: futures::channel::mpsc::Receiver<T>,
+    task: Option<JoinHandle<()>>,
+    finished: bool,
+}
+impl<T> futures::Stream for DrivenStream<T> {
+    type Item = T;
+    fn poll_next(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Option<T>> {
+        if self.finished {
+            return Poll::Ready(None);
+        }
+        match Pin::new(&mut self.receiver).poll_next(cx) {
+            Poll::Ready(None) => {
+                let Some(task) = self.task.as_mut() else {
+                    return Poll::Ready(None);
+                };
+                match Pin::new(task).poll(cx) {
+                    Poll::Pending => Poll::Pending,
+                    Poll::Ready(result) => {
+                        self.task = None;
+                        self.finished = true;
+                        if let Err(error) = result {
+                            if error.is_panic() {
+                                resume_unwind(error.into_panic());
+                            }
+                            panic!("host stream task was cancelled while still being consumed");
+                        }
+                        Poll::Ready(None)
+                    }
+                }
+            }
+            item => item,
+        }
+    }
+}
+impl<T> Drop for DrivenStream<T> {
+    fn drop(&mut self) {
+        if let Some(task) = self.task.take() {
+            task.abort();
+        }
+    }
+}
+
+struct ScopedStream<S> {
+    stream: Pin<Box<S>>,
+    executor: Weak<dyn Executor>,
+    reactor: Handle,
+}
+impl<S: futures::Stream> futures::Stream for ScopedStream<S> {
+    type Item = S::Item;
+    fn poll_next(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Option<Self::Item>> {
+        let reactor = self.reactor.clone();
+        let _reactor = reactor.enter();
+        let _context = ContextGuard::enter(self.executor.clone());
+        self.stream.as_mut().poll_next(cx)
+    }
+}
+
+/// Cancellation-safe operation task, matching DataFusion's abort-on-drop contract.
+pub struct SpawnedTask<T>(JoinHandle<T>);
+impl<T> std::fmt::Debug for SpawnedTask<T> {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("SpawnedTask").finish_non_exhaustive()
+    }
+}
+impl<T: Send + 'static> SpawnedTask<T> {
+    /// Submit through the operation's executor, retaining abort-on-drop behavior.
+    pub fn spawn<F: Future<Output = T> + Send + 'static>(future: F) -> Self {
+        Self(spawn(future))
+    }
+}
+impl<T> Future for SpawnedTask<T> {
+    type Output = Result<T, tokio::task::JoinError>;
+    fn poll(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Self::Output> {
+        Pin::new(&mut self.0).poll(cx)
+    }
+}
+impl<T> Drop for SpawnedTask<T> {
+    fn drop(&mut self) {
+        self.0.abort();
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::collections::VecDeque;
+    use std::sync::Mutex;
+
+    #[derive(Default)]
+    struct ManualExecutor(Mutex<VecDeque<Task>>, futures::task::AtomicWaker);
+
+    impl Executor for ManualExecutor {
+        fn schedule(&self, _kind: TaskKind, task: Task) {
+            self.0.lock().unwrap().push_back(task);
+            self.1.wake();
+        }
+    }
+
+    impl ManualExecutor {
+        fn run(&self) {
+            loop {
+                let task = self.0.lock().unwrap().pop_front();
+                match task {
+                    Some(task) => task(),
+                    None => break,
+                }
+            }
+        }
+    }
+
+    #[tokio::test(flavor = "current_thread")]
+    async fn nested_tasks_execute_on_host_and_restore_context() {
+        let executor = Arc::new(ManualExecutor::default());
+        let host_thread = std::thread::current().id();
+        let future = scope(executor.clone(), async move {
+            spawn(async move {
+                assert_eq!(std::thread::current().id(), host_thread);
+                spawn_blocking(TaskKind::Cpu, move || std::thread::current().id())
+                    .await
+                    .unwrap()
+            })
+            .await
+            .unwrap()
+        });
+        tokio::pin!(future);
+        let actual = futures::future::poll_fn(|cx| {
+            executor.1.register(cx.waker());
+            executor.run();
+            future.as_mut().poll(cx)
+        });
+        let actual = tokio::time::timeout(std::time::Duration::from_secs(2), actual)
+            .await
+            .unwrap();
+        assert_eq!(actual, host_thread);
+        assert!(current_executor().is_none());
+    }
+
+    #[tokio::test(flavor = "current_thread")]
+    async fn abort_drops_pending_host_future() {
+        struct Dropped(Arc<std::sync::atomic::AtomicBool>);
+        impl Drop for Dropped {
+            fn drop(&mut self) {
+                self.0.store(true, std::sync::atomic::Ordering::SeqCst);
+            }
+        }
+        let executor = Arc::new(ManualExecutor::default());
+        let dropped = Arc::new(std::sync::atomic::AtomicBool::new(false));
+        let guard = Dropped(dropped.clone());
+        let handle = scope(executor.clone(), async move {
+            spawn(async move {
+                let _guard = guard;
+                futures::future::pending::<()>().await;
+            })
+        })
+        .await;
+        executor.run();
+        tokio::task::yield_now().await;
+        handle.abort();
+        assert!(handle.await.unwrap_err().is_cancelled());
+        executor.run();
+        assert!(dropped.load(std::sync::atomic::Ordering::SeqCst));
+    }
+
+    #[tokio::test(flavor = "current_thread")]
+    async fn panic_is_a_join_error_without_crossing_host_callback() {
+        let executor = Arc::new(ManualExecutor::default());
+        let handle = scope(executor.clone(), async {
+            spawn(async {
+                panic!("host task panic");
+            })
+        })
+        .await;
+        executor.run();
+        assert!(handle.await.unwrap_err().is_panic());
+    }
+
+    #[tokio::test(flavor = "current_thread")]
+    async fn default_executor_remains_tokio() {
+        let handle = spawn(async { 42 });
+        assert_eq!(handle.await.unwrap(), 42);
+    }
+}
