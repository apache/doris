+        })
+        .await;
+        executor.run();
+        assert!(handle.await.unwrap_err().is_panic());
+    }
+
+    #[tokio::test(flavor = "current_thread")]
+    async fn default_executor_remains_tokio() {
+        let handle = spawn(async { 42 });
+        assert_eq!(handle.await.unwrap(), 42);
+    }
