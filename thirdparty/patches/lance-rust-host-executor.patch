+//! Optional host scheduling for operation-owned tasks. Tokio remains the I/O reactor.
+
+use std::cell::RefCell;
+use std::future::Future;
+use std::panic::{AssertUnwindSafe, resume_unwind};
+use std::pin::Pin;
+use std::sync::atomic::{AtomicUsize, Ordering};
+use std::sync::{Arc, OnceLock, Weak};
+use std::task::{Context, Poll};
+
+use futures::FutureExt;
+use tokio::runtime::Handle;
+use tokio::task::JoinHandle;
+
+use super::memory::{self, MemoryAccount, MemoryGuard};
+
+/// One nonblocking poll, or one blocking operation, scheduled by the host.
+pub type Task = Box<dyn FnOnce() + Send + 'static>;
+
+/// CPU polls and blocking I/O may use different host execution resources.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum TaskKind {
+    /// Async polls and CPU-intensive work.
+    Cpu,
+    /// Blocking file operations. A running operation must be allowed to finish.
+    Io,
+    /// Deferred destruction, admitted until the host runtime has completely stopped.
+    Cleanup,
+}
+
+/// The host must enqueue a task without blocking or executing it inline.
+pub trait Executor: Send + Sync + 'static {
+    /// Schedule exactly one execution of `task`, including during cancellation.
+    fn schedule(&self, kind: TaskKind, task: Task);
+
+    /// Allocation ledger for operation-owned work. Shared cache scopes may override it.
+    fn memory_account(&self) -> Option<Arc<MemoryAccount>> {
+        None
+    }
+
+    /// Maximum fan-out for one synchronous CPU operation; process services default to serial.
+    fn cpu_parallelism(&self) -> usize {
+        1
+    }
+
+    /// Cooperatively execute a ready CPU child while a synchronous host caller joins its work.
+    fn run_cpu_task(&self) -> bool {
+        false
+    }
+}
+
+thread_local! {
+    static CURRENT_EXECUTOR: RefCell<Option<Weak<dyn Executor>>> = RefCell::new(None);
+}
+
+static DEFAULT_EXECUTOR: OnceLock<Arc<dyn Executor>> = OnceLock::new();
+
+/// Install process services for work that is not owned by a query.
+pub fn set_default_executor(executor: Arc<dyn Executor>) {
+    let _ = DEFAULT_EXECUTOR.set(executor);
+}
+
+/// Returns the operation executor, or the host-owned process services.
+pub fn current_executor() -> Option<Arc<dyn Executor>> {
+    CURRENT_EXECUTOR
+        .with(|current| current.borrow().as_ref().and_then(Weak::upgrade))
+        .or_else(|| DEFAULT_EXECUTOR.get().cloned())
+}
+
+static DEFERRED_DROPS: AtomicUsize = AtomicUsize::new(0);
+static DROPS_DONE: tokio::sync::Notify = tokio::sync::Notify::const_new();
+
+struct DropCompletion;
+impl Drop for DropCompletion {
+    fn drop(&mut self) {
+        DEFERRED_DROPS.fetch_sub(1, Ordering::AcqRel);
+        DROPS_DONE.notify_waiters();
+    }
+}
+
+/// Leave wake locks before handing potentially expensive destructors to host cleanup workers.
+/// The host must continue accepting Cleanup jobs until its runtime-stop fence completes.
+pub fn defer_drop<T: Send + 'static>(reactor: Handle, value: T) {
+    DEFERRED_DROPS.fetch_add(1, Ordering::AcqRel);
+    let deferred = (value, DropCompletion);
+    let executor = DEFAULT_EXECUTOR.get().cloned();
+    reactor.spawn(async move {
+        if let Some(executor) = executor {
+            executor.schedule(TaskKind::Cleanup, Box::new(move || drop(deferred)));
+        } else {
+            drop(deferred);
+        }
+    });
+}
+
+/// Wait for reactor handoffs and all recursively scheduled destructors before stopping services.
+pub async fn drain_deferred_drops() {
+    loop {
+        let notified = DROPS_DONE.notified();
+        tokio::pin!(notified);
+        notified.as_mut().enable();
+        if DEFERRED_DROPS.load(Ordering::Acquire) == 0 {
+            return;
+        }
+        notified.await;
+    }
+}
