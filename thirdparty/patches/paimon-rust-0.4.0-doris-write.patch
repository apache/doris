+/// Stop a standard writer and wait for its outstanding file work.
+/// Prepared messages remain caller-owned; this only cleans producer-owned output.
+///
+/// # Safety
+/// `tw` must be a live, exclusively accessed standard writer handle.
+#[no_mangle]
+pub unsafe extern "C" fn paimon_table_write_close(
+    tw: *mut paimon_table_write,
+) -> *mut paimon_error {
+    if let Err(error) = check_non_null(tw, "tw") {
+        return error;
+    }
+    let state = &mut *((*tw).inner as *mut TableWriteState);
+    runtime().block_on(state.write.close());
+    ptr::null_mut()
+}
+
+/// Export the pinned table's Arrow schema through the Arrow C Data Interface.
+///
+/// # Safety
+/// `table` must be a valid table handle. `schema` must point to writable storage
+/// for an empty ArrowSchema; the caller owns its returned release callback.
+#[no_mangle]
+pub unsafe extern "C" fn paimon_table_export_arrow_schema(
+    table: *const paimon_table,
+    schema: *mut c_void,
+) -> *mut paimon_error {
+    if let Err(error) = check_non_null(table, "table") {
+        return error;
+    }
+    if let Err(error) = check_non_null(schema, "schema") {
+        return error;
+    }
+    let table = &*((*table).inner as *const Table);
+    let arrow_schema = match paimon::arrow::build_target_arrow_schema(table.schema().fields()) {
+        Ok(schema) => schema,
+        Err(error) => return paimon_error::from_paimon(error),
+    };
+    match FFI_ArrowSchema::try_from(arrow_schema.as_ref()) {
+        Ok(value) => {
+            ptr::write(schema.cast::<FFI_ArrowSchema>(), value);
+            ptr::null_mut()
+        }
+        Err(error) => invalid_input(format!("Cannot export Arrow schema: {error}")),
+    }
+}
