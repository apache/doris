+    /// Encode an ordinary append for Java 1.4.x CommitMessageSerializer v11.
+    /// Newer conflict and index semantics must never be silently discarded.
+    pub fn serialize_append_java_v11(&self, max_bytes: usize) -> crate::Result<Vec<u8>> {
+        if self.format_file.is_some()
+            || self.fixed_bucket_overwrite
+            || self.check_from_snapshot.is_some()
+            || self.total_buckets.is_some()
+            || !self.deleted_files.is_empty()
+            || !self.new_changelog_files.is_empty()
+            || !self.new_index_files.is_empty()
+            || !self.deleted_index_files.is_empty()
+            || !self.compact_before.is_empty()
+            || !self.compact_after.is_empty()
+            || !self.compact_changelog_files.is_empty()
+            || !self.compact_new_index_files.is_empty()
+            || !self.compact_deleted_index_files.is_empty()
+        {
+            return Err(crate::Error::Unsupported {
+                message: "Java v11 export supports ordinary append messages only".into(),
+            });
+        }
+        fn append(out: &mut Vec<u8>, data: &[u8], limit: usize) -> crate::Result<()> {
+            if data.len() > limit.saturating_sub(out.len()) {
+                return Err(crate::Error::ResourceExhausted {
+                    message: "Serialized commit message exceeds its output limit".into(),
+                });
+            }
+            out.extend_from_slice(data);
+            Ok(())
+        }
+        let partition = if self.partition.is_empty() {
+            BinaryRow::new(0).to_serialized_bytes()
+        } else {
+            BinaryRow::from_serialized_bytes(&self.partition)?;
+            self.partition.clone()
+        };
+        let mut out = Vec::new();
+        append(&mut out, &(partition.len() as i32).to_be_bytes(), max_bytes)?;
+        append(&mut out, &partition, max_bytes)?;
+        append(&mut out, &self.bucket.to_be_bytes(), max_bytes)?;
+        append(&mut out, &[0], max_bytes)?; // no totalBuckets
+        let count =
+            i32::try_from(self.new_files.len()).map_err(|_| invalid("Too many data files"))?;
+        append(&mut out, &count.to_be_bytes(), max_bytes)?;
+        for file in &self.new_files {
+            let row = file.to_serialized_row_data_with_layout(DataFileMetaRowLayout::WriteCols)?;
+            let length =
+                i32::try_from(row.len()).map_err(|_| invalid("Data file metadata too large"))?;
+            append(&mut out, &length.to_be_bytes(), max_bytes)?;
+            append(&mut out, &row, max_bytes)?;
+        }
+        // Nine empty lists: the remaining data increment and compact increment.
+        append(&mut out, &[0; 36], max_bytes)?;
+        Ok(out)
+    }
