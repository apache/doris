     #[tokio::test]
+    async fn doris_reserved_input_triggers_flush_for_dictionary_encoded_strings() {
+        use crate::spec::VarCharType;
+        use arrow_array::StringArray;
+        use parquet::arrow::arrow_reader::ParquetRecordBatchReaderBuilder;
+
+        let limit = 6 * 1024 * 1024;
+        let resources = ResourceContext::builder()
+            .memory_limit(limit)
+            .build()
+            .unwrap();
+        let io = FileIOBuilder::new("memory").build().unwrap();
+        let path = "memory:///doris-input-budget";
+        let mut writer = DataFileWriter::new(
+            io.clone(),
+            path.into(),
+            String::new(),
+            0,
+            0,
+            i64::MAX,
+            "zstd".into(),
+            1,
+            1024 * 1024,
+            "parquet".into(),
+            vec![DataField::new(
+                0,
+                "id".into(),
+                DataType::VarChar(VarCharType::string_type()),
+            )],
+            HashMap::new(),
+            Some(0),
+            None,
+            None,
+        )
+        .unwrap()
+        .with_resources(Some(resources.clone()));
+        let schema = Arc::new(Schema::new(vec![Field::new(
+            "id",
+            ArrowDataType::Utf8,
+            true,
+        )]));
+        let value = "x".repeat(4096);
+        for _ in 0..4 {
+            // Distinct input buffers, but the dictionary encodes each batch to a few KiB.
+            let array = StringArray::from(vec![value.as_str(); 1024]);
+            let batch = RecordBatch::try_new(schema.clone(), vec![Arc::new(array)]).unwrap();
+            writer.write(&batch).await.unwrap();
+        }
+        let files = writer.prepare_commit().await.unwrap();
+        assert_eq!(files.len(), 1);
+        assert_eq!(files[0].row_count, 4096);
+        let input = io
+            .new_input(&format!("{path}/bucket-0/{}", files[0].file_name))
+            .unwrap();
+        let reader = ParquetRecordBatchReaderBuilder::try_new(input.read().await.unwrap())
+            .unwrap()
+            .build()
+            .unwrap();
+        assert_eq!(
+            reader.map(|batch| batch.unwrap().num_rows()).sum::<usize>(),
+            4096
+        );
+        assert_eq!(resources.metrics().reserved_memory_bytes, 0);
+        assert!(resources.metrics().peak_reserved_memory_bytes <= limit);
+    }
