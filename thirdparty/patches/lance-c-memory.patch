+            for index in range.start / block_size..=(range.end - 1) / block_size {
+                indices.try_push(index).map_err(cache_budget_error)?;
+            }
+        }
+        indices.sort_unstable();
+        let mut distinct = 0;
+        for index in 0..indices.len() {
+            let value = indices[index];
+            if distinct == 0 || indices[distinct - 1] != value {
+                indices[distinct] = value;
+                distinct += 1;
+            }
+        }
+        indices.truncate(distinct);
+        let mut entries = lance_core::memory::BudgetedVec::try_with_capacity(indices.len())
+            .map_err(cache_budget_error)?;
