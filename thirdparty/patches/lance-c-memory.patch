diff --git a/tests/test_header_order.sh b/tests/test_header_order.sh
new file mode 100755
index 0000000000000000000000000000000000000000..789a37e990a11ed5262c778255f055e21b760b4f
--- /dev/null
+++ b/tests/test_header_order.sh
@@ -0,0 +1,33 @@
+#!/usr/bin/env bash
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright The Lance Authors
+set -euo pipefail
+native_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
+arrow_include=${1:?provide the Arrow include directory containing arrow/c/abi.h}
+source_file=$(mktemp)
+trap 'rm -f "${source_file}"' EXIT
+cat > "${source_file}" <<'SOURCE'
+int main(void) {
+    LanceSession* session = 0;
+    LanceMemoryBudget* budget = 0;
+    return lance_session_set_memory_budget(session, budget);
+}
+SOURCE
+for language in c c++; do
+    compiler=cc
+    standard=c11
+    if [[ ${language} == c++ ]]; then
+        compiler=c++
+        standard=c++17
+    fi
+    for first in arrow lance; do
+        if [[ ${first} == arrow ]]; then
+            headers=(-include arrow/c/abi.h -include lance/lance.h)
+        else
+            headers=(-include lance/lance.h -include arrow/c/abi.h)
+        fi
+        "${compiler}" -std="${standard}" -x "${language}" -fsyntax-only \
+            -I "${native_root}/include" -I "${arrow_include}" \
+            "${headers[@]}" "${source_file}"
+    done
+done
