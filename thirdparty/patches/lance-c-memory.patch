diff --git a/src/memory.rs b/src/memory.rs
new file mode 100644
index 0000000000000000000000000000000000000000..ddd57bb49e3a635efdec8b571ef4b4a67b9a74d5
--- /dev/null
+++ b/src/memory.rs
@@ -0,0 +1,345 @@
+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright The Lance Authors
+
+//! Owned allocation budgets for embedding query and process accounts.
+
+use std::ffi::c_void;
+use std::fmt;
+use std::sync::Arc;
+
+use lance_core::memory::{MemoryAccountant, MemoryBudget, MemoryError, MemoryScope};
+use lance_core::{Error, Result};
+
+use crate::error::{ffi_try, swallow_unwind};
+
+/// Non-unwinding, thread-safe callbacks retained until the last allocation owner.
+#[repr(C)]
+#[derive(Clone, Copy)]
+pub struct LanceMemoryCallbacks {
+    pub context: *mut c_void,
+    pub try_reserve: Option<unsafe extern "C" fn(*mut c_void, u64) -> i32>,
+    pub release: Option<unsafe extern "C" fn(*mut c_void, u64)>,
+    pub release_context: Option<unsafe extern "C" fn(*mut c_void)>,
+}
+
+struct HostAccountant {
+    context: *mut c_void,
+    try_reserve: unsafe extern "C" fn(*mut c_void, u64) -> i32,
+    release: unsafe extern "C" fn(*mut c_void, u64),
+    release_context: Option<unsafe extern "C" fn(*mut c_void)>,
+}
+
+// The callback contract requires the host context and callbacks to be thread-safe.
+unsafe impl Send for HostAccountant {}
+unsafe impl Sync for HostAccountant {}
+impl std::panic::RefUnwindSafe for HostAccountant {}
+
+impl fmt::Debug for HostAccountant {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str("HostAccountant")
+    }
+}
+
+impl MemoryAccountant for HostAccountant {
+    fn try_reserve(&self, bytes: usize) -> Result<()> {
+        match unsafe { (self.try_reserve)(self.context, bytes as u64) } {
+            0 => Ok(()),
+            1 => Err(MemoryError::LimitExceeded {
+                requested: bytes,
+                used: 0,
+                limit: 0,
+            }
+            .into()),
+            2 => Err(MemoryError::Cancelled.into()),
+            code => Err(MemoryError::ExternalCallbackFailed { code, bytes }.into()),
+        }
+    }
+
+    fn release(&self, bytes: usize) {
+        unsafe { (self.release)(self.context, bytes as u64) };
+    }
+}
+
+impl Drop for HostAccountant {
+    fn drop(&mut self) {
+        if let Some(callback) = self.release_context {
+            unsafe { callback(self.context) };
+        }
+    }
+}
+
+/// Opaque, movable owner. Closing it does not revoke exported allocations.
+pub struct LanceMemoryBudget {
+    pub(crate) inner: Arc<MemoryBudget>,
+}
+
+/// Opaque synchronous scope: exit on the same thread, in reverse entry order.
+pub struct LanceMemoryScope {
+    _inner: MemoryScope,
+}
+
+/// Construct an owned budget. Callback context ownership transfers on success.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn lance_memory_budget_new(
+    limit: u64,
+    callbacks: *const LanceMemoryCallbacks,
+) -> *mut LanceMemoryBudget {
+    ffi_try!(
+        (|| {
+            let limit = usize::try_from(limit).map_err(|_| {
+                Error::invalid_input_source("memory budget limit exceeds usize::MAX".into())
+            })?;
+            let budget = MemoryBudget::new(limit)?;
+            let budget = if callbacks.is_null() {
+                budget
+            } else {
+                let callbacks = unsafe { std::ptr::read_unaligned(callbacks) };
+                if callbacks.try_reserve.is_none() || callbacks.release.is_none() {
+                    return Err(Error::invalid_input_source(
+                        "memory callbacks require try_reserve and release".into(),
+                    ));
+                }
+                budget.with_accountant(Arc::new(HostAccountant {
+                    context: callbacks.context,
+                    try_reserve: callbacks
+                        .try_reserve
+                        .expect("validated reservation callback"),
+                    release: callbacks.release.expect("validated release callback"),
+                    release_context: callbacks.release_context,
+                }))
+            };
+            Ok(Box::into_raw(Box::new(LanceMemoryBudget {
+                inner: Arc::new(budget),
+            })))
+        })(),
+        null
+    )
+}
+
+/// Install an owned budget for synchronous calls and submitted async descendants.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn lance_memory_scope_enter(
+    budget: *const LanceMemoryBudget,
+) -> *mut LanceMemoryScope {
+    ffi_try!(
+        (|| {
+            let budget = unsafe { budget.as_ref() }.ok_or_else(|| {
+                Error::invalid_input_source("memory budget must not be NULL".into())
+            })?;
+            Ok(Box::into_raw(Box::new(LanceMemoryScope {
+                _inner: MemoryScope::enter(Some(budget.inner.clone())),
+            })))
+        })(),
+        null
+    )
+}
+
+/// Restore the previous synchronous scope. NULL is accepted.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn lance_memory_scope_exit(scope: *mut LanceMemoryScope) {
+    if !scope.is_null() {
+        swallow_unwind("lance_memory_scope_exit", || unsafe {
+            drop(Box::from_raw(scope))
+        });
+    }
+}
+
+/// Drop the host handle while preserving all live reservations and descendants.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn lance_memory_budget_close(budget: *mut LanceMemoryBudget) {
+    if !budget.is_null() {
+        swallow_unwind("lance_memory_budget_close", || unsafe {
+            drop(Box::from_raw(budget))
+        });
+    }
+}
+
+/// Reject future reservations without releasing memory still in use.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn lance_memory_budget_cancel(budget: *const LanceMemoryBudget) {
+    if let Some(budget) = unsafe { budget.as_ref() } {
+        budget.inner.cancel();
+    }
+}
+
+/// Return live admitted bytes, including exported buffers and pending tasks.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn lance_memory_budget_usage(budget: *const LanceMemoryBudget) -> u64 {
+    unsafe { budget.as_ref() }.map_or(0, |budget| budget.inner.used() as u64)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::error::{lance_last_error_memory_kind, set_lance_error};
+    use arrow::ffi::{FFI_ArrowArray, FFI_ArrowSchema};
+    use arrow_array::{Array, UInt32Array};
+    use lance_core::memory::BudgetedVec;
+    use std::sync::atomic::{AtomicI32, AtomicUsize, Ordering};
+
+    #[derive(Default)]
+    struct Host {
+        bytes: AtomicUsize,
+        drops: AtomicUsize,
+        reject: AtomicI32,
+    }
+    unsafe extern "C" fn reserve(context: *mut c_void, bytes: u64) -> i32 {
+        let host = unsafe { &*(context as *const Host) };
+        let rejection = host.reject.load(Ordering::Acquire);
+        if rejection != 0 {
+            return rejection;
+        }
+        host.bytes.fetch_add(bytes as usize, Ordering::AcqRel);
+        0
+    }
+    unsafe extern "C" fn release(context: *mut c_void, bytes: u64) {
+        unsafe { &*(context as *const Host) }
+            .bytes
+            .fetch_sub(bytes as usize, Ordering::AcqRel);
+    }
+    unsafe extern "C" fn release_context(context: *mut c_void) {
+        let host = unsafe { Box::from_raw(context as *mut Arc<Host>) };
+        host.drops.fetch_add(1, Ordering::AcqRel);
+    }
+    unsafe extern "C" fn arc_reserve(context: *mut c_void, bytes: u64) -> i32 {
+        let host = unsafe { &*(context as *const Arc<Host>) };
+        unsafe { reserve(Arc::as_ptr(host) as *mut c_void, bytes) }
+    }
+    unsafe extern "C" fn arc_release(context: *mut c_void, bytes: u64) {
+        let host = unsafe { &*(context as *const Arc<Host>) };
+        unsafe { release(Arc::as_ptr(host) as *mut c_void, bytes) }
+    }
+    fn budget(host: &Arc<Host>, limit: u64) -> *mut LanceMemoryBudget {
+        let callbacks = LanceMemoryCallbacks {
+            context: Box::into_raw(Box::new(host.clone())).cast(),
+            try_reserve: Some(arc_reserve),
+            release: Some(arc_release),
+            release_context: Some(release_context),
+        };
+        unsafe { lance_memory_budget_new(limit, &callbacks) }
+    }
+
+    #[test]
+    fn exported_arrow_retains_host_after_budget_scope_and_handle_close() {
+        let host = Arc::new(Host::default());
+        let budget = budget(&host, 16);
+        assert!(!budget.is_null());
+        let scope = unsafe { lance_memory_scope_enter(budget) };
+        let values = BudgetedVec::try_filled(4, 7_u32).unwrap();
+        let array = UInt32Array::new(
+            arrow::buffer::ScalarBuffer::new(values.into_buffer(), 0, 4),
+            None,
+        );
+        let exported = FFI_ArrowArray::new(&array.to_data());
+        let schema = FFI_ArrowSchema::try_from(array.data_type()).unwrap();
+        drop(array);
+        unsafe {
+            lance_memory_scope_exit(scope);
+            lance_memory_budget_close(budget);
+        }
+        assert_eq!(
+            (
+                host.bytes.load(Ordering::Acquire),
+                host.drops.load(Ordering::Acquire)
+            ),
+            (16, 0)
+        );
+        drop(schema);
+        drop(exported);
+        assert_eq!(
+            (
+                host.bytes.load(Ordering::Acquire),
+                host.drops.load(Ordering::Acquire)
+            ),
+            (0, 1)
+        );
+    }
+
+    #[test]
+    fn rejection_and_cancellation_preserve_memory_kind_and_live_charges() {
+        let host = Arc::new(Host::default());
+        let budget = budget(&host, 16);
+        let scope = unsafe { lance_memory_scope_enter(budget) };
+        let values = BudgetedVec::try_filled(2, 1_u32).unwrap();
+        host.reject.store(1, Ordering::Release);
+        let error = BudgetedVec::try_filled(1, 1_u32).unwrap_err();
+        set_lance_error(&error);
+        assert_eq!(lance_last_error_memory_kind(), 1);
+        assert_eq!(host.bytes.load(Ordering::Acquire), 8);
+        unsafe {
+            lance_memory_budget_cancel(budget);
+        }
+        let error = BudgetedVec::try_filled(1, 1_u32).unwrap_err();
+        set_lance_error(&error);
+        assert_eq!(lance_last_error_memory_kind(), 2);
+        assert_eq!(unsafe { lance_memory_budget_usage(budget) }, 8);
+        drop(values);
+        unsafe {
+            lance_memory_scope_exit(scope);
+            lance_memory_budget_close(budget);
+        }
+        assert_eq!(
+            (
+                host.bytes.load(Ordering::Acquire),
+                host.drops.load(Ordering::Acquire)
+            ),
+            (0, 1)
+        );
+    }
+
+    #[test]
+    fn invalid_construction_does_not_take_callback_context() {
+        let host = Arc::new(Host::default());
+        let callbacks = LanceMemoryCallbacks {
+            context: Arc::as_ptr(&host) as *mut c_void,
+            try_reserve: None,
+            release: Some(release),
+            release_context: None,
+        };
+        assert!(unsafe { lance_memory_budget_new(16, &callbacks) }.is_null());
+        assert!(unsafe { lance_memory_budget_new(u64::MAX, std::ptr::null()) }.is_null());
+        assert_eq!(host.drops.load(Ordering::Acquire), 0);
+    }
+    #[test]
+    fn external_callback_failure_keeps_kind_three_without_charging_and_retry_clears_it() {
+        let host = Arc::new(Host::default());
+        let budget = budget(&host, 16);
+        let scope = unsafe { lance_memory_scope_enter(budget) };
+        host.reject.store(3, Ordering::Release);
+        let error = BudgetedVec::try_filled(1, 7_u32).unwrap_err();
+        assert!(matches!(
+            MemoryError::find_in_chain(&error),
+            Some(MemoryError::ExternalCallbackFailed { code: 3, bytes: 4 })
+        ));
+        set_lance_error(&error);
+        assert_eq!(
+            crate::error::lance_last_error_code(),
+            crate::error::LanceErrorCode::Internal
+        );
+        assert_eq!(lance_last_error_memory_kind(), 3);
+        assert_eq!(host.bytes.load(Ordering::Acquire), 0);
+        assert_eq!(unsafe { lance_memory_budget_usage(budget) }, 0);
+        host.reject.store(0, Ordering::Release);
+        let values =
+            crate::error::ffi_guard_with(|| BudgetedVec::try_filled(1, 7_u32).map(Some), |_| None)
+                .expect("retry succeeds after host callback recovers");
+        assert_eq!(lance_last_error_memory_kind(), 0);
+        assert_eq!(
+            crate::error::lance_last_error_code(),
+            crate::error::LanceErrorCode::Ok
+        );
+        assert_eq!(host.bytes.load(Ordering::Acquire), 4);
+        drop(values);
+        unsafe {
+            lance_memory_scope_exit(scope);
+            lance_memory_budget_close(budget);
+        }
+        assert_eq!(
+            (
+                host.bytes.load(Ordering::Acquire),
+                host.drops.load(Ordering::Acquire)
+            ),
+            (0, 1)
+        );
+    }
+}
