+++ b/tests/native_memory_support/mod.rs
@@ -0,0 +1,147 @@
+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright The Lance Authors
+
+use lance_c::*;
+use std::ffi::c_void;
+use std::sync::Arc;
+use std::sync::atomic::{AtomicUsize, Ordering};
+
+#[derive(Default)]
+struct Counters {
+    used: AtomicUsize,
+    limit: AtomicUsize,
+    peak: AtomicUsize,
+    rejected: AtomicUsize,
+}
+unsafe extern "C" fn reserve(context: *mut c_void, bytes: u64) -> i32 {
+    let state = unsafe { &*(context as *const Arc<Counters>) };
+    let mut used = state.used.load(Ordering::Acquire);
+    loop {
+        let Some(next) = used.checked_add(bytes as usize) else {
+            return 1;
+        };
+        if next > state.limit.load(Ordering::Acquire) {
+            state.rejected.fetch_add(1, Ordering::AcqRel);
+            return 1;
+        }
+        match state
+            .used
+            .compare_exchange_weak(used, next, Ordering::AcqRel, Ordering::Acquire)
+        {
+            Ok(_) => {
+                state.peak.fetch_max(next, Ordering::AcqRel);
+                return 0;
+            }
+            Err(actual) => used = actual,
+        }
+    }
+}
+unsafe extern "C" fn release(context: *mut c_void, bytes: u64) {
+    unsafe { &*(context as *const Arc<Counters>) }
+        .used
+        .fetch_sub(bytes as usize, Ordering::AcqRel);
+}
+unsafe extern "C" fn release_context(context: *mut c_void) {
+    unsafe {
+        drop(Box::from_raw(context as *mut Arc<Counters>));
+    }
+}
+
+pub struct Probe {
+    budget: *mut LanceMemoryBudget,
+    counters: Arc<Counters>,
+}
+impl Probe {
+    pub fn new() -> Self {
+        let counters = Arc::new(Counters::default());
+        counters.limit.store(64 * 1024 * 1024, Ordering::Release);
+        let callbacks = LanceMemoryCallbacks {
+            context: Box::into_raw(Box::new(counters.clone())).cast(),
+            try_reserve: Some(reserve),
+            release: Some(release),
+            release_context: Some(release_context),
+        };
+        let budget = unsafe { lance_memory_budget_new(64 * 1024 * 1024, &callbacks) };
+        assert!(!budget.is_null());
+        Self { budget, counters }
+    }
+    pub fn enter(&self) -> Scope {
+        let scope = unsafe { lance_memory_scope_enter(self.budget) };
+        assert!(!scope.is_null());
+        Scope(scope)
+    }
+    pub fn reject_new_allocations(&self) {
+        self.counters.limit.store(0, Ordering::Release);
+    }
+    pub fn rejected(&self) -> usize {
+        self.counters.rejected.load(Ordering::Acquire)
+    }
+    pub fn used(&self) -> usize {
+        self.counters.used.load(Ordering::Acquire)
+    }
+    pub fn peak(&self) -> usize {
+        self.counters.peak.load(Ordering::Acquire)
+    }
+    #[track_caller]
+    pub fn assert_drained(&self) {
+        let deadline = std::time::Instant::now() + std::time::Duration::from_secs(5);
+        while self.counters.used.load(Ordering::Acquire) != 0
+            && std::time::Instant::now() < deadline
+        {
+            std::thread::yield_now();
+        }
+        assert_eq!(self.counters.used.load(Ordering::Acquire), 0);
+        assert_eq!(unsafe { lance_memory_budget_usage(self.budget) }, 0);
+    }
+}
+impl Drop for Probe {
+    fn drop(&mut self) {
+        unsafe {
+            lance_memory_budget_close(self.budget);
+        }
+    }
+}
+pub struct Scope(*mut LanceMemoryScope);
+impl Drop for Scope {
+    fn drop(&mut self) {
+        unsafe {
+            lance_memory_scope_exit(self.0);
+        }
+    }
+}
+
+/// Mirrors a host's process cache owner independently of each query probe.
+pub struct CacheSession {
+    handle: *mut LanceSession,
+    process: Probe,
+}
+impl CacheSession {
+    pub fn new() -> Self {
+        let process = Probe::new();
+        let scope = process.enter();
+        let handle = lance_session_new(8 * 1024 * 1024, 4 * 1024 * 1024);
+        assert!(!handle.is_null());
+        assert_eq!(
+            unsafe { lance_session_set_memory_budget(handle, process.budget) },
+            0
+        );
+        drop(scope);
+        Self { handle, process }
+    }
+    pub fn open_dataset(&self, uri: *const std::ffi::c_char) -> *mut LanceDataset {
+        let dataset =
+            unsafe { lance_dataset_open_with_session(uri, std::ptr::null(), 0, self.handle) };
+        assert!(!dataset.is_null());
+        dataset
+    }
+    pub fn assert_retained_then_clear(&self) {
+        assert!(self.process.used() > 0);
+        assert_eq!(unsafe { lance_session_clear_caches(self.handle) }, 0);
+        self.process.assert_drained();
+    }
+}
+impl Drop for CacheSession {
+    fn drop(&mut self) {
+        unsafe { lance_session_close(self.handle) };
+    }
+}
