+fn assert_native_budget_path(
+    dataset: *const LanceDataset,
+    filter: Option<&str>,
+    configure: impl Fn(*mut LanceScanner),
+    expected_ids: &[i32],
+    expected_metric: Option<&str>,
+) {
+    for denied in [false, true] {
+        let probe = native_memory_support::Probe::new();
+        let scope = probe.enter();
+        let id = c_str("id");
+        let columns = [id.as_ptr(), ptr::null()];
+        let filter = filter.map(c_str);
+        let scanner = unsafe {
+            lance_scanner_new(
+                dataset,
+                columns.as_ptr(),
+                filter
+                    .as_ref()
+                    .map_or(ptr::null(), |filter| filter.as_ptr()),
+            )
+        };
+        assert!(!scanner.is_null());
+        configure(scanner);
+        let mut statistics = CapturedScanStatistics::default();
+        assert_eq!(
+            unsafe {
+                lance_scanner_set_statistics_callback(
+                    scanner,
+                    Some(capture_scan_statistics),
+                    (&mut statistics as *mut CapturedScanStatistics).cast(),
+                )
+            },
+            0
+        );
+        drop(scope);
+        if denied {
+            probe.reject_new_allocations();
+        }
+        let mut ids = Vec::new();
+        let mut failed = false;
+        loop {
+            let mut batch = ptr::null_mut();
+            let status = unsafe { lance_scanner_next(scanner, &mut batch) };
+            if status == -1 {
+                assert!(denied, "{}", take_last_error_message());
+                assert_eq!(lance_last_error_memory_kind(), 1);
+                assert!(batch.is_null());
+                failed = true;
+                break;
+            }
+            if status == 1 {
+                break;
+            }
+            assert_eq!(status, 0);
+            let mut array = FFI_ArrowArray::empty();
+            let mut schema = FFI_ArrowSchema::empty();
+            assert_eq!(
+                unsafe { lance_batch_to_arrow(batch, &mut array, &mut schema) },
+                0
+            );
+            let data = unsafe { from_ffi(array, &schema) }.unwrap();
+            let rows = arrow_array::StructArray::from(data);
+            let id = rows
+                .column_by_name("id")
+                .unwrap()
+                .as_any()
+                .downcast_ref::<Int32Array>()
+                .unwrap();
+            ids.extend_from_slice(id.values());
+            unsafe {
+                lance_batch_free(batch);
+            }
+        }
+        unsafe {
+            lance_scanner_close(scanner);
+        }
+        if denied {
+            assert!(failed);
+            assert!(probe.rejected() > 0);
+        } else {
+            assert_eq!(ids, expected_ids);
+            assert!(probe.peak() > 0);
+            assert_eq!(statistics.calls, 1);
+            if let Some(metric) = expected_metric {
+                assert!(
+                    statistics
+                        .metrics
+                        .iter()
+                        .any(|(name, _, value)| name == metric && *value > 0),
+                    "missing executed-path metric {metric}"
+                );
+            }
+        }
+        probe.assert_drained();
+    }
+}
