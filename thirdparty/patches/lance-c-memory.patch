+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright The Lance Authors
+
+//! Generate the deterministic decoded-memory fixture used by Doris regression tests.
+
+use std::sync::Arc;
+
+use arrow_array::{Int64Array, RecordBatch, RecordBatchIterator, StringArray};
+use arrow_schema::{DataType, Field, Schema};
+use lance::Dataset;
+use lance::dataset::WriteParams;
+use lance_file::version::LanceFileVersion;
+
+fn main() -> Result<(), Box<dyn std::error::Error>> {
+    let output = std::env::args()
+        .nth(1)
+        .ok_or("usage: generate_memory_fixture output.lance")?;
+    let schema = Arc::new(Schema::new(vec![
+        Field::new("row_id", DataType::Int64, false),
+        Field::new("payload", DataType::Utf8, false),
+    ]));
+    let batches = (0..16_i64)
+        .map(|part| {
+            let start = part * 1024;
+            let payload = StringArray::from_iter_values((start..start + 1024).map(|row| {
+                let prefix = format!("native-memory-{row:05}-");
+                let mut text = prefix;
+                text.extend(std::iter::repeat_n('x', 4096 - text.len()));
+                text
+            }));
+            RecordBatch::try_new(
+                schema.clone(),
+                vec![
+                    Arc::new(Int64Array::from_iter_values(start..start + 1024)),
+                    Arc::new(payload),
+                ],
+            )
+        })
+        .collect::<Vec<_>>();
+    lance_c::runtime::block_on(Dataset::write(
+        RecordBatchIterator::new(batches, schema),
+        &output,
+        Some(WriteParams {
+            max_rows_per_file: 1024,
+            max_rows_per_group: 1024,
+            data_storage_version: Some(LanceFileVersion::V2_2),
+            ..Default::default()
+        }),
+    ))?;
+    println!("rows=16384 payload_bytes=67108864 storage_version=2.2 dataset={output}");
+    Ok(())
+}
