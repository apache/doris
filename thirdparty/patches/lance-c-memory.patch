+
+/// Classify expected memory/cancellation failures without changing legacy error codes.
+pub(crate) fn memory_kind_from_error(err: &(dyn std::error::Error + 'static)) -> i32 {
+    match lance_core::memory::MemoryError::find_in_chain(err) {
+        Some(lance_core::memory::MemoryError::Cancelled) => 2,
+        Some(lance_core::memory::MemoryError::ExternalCallbackFailed { .. }) => 3,
+        Some(_) => 1,
+        None => {
+            let mut source = Some(err);
+            while let Some(error) = source {
+                if let Some(datafusion::common::DataFusionError::ResourcesExhausted(_)) =
+                    error.downcast_ref::<datafusion::common::DataFusionError>()
+                {
+                    return 1;
+                }
+                source = error.source();
+            }
+            0
+        }
+    }
+}
+
+pub(crate) fn set_last_error_memory_kind(kind: i32) {
+    LAST_ERROR.with_borrow_mut(|last| {
+        if let Some(error) = last {
+            error.memory_kind = kind;
+        }
+    });
+}
+
+/// Return 1 for native memory admission/allocation failure, 2 for cancellation.
+/// Read before taking the error message, which clears the pending error.
+#[unsafe(no_mangle)]
+pub extern "C" fn lance_last_error_memory_kind() -> i32 {
+    LAST_ERROR.with_borrow(|error| error.as_ref().map_or(0, |error| error.memory_kind))
 }
 
