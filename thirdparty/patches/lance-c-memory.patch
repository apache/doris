@@ -0,0 +1,622 @@
+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright The Lance Authors
+
+//! Admission and final-owner accounting for Arrow C export allocations.
+
+use std::ffi::{CString, c_char, c_void};
+use std::mem::size_of;
+use std::sync::{Arc, Mutex};
+
+use arrow::array::AsArray;
+use arrow::ffi::{FFI_ArrowArray, FFI_ArrowSchema};
+use arrow::ffi_stream::FFI_ArrowArrayStream;
+use arrow_array::types::*;
+use arrow_array::{Array, RecordBatch};
+use arrow_schema::{DataType, Field, Schema, SchemaRef};
+use lance_core::memory::{MemoryBudget, MemoryReservation, MemoryScope, reserve_current};
+use lance_core::{Error, Result};
+
+fn add(left: usize, right: usize) -> Result<usize> {
+    left.checked_add(right)
+        .ok_or_else(|| Error::invalid_input("Arrow export allocation size overflow"))
+}
+fn mul(left: usize, right: usize) -> Result<usize> {
+    left.checked_mul(right)
+        .ok_or_else(|| Error::invalid_input("Arrow export allocation size overflow"))
+}
+
+// Pinned Arrow 58.3 builds a temporary Vec<FFI_ArrowSchema>, boxed child
+// structs/pointers, and private data per node. Four complete node layouts
+// cover those overlapping lifetimes and our release-owner box.
+fn dtype_schema_bytes(dtype: &DataType) -> Result<usize> {
+    let mut bytes = 4 * size_of::<FFI_ArrowSchema>() + 256;
+    match dtype {
+        DataType::Timestamp(_, Some(timezone)) => bytes = add(bytes, mul(timezone.len(), 3)?)?,
+        DataType::List(field)
+        | DataType::LargeList(field)
+        | DataType::ListView(field)
+        | DataType::LargeListView(field)
+        | DataType::FixedSizeList(field, _)
+        | DataType::Map(field, _) => {
+            bytes = add(bytes, field_schema_bytes(field)?)?;
+        }
+        DataType::Struct(fields) => {
+            for field in fields {
+                bytes = add(bytes, field_schema_bytes(field)?)?;
+            }
+        }
+        DataType::Union(fields, _) => {
+            for (_, field) in fields.iter() {
+                // Type-id format strings and their temporary String vector.
+                bytes = add(bytes, add(field_schema_bytes(field)?, 128)?)?;
+            }
+        }
+        DataType::Dictionary(key, value) => {
+            bytes = add(bytes, dtype_schema_bytes(key)?)?;
+            bytes = add(bytes, dtype_schema_bytes(value)?)?;
+        }
+        DataType::RunEndEncoded(ends, values) => {
+            bytes = add(bytes, field_schema_bytes(ends)?)?;
+            bytes = add(bytes, field_schema_bytes(values)?)?;
+        }
+        _ => {}
+    }
+    Ok(bytes)
+}
+fn metadata_bytes(metadata: &std::collections::HashMap<String, String>) -> Result<usize> {
+    let mut serialized = 4_usize;
+    for (key, value) in metadata {
+        serialized = add(serialized, add(8, add(key.len(), value.len())?)?)?;
+    }
+    // Vec serialization grows geometrically; 3x covers old/new allocation
+    // coexistence, and collecting borrowed pairs needs two pointers per pair.
+    add(
+        mul(serialized, 3)?,
+        mul(metadata.len(), 4 * size_of::<usize>())?,
+    )
+}
+fn field_schema_bytes(field: &Field) -> Result<usize> {
+    add(
+        dtype_schema_bytes(field.data_type())?,
+        add(
+            mul(add(field.name().len(), 1)?, 2)?,
+            metadata_bytes(field.metadata())?,
+        )?,
+    )
+}
+pub(crate) fn reserve_schema(schema: &Schema) -> Result<Option<MemoryReservation>> {
+    if MemoryScope::current().is_none() {
+        return Ok(None);
+    }
+    let mut bytes = add(
+        4 * size_of::<FFI_ArrowSchema>() + 256,
+        metadata_bytes(schema.metadata())?,
+    )?;
+    for field in schema.fields() {
+        bytes = add(bytes, field_schema_bytes(field)?)?;
+    }
+    reserve_current(bytes)
+}
+
+fn array_bytes(array: &dyn Array) -> Result<usize> {
+    let mut buffers = 4;
+    match array.data_type() {
+        DataType::Utf8View => buffers = add(array.as_string_view().data_buffers().len(), 3)?,
+        DataType::BinaryView => buffers = add(array.as_binary_view().data_buffers().len(), 3)?,
+        _ => {}
+    }
+    // ArrayData clones, FFI child structs/pointers, retained Buffer descriptors,
+    // and the variadic-buffer-lengths slab all have a known per-node layout.
+    let mut bytes = add(
+        3 * size_of::<arrow::array::ArrayData>() + 4 * size_of::<FFI_ArrowArray>() + 256,
+        mul(
+            buffers,
+            3 * (size_of::<Option<arrow::buffer::Buffer>>() + 2 * size_of::<usize>()),
+        )?,
+    )?;
+    if let Some(nulls) = array.nulls() {
+        if array.offset() != nulls.offset() {
+            let bits = add(array.offset(), nulls.len())?;
+            bytes = add(bytes, add(bits.div_ceil(8), 63)? & !63)?;
+        }
+    }
+    match array.data_type() {
+        DataType::Struct(_) => {
+            for child in array.as_struct().columns() {
+                bytes = add(bytes, array_bytes(child.as_ref())?)?;
+            }
+        }
+        DataType::List(_) => {
+            bytes = add(
+                bytes,
+                array_bytes(array.as_list::<i32>().values().as_ref())?,
+            )?
+        }
+        DataType::LargeList(_) => {
+            bytes = add(
+                bytes,
+                array_bytes(array.as_list::<i64>().values().as_ref())?,
+            )?
+        }
+        DataType::ListView(_) => {
+            bytes = add(
+                bytes,
+                array_bytes(array.as_list_view::<i32>().values().as_ref())?,
+            )?
+        }
+        DataType::LargeListView(_) => {
+            bytes = add(
+                bytes,
+                array_bytes(array.as_list_view::<i64>().values().as_ref())?,
+            )?
+        }
+        DataType::FixedSizeList(_, _) => {
+            bytes = add(
+                bytes,
+                array_bytes(array.as_fixed_size_list().values().as_ref())?,
+            )?
+        }
+        DataType::Map(_, _) => bytes = add(bytes, array_bytes(array.as_map().entries())?)?,
+        DataType::Union(fields, _) => {
+            for (id, _) in fields.iter() {
+                bytes = add(bytes, array_bytes(array.as_union().child(id).as_ref())?)?;
+            }
+        }
+        DataType::Dictionary(key, _) => {
+            macro_rules! values {
+                ($ty:ty) => {
+                    array.as_dictionary::<$ty>().values().as_ref()
+                };
+            }
+            let child: &dyn Array = match key.as_ref() {
+                DataType::Int8 => values!(Int8Type),
+                DataType::Int16 => values!(Int16Type),
+                DataType::Int32 => values!(Int32Type),
+                DataType::Int64 => values!(Int64Type),
+                DataType::UInt8 => values!(UInt8Type),
+                DataType::UInt16 => values!(UInt16Type),
+                DataType::UInt32 => values!(UInt32Type),
+                DataType::UInt64 => values!(UInt64Type),
+                _ => {
+                    return Err(Error::invalid_input(
+                        "Arrow dictionary key type is not integral",
+                    ));
+                }
+            };
+            bytes = add(bytes, array_bytes(child)?)?;
+        }
+        DataType::RunEndEncoded(ends, _) => {
+            let child: &dyn Array = match ends.data_type() {
+                DataType::Int16 => array.as_run::<Int16Type>().values().as_ref(),
+                DataType::Int32 => array.as_run::<Int32Type>().values().as_ref(),
+                DataType::Int64 => array.as_run::<Int64Type>().values().as_ref(),
+                _ => return Err(Error::invalid_input("Arrow run-end type is not integral")),
+            };
+            bytes = add(bytes, add(array_bytes(child)?, 1024)?)?;
+        }
+        _ => {}
+    }
+    Ok(bytes)
+}
+pub(crate) fn reserve_batch(batch: &RecordBatch) -> Result<Option<MemoryReservation>> {
+    if MemoryScope::current().is_none() {
+        return Ok(None);
+    }
+    let mut bytes =
+        3 * size_of::<arrow::array::ArrayData>() + 4 * size_of::<FFI_ArrowArray>() + 256;
+    for array in batch.columns() {
+        bytes = add(bytes, array_bytes(array.as_ref())?)?;
+    }
+    reserve_current(bytes)
+}
+
+struct SchemaOwner {
+    release: unsafe extern "C" fn(*mut FFI_ArrowSchema),
+    private: *mut c_void,
+    _memory: Arc<MemoryReservation>,
+}
+unsafe fn release_schema_inner(schema: *mut FFI_ArrowSchema) {
+    let schema = unsafe { &mut *schema };
+    let owner = unsafe { Box::from_raw(schema.private_data.cast::<SchemaOwner>()) };
+    schema.private_data = owner.private;
+    schema.release = Some(owner.release);
+    unsafe {
+        (owner.release)(schema);
+    }
+    drop(owner);
+}
+unsafe extern "C" fn release_schema(schema: *mut FFI_ArrowSchema) {
+    crate::error::swallow_unwind("Arrow schema memory owner release", || unsafe {
+        release_schema_inner(schema)
+    });
+}
+pub(crate) fn own_schema(schema: &mut FFI_ArrowSchema, memory: Arc<MemoryReservation>) {
+    for index in 0..schema.n_children as usize {
+        own_schema(unsafe { &mut **schema.children.add(index) }, memory.clone());
+    }
+    if !schema.dictionary.is_null() {
+        own_schema(unsafe { &mut *schema.dictionary }, memory.clone());
+    }
+    let owner = Box::new(SchemaOwner {
+        release: schema
+            .release
+            .expect("successful Arrow schema export has a release callback"),
+        private: schema.private_data,
+        _memory: memory,
+    });
+    schema.private_data = Box::into_raw(owner).cast();
+    schema.release = Some(release_schema);
+}
+struct ArrayOwner {
+    release: unsafe extern "C" fn(*mut FFI_ArrowArray),
+    private: *mut c_void,
+    _memory: Arc<MemoryReservation>,
+}
+unsafe fn release_array_inner(array: *mut FFI_ArrowArray) {
+    let array = unsafe { &mut *array };
+    let owner = unsafe { Box::from_raw(array.private_data.cast::<ArrayOwner>()) };
+    array.private_data = owner.private;
+    array.release = Some(owner.release);
+    unsafe {
+        (owner.release)(array);
+    }
+    drop(owner);
+}
+unsafe extern "C" fn release_array(array: *mut FFI_ArrowArray) {
+    crate::error::swallow_unwind("Arrow array memory owner release", || unsafe {
+        release_array_inner(array)
+    });
+}
+pub(crate) fn own_array(array: &mut FFI_ArrowArray, memory: Arc<MemoryReservation>) {
+    for index in 0..array.n_children as usize {
+        own_array(unsafe { &mut **array.children.add(index) }, memory.clone());
+    }
+    if !array.dictionary.is_null() {
+        own_array(unsafe { &mut *array.dictionary }, memory.clone());
+    }
+    let owner = Box::new(ArrayOwner {
+        release: array
+            .release
+            .expect("successful Arrow array export has a release callback"),
+        private: array.private_data,
+        _memory: memory,
+    });
+    array.private_data = Box::into_raw(owner).cast();
+    array.release = Some(release_array);
+}
+
+pub(crate) struct ExportMemory {
+    schema: SchemaRef,
+    budget: Option<Arc<MemoryBudget>>,
+    array: Mutex<Option<MemoryReservation>>,
+}
+impl ExportMemory {
+    pub(crate) fn new(schema: SchemaRef) -> Arc<Self> {
+        Arc::new(Self {
+            schema,
+            budget: MemoryScope::current(),
+            array: Mutex::new(None),
+        })
+    }
+    pub(crate) fn prepare_array(&self, batch: &RecordBatch) -> Result<()> {
+        let _scope = MemoryScope::enter(self.budget.clone());
+        *self
+            .array
+            .lock()
+            .expect("Arrow export state lock must not be poisoned") = reserve_batch(batch)?;
+        Ok(())
+    }
+}
+struct StreamOwner {
+    original: FFI_ArrowArrayStream,
+    memory: Arc<ExportMemory>,
+    error: Option<CString>,
+}
+// Original callbacks require their private_data, while our wrapper owns the
+// public stream. Restore the wrapper pointer on every return and unwind.
+struct OriginalPrivate {
+    stream: *mut FFI_ArrowArrayStream,
+    wrapper: *mut c_void,
+}
+impl OriginalPrivate {
+    unsafe fn enter(stream: *mut FFI_ArrowArrayStream, original: *mut c_void) -> Self {
+        let wrapper = unsafe { (*stream).private_data };
+        unsafe {
+            (*stream).private_data = original;
+        }
+        Self { stream, wrapper }
+    }
+}
+impl Drop for OriginalPrivate {
+    fn drop(&mut self) {
+        unsafe {
+            (*self.stream).private_data = self.wrapper;
+        }
+    }
+}
+fn stream_error(owner: &mut StreamOwner, error: Error) -> i32 {
+    crate::error::set_lance_error(&error);
+    owner.error =
+        Some(CString::new(error.to_string().replace('\0', "\\0")).expect("sanitized Arrow error"));
+    match crate::error::lance_last_error_memory_kind() {
+        1 => libc::ENOMEM,
+        2 => libc::ECANCELED,
+        _ => libc::EIO,
+    }
+}
+unsafe fn stream_schema_inner(stream: *mut FFI_ArrowArrayStream, out: *mut FFI_ArrowSchema) -> i32 {
+    let owner = unsafe { &mut *((*stream).private_data.cast::<StreamOwner>()) };
+    owner.error = None;
+    crate::error::clear_last_error();
+    let _scope = MemoryScope::enter(owner.memory.budget.clone());
+    let lease = match reserve_schema(&owner.memory.schema) {
+        Ok(lease) => lease,
+        Err(error) => return stream_error(owner, error),
+    };
+    let original = unsafe { OriginalPrivate::enter(stream, owner.original.private_data) };
+    let status = unsafe {
+        (owner
+            .original
+            .get_schema
+            .expect("Arrow stream schema callback"))(stream, out)
+    };
+    drop(original);
+    if status == 0 {
+        crate::error::clear_last_error();
+        owner.error = None;
+        if let Some(lease) = lease {
+            own_schema(unsafe { &mut *out }, Arc::new(lease));
+        }
+    }
+    status
+}
+unsafe fn stream_next_inner(stream: *mut FFI_ArrowArrayStream, out: *mut FFI_ArrowArray) -> i32 {
+    let owner = unsafe { &mut *((*stream).private_data.cast::<StreamOwner>()) };
+    owner.error = None;
+    crate::error::clear_last_error();
+    let _scope = MemoryScope::enter(owner.memory.budget.clone());
+    owner
+        .memory
+        .array
+        .lock()
+        .expect("Arrow export state lock must not be poisoned")
+        .take();
+    let original = unsafe { OriginalPrivate::enter(stream, owner.original.private_data) };
+    let status =
+        unsafe { (owner.original.get_next.expect("Arrow stream next callback"))(stream, out) };
+    drop(original);
+    let lease = owner
+        .memory
+        .array
+        .lock()
+        .expect("Arrow export state lock must not be poisoned")
+        .take();
+    if status == 0 {
+        crate::error::clear_last_error();
+    }
+    if status == 0 && unsafe { (*out).release.is_some() } {
+        owner.error = None;
+        if let Some(lease) = lease {
+            own_array(unsafe { &mut *out }, Arc::new(lease));
+        }
+    }
+    status
+}
+unsafe fn stream_last_error_inner(stream: *mut FFI_ArrowArrayStream) -> *const c_char {
+    let owner = unsafe { &mut *((*stream).private_data.cast::<StreamOwner>()) };
+    if let Some(error) = &owner.error {
+        return error.as_ptr();
+    }
+    let original = unsafe { OriginalPrivate::enter(stream, owner.original.private_data) };
+    let message = unsafe {
+        (owner
+            .original
+            .get_last_error
+            .expect("Arrow stream error callback"))(stream)
+    };
+    drop(original);
+    message
+}
+unsafe fn stream_release_inner(stream: *mut FFI_ArrowArrayStream) {
+    let owner = unsafe { Box::from_raw((*stream).private_data.cast::<StreamOwner>()) };
+    // Release through the saved stream so its destructor never sees the
+    // wrapper private pointer. Its callback resets release to None.
+    let StreamOwner {
+        original,
+        memory,
+        error,
+    } = *owner;
+    drop(original);
+    drop(error);
+    drop(memory);
+    unsafe {
+        (*stream).release = None;
+        (*stream).private_data = std::ptr::null_mut();
+    }
+}
+fn guarded_stream_call(stream: *mut FFI_ArrowArrayStream, call: impl FnOnce() -> i32) -> i32 {
+    match std::panic::catch_unwind(std::panic::AssertUnwindSafe(call)) {
+        Ok(status) => status,
+        Err(payload) => {
+            crate::error::set_last_error(
+                crate::error::LanceErrorCode::Panic,
+                format!(
+                    "panic in Arrow export: {}",
+                    crate::error::panic_payload_message(&*payload)
+                ),
+            );
+            let owner = unsafe { &mut *((*stream).private_data.cast::<StreamOwner>()) };
+            // A pending batch admission must not survive a failed export.
+            owner
+                .memory
+                .array
+                .lock()
+                .expect("Arrow export state lock must not be poisoned")
+                .take();
+            owner.error = Some(CString::new("panic in Arrow export").expect("static Arrow error"));
+            libc::EIO
+        }
+    }
+}
+unsafe extern "C" fn stream_schema(
+    stream: *mut FFI_ArrowArrayStream,
+    out: *mut FFI_ArrowSchema,
+) -> i32 {
+    guarded_stream_call(stream, || unsafe { stream_schema_inner(stream, out) })
+}
+unsafe extern "C" fn stream_next(
+    stream: *mut FFI_ArrowArrayStream,
+    out: *mut FFI_ArrowArray,
+) -> i32 {
+    guarded_stream_call(stream, || unsafe { stream_next_inner(stream, out) })
+}
+unsafe extern "C" fn stream_last_error(stream: *mut FFI_ArrowArrayStream) -> *const c_char {
+    std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| unsafe {
+        stream_last_error_inner(stream)
+    }))
+    .unwrap_or(c"panic reading Arrow export error".as_ptr())
+}
+unsafe extern "C" fn stream_release(stream: *mut FFI_ArrowArrayStream) {
+    crate::error::swallow_unwind("Arrow export stream memory owner release", || unsafe {
+        stream_release_inner(stream)
+    });
+}
+pub(crate) fn own_stream(
+    mut stream: FFI_ArrowArrayStream,
+    memory: Arc<ExportMemory>,
+) -> FFI_ArrowArrayStream {
+    if memory.budget.is_none() {
+        return stream;
+    }
+    let original = std::mem::replace(&mut stream, FFI_ArrowArrayStream::empty());
+    let owner = Box::new(StreamOwner {
+        original,
+        memory,
+        error: None,
+    });
+    stream.private_data = Box::into_raw(owner).cast();
+    stream.get_schema = Some(stream_schema);
+    stream.get_next = Some(stream_next);
+    stream.get_last_error = Some(stream_last_error);
+    stream.release = Some(stream_release);
+    stream
+}
