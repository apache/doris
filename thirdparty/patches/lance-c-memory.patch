+        let path = Path::from("table.lance/data/native-memory.lance");
+        let data = Bytes::from(vec![7; 1024 * 1024]);
+        original.put(&path, data.clone().into()).await.unwrap();
+        let (wrapped, statistics) = wrap_for_test(&cache, original);
+        let reader = lance_io::object_reader::CloudObjectReader::new(
+            wrapped.clone(),
+            path,
+            1024 * 1024,
+            Some(data.len()),
+            0,
+        )
+        .unwrap();
+        let warm = Arc::new(MemoryBudget::new(32 * 1024 * 1024).unwrap());
+        let first = BudgetedFuture::new(Some(warm.clone()), reader.get_all())
+            .await
+            .unwrap();
+        assert_eq!(first, data);
+        drop(first);
+        assert_eq!(warm.used(), 0);
+        let query = Arc::new(MemoryBudget::new(8 * 1024).unwrap());
+        let borrowed = BudgetedFuture::new(Some(query.clone()), reader.get_all())
+            .await
+            .unwrap();
+        assert_eq!(borrowed, data);
+        assert_eq!(query.used(), 0);
+        assert!(process.used() >= data.len());
+        let clone = borrowed.slice(0..32);
+        drop(borrowed);
+        cache.clear().unwrap();
+        assert!(process.used() >= data.len());
+        assert_eq!(clone.as_ref(), &[7; 32]);
+        drop(clone);
+        drop(reader);
+        drop(wrapped);
+        drop(statistics);
+        drop(cache);
+        let deadline = std::time::Instant::now() + Duration::from_secs(5);
+        while process.used() != 0 && std::time::Instant::now() < deadline {
+            tokio::task::yield_now().await;
+        }
+        assert_eq!(process.used(), 0);
+    }
+    #[tokio::test]
+    async fn native_memory_cross_block_get_range_admits_and_retains_assembly() {
+        use lance_core::memory::{BudgetedFuture, MemoryBudget, MemoryError};
+        let directory = tempfile::tempdir().unwrap();
+        let cache = FoyerDataCache::try_new(directory.path(), 64 * 1024, 128 * 1024, 4096)
+            .await
+            .unwrap();
+        let process = Arc::new(MemoryBudget::new(1024 * 1024).unwrap());
+        cache.set_memory_budget(process);
+        let original = Arc::new(InMemory::new());
+        let path = Path::from("table.lance/data/cross-block-memory.lance");
+        let data = Bytes::from(vec![9; 8192]);
+        original.put(&path, data.clone().into()).await.unwrap();
+        let (wrapped, _statistics) = wrap_for_test(&cache, original);
+        let warm = Arc::new(MemoryBudget::new(1024 * 1024).unwrap());
+        let first = BudgetedFuture::new(Some(warm.clone()), wrapped.get_range(&path, 0..8192))
+            .await
+            .unwrap();
+        drop(first);
+        assert_eq!(warm.used(), 0);
+        let low = Arc::new(MemoryBudget::new(4096).unwrap());
+        let error = BudgetedFuture::new(Some(low.clone()), wrapped.get_range(&path, 0..8192))
+            .await
+            .unwrap_err();
+        assert!(matches!(
+            MemoryError::find_in_chain(&error),
+            Some(MemoryError::LimitExceeded { .. })
+        ));
+        assert_eq!(low.used(), 0);
+        let query = Arc::new(MemoryBudget::new(16 * 1024).unwrap());
+        let result = BudgetedFuture::new(Some(query.clone()), wrapped.get_range(&path, 0..8192))
+            .await
+            .unwrap();
+        assert_eq!(result, data);
+        assert_eq!(query.used(), 8192);
+        let escaped = result.slice(4096..4100);
+        drop(result);
+        cache.clear().unwrap();
+        assert_eq!(query.used(), 8192);
+        assert_eq!(escaped.as_ref(), &[9; 4]);
+        drop(escaped);
+        assert_eq!(query.used(), 0);
+    }
 }
