+use bytes::Bytes;
+use foyer::Code;
+use lance_core::memory::{BudgetedVec, MemoryBudget, MemoryScope, TransferableAccountant};
+
+static OWNERS: LazyLock<Mutex<HashMap<String, Weak<MemoryBudget>>>> =
+    LazyLock::new(|| Mutex::new(HashMap::new()));
+
+pub(crate) fn register_owner(key: &str, owner: &Arc<MemoryBudget>) {
+    OWNERS
+        .lock()
+        .expect("cache owner registry lock must not be poisoned")
+        .insert(key.to_owned(), Arc::downgrade(owner));
+}
+
+#[derive(Clone, Debug)]
+pub(crate) struct CachedBytes {
+    pub(crate) bytes: Bytes,
+    owner_key: String,
+    accounted: bool,
+}
+
+impl CachedBytes {
+    /// Admit the copy under the loading query before it can enter a shared tier.
+    pub(crate) fn copy_from_slice(
+        bytes: &[u8],
+        owner_key: &str,
+        process: Option<Arc<MemoryBudget>>,
+    ) -> lance_core::Result<Self> {
+        let query = MemoryScope::current();
+        if query.is_some() && process.is_none() {
+            return Err(lance_core::Error::invalid_input(
+                "a query-owned cache insertion requires a process owner",
+            ));
+        }
+        let (scope_owner, transfer) = match query {
+            Some(query) => {
+                let transfer = TransferableAccountant::new(&query)?;
+                let child =
+                    Arc::new(MemoryBudget::new(query.limit())?.with_accountant(transfer.clone()));
+                (Some(child), Some(transfer))
+            }
+            None => (process.clone(), None),
+        };
+        let accounted = process.is_some();
+        let value = {
+            let _scope = MemoryScope::enter(scope_owner);
+            let mut value = BudgetedVec::try_with_capacity(bytes.len())?;
+            value.try_extend_from_slice(bytes)?;
+            Bytes::from_owner(value)
+        };
+        if let (Some(process), Some(transfer)) = (process, transfer) {
+            transfer.transfer_to(&process)?;
+        }
+        Ok(Self {
+            bytes: value,
+            owner_key: owner_key.to_owned(),
+            accounted,
+        })
+    }
+}
+
+impl Code for CachedBytes {
+    fn encode(&self, writer: &mut impl Write) -> foyer::Result<()> {
+        writer
+            .write_all(&(self.owner_key.len() as u64).to_le_bytes())
+            .map_err(foyer::Error::io_error)?;
+        writer
+            .write_all(self.owner_key.as_bytes())
+            .map_err(foyer::Error::io_error)?;
+        writer
+            .write_all(&[u8::from(self.accounted)])
+            .map_err(foyer::Error::io_error)?;
+        writer
+            .write_all(&(self.bytes.len() as u64).to_le_bytes())
+            .map_err(foyer::Error::io_error)?;
+        writer
+            .write_all(&self.bytes)
+            .map_err(foyer::Error::io_error)
+    }
+
+    fn decode(reader: &mut impl Read) -> foyer::Result<Self> {
+        let mut size = [0_u8; 8];
+        reader
+            .read_exact(&mut size)
+            .map_err(foyer::Error::io_error)?;
+        let key_len = usize::try_from(u64::from_le_bytes(size))
+            .map_err(|error| foyer::Error::io_error(std::io::Error::other(error)))?;
+        // The key is a canonical local cache directory, never file payload.
+        if key_len > 4096 {
+            return Err(foyer::Error::io_error(std::io::Error::other(
+                "invalid cache memory owner key length",
+            )));
+        }
+        let mut key = vec![0; key_len];
+        reader
+            .read_exact(&mut key)
+            .map_err(foyer::Error::io_error)?;
+        let owner_key = String::from_utf8(key)
+            .map_err(|error| foyer::Error::io_error(std::io::Error::other(error)))?;
+        let mut flag = [0];
+        reader
+            .read_exact(&mut flag)
+            .map_err(foyer::Error::io_error)?;
+        let accounted = flag[0] != 0;
+        reader
+            .read_exact(&mut size)
+            .map_err(foyer::Error::io_error)?;
+        let len = usize::try_from(u64::from_le_bytes(size))
+            .map_err(|error| foyer::Error::io_error(std::io::Error::other(error)))?;
+        let owner = OWNERS
+            .lock()
+            .expect("cache owner registry lock must not be poisoned")
+            .get(&owner_key)
+            .and_then(Weak::upgrade);
+        if accounted && owner.is_none() {
+            return Err(foyer::Error::io_error(std::io::Error::other(
+                "cache memory owner is unavailable",
+            )));
+        }
+        let _scope = MemoryScope::enter(owner);
+        let mut bytes = BudgetedVec::try_filled(len, 0_u8)
+            .map_err(|error| foyer::Error::io_error(std::io::Error::other(error)))?;
+        reader
+            .read_exact(&mut bytes)
+            .map_err(foyer::Error::io_error)?;
+        Ok(Self {
+            bytes: Bytes::from_owner(bytes),
+            owner_key,
+            accounted,
+        })
+    }
+
+    fn estimated_size(&self) -> usize {
+        17 + self.owner_key.len() + self.bytes.len()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn process_owner_survives_memory_clear_and_disk_codec_round_trip() {
+        let query = Arc::new(MemoryBudget::new(64).unwrap());
+        let process = Arc::new(MemoryBudget::new(64).unwrap());
+        register_owner("native-memory-codec-test", &process);
+        let value = {
+            let _scope = MemoryScope::enter(Some(query.clone()));
+            CachedBytes::copy_from_slice(
+                &[7; 16],
+                "native-memory-codec-test",
+                Some(process.clone()),
+            )
+            .unwrap()
+        };
+        assert_eq!((query.used(), process.used()), (0, 16));
+        let escaped = value.bytes.slice(4..8);
+        let mut encoded = Vec::new();
+        value.encode(&mut encoded).unwrap();
+        drop(value);
+        assert_eq!(process.used(), 16);
+        let loaded = CachedBytes::decode(&mut encoded.as_slice()).unwrap();
+        assert_eq!(process.used(), 32);
+        assert_eq!(&*loaded.bytes, &[7; 16]);
+        drop(escaped);
+        assert_eq!(process.used(), 16);
+        drop(loaded);
+        assert_eq!((query.used(), process.used()), (0, 0));
+    }
+
+    #[test]
+    fn query_denies_copy_before_process_cache_admission() {
+        let query = Arc::new(MemoryBudget::new(8).unwrap());
+        let process = Arc::new(MemoryBudget::new(64).unwrap());
+        let _scope = MemoryScope::enter(Some(query.clone()));
+        let error =
+            CachedBytes::copy_from_slice(&[7; 16], "native-denial-test", Some(process.clone()))
+                .unwrap_err();
+        assert!(lance_core::memory::MemoryError::find_in_chain(&error).is_some());
+        assert_eq!((query.used(), process.used()), (0, 0));
+    }
+}
