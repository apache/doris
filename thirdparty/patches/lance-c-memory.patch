+    let budget = unsafe { lance_memory_budget_new(64 * 1024 * 1024, ptr::null()) };
+    let scope = unsafe { lance_memory_scope_enter(budget) };
+    let id = c_str("id");
+    let columns = [id.as_ptr(), ptr::null()];
+    let scanner = unsafe { lance_scanner_new(dataset, columns.as_ptr(), ptr::null()) };
+    unsafe {
+        lance_memory_scope_exit(scope);
+    }
+    let mut batch = ptr::null_mut();
+    assert_eq!(unsafe { lance_scanner_next(scanner, &mut batch) }, 0);
+    let mut array = FFI_ArrowArray::empty();
+    let mut schema = FFI_ArrowSchema::empty();
+    assert_eq!(
+        unsafe { lance_batch_to_arrow(batch, &mut array, &mut schema) },
+        0
+    );
+    unsafe {
+        lance_batch_free(batch);
+        lance_scanner_close(scanner);
+        lance_dataset_close(dataset);
+    }
+    assert!(unsafe { lance_memory_budget_usage(budget) } >= 1024 * 4);
+    drop(array);
+    drop(schema);
+    // Decode/read tasks may be in cancellation cleanup; their owners must
+    // finish before accounting reaches zero, rather than being reset on close.
+    let deadline = std::time::Instant::now() + std::time::Duration::from_secs(5);
+    while unsafe { lance_memory_budget_usage(budget) } != 0 && std::time::Instant::now() < deadline
+    {
+        std::thread::yield_now();
+    }
+    assert_eq!(unsafe { lance_memory_budget_usage(budget) }, 0);
+    unsafe {
+        lance_memory_budget_close(budget);
+    }
