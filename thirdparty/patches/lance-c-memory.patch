+            let (actual, stats) = query(reopened);
+            assert_eq!(actual, expected);
+            assert_eq!(
+                stats.index_partitions_loaded, 0,
+                "legacy weak cache must remain usable after the last dataset closes"
+            );
+        }
+        let mut queried = LanceSessionCacheStats::default();
+        assert_eq!(lance_session_get_cache_stats(session, &mut queried), 0);
+        assert!(queried.index_cache_hits > warmed.index_cache_hits);
+        assert_eq!(lance_session_clear_caches(session), 0);
+        let (_, cleared) = query(reopened);
+        assert!(
+            cleared.index_partitions_loaded > 0,
+            "clear must remove real partitions"
+        );
+        lance_session_close(session);
+        assert_eq!(
+            query(reopened).0,
+            expected,
+            "dataset retains its cache state"
+        );
+        lance_dataset_close(reopened);
+    }
