+fn test_native_memory_budget_private_cache_lifetime_follows_dataset() {
+    let (_tmp, uri) = create_test_dataset();
+    let uri = c_str(&uri);
+    let dataset = unsafe { lance_dataset_open(uri.as_ptr(), ptr::null(), 0) };
+    assert!(!dataset.is_null());
+    let probe = native_memory_support::Probe::new();
+    let scope = probe.enter();
+    let scanner = unsafe { lance_scanner_new(dataset, ptr::null(), ptr::null()) };
+    assert!(!scanner.is_null());
+    drop(scope);
+    let mut rows = 0;
+    loop {
+        let mut batch = ptr::null_mut();
+        let status = unsafe { lance_scanner_next(scanner, &mut batch) };
+        if status == 1 {
+            break;
+        }
+        assert_eq!(status, 0, "{}", take_last_error_message());
+        let mut array = FFI_ArrowArray::empty();
+        let mut schema = FFI_ArrowSchema::empty();
+        assert_eq!(
+            unsafe { lance_batch_to_arrow(batch, &mut array, &mut schema) },
+            0
+        );
+        rows += array.len();
+        unsafe { lance_batch_free(batch) };
+    }
+    assert_eq!(rows, 5);
+    unsafe { lance_scanner_close(scanner) };
+    // The private session still owns its decoded cache entries, so releasing the
+    // scanner must not release the corresponding loading-scope charges early.
+    assert!(probe.used() > 0);
+    unsafe { lance_dataset_close(dataset) };
+    probe.assert_drained();
+}
