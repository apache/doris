+#[cfg(test)]
+mod tests {
+    use super::*;
+    use arrow_array::{Int32Array, RecordBatchIterator};
+    use std::collections::HashMap;
+
+    fn fixture() -> RecordBatch {
+        let field = Field::new("value", DataType::Int32, false)
+            .with_metadata(HashMap::from([("large".to_owned(), "x".repeat(65536))]));
+        RecordBatch::try_new(
+            Arc::new(Schema::new(vec![field])),
+            vec![Arc::new(Int32Array::from(vec![1, 2, 3]))],
+        )
+        .unwrap()
+    }
+    fn export(batch: RecordBatch) -> FFI_ArrowArrayStream {
+        let schema = batch.schema();
+        crate::stream_guard::guarded_ffi_stream_from_reader(RecordBatchIterator::new(
+            vec![Ok(batch)],
+            schema,
+        ))
+        .unwrap()
+    }
+    unsafe fn get_schema(stream: &mut FFI_ArrowArrayStream, out: &mut FFI_ArrowSchema) -> i32 {
+        unsafe { stream.get_schema.unwrap()(stream, out) }
+    }
+    unsafe fn get_next(stream: &mut FFI_ArrowArrayStream, out: &mut FFI_ArrowArray) -> i32 {
+        unsafe { stream.get_next.unwrap()(stream, out) }
+    }
+
+    #[test]
+    fn large_schema_is_admitted_before_conversion() {
+        let batch = fixture();
+        let budget = Arc::new(MemoryBudget::new(8192).unwrap());
+        let _scope = MemoryScope::enter(Some(budget.clone()));
+        let result = crate::stream_guard::guarded_ffi_stream_from_reader(RecordBatchIterator::new(
+            vec![Ok(batch.clone())],
+            batch.schema(),
+        ));
+        let error = match result {
+            Ok(_) => panic!("large schema unexpectedly admitted"),
+            Err(error) => error,
+        };
+        assert!(lance_core::memory::MemoryError::find_in_chain(&error).is_some());
+        assert_eq!(budget.used(), 0);
+    }
+
+    #[test]
+    fn repeated_schema_exports_and_moved_child_keep_owner_until_last_release() {
+        let budget = Arc::new(MemoryBudget::new(1 << 24).unwrap());
+        let scope = MemoryScope::enter(Some(budget.clone()));
+        let mut stream = export(fixture());
+        drop(scope);
+        let mut first = FFI_ArrowSchema::empty();
+        let mut second = FFI_ArrowSchema::empty();
+        assert_eq!(unsafe { get_schema(&mut stream, &mut first) }, 0);
+        let one = budget.used();
+        assert!(one >= 65536);
+        assert_eq!(unsafe { get_schema(&mut stream, &mut second) }, 0);
+        assert_eq!(budget.used(), 2 * one);
+        let moved_child =
+            unsafe { std::mem::replace(&mut **first.children, FFI_ArrowSchema::empty()) };
+        drop(first);
+        drop(stream);
+        assert_eq!(budget.used(), 2 * one);
+        drop(second);
+        assert_eq!(budget.used(), one);
+        drop(moved_child);
+        assert_eq!(budget.used(), 0);
+    }
+
+    #[test]
+    fn array_export_retains_metadata_after_stream_close_and_child_move() {
+        let budget = Arc::new(MemoryBudget::new(1 << 24).unwrap());
+        let scope = MemoryScope::enter(Some(budget.clone()));
+        let mut stream = export(fixture());
+        drop(scope);
+        let mut array = FFI_ArrowArray::empty();
+        assert_eq!(unsafe { get_next(&mut stream, &mut array) }, 0);
+        let used = budget.used();
+        assert!(used > 0);
+        let moved_child =
+            unsafe { std::mem::replace(&mut **array.children, FFI_ArrowArray::empty()) };
+        drop(array);
+        drop(stream);
+        assert_eq!(budget.used(), used);
+        drop(moved_child);
+        assert_eq!(budget.used(), 0);
+    }
+
+    #[test]
+    fn callback_denial_preserves_private_state_for_retry_and_error_cleans_pending() {
+        let budget = Arc::new(MemoryBudget::new(1 << 24).unwrap());
+        let scope = MemoryScope::enter(Some(budget.clone()));
+        let mut stream = export(fixture());
+        drop(scope);
+        let used = budget.used();
+        let pressure = budget.reserve(budget.limit() - used).unwrap();
+        let mut schema = FFI_ArrowSchema::empty();
+        assert_eq!(
+            unsafe { get_schema(&mut stream, &mut schema) },
+            libc::ENOMEM
+        );
+        assert_eq!(crate::error::lance_last_error_memory_kind(), 1);
+        let mut array = FFI_ArrowArray::empty();
+        assert_ne!(unsafe { get_next(&mut stream, &mut array) }, 0);
+        assert!(array.release.is_none());
+        assert_eq!(budget.used(), budget.limit());
+        drop(pressure);
+        assert_eq!(budget.used(), used);
+        assert_eq!(unsafe { get_schema(&mut stream, &mut schema) }, 0);
+        assert_eq!(crate::error::lance_last_error_memory_kind(), 0);
+        assert!(!schema.release.is_none());
+        drop(schema);
+        drop(stream);
+        assert_eq!(budget.used(), 0);
+    }
+}
