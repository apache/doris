+++ b/Cargo.toml
@@ -43,6 +43,8 @@
 log = "0.4"
 libc = "0.2"
 object_store = "0.13.2"
+# Explicitly install the HTTP transport when embedded in a static C/C++ executable.
+opendal = { version = "=0.58.2", default-features = false, features = ["http-transport-reqwest"] }
 pin-project = "1.0"
