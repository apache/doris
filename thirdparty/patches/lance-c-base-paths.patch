# Read-only base-path inspection, matching upstream lance-c main API.
# Base: 4fafcd64525b274b113208390bbcca86bbbc093b, after lance-c-foyer.patch.
# Keeps local-base placement in Doris without resolving per-value physical Blob URIs.
--- a/src/blob.rs
+++ b/src/blob.rs
@@ -18,6 +18,42 @@
 use crate::error::{ffi_try, swallow_unwind};
 use crate::helpers;
 use crate::runtime::block_on;
+
+/// Return the pinned snapshot's native base-path registry. This is the read-only
+/// metadata API from upstream lance-c main, backported without URI resolution.
+/// Caller frees the returned string with lance_free_string().
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn lance_dataset_base_paths_json(
+    dataset: *const LanceDataset,
+) -> *const c_char {
+    ffi_try!(unsafe { base_paths_json_inner(dataset) }, null)
+}
+
+unsafe fn base_paths_json_inner(dataset: *const LanceDataset) -> Result<*const c_char> {
+    if dataset.is_null() {
+        return Err(lance_core::Error::invalid_input("dataset must not be NULL"));
+    }
+    let snapshot = unsafe { &*dataset }.snapshot();
+    let mut bases = std::collections::BTreeMap::new();
+    for (id, base) in &snapshot.manifest().base_paths {
+        bases.insert(
+            *id,
+            serde_json::json!({
+                "id": base.id,
+                "name": base.name,
+                "path": base.path,
+                "is_dataset_root": base.is_dataset_root,
+            }),
+        );
+    }
+    let json = serde_json::to_string(&bases).map_err(|error| {
+        lance_core::Error::internal(format!("failed to serialize dataset base paths: {error}"))
+    })?;
+    let json = std::ffi::CString::new(json).map_err(|error| {
+        lance_core::Error::internal(format!("invalid dataset base paths JSON: {error}"))
+    })?;
+    Ok(json.into_raw())
+}
 
