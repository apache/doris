+//! Scoped, fallible kernel hooks for embedding allocation admission.
+//!
+//! A hook delegates a complete operation to an embedding implementation that
+//! admits output and scratch storage before allocating. It never changes the
+//! process allocator or unwinds through an allocation callback. Scopes belong
+//! only to synchronous execution; async embedders enter a fresh scope per poll.
+
+use std::cell::Cell;
+use std::marker::PhantomData;
+use std::rc::Rc;
+
+use arrow_array::{Array, ArrayRef, BooleanArray};
+use arrow_schema::ArrowError;
+
+use crate::take::TakeOptions;
+
+/// Fallible implementations supplied by the current embedding execution owner.
+#[derive(Clone, Copy, Debug)]
+pub struct KernelMemoryHooks {
+    /// Take selected rows after admitting all new buffers.
+    pub take: fn(&dyn Array, &dyn Array, Option<TakeOptions>) -> Result<ArrayRef, ArrowError>,
+    /// Filter selected rows without unaccounted predicate scratch.
+    pub filter: fn(&dyn Array, &BooleanArray) -> Result<ArrayRef, ArrowError>,
+    /// Concatenate arrays after admitting output and kernel scratch.
+    pub concat: fn(&[&dyn Array]) -> Result<ArrayRef, ArrowError>,
+    /// Interleave sorted inputs after admitting their merged output.
+    pub interleave: fn(&[&dyn Array], &[(usize, usize)]) -> Result<ArrayRef, ArrowError>,
+}
+
+thread_local! {
+    static HOOKS: Cell<Option<KernelMemoryHooks>> = const { Cell::new(None) };
+}
+
+pub(crate) fn current() -> Option<KernelMemoryHooks> {
+    HOOKS.get()
+}
+
+/// A synchronous hook scope, restored on ordinary return or unwind.
+///
+/// This scope cannot move between threads and must not cross an async await.
+/// An embedding callback invoking a pre-admitted original kernel can temporarily
+/// suspend delegation by entering `None`, then restore its caller on drop.
+#[derive(Debug)]
+pub struct KernelMemoryScope {
+    previous: Option<KernelMemoryHooks>,
+    thread_bound: PhantomData<Rc<()>>,
+}
+
+impl KernelMemoryScope {
+    /// Install the current execution's hooks, or suspend them with `None`.
+    pub fn enter(hooks: Option<KernelMemoryHooks>) -> Self {
+        Self {
+            previous: HOOKS.replace(hooks),
+            thread_bound: PhantomData,
+        }
+    }
+}
+
+impl Drop for KernelMemoryScope {
+    fn drop(&mut self) {
+        HOOKS.set(self.previous);
+    }
+}
