+
+        for _ in 0..2 {
+            let (value, was_cached) = cache
+                .get_or_insert(
+                    &key,
+                    Box::pin(async { panic!("cache hit must not execute source loader") }),
+                    codec,
+                )
+                .await
+                .unwrap();
+            assert_eq!(*value.downcast_ref::<u64>().unwrap(), 42);
+            assert!(was_cached);
+        }
+        let stats = cache.stats.snapshot();
