+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright The Lance Authors
+
+//! Foyer-backed cache for immutable Lance data-file batched range reads.
+
+use std::collections::{BTreeMap, HashMap};
