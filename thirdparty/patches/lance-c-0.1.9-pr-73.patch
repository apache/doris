+#[derive(Clone, Debug)]
+struct DataCacheReader {
+    cache: FoyerDataCache,
+    store_prefix: String,
+    original: Arc<dyn ObjectStore>,
+    statistics: Arc<FoyerDataCacheStatistics>,
+}
