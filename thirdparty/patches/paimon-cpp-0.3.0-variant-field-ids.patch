+constexpr int32_t kStructuredTypeFieldIdBase = std::numeric_limits<int32_t>::max() / 4;
+constexpr int32_t kStructuredTypeFieldDepthLimit = 1 << 10;
+
+Result<std::shared_ptr<arrow::Field>> WithPaimonFieldIds(
+    const std::shared_ptr<arrow::Field>& field, int32_t fallback_field_id,
+    const std::optional<int32_t>& structured_root_id = std::nullopt, int32_t structured_depth = 0) {
+    std::shared_ptr<arrow::Field> field_with_id = field;
+    if (!field->HasMetadata() || !field->metadata()->Contains(DataField::FIELD_ID)) {
+        auto metadata = arrow::KeyValueMetadata::Make({DataField::FIELD_ID},
+                                                      {std::to_string(fallback_field_id)});
+        field_with_id = field->WithMergedMetadata(metadata);
+    }
+    PAIMON_ASSIGN_OR_RAISE(DataField data_field,
+                           DataField::ConvertArrowFieldToDataField(field_with_id));
+
+    if (field_with_id->type()->id() == arrow::Type::STRUCT) {
+        const auto& struct_type = static_cast<const arrow::StructType&>(*field_with_id->type());
+        arrow::FieldVector children;
+        children.reserve(struct_type.num_fields());
+        for (int32_t i = 0; i < struct_type.num_fields(); ++i) {
+            PAIMON_ASSIGN_OR_RAISE(auto child, WithPaimonFieldIds(struct_type.field(i), i));
+            children.push_back(std::move(child));
+        }
+        return field_with_id->WithType(arrow::struct_(std::move(children)));
+    }
+    if (field_with_id->type()->id() == arrow::Type::LIST) {
+        const auto& list_type = static_cast<const arrow::ListType&>(*field_with_id->type());
+        int32_t root_id = structured_root_id.value_or(data_field.Id());
+        int32_t child_depth = structured_depth + 1;
+        int32_t child_id =
+            kStructuredTypeFieldIdBase + root_id * kStructuredTypeFieldDepthLimit + child_depth;
+        PAIMON_ASSIGN_OR_RAISE(auto child, WithPaimonFieldIds(list_type.value_field(), child_id,
+                                                              root_id, child_depth));
+        return field_with_id->WithType(arrow::list(std::move(child)));
+    }
+    return field_with_id;
+}
