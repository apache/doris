+TEST_F(VariantShreddingTest, ShreddingSchemaFieldIdsMatchJava) {
+    auto explicit_id = arrow::KeyValueMetadata::Make({"paimon.id"}, {"7"});
+    auto shredding_type = arrow::struct_({
+        arrow::field("a", arrow::int32(), /*nullable=*/true, explicit_id),
+        arrow::field("b", arrow::utf8()),
+        arrow::field("c", arrow::list(arrow::int32())),
+    });
+    ASSERT_OK_AND_ASSIGN(std::shared_ptr<arrow::DataType> physical,
+                         VariantShreddingUtils::VariantShreddingSchema(shredding_type));
+    const auto& top_level = static_cast<const arrow::StructType&>(*physical);
+    ASSERT_EQ(top_level.field(0)->metadata()->Get("paimon.id").ValueOr(""), "0");
+    ASSERT_EQ(top_level.field(1)->metadata()->Get("paimon.id").ValueOr(""), "1");
+    ASSERT_EQ(top_level.field(2)->metadata()->Get("paimon.id").ValueOr(""), "2");
+
+    const auto& typed_value = static_cast<const arrow::StructType&>(*top_level.field(2)->type());
+    ASSERT_EQ(typed_value.field(0)->metadata()->Get("paimon.id").ValueOr(""), "7");
+    ASSERT_EQ(typed_value.field(1)->metadata()->Get("paimon.id").ValueOr(""), "1");
+    ASSERT_EQ(typed_value.field(2)->metadata()->Get("paimon.id").ValueOr(""), "2");
+    for (const auto& object_field : typed_value.fields()) {
+        const auto& object_value = static_cast<const arrow::StructType&>(*object_field->type());
+        ASSERT_EQ(object_value.field(0)->metadata()->Get("paimon.id").ValueOr(""), "0");
+        ASSERT_EQ(object_value.field(1)->metadata()->Get("paimon.id").ValueOr(""), "1");
+    }
+    const auto& array_wrapper =
+        static_cast<const arrow::StructType&>(*typed_value.field(2)->type());
+    const auto& array_type = static_cast<const arrow::ListType&>(*array_wrapper.field(1)->type());
+    ASSERT_EQ(array_type.value_field()->metadata()->Get("paimon.id").ValueOr(""), "536871936");
+}
