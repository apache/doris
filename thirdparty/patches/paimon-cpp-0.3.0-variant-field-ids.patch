 namespace {

+// Java Paimon assigns global preorder IDs when all configured fields omit them, but rejects a
+// schema that mixes explicit and implicit IDs. Normalize before using the stricter C++ parser.
+Status NormalizeConfiguredFieldIds(rapidjson::Value* type, int32_t* next_field_id,
+                                   std::optional<bool>* field_ids_present,
+                                   rapidjson::Document::AllocatorType* allocator) {
+    if (!type->IsObject() || !type->HasMember("type") || !(*type)["type"].IsString()) {
+        return Status::OK();
+    }
+    const std::string type_name = (*type)["type"].GetString();
+    if (type_name.rfind("ROW", 0) == 0) {
+        if (!type->HasMember("fields") || !(*type)["fields"].IsArray()) {
+            return Status::OK();
+        }
+        for (auto& field : (*type)["fields"].GetArray()) {
+            if (!field.IsObject()) {
+                continue;
+            }
+            bool has_id = field.HasMember("id");
+            if (field_ids_present->has_value() && field_ids_present->value() != has_id) {
+                return Status::Invalid(
+                    "partial field IDs are not allowed in a variant shredding schema");
+            }
+            *field_ids_present = has_id;
+            if (!has_id) {
+                field.AddMember(rapidjson::StringRef("id"), *next_field_id, *allocator);
+            }
+            ++*next_field_id;
+            if (field.HasMember("type")) {
+                PAIMON_RETURN_NOT_OK(NormalizeConfiguredFieldIds(&field["type"], next_field_id,
+                                                                 field_ids_present, allocator));
+            }
+        }
+    } else if ((type_name.rfind("ARRAY", 0) == 0 || type_name.rfind("MULTISET", 0) == 0) &&
+               type->HasMember("element")) {
+        PAIMON_RETURN_NOT_OK(NormalizeConfiguredFieldIds(&(*type)["element"], next_field_id,
+                                                         field_ids_present, allocator));
+    } else if (type_name.rfind("MAP", 0) == 0) {
+        if (type->HasMember("key")) {
+            PAIMON_RETURN_NOT_OK(NormalizeConfiguredFieldIds(&(*type)["key"], next_field_id,
+                                                             field_ids_present, allocator));
+        }
+        if (type->HasMember("value")) {
+            PAIMON_RETURN_NOT_OK(NormalizeConfiguredFieldIds(&(*type)["value"], next_field_id,
+                                                             field_ids_present, allocator));
+        }
+    }
+    return Status::OK();
+}
