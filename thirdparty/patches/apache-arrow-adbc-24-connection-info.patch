+type dorisUnsupportedInfoServer struct{ flightsql.BaseServer }
+
+func (*dorisUnsupportedInfoServer) GetFlightInfoSqlInfo(context.Context, flightsql.GetSqlInfo, *flight.FlightDescriptor) (*flight.FlightInfo, error) {
+	return nil, status.Error(codes.Unimplemented, "SQL info unsupported")
+}
+
+func dorisInfoServer(t *testing.T, supported bool) string {
+	t.Helper()
+	server := flight.NewServerWithMiddleware(nil)
+	base := flightsql.BaseServer{Alloc: memory.DefaultAllocator}
+	if supported {
+		require.NoError(t, base.RegisterSqlInfo(flightsql.SqlInfoFlightSqlServerName, "DorisFE"))
+		require.NoError(t, base.RegisterSqlInfo(flightsql.SqlInfoFlightSqlServerTransaction, int32(0)))
+		server.RegisterFlightService(flightsql.NewFlightServer(&base))
+	} else {
+		server.RegisterFlightService(flightsql.NewFlightServer(&dorisUnsupportedInfoServer{BaseServer: base}))
+	}
+	require.NoError(t, server.Init("127.0.0.1:0"))
+	done := make(chan struct{})
+	go func() { defer close(done); _ = server.Serve() }()
+	t.Cleanup(func() { server.Shutdown(); <-done })
+	return "grpc+tcp://" + server.Addr().String()
+}
+
+func dorisReadVendor(connection adbc.Connection) (string, error) {
+	reader, err := connection.GetInfo(context.Background(), []adbc.InfoCode{adbc.InfoVendorName})
+	if err != nil {
+		return "", err
+	}
+	defer reader.Release()
+	for reader.Next() {
+		record := reader.RecordBatch()
+		values := record.Column(1).(*array.DenseUnion)
+		for row := 0; row < int(record.NumRows()); row++ {
+			if record.Column(0).(*array.Uint32).Value(row) == uint32(adbc.InfoVendorName) {
+				strings := values.Field(values.ChildID(row)).(*array.String)
+				return strings.Value(int(values.ValueOffset(row))), nil
+			}
+		}
+	}
+	return "", reader.Err()
+}
+
+func TestDorisFlightSqlVendorInfoDoesNotLeak(t *testing.T) {
+	native := driver.NewDriver(memory.DefaultAllocator)
+	first, err := native.NewDatabase(map[string]string{"uri": dorisInfoServer(t, true)})
+	require.NoError(t, err)
+	defer first.Close()
+	a, err := first.Open(context.Background())
+	require.NoError(t, err)
+	defer a.Close()
+	vendor, err := dorisReadVendor(a)
+	require.NoError(t, err)
+	require.Equal(t, "DorisFE", vendor)
+	second, err := native.NewDatabase(map[string]string{"uri": dorisInfoServer(t, false)})
+	require.NoError(t, err)
+	defer second.Close()
+	b, err := second.Open(context.Background())
+	require.NoError(t, err)
+	defer b.Close()
+	vendor, err = dorisReadVendor(b)
+	require.NoError(t, err)
+	require.Equal(t, "Flight SQL", vendor, "An unsupported server must not inherit another server's vendor")
+}
+
+func TestDorisFlightSqlMixedConnectionsAndProbes(t *testing.T) {
+	native := driver.NewDriver(memory.DefaultAllocator)
+	database, err := native.NewDatabase(map[string]string{"uri": dorisInfoServer(t, true)})
+	require.NoError(t, err)
+	defer database.Close()
+	var done sync.WaitGroup
+	for worker := 0; worker < 16; worker++ {
+		done.Add(1)
+		go func(probe bool) {
+			defer done.Done()
+			for round := 0; round < 16; round++ {
+				connection, err := database.Open(context.Background())
+				if err != nil {
+					t.Error(err)
+					return
+				}
+				if probe {
+					_, err = dorisReadVendor(connection)
+					if err != nil {
+						t.Error(err)
+					}
+				}
+				if err = connection.Close(); err != nil {
+					t.Error(err)
+				}
+			}
+		}(worker == 0)
+	}
+	done.Wait()
+}
