Isolate remote GetInfo state per connection. The driver/database map remains immutable,
so connection-open readers cannot race with vendor writes and unsupported servers cannot
inherit a previous server's identity. Advertise local capability 0x444f0001 for FE's guard.

--- a/go/adbc/driver/internal/driverbase/driver_info.go
+++ b/go/adbc/driver/internal/driverbase/driver_info.go
@@ -103,0 +104,9 @@
+// Clone preserves immutable driver defaults without sharing server information between connections.
+func (di *DriverInfo) Clone() *DriverInfo {
+	info := make(map[adbc.InfoCode]any, len(di.info))
+	for code, value := range di.info {
+		info[code] = value
+	}
+	return &DriverInfo{name: di.name, info: info}
+}
