+
+func TestConnectionDriverInfoIsolated(t *testing.T) {
+	shared := DefaultDriverInfo("Flight SQL")
+	database := &DatabaseImplBase{DriverInfo: shared}
+	first := NewConnectionImplBase(database)
+	second := NewConnectionImplBase(database)
+	if err := first.DriverInfo.RegisterInfoCode(adbc.InfoVendorName, "DorisFE"); err != nil {
+		t.Fatal(err)
+	}
+	for name, info := range map[string]*DriverInfo{"driver": shared, "second connection": second.DriverInfo} {
+		got, _ := info.GetInfoForInfoCode(adbc.InfoVendorName)
+		if got != "Flight SQL" {
+			t.Fatalf("%s inherited another connection's vendor: %v", name, got)
+		}
+	}
+}
+
+func TestConnectionDriverInfoConcurrentReadersAndWriters(t *testing.T) {
+	shared := DefaultDriverInfo("Flight SQL")
+	database := &DatabaseImplBase{DriverInfo: shared}
+	var done sync.WaitGroup
+	for worker := 0; worker < 16; worker++ {
+		done.Add(1)
+		go func() {
+			defer done.Done()
+			connection := NewConnectionImplBase(database)
+			for round := 0; round < 1000; round++ {
+				if err := connection.DriverInfo.RegisterInfoCode(adbc.InfoVendorName, "DorisFE"); err != nil {
+					t.Error(err)
+					return
+				}
+				shared.GetInfoForInfoCode(adbc.InfoDriverVersion)
+				shared.InfoSupportedCodes()
+			}
+		}()
+	}
+	done.Wait()
+}
