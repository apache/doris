+
+    fn packed_batch() -> RecordBatch {
+        let prefix = super::super::super::encoding::posting_block_score_prefix_len(128);
+        let mut block = vec![0; prefix + 4];
+        block[prefix..].copy_from_slice(&7_u32.to_le_bytes());
+        let mut postings = ListBuilder::new(LargeBinaryBuilder::new());
+        postings.values().append_value(block);
+        postings.append(true);
+        let postings = postings.finish();
+        let mut impacts = ListBuilder::new(LargeBinaryBuilder::new());
+        // One level-0 block and its level-1 entry. Empty entries deliberately
+        // decode to the existing conservative u32::MAX marker.
+        impacts.values().append_value([]);
+        impacts.values().append_value([]);
+        impacts.append(true);
+        let impacts = impacts.finish();
+        RecordBatch::try_new(
+            Arc::new(Schema::new(vec![
+                Field::new(POSTING_COL, postings.data_type().clone(), false),
+                Field::new(IMPACT_COL, impacts.data_type().clone(), false),
+            ])),
+            vec![Arc::new(postings), Arc::new(impacts)],
+        )
+        .unwrap()
+    }
+
+    fn group() -> PostingListGroup {
+        PostingListGroup::new_packed(packed_batch(), PostingTailCodec::VarintDelta).unwrap()
