+        let group = group();
+        for limit in [0, 8] {
+            let query = Arc::new(MemoryBudget::new(limit).unwrap());
+            let _scope = MemoryScope::enter(Some(query.clone()));
+            let error = group.posting_list(0, Some(1.0), Some(128)).unwrap_err();
+            assert!(matches!(
+                MemoryError::find_in_chain(&error),
+                Some(MemoryError::LimitExceeded { .. })
+            ));
+            assert_eq!(query.used(), 0);
+            assert_cold_states(&group);
+        }
+    }
