+#[cfg(test)]
+mod memory_tests {
+    use super::*;
+    use crate::uring::current_thread_future::UringCurrentThreadFuture;
+    use crate::uring::future::UringReadFuture;
+    use lance_core::memory::MemoryBudget;
+    use std::sync::Arc;
+
+    fn request(budget: &Arc<MemoryBudget>) -> Arc<IoRequest> {
+        let reservation = budget.reserve(16).unwrap();
+        Arc::new(IoRequest {
+            fd: -1,
+            offset: 0,
+            length: 16,
+            thread_id: std::thread::current().id(),
+            state: Mutex::new(RequestState {
+                completed: false,
+                waker: None,
+                err: None,
+                buffer: BytesMut::from(&[7; 16][..]),
+                reservation: Some(reservation),
+                bytes_read: 0,
+            }),
+        })
+    }
+
+    #[test]
+    fn dropped_observer_keeps_admission_until_kernel_request_drops() {
+        let budget = Arc::new(MemoryBudget::new(16).unwrap());
+        let pending = request(&budget);
+        let observer = UringReadFuture {
+            request: pending.clone(),
+        };
+        drop(observer);
+        budget.cancel();
+        assert_eq!(budget.used(), 16);
+        drop(pending);
+        assert_eq!(budget.used(), 0);
+    }
+
+    #[test]
+    fn completed_read_moves_lease_into_exported_bytes() {
+        let budget = Arc::new(MemoryBudget::new(16).unwrap());
+        let pending = request(&budget);
+        {
+            let mut state = pending.state.lock().unwrap();
+            state.bytes_read = 16;
+            state.completed = true;
+        }
+        // No dispatch to a Tokio worker: thread-local requests stay on the
+        // submitting thread while transferring their storage lease normally.
+        let bytes =
+            futures::executor::block_on(UringCurrentThreadFuture::new(pending.clone())).unwrap();
+        let slice = bytes.slice(3..5);
+        drop((bytes, pending));
+        assert_eq!(budget.used(), 16);
+        assert_eq!(&slice[..], &[7; 2]);
+        drop(slice);
+        assert_eq!(budget.used(), 0);
+    }
+
+    #[test]
+    fn failed_request_releases_storage_and_admission_together() {
+        let budget = Arc::new(MemoryBudget::new(16).unwrap());
+        let pending = request(&budget);
+        pending.fail(io::Error::other("injected submission failure"));
+        let error = futures::executor::block_on(UringReadFuture {
+            request: pending.clone(),
+        })
+        .unwrap_err();
+        assert!(error.to_string().contains("injected submission failure"));
+        assert_eq!(budget.used(), 16);
+        drop(pending);
+        assert_eq!(budget.used(), 0);
+    }
+}
