new file mode 100644
index 0000000000000000000000000000000000000000..62893f4d5c36567aeca746b6a109f9487ca1cea1
--- /dev/null
+++ b/rust/lance-core/src/memory/retained_stream.rs
@@ -0,0 +1,29 @@
+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright The Lance Authors
+
+use super::MemoryReservation;
+use futures::Stream;
+use std::pin::Pin;
+use std::sync::Arc;
+use std::task::{Context, Poll};
+
+/// Keep a pre-allocation admission until the underlying stream is fully dropped.
+/// Field order frees pending tasks and their payloads before the lease.
+pub struct RetainedMemoryStream<S> {
+    inner: S,
+    _memory: Option<Arc<MemoryReservation>>,
+}
+impl<S> RetainedMemoryStream<S> {
+    pub fn new(inner: S, memory: Option<Arc<MemoryReservation>>) -> Self {
+        Self {
+            inner,
+            _memory: memory,
+        }
+    }
+}
+impl<S: Stream + Unpin> Stream for RetainedMemoryStream<S> {
+    type Item = S::Item;
+    fn poll_next(self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Option<Self::Item>> {
+        Pin::new(&mut self.get_mut().inner).poll_next(cx)
+    }
+}
diff --git a/rust/lance-core/src/memory/schema.rs b/rust/lance-core/src/memory/schema.rs
new file mode 100644
index 0000000000000000000000000000000000000000..e25a1251efaad5cc318f09d2033bb684fc0bd553
--- /dev/null
+++ b/rust/lance-core/src/memory/schema.rs
@@ -0,0 +1,174 @@
+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright The Lance Authors
+
+use std::collections::HashMap;
+use std::mem::size_of;
+
+use super::{MemoryReservation, reserve_current};
+use crate::datatypes::{Field, Schema};
+use crate::{Error, Result};
+
+fn add(left: usize, right: usize) -> Result<usize> {
+    left.checked_add(right)
+        .ok_or_else(|| Error::invalid_input("schema clone admission overflow"))
+}
+fn mul(left: usize, right: usize) -> Result<usize> {
+    left.checked_mul(right)
+        .ok_or_else(|| Error::invalid_input("schema clone admission overflow"))
+}
+
+fn table_bytes(buckets: usize) -> Result<usize> {
+    if buckets == 0 {
+        return Ok(0);
+    }
+    add(
+        add(mul(buckets, size_of::<(String, String)>())?, 15)? / 16 * 16,
+        add(buckets, 16)?,
+    )
+}
+
+fn metadata_clone(map: &HashMap<String, String>, extra: usize) -> Result<usize> {
+    let old = if map.capacity() == 0 {
+        0
+    } else {
+        add(map.capacity(), 1)?
+            .checked_next_power_of_two()
+            .ok_or_else(|| Error::invalid_input("schema metadata capacity overflow"))?
+    };
+    let count = add(map.len(), extra)?;
+    let needed = if count == 0 {
+        0
+    } else {
+        add(mul(count, 8)?, 6)?
+            .checked_div(7)
+            .and_then(usize::checked_next_power_of_two)
+            .ok_or_else(|| Error::invalid_input("schema metadata capacity overflow"))?
+            .max(4)
+    };
+    let mut bytes = table_bytes(old.max(needed))?;
+    if needed > old {
+        bytes = add(bytes, table_bytes(old)?)?;
+    }
+    for (key, value) in map {
+        bytes = add(bytes, add(key.len(), value.len())?)?;
+    }
+    Ok(bytes)
+}
+
+fn logical_type_working(mut logical: &str) -> Result<usize> {
+    let mut bytes = 0;
+    loop {
+        let components = logical.split(':').count();
+        if components > 1 {
+            // LogicalType parsing collects split slices with Vec growth. Its
+            // old/new buffers coexist during a move, hence three complete lists.
+            bytes = add(bytes, mul(mul(components, 3)?, size_of::<&str>())?)?;
+        }
+        if let Some(inner) = logical.strip_prefix("fixed_size_list:") {
+            let end = inner
+                .rfind(':')
+                .ok_or_else(|| Error::invalid_input("fixed list logical type has no dimension"))?;
+            logical = &inner[..end];
+            // join() plus LogicalType::to_string() coexist across recursion.
+            bytes = add(bytes, mul(logical.len(), 2)?)?;
+            bytes = add(
+                bytes,
+                size_of::<arrow_schema::Field>() + 2 * size_of::<usize>() + "item".len(),
+            )?;
+            // The bfloat16 item adds exactly these extension metadata entries.
+            bytes = add(bytes, metadata_clone(&HashMap::new(), 2)?)?;
+            bytes = add(
+                bytes,
+                lance_arrow::ARROW_EXT_NAME_KEY.len()
+                    + lance_arrow::bfloat16::BFLOAT16_EXT_NAME.len()
+                    + lance_arrow::ARROW_EXT_META_KEY.len(),
+            )?;
+        } else {
+            // Timestamp timezone join plus its Arc<str> conversion can coexist.
+            bytes = add(bytes, mul(logical.len(), 2)?)?;
+            return add(bytes, 2 * size_of::<usize>());
+        }
+    }
+}
+
+fn field_clone(field: &Field) -> Result<usize> {
+    let mut bytes = add(field.name.len(), field.logical_type.allocated_bytes())?;
+    bytes = add(bytes, metadata_clone(&field.metadata, 0)?)?;
+    bytes = add(bytes, mul(field.children.len(), size_of::<Field>())?)?;
+    for child in &field.children {
+        bytes = add(bytes, field_clone(child)?)?;
+    }
+    Ok(bytes)
+}
+
+fn arrow_field(field: &Field) -> Result<usize> {
+    let mut bytes = add(
+        size_of::<arrow_schema::Field>() + 2 * size_of::<usize>(),
+        field.name.len(),
+    )?;
+    // Arrow conversion may add blob/JSON extension metadata. The table's
+    // pre-existing and replacement bucket arrays are both included at growth.
+    bytes = add(bytes, metadata_clone(&field.metadata, 2)?)?;
+    bytes = add(
+        bytes,
+        lance_arrow::BLOB_META_KEY.len()
+            + "true".len()
+            + lance_arrow::ARROW_EXT_NAME_KEY.len()
+            + lance_arrow::json::JSON_EXT_NAME.len(),
+    )?;
+    bytes = add(bytes, logical_type_working(field.logical_type.as_str())?)?;
+    // Struct Fields conversion keeps Vec<FieldRef> and Arc<[FieldRef]> together.
+    bytes = add(
+        bytes,
+        mul(
+            mul(field.children.len(), 2)?,
+            size_of::<std::sync::Arc<arrow_schema::Field>>(),
+        )?,
+    )?;
+    for child in &field.children {
+        bytes = add(bytes, arrow_field(child)?)?;
+    }
+    Ok(bytes)
+}
+
+/// Admission for one deep schema working copy and its Arrow-schema conversion.
+///
+/// Counts the actual field tree, string lengths, metadata hash-table layouts,
+/// nested logical-type parsing, and temporary Vec-to-Arc field-array storage.
+pub fn schema_clone_admission_bytes(schema: &Schema) -> Result<usize> {
+    let mut bytes = mul(schema.fields.len(), size_of::<Field>())?;
+    bytes = add(bytes, metadata_clone(&schema.metadata, 0)?)?;
+    for field in &schema.fields {
+        bytes = add(bytes, field_clone(field)?)?;
+    }
+    bytes = add(
+        bytes,
+        mul(
+            mul(schema.fields.len(), 2)?,
+            size_of::<std::sync::Arc<arrow_schema::Field>>(),
+        )?,
+    )?;
+    bytes = add(bytes, metadata_clone(&schema.metadata, 0)?)?;
+    for field in &schema.fields {
+        bytes = add(bytes, arrow_field(field)?)?;
+    }
+    Ok(bytes)
+}
+
+/// Reserve schema copies before invoking infallible Clone/Arrow conversions.
+pub fn reserve_schema_clone(schema: &Schema) -> Result<Option<MemoryReservation>> {
+    reserve_current(schema_clone_admission_bytes(schema)?)
+}
+
+/// Bound a field deep copy and its Arrow conversion without constructing a schema.
+pub fn field_clone_admission_bytes(field: &Field) -> Result<usize> {
+    add(field_clone(field)?, arrow_field(field)?)
+}
+
+/// Clone an owned schema at a Result boundary, retaining its new allocation lease.
+pub fn try_clone_schema(schema: &Schema) -> Result<Schema> {
+    let reservation = reserve_schema_clone(schema)?;
+    let mut cloned = schema.clone();
+    cloned.memory_owner = reservation.map(super::MemoryOwner::new);
+    Ok(cloned)
+}
diff --git a/rust/lance-core/src/memory/selection.rs b/rust/lance-core/src/memory/selection.rs
new file mode 100644
index 0000000000000000000000000000000000000000..b22820aba10bb41278024f89af801cfa82f1fe03
--- /dev/null
+++ b/rust/lance-core/src/memory/selection.rs
@@ -0,0 +1,885 @@
+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright The Lance Authors
+
+//! Budgeted row selection uses explicit MutableArrayData capacities. This avoids
+//! Arrow take's temporary fixed-list indices and filter's cached predicate Vecs.
+
+use arrow_array::{
+    Array, ArrayRef, BooleanArray, RecordBatch, RecordBatchOptions, cast::AsArray, make_array,
+    types::*,
+};
+use arrow_buffer::ArrowNativeType;
+use arrow_data::{
+    ArrayData,
+    transform::{Capacities, MutableArrayData},
+};
+use arrow_schema::ArrowError;
+use arrow_schema::DataType;
+use arrow_select::take::TakeOptions;
+
+use super::{MemoryScope, retain_array_buffers};
+use crate::{Error, Result};
+
+fn add(left: usize, right: usize) -> Result<usize> {
+    left.checked_add(right)
+        .ok_or_else(|| Error::invalid_input("row selection size overflow"))
+}
+
+fn mul(left: usize, right: usize) -> Result<usize> {
+    left.checked_mul(right)
+        .ok_or_else(|| Error::invalid_input("row selection allocation size overflow"))
+}
+
+fn aligned(bytes: usize) -> Result<usize> {
+    Ok(add(bytes, 63)? & !63)
+}
+
+fn growth_peak(initial: usize, required: usize) -> Result<usize> {
+    let initial = aligned(initial)?;
+    let required = aligned(required)?;
+    if initial >= required {
+        Ok(initial)
+    } else {
+        mul(required, 3)
+    }
+}
+
+trait Selection {
+    fn len(&self) -> usize;
+    fn visit(&self, visitor: &mut dyn FnMut(Option<usize>) -> Result<()>) -> Result<()>;
+}
+
+struct Indices<'a>(&'a dyn Array);
+
+impl Selection for Indices<'_> {
+    fn len(&self) -> usize {
+        self.0.len()
+    }
+
+    fn visit(&self, visitor: &mut dyn FnMut(Option<usize>) -> Result<()>) -> Result<()> {
+        macro_rules! visit {
+            ($type:ty) => {{
+                for index in self.0.as_primitive::<$type>().iter() {
+                    visitor(index.map(ArrowNativeType::as_usize))?;
+                }
+            }};
+        }
+        match self.0.data_type() {
+            DataType::UInt8 => visit!(UInt8Type),
+            DataType::UInt16 => visit!(UInt16Type),
+            DataType::UInt32 => visit!(UInt32Type),
+            DataType::UInt64 => visit!(UInt64Type),
+            DataType::Int8 => visit!(Int8Type),
+            DataType::Int16 => visit!(Int16Type),
+            DataType::Int32 => visit!(Int32Type),
+            DataType::Int64 => visit!(Int64Type),
+            other => {
+                return Err(Error::invalid_input(format!(
+                    "unsupported take index type {other}"
+                )));
+            }
+        }
+        Ok(())
+    }
+}
+
+struct Predicate<'a> {
+    values: &'a BooleanArray,
+    count: usize,
+}
+
+struct SourceIndices<'a> {
+    source: usize,
+    indices: &'a [(usize, usize)],
+    len: usize,
+}
+
+impl Selection for SourceIndices<'_> {
+    fn len(&self) -> usize {
+        self.len
+    }
+
+    fn visit(&self, visitor: &mut dyn FnMut(Option<usize>) -> Result<()>) -> Result<()> {
+        for &(source, row) in self.indices {
+            if source == self.source {
+                visitor(Some(row))?;
+            }
+        }
+        Ok(())
+    }
+}
+
+impl Selection for Predicate<'_> {
+    fn len(&self) -> usize {
+        self.count
+    }
+
+    fn visit(&self, visitor: &mut dyn FnMut(Option<usize>) -> Result<()>) -> Result<()> {
+        for (index, selected) in self.values.iter().enumerate() {
+            if selected == Some(true) {
+                visitor(Some(index))?;
+            }
+        }
+        Ok(())
+    }
+}
+
+#[derive(Clone, Copy)]
+enum ChildKind {
+    Fixed(usize),
+    List32,
+    List64,
+    View32,
+    View64,
+}
+
+struct ChildSelection<'a> {
+    parent: &'a dyn Selection,
+    data: &'a ArrayData,
+    kind: ChildKind,
+    len: usize,
+}
+
+impl ChildSelection<'_> {
+    fn range(&self, index: usize) -> Result<std::ops::Range<usize>> {
+        let (start, end) = match self.kind {
+            ChildKind::Fixed(dimension) => {
+                let start = mul(add(self.data.offset(), index)?, dimension)?;
+                return Ok(start..add(start, dimension)?);
+            }
+            ChildKind::List32 => {
+                let offsets = self.data.buffer::<i32>(0);
+                (i64::from(offsets[index]), i64::from(offsets[index + 1]))
+            }
+            ChildKind::List64 => {
+                let offsets = self.data.buffer::<i64>(0);
+                (offsets[index], offsets[index + 1])
+            }
+            ChildKind::View32 => {
+                let offsets = self.data.buffer::<i32>(0);
+                let sizes = self.data.buffer::<i32>(1);
+                (
+                    i64::from(offsets[index]),
+                    i64::from(offsets[index]) + i64::from(sizes[index]),
+                )
+            }
+            ChildKind::View64 => {
+                let offsets = self.data.buffer::<i64>(0);
+                let sizes = self.data.buffer::<i64>(1);
+                (
+                    offsets[index],
+                    offsets[index]
+                        .checked_add(sizes[index])
+                        .ok_or_else(|| Error::invalid_input("list view range overflow"))?,
+                )
+            }
+        };
+        let start =
+            usize::try_from(start).map_err(|_| Error::invalid_input("negative list offset"))?;
+        let end = usize::try_from(end).map_err(|_| Error::invalid_input("negative list offset"))?;
+        Ok(start..end)
+    }
+
+    fn count(&self) -> Result<usize> {
+        if let ChildKind::Fixed(dimension) = self.kind {
+            return mul(self.parent.len(), dimension);
+        }
+        let mut count = 0;
+        self.parent.visit(&mut |index| {
+            if let Some(index) = index {
+                let range = self.range(index)?;
+                count = add(count, range.end - range.start)?;
+            }
+            Ok(())
+        })?;
+        Ok(count)
+    }
+}
+
+impl Selection for ChildSelection<'_> {
+    fn len(&self) -> usize {
+        self.len
+    }
+
+    fn visit(&self, visitor: &mut dyn FnMut(Option<usize>) -> Result<()>) -> Result<()> {
+        self.parent.visit(&mut |index| {
+            match index {
+                Some(index) => {
+                    for child in self.range(index)? {
+                        visitor(Some(child))?;
+                    }
+                }
+                None => {
+                    if let ChildKind::Fixed(dimension) = self.kind {
+                        for _ in 0..dimension {
+                            visitor(None)?;
+                        }
+                    }
+                }
+            }
+            Ok(())
+        })
+    }
+}
+
+struct Plan {
+    data_type: DataType,
+    rows: usize,
+    bytes: usize,
+    children: Vec<Self>,
+}
+
+impl Plan {
+    fn merge(&mut self, other: Self) -> Result<()> {
+        self.rows = add(self.rows, other.rows)?;
+        self.bytes = add(self.bytes, other.bytes)?;
+        for (child, other_child) in self.children.iter_mut().zip(other.children) {
+            child.merge(other_child)?;
+        }
+        Ok(())
+    }
+    fn new(data: &ArrayData, selection: &dyn Selection) -> Result<Self> {
+        let mut plan = Self {
+            data_type: data.data_type().clone(),
+            rows: selection.len(),
+            bytes: 0,
+            children: vec![],
+        };
+        match data.data_type() {
+            DataType::Utf8 | DataType::Binary | DataType::LargeUtf8 | DataType::LargeBinary => {
+                let large = matches!(
+                    data.data_type(),
+                    DataType::LargeUtf8 | DataType::LargeBinary
+                );
+                selection.visit(&mut |index| {
+                    if let Some(index) = index {
+                        let bytes = if large {
+                            let offsets = data.buffer::<i64>(0);
+                            usize::try_from(offsets[index + 1] - offsets[index])
+                                .map_err(|_| Error::invalid_input("invalid byte offsets"))?
+                        } else {
+                            let offsets = data.buffer::<i32>(0);
+                            usize::try_from(offsets[index + 1] - offsets[index])
+                                .map_err(|_| Error::invalid_input("invalid byte offsets"))?
+                        };
+                        plan.bytes = add(plan.bytes, bytes)?;
+                    }
+                    Ok(())
+                })?;
+            }
+            DataType::Struct(_) => {
+                plan.children = data
+                    .child_data()
+                    .iter()
+                    .map(|child| Self::new(child, selection))
+                    .collect::<Result<Vec<_>>>()?;
+            }
+            DataType::List(_)
+            | DataType::Map(_, _)
+            | DataType::LargeList(_)
+            | DataType::ListView(_)
+            | DataType::LargeListView(_)
+            | DataType::FixedSizeList(_, _) => {
+                let kind = match data.data_type() {
+                    DataType::LargeList(_) => ChildKind::List64,
+                    DataType::ListView(_) => ChildKind::View32,
+                    DataType::LargeListView(_) => ChildKind::View64,
+                    DataType::FixedSizeList(_, dimension) => ChildKind::Fixed(
+                        usize::try_from(*dimension)
+                            .map_err(|_| Error::invalid_input("negative fixed list dimension"))?,
+                    ),
+                    _ => ChildKind::List32,
+                };
+                let mut child_selection = ChildSelection {
+                    parent: selection,
+                    data,
+                    kind,
+                    len: 0,
+                };
+                child_selection.len = child_selection.count()?;
+                plan.children
+                    .push(Self::new(&data.child_data()[0], &child_selection)?);
+            }
+            DataType::Union(_, _) | DataType::RunEndEncoded(_, _) => {
+                return Err(Error::not_supported(format!(
+                    "budgeted row selection for {}",
+                    data.data_type()
+                )));
+            }
+            _ => {}
+        }
+        Ok(plan)
+    }
+
+    fn capacities(&self) -> Capacities {
+        match self.data_type {
+            DataType::Utf8 | DataType::Binary | DataType::LargeUtf8 | DataType::LargeBinary => {
+                Capacities::Binary(self.rows, Some(self.bytes))
+            }
+            // Arrow 58.3 declares Capacities::Struct but rejects it before
+            // constructing child data. Struct and Map therefore use its
+            // supported Array capacities; generic_admission below covers the
+            // recursive default capacities and every child-buffer growth peak.
+            DataType::Struct(_) | DataType::Map(_, _) => Capacities::Array(self.rows),
+            DataType::List(_)
+            | DataType::LargeList(_)
+            | DataType::ListView(_)
+            | DataType::LargeListView(_)
+            | DataType::FixedSizeList(_, _) => {
+                Capacities::List(self.rows, Some(Box::new(self.children[0].capacities())))
+            }
+            _ => Capacities::Array(self.rows),
+        }
+    }
+
+    fn buffer_sizes(&self, rows: usize, generic: bool) -> Result<Vec<usize>> {
+        if let Some(width) = self.data_type.primitive_width() {
+            return Ok(vec![mul(rows, width)?]);
+        }
+        Ok(match &self.data_type {
+            DataType::Null | DataType::Struct(_) | DataType::FixedSizeList(_, _) => vec![],
+            DataType::Boolean => vec![rows.div_ceil(8)],
+            DataType::Utf8 | DataType::Binary => vec![
+                mul(add(rows, 1)?, 4)?,
+                if generic { rows } else { self.bytes },
+            ],
+            DataType::LargeUtf8 | DataType::LargeBinary => vec![
+                mul(add(rows, 1)?, 8)?,
+                if generic { rows } else { self.bytes },
+            ],
+            DataType::Utf8View | DataType::BinaryView => vec![mul(rows, 16)?],
+            DataType::FixedSizeBinary(width) => vec![mul(
+                rows,
+                usize::try_from(*width)
+                    .map_err(|_| Error::invalid_input("negative fixed binary width"))?,
+            )?],
+            DataType::List(_) | DataType::Map(_, _) => vec![mul(add(rows, 1)?, 4)?],
+            DataType::LargeList(_) => vec![mul(add(rows, 1)?, 8)?],
+            DataType::ListView(_) => vec![mul(rows, 4)?, mul(rows, 4)?],
+            DataType::LargeListView(_) => vec![mul(rows, 8)?, mul(rows, 8)?],
+            DataType::Dictionary(key, _) => vec![mul(
+                rows,
+                key.primitive_width()
+                    .ok_or_else(|| Error::invalid_input("invalid dictionary key"))?,
+            )?],
+            other => {
+                return Err(Error::not_supported(format!(
+                    "budgeted row selection for {other}"
+                )));
+            }
+        })
+    }
+
+    fn generic_admission(&self, initial_rows: usize) -> Result<usize> {
+        let mut bytes = growth_peak(initial_rows.div_ceil(8), self.rows.div_ceil(8))?;
+        let initial = self.buffer_sizes(initial_rows, true)?;
+        let required = self.buffer_sizes(self.rows, false)?;
+        for (initial, required) in initial.into_iter().zip(required) {
+            bytes = add(bytes, growth_peak(initial, required)?)?;
+        }
+        let child_rows = match self.data_type {
+            DataType::FixedSizeList(_, dimension) => mul(
+                initial_rows,
+                usize::try_from(dimension)
+                    .map_err(|_| Error::invalid_input("negative fixed list dimension"))?,
+            )?,
+            _ => initial_rows,
+        };
+        for child in &self.children {
+            bytes = add(bytes, child.generic_admission(child_rows)?)?;
+        }
+        Ok(bytes)
+    }
+
+    fn admission(&self) -> Result<usize> {
+        if matches!(self.data_type, DataType::Struct(_) | DataType::Map(_, _)) {
+            return self.generic_admission(self.rows);
+        }
+        let mut bytes = aligned(self.rows.div_ceil(8))?;
+        for buffer in self.buffer_sizes(self.rows, false)? {
+            bytes = add(bytes, aligned(buffer)?)?;
+        }
+        for child in &self.children {
+            bytes = add(bytes, child.admission()?)?;
+        }
+        Ok(bytes)
+    }
+}
+
+fn select(data: &ArrayData, selection: &dyn Selection) -> Result<Option<ArrayRef>> {
+    let Some(owner) = MemoryScope::current() else {
+        return Ok(None);
+    };
+    selection.visit(&mut |index| {
+        if index.is_some_and(|index| index >= data.len()) {
+            return Err(Error::invalid_input("take index exceeds input length"));
+        }
+        Ok(())
+    })?;
+    let plan = Plan::new(data, selection)?;
+    let reservation = owner.reserve(plan.admission()?)?;
+    let mut output = MutableArrayData::with_capacities(vec![data], true, plan.capacities());
+    let mut pending: Option<std::ops::Range<usize>> = None;
+    let mut nulls = 0;
+    selection.visit(&mut |index| {
+        match index {
+            Some(index) => {
+                if nulls != 0 {
+                    output.extend_nulls(nulls);
+                    nulls = 0;
+                }
+                match pending.as_mut() {
+                    Some(range) if range.end == index => range.end += 1,
+                    _ => {
+                        if let Some(range) = pending.take() {
+                            output.extend(0, range.start, range.end);
+                        }
+                        pending = Some(index..index + 1);
+                    }
+                }
+            }
+            None => {
+                if let Some(range) = pending.take() {
+                    output.extend(0, range.start, range.end);
+                }
+                nulls += 1;
+            }
+        }
+        Ok(())
+    })?;
+    if let Some(range) = pending {
+        output.extend(0, range.start, range.end);
+    }
+    if nulls != 0 {
+        output.extend_nulls(nulls);
+    }
+    Ok(Some(make_array(retain_array_buffers(
+        reservation,
+        std::slice::from_ref(data),
+        output.freeze(),
+    )?)))
+}
+
+/// Select rows under the active budget, or return `None` to use the normal kernel.
+///
+/// Integer indices can repeat and contain nulls. All payload sizes are computed
+/// before admitting and constructing the output, including nested lists/maps.
+pub fn take_array_with_budget(values: &dyn Array, indices: &dyn Array) -> Result<Option<ArrayRef>> {
+    select(&values.to_data(), &Indices(indices))
+}
+
+/// Filter under the active budget without building an unaccounted predicate Vec.
+pub fn filter_array_with_budget(
+    values: &dyn Array,
+    filter: &BooleanArray,
+) -> Result<Option<ArrayRef>> {
+    let Some(owner) = MemoryScope::current() else {
+        return Ok(None);
+    };
+    if filter.len() > values.len() {
+        return Err(Error::invalid_input("filter exceeds input length"));
+    }
+    let count = filter.iter().filter(|value| *value == Some(true)).count();
+    if count == filter.len() {
+        let _admission = owner.reserve(0)?;
+        return Ok(Some(values.slice(0, count)));
+    }
+    select(
+        &values.to_data(),
+        &Predicate {
+            values: filter,
+            count,
+        },
+    )
+}
+
+fn has_dictionary(data_type: &DataType) -> bool {
+    match data_type {
+        DataType::Dictionary(_, _) => true,
+        DataType::Struct(fields) => fields.iter().any(|field| has_dictionary(field.data_type())),
+        DataType::List(field)
+        | DataType::LargeList(field)
+        | DataType::ListView(field)
+        | DataType::LargeListView(field)
+        | DataType::FixedSizeList(field, _)
+        | DataType::Map(field, _) => has_dictionary(field.data_type()),
+        _ => false,
+    }
+}
+
+/// Interleave sorted/merged inputs under one admitted output allocation plan.
+pub fn interleave_with_budget(
+    values: &[&dyn Array],
+    indices: &[(usize, usize)],
+) -> Result<Option<ArrayRef>> {
+    let Some(owner) = MemoryScope::current() else {
+        return Ok(None);
+    };
+    let first = values
+        .first()
+        .ok_or_else(|| Error::invalid_input("interleave requires input arrays"))?;
+    for value in values {
+        if value.data_type() != first.data_type() {
+            return Err(Error::invalid_input("interleave input types differ"));
+        }
+    }
+    for &(source, row) in indices {
+        let value = values
+            .get(source)
+            .ok_or_else(|| Error::invalid_input("interleave source index out of bounds"))?;
+        if row >= value.len() {
+            return Err(Error::invalid_input("interleave row index out of bounds"));
+        }
+    }
+    if has_dictionary(first.data_type()) {
+        return Err(Error::not_supported(
+            "budgeted interleave of dictionaries is not supported",
+        ));
+    }
+    let inputs = values
+        .iter()
+        .map(|value| value.to_data())
+        .collect::<Vec<_>>();
+    let mut plan = None;
+    for (source, input) in inputs.iter().enumerate() {
+        let len = indices.iter().filter(|(index, _)| *index == source).count();
+        let next = Plan::new(
+            input,
+            &SourceIndices {
+                source,
+                indices,
+                len,
+            },
+        )?;
+        match plan.as_mut() {
+            Some(plan) => Plan::merge(plan, next)?,
+            None => plan = Some(next),
+        }
+    }
+    let plan = plan.ok_or_else(|| Error::invalid_input("interleave requires a plan"))?;
+    let reservation = owner.reserve(plan.admission()?)?;
+    let mut output =
+        MutableArrayData::with_capacities(inputs.iter().collect(), true, plan.capacities());
+    let mut pending: Option<(usize, std::ops::Range<usize>)> = None;
+    for &(source, row) in indices {
+        match pending.as_mut() {
+            Some((previous_source, range)) if *previous_source == source && range.end == row => {
+                range.end += 1
+            }
+            _ => {
+                if let Some((source, range)) = pending.take() {
+                    output.extend(source, range.start, range.end);
+                }
+                pending = Some((source, row..row + 1));
+            }
+        }
+    }
+    if let Some((source, range)) = pending {
+        output.extend(source, range.start, range.end);
+    }
+    Ok(Some(make_array(retain_array_buffers(
+        reservation,
+        &inputs,
+        output.freeze(),
+    )?)))
+}
+
+/// Budgeted record-batch take; `None` preserves callers' existing unscoped path.
+pub fn take_record_batch_with_budget(
+    batch: &RecordBatch,
+    indices: &dyn Array,
+) -> Result<Option<RecordBatch>> {
+    if MemoryScope::current().is_none() {
+        return Ok(None);
+    }
+    let columns = batch
+        .columns()
+        .iter()
+        .map(|column| {
+            take_array_with_budget(column.as_ref(), indices)?
+                .ok_or_else(|| Error::internal("missing active selection budget"))
+        })
+        .collect::<Result<Vec<_>>>()?;
+    Ok(Some(RecordBatch::try_new_with_options(
+        batch.schema(),
+        columns,
+        &RecordBatchOptions::new().with_row_count(Some(indices.len())),
+    )?))
+}
+
+/// Budgeted record-batch filter, retaining all new buffer owners in its columns.
+pub fn filter_record_batch_with_budget(
+    batch: &RecordBatch,
+    filter: &BooleanArray,
+) -> Result<Option<RecordBatch>> {
+    if MemoryScope::current().is_none() {
+        return Ok(None);
+    }
+    if filter.len() > batch.num_rows() {
+        return Err(Error::invalid_input("filter exceeds record batch length"));
+    }
+    let columns = batch
+        .columns()
+        .iter()
+        .map(|column| {
+            filter_array_with_budget(column.as_ref(), filter)?
+                .ok_or_else(|| Error::internal("missing active selection budget"))
+        })
+        .collect::<Result<Vec<_>>>()?;
+    let rows = filter.iter().filter(|value| *value == Some(true)).count();
+    Ok(Some(RecordBatch::try_new_with_options(
+        batch.schema(),
+        columns,
+        &RecordBatchOptions::new().with_row_count(Some(rows)),
+    )?))
+}
+
+/// Arrow-compatible take with native admission while an embedding budget is active.
+pub fn take(
+    values: &dyn Array,
+    indices: &dyn Array,
+    options: Option<TakeOptions>,
+) -> std::result::Result<ArrayRef, ArrowError> {
+    match take_array_with_budget(values, indices)? {
+        Some(output) => Ok(output),
+        None => arrow_select::take::take(values, indices, options),
+    }
+}
+
+/// Arrow-compatible filter with admitted output and no predicate heap scratch.
+pub fn filter(
+    values: &dyn Array,
+    predicate: &BooleanArray,
+) -> std::result::Result<ArrayRef, ArrowError> {
+    match filter_array_with_budget(values, predicate)? {
+        Some(output) => Ok(output),
+        None => arrow_select::filter::filter(values, predicate),
+    }
+}
+
+/// Arrow-compatible record-batch take retaining every selected buffer's owner.
+pub fn take_record_batch(
+    batch: &RecordBatch,
+    indices: &dyn Array,
+) -> std::result::Result<RecordBatch, ArrowError> {
+    match take_record_batch_with_budget(batch, indices)? {
+        Some(output) => Ok(output),
+        None => arrow_select::take::take_record_batch(batch, indices),
+    }
+}
+
+/// Arrow-compatible record-batch filter retaining every new buffer's owner.
+pub fn filter_record_batch(
+    batch: &RecordBatch,
+    predicate: &BooleanArray,
+) -> std::result::Result<RecordBatch, ArrowError> {
+    match filter_record_batch_with_budget(batch, predicate)? {
+        Some(output) => Ok(output),
+        None => arrow_select::filter::filter_record_batch(batch, predicate),
+    }
+}
+
+/// Arrow-compatible interleave retaining sort/merge output buffer owners.
+pub fn interleave(
+    values: &[&dyn Array],
+    indices: &[(usize, usize)],
+) -> std::result::Result<ArrayRef, ArrowError> {
+    match interleave_with_budget(values, indices)? {
+        Some(output) => Ok(output),
+        None => arrow_select::interleave::interleave(values, indices),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::memory::{MemoryBudget, MemoryError};
+    use arrow_array::{
+        DictionaryArray, Int32Array, LargeStringArray, ListArray, StringArray, StructArray,
+        UInt32Array,
+    };
+    use arrow_buffer::OffsetBuffer;
+    use arrow_schema::Field;
+    use std::sync::Arc;
+
+    #[test]
+    fn struct_selection_hooks_admit_recursive_growth_and_retain_output() {
+        let strings = StringArray::from(vec!["a".repeat(513), "b".repeat(257), "c".repeat(129)]);
+        let lists = ListArray::from_iter_primitive::<Int32Type, _, _>([
+            Some(vec![Some(1), None]),
+            None,
+            Some(vec![Some(3), Some(4), Some(5)]),
+        ]);
+        let values = StructArray::from(vec![
+            (
+                Arc::new(Field::new("text", DataType::Utf8, false)),
+                Arc::new(strings) as ArrayRef,
+            ),
+            (
+                Arc::new(Field::new("list", lists.data_type().clone(), true)),
+                Arc::new(lists) as ArrayRef,
+            ),
+        ]);
+        let indices = UInt32Array::from(vec![Some(2), None, Some(0), Some(2)]);
+        let predicate = BooleanArray::from(vec![true, false, true]);
+        let merged_indices = [(0, 2), (1, 0), (0, 1)];
+        let expected_take = arrow_select::take::take(&values, &indices, None).unwrap();
+        let expected_filter = arrow_select::filter::filter(&values, &predicate).unwrap();
+        let expected_merge =
+            arrow_select::interleave::interleave(&[&values, &values], &merged_indices).unwrap();
+        let owner = Arc::new(MemoryBudget::new(1 << 20).unwrap());
+        let (taken, filtered, merged) = {
+            let _scope = MemoryScope::enter(Some(owner.clone()));
+            (
+                arrow_select::take::take(&values, &indices, None).unwrap(),
+                arrow_select::filter::filter(&values, &predicate).unwrap(),
+                arrow_select::interleave::interleave(&[&values, &values], &merged_indices).unwrap(),
+            )
+        };
+        assert_eq!(taken.to_data(), expected_take.to_data());
+        assert_eq!(filtered.to_data(), expected_filter.to_data());
+        assert_eq!(merged.to_data(), expected_merge.to_data());
+        let escaped = taken.slice(0, 1);
+        drop((taken, filtered, merged));
+        assert!(owner.used() > 0);
+        drop(escaped);
+        assert_eq!(owner.used(), 0);
+    }
+
+    #[test]
+    fn list_of_struct_dictionary_selection_is_admitted_before_construction() {
+        let dictionary = DictionaryArray::<Int8Type>::from_iter(["one", "two", "one"]);
+        let values = StructArray::from(vec![
+            (
+                Arc::new(Field::new("number", DataType::Int32, false)),
+                Arc::new(Int32Array::from(vec![1, 2, 3])) as ArrayRef,
+            ),
+            (
+                Arc::new(Field::new(
+                    "dictionary",
+                    dictionary.data_type().clone(),
+                    false,
+                )),
+                Arc::new(dictionary) as ArrayRef,
+            ),
+        ]);
+        let values = ListArray::new(
+            Arc::new(Field::new("item", values.data_type().clone(), false)),
+            OffsetBuffer::new(vec![0_i32, 2, 3].into()),
+            Arc::new(values),
+            None,
+        );
+        let input = values.to_data();
+        let indices = UInt32Array::from(vec![Some(1), Some(0), None, Some(0)]);
+        let expected = arrow_select::take::take(&values, &indices, None).unwrap();
+        let denied = Arc::new(MemoryBudget::new(1).unwrap());
+        {
+            let _scope = MemoryScope::enter(Some(denied.clone()));
+            let error = take_array_with_budget(&values, &indices).unwrap_err();
+            assert!(matches!(
+                MemoryError::find_in_chain(&error),
+                Some(MemoryError::LimitExceeded { .. })
+            ));
+        }
+        assert_eq!(denied.used(), 0);
+        assert_eq!(values.to_data(), input);
+        let owner = Arc::new(MemoryBudget::new(4096).unwrap());
+        let output = {
+            let _scope = MemoryScope::enter(Some(owner.clone()));
+            arrow_select::take::take(&values, &indices, None).unwrap()
+        };
+        assert_eq!(output.to_data(), expected.to_data());
+        assert!(owner.used() > 0);
+        drop(output);
+        assert_eq!(owner.used(), 0);
+    }
+
+    #[test]
+    fn take_repeated_strings_and_null_indices_retains_only_output_capacity() {
+        let values = LargeStringArray::from(vec![Some("zero"), None, Some("two")]);
+        let indices = UInt32Array::from(vec![Some(2), None, Some(0), Some(2)]);
+        let owner = Arc::new(MemoryBudget::new(4096).unwrap());
+        let output = {
+            let _scope = MemoryScope::enter(Some(owner.clone()));
+            take_array_with_budget(&values, &indices).unwrap().unwrap()
+        };
+        let expected = LargeStringArray::from(vec![Some("two"), None, Some("zero"), Some("two")]);
+        assert_eq!(output.to_data(), expected.to_data());
+        assert!(owner.used() >= 40);
+        let escaped = output.slice(0, 1);
+        drop(output);
+        assert!(owner.used() >= 40);
+        drop(escaped);
+        assert_eq!(owner.used(), 0);
+    }
+
+    #[test]
+    fn take_nested_lists_preallocates_repeated_child_values() {
+        let values = ListArray::from_iter_primitive::<Int32Type, _, _>([
+            Some(vec![Some(1), None]),
+            None,
+            Some(vec![Some(3)]),
+        ]);
+        let indices = UInt32Array::from(vec![Some(0), None, Some(2), Some(0)]);
+        let owner = Arc::new(MemoryBudget::new(4096).unwrap());
+        let _scope = MemoryScope::enter(Some(owner.clone()));
+        let output = take_array_with_budget(&values, &indices).unwrap().unwrap();
+        let expected = ListArray::from_iter_primitive::<Int32Type, _, _>([
+            Some(vec![Some(1), None]),
+            None,
+            Some(vec![Some(3)]),
+            Some(vec![Some(1), None]),
+        ]);
+        assert_eq!(output.to_data(), expected.to_data());
+        drop(output);
+        assert_eq!(owner.used(), 0);
+    }
+
+    #[test]
+    fn filter_has_no_unaccounted_predicate_or_output_allocation() {
+        let values = Int32Array::from(vec![Some(1), None, Some(3), Some(4)]);
+        let filter = BooleanArray::from(vec![Some(true), None, Some(false), Some(true)]);
+        let owner = Arc::new(MemoryBudget::new(4096).unwrap());
+        let _scope = MemoryScope::enter(Some(owner.clone()));
+        let output = filter_array_with_budget(&values, &filter).unwrap().unwrap();
+        assert_eq!(output.to_data(), Int32Array::from(vec![1, 4]).to_data());
+        drop(output);
+        assert_eq!(owner.used(), 0);
+    }
+
+    #[test]
+    fn selection_denial_leaves_the_input_and_owner_unchanged() {
+        let values = LargeStringArray::from(vec!["abcdefgh"; 1024]);
+        let indices = UInt32Array::from(vec![0; 1024]);
+        let owner = Arc::new(MemoryBudget::new(128).unwrap());
+        let _scope = MemoryScope::enter(Some(owner.clone()));
+        let error = take_array_with_budget(&values, &indices).unwrap_err();
+        assert!(matches!(
+            MemoryError::find_in_chain(&error),
+            Some(MemoryError::LimitExceeded { .. })
+        ));
+        assert_eq!(owner.used(), 0);
+        assert_eq!(values.value(0), "abcdefgh");
+    }
+    #[test]
+    fn arrow_interleave_hook_keeps_merged_nested_payloads_owned() {
+        let left =
+            ListArray::from_iter_primitive::<Int32Type, _, _>([Some(vec![Some(1), Some(2)]), None]);
+        let right = ListArray::from_iter_primitive::<Int32Type, _, _>([Some(vec![Some(3)])]);
+        let owner = Arc::new(MemoryBudget::new(4096).unwrap());
+        let output = {
+            let _scope = MemoryScope::enter(Some(owner.clone()));
+            arrow_select::interleave::interleave(&[&left, &right], &[(0, 1), (1, 0), (0, 0)])
+                .unwrap()
+        };
+        let expected = ListArray::from_iter_primitive::<Int32Type, _, _>([
+            None,
+            Some(vec![Some(3)]),
+            Some(vec![Some(1), Some(2)]),
+        ]);
+        assert_eq!(output.to_data(), expected.to_data());
+        assert!(owner.used() >= 12);
+        drop(output);
+        assert_eq!(owner.used(), 0);
+    }
+}
