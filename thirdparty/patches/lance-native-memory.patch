+++ b/rust/lance-core/src/memory/protobuf.rs
@@ -0,0 +1,321 @@
+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright The Lance Authors
+
+//! Allocation-free protobuf admission over contiguous and chunked wire input.
+
+use crate::{Error, Result};
+
+pub struct WireSchema {
+    pub size: usize,
+    pub fields: &'static [WireField],
+}
+pub struct WireField {
+    pub number: u32,
+    pub repeated: bool,
+    pub kind: FieldKind,
+}
+pub enum FieldKind {
+    Scalar { width: usize, wire: u8 },
+    Bytes { width: usize },
+    Message(&'static WireSchema),
+    Map(&'static WireSchema),
+}
+
+fn add(left: usize, right: usize) -> Result<usize> {
+    left.checked_add(right)
+        .ok_or_else(|| Error::invalid_input("metadata memory size overflow"))
+}
+fn mul(left: usize, right: usize) -> Result<usize> {
+    left.checked_mul(right)
+        .ok_or_else(|| Error::invalid_input("metadata memory size overflow"))
+}
+
+#[derive(Clone)]
+struct Cursor<'a, I: Iterator<Item = &'a [u8]> + Clone> {
+    chunks: I,
+    current: &'a [u8],
+    remaining: usize,
+}
+
+impl<'a, I: Iterator<Item = &'a [u8]> + Clone> Cursor<'a, I> {
+    fn new(chunks: I) -> Result<Self> {
+        let remaining = chunks
+            .clone()
+            .try_fold(0, |total, chunk| add(total, chunk.len()))?;
+        Ok(Self {
+            chunks,
+            current: &[],
+            remaining,
+        })
+    }
+
+    fn read(&mut self) -> Result<u8> {
+        if self.remaining == 0 {
+            return Err(Error::invalid_input("truncated protobuf varint"));
+        }
+        while self.current.is_empty() {
+            self.current = self
+                .chunks
+                .next()
+                .ok_or_else(|| Error::invalid_input("truncated protobuf chunks"))?;
+        }
+        let byte = self.current[0];
+        self.current = &self.current[1..];
+        self.remaining -= 1;
+        Ok(byte)
+    }
+
+    fn skip(&mut self, mut len: usize) -> Result<()> {
+        if len > self.remaining {
+            return Err(Error::invalid_input("truncated protobuf bytes"));
+        }
+        self.remaining -= len;
+        while len > 0 {
+            while self.current.is_empty() {
+                self.current = self
+                    .chunks
+                    .next()
+                    .ok_or_else(|| Error::invalid_input("truncated protobuf chunks"))?;
+            }
+            let take = len.min(self.current.len());
+            self.current = &self.current[take..];
+            len -= take;
+        }
+        Ok(())
+    }
+
+    fn take(&mut self, len: usize) -> Result<Self> {
+        if len > self.remaining {
+            return Err(Error::invalid_input("truncated protobuf bytes"));
+        }
+        let mut child = self.clone();
+        child.remaining = len;
+        self.skip(len)?;
+        Ok(child)
+    }
+
+    fn varint(&mut self) -> Result<u64> {
+        let mut value = 0;
+        for shift in (0..70).step_by(7) {
+            let byte = self.read()?;
+            if shift == 63 && byte > 1 {
+                return Err(Error::invalid_input("protobuf varint overflow"));
+            }
+            value |= u64::from(byte & 0x7f) << shift;
+            if byte < 0x80 {
+                return Ok(value);
+            }
+        }
+        Err(Error::invalid_input("protobuf varint exceeds ten bytes"))
+    }
+
+    fn value(&mut self, field: u32, wire: u8, depth: usize) -> Result<Value<'a, I>> {
+        match wire {
+            0 => {
+                self.varint()?;
+                Ok(Value::Scalar(0))
+            }
+            1 | 5 => {
+                self.skip(if wire == 1 { 8 } else { 4 })?;
+                Ok(Value::Scalar(wire))
+            }
+            2 => {
+                let len = usize::try_from(self.varint()?)
+                    .map_err(|_| Error::invalid_input("protobuf length exceeds usize"))?;
+                Ok(Value::Bytes(self.take(len)?))
+            }
+            3 => {
+                if depth >= 100 {
+                    return Err(Error::invalid_input("protobuf recursion limit exceeded"));
+                }
+                loop {
+                    let tag = self.varint()?;
+                    let child = (tag >> 3) as u32;
+                    let child_wire = (tag & 7) as u8;
+                    if child_wire == 4 {
+                        if child != field {
+                            return Err(Error::invalid_input("mismatched protobuf end group"));
+                        }
+                        return Ok(Value::Group);
+                    }
+                    self.value(child, child_wire, depth + 1)?;
+                }
+            }
+            _ => Err(Error::invalid_input("invalid protobuf wire type")),
+        }
+    }
+}
+
+enum Value<'a, I: Iterator<Item = &'a [u8]> + Clone> {
+    Scalar(u8),
+    Bytes(Cursor<'a, I>),
+    Group,
+}
+
+impl WireSchema {
+    /// Calculate a bound before prost decodes a contiguous protobuf message.
+    pub fn peak(&self, bytes: &[u8], depth: usize) -> Result<usize> {
+        self.cursor_peak(Cursor::new(std::iter::once(bytes))?, depth)
+    }
+
+    /// Calculate the same bound without copying payloads split across I/O chunks.
+    pub fn peak_chunks<'a>(
+        &self,
+        chunks: impl Iterator<Item = &'a bytes::Bytes> + Clone,
+    ) -> Result<usize> {
+        self.cursor_peak(Cursor::new(chunks.map(|chunk| chunk.as_ref()))?, 0)
+    }
+
+    fn cursor_peak<'a, I: Iterator<Item = &'a [u8]> + Clone>(
+        &self,
+        mut bytes: Cursor<'a, I>,
+        depth: usize,
+    ) -> Result<usize> {
+        if depth >= 100 {
+            return Err(Error::invalid_input("protobuf recursion limit exceeded"));
+        }
+        assert!(self.fields.len() <= 64);
+        let mut counts = [0_usize; 64];
+        let mut peak = 0;
+        while bytes.remaining > 0 {
+            let tag = bytes.varint()?;
+            let number = (tag >> 3) as u32;
+            if number == 0 {
+                return Err(Error::invalid_input("protobuf field number is zero"));
+            }
+            let wire = (tag & 7) as u8;
+            let value = bytes.value(number, wire, depth)?;
+            let Some((index, field)) = self
+                .fields
+                .iter()
+                .enumerate()
+                .find(|(_, field)| field.number == number)
+            else {
+                continue;
+            };
+            match (&field.kind, value) {
+                (FieldKind::Scalar { wire: expected, .. }, Value::Scalar(actual))
+                    if *expected == actual =>
+                {
+                    if field.repeated {
+                        counts[index] = add(counts[index], 1)?;
+                    }
+                }
+                (FieldKind::Scalar { wire, .. }, Value::Bytes(mut bytes)) if field.repeated => {
+                    let count = if *wire == 0 {
+                        let mut count = 0;
+                        while bytes.remaining > 0 {
+                            bytes.varint()?;
+                            count += 1;
+                        }
+                        count
+                    } else {
+                        let width = if *wire == 1 { 8 } else { 4 };
+                        if !bytes.remaining.is_multiple_of(width) {
+                            return Err(Error::invalid_input("misaligned packed protobuf scalar"));
+                        }
+                        bytes.remaining / width
+                    };
+                    counts[index] = add(counts[index], count)?;
+                }
+                (FieldKind::Bytes { .. }, Value::Bytes(bytes)) => {
+                    peak = add(peak, mul(bytes.remaining.max(8), 3)?)?;
+                    if field.repeated {
+                        counts[index] = add(counts[index], 1)?;
+                    }
+                }
+                (FieldKind::Message(child), Value::Bytes(bytes)) => {
+                    peak = add(peak, child.cursor_peak(bytes, depth + 1)?)?;
+                    if field.repeated {
+                        counts[index] = add(counts[index], 1)?;
+                    } else {
+                        peak = add(peak, child.size)?;
+                    }
+                }
+                (FieldKind::Map(child), Value::Bytes(bytes)) => {
+                    peak = add(peak, child.cursor_peak(bytes, depth + 1)?)?;
+                    counts[index] = add(counts[index], 1)?;
+                }
+                _ => {
+                    return Err(Error::invalid_input(
+                        "protobuf wire type does not match metadata field",
+                    ));
+                }
+            }
+        }
+        for (field, count) in self.fields.iter().zip(counts) {
+            if count == 0 {
+                continue;
+            }
+            let width = match field.kind {
+                FieldKind::Scalar { width, .. } => width,
+                FieldKind::Message(child) => child.size,
+                FieldKind::Map(child) => {
+                    let buckets = add(mul(count, 8)?, 6)?
+                        .checked_div(7)
+                        .and_then(usize::checked_next_power_of_two)
+                        .ok_or_else(|| Error::invalid_input("metadata map capacity overflow"))?
+                        .max(4);
+                    let table = add(
+                        add(mul(buckets, child.size)?, 15)? / 16 * 16,
+                        add(buckets, 16)?,
+                    )?;
+                    peak = add(peak, mul(table, 3)?)?;
+                    continue;
+                }
+                FieldKind::Bytes { width } => width,
+            };
+            let capacity_peak = mul(count, 3)?.max(if width == 1 { 8 } else { 4 });
+            peak = add(peak, mul(capacity_peak, width)?)?;
+        }
+        Ok(peak)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    static SCHEMA: WireSchema = WireSchema {
+        size: 24,
+        fields: &[
+            WireField {
+                number: 1,
+                repeated: true,
+                kind: FieldKind::Bytes { width: 24 },
+            },
+            WireField {
+                number: 2,
+                repeated: true,
+                kind: FieldKind::Scalar { width: 8, wire: 0 },
+            },
+        ],
+    };
+
+    #[test]
+    fn chunk_bound_matches_contiguous_at_every_boundary() {
+        let wire =
+            bytes::Bytes::from_static(&[10, 3, b'a', b'b', b'c', 10, 0, 18, 4, 1, 128, 1, 3]);
+        let expected = SCHEMA.peak(&wire, 0).unwrap();
+        for split in 0..=wire.len() {
+            let chunks = [wire.slice(..split), wire.slice(split..)];
+            assert_eq!(SCHEMA.peak_chunks(chunks.iter()).unwrap(), expected);
+        }
+        let chunks: Vec<_> = (0..wire.len()).map(|i| wire.slice(i..i + 1)).collect();
+        assert_eq!(SCHEMA.peak_chunks(chunks.iter()).unwrap(), expected);
+    }
+
+    #[test]
+    fn repeated_empty_bytes_still_admit_vector_headers() {
+        assert_eq!(
+            SCHEMA.peak(&[10, 0, 10, 0], 0).unwrap(),
+            2 * 8 * 3 + 2 * 3 * 24
+        );
+    }
+
+    #[test]
+    fn malformed_wire_fails_without_count_storage() {
+        assert!(SCHEMA.peak(&[10, 4, 1], 0).is_err());
+        assert!(SCHEMA.peak(&[18, 1, 128], 0).is_err());
+        assert!(SCHEMA.peak(&[11, 20], 0).is_err());
+    }
+}
