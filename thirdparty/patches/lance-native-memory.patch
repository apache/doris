+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright The Lance Authors
+
+use std::ops::Range;
+
+use arrow_buffer::{BooleanBuffer, Buffer, bit_util};
+
+use super::BudgetedVec;
+use crate::{Error, Result};
+
+/// A packed bitmap builder that admits capacity before allocating or growing.
+#[derive(Debug)]
+pub struct BudgetedBitmap {
+    bytes: BudgetedVec<u8>,
+    len: usize,
+}
+
+impl BudgetedBitmap {
+    /// Append one bit after admitting any required byte storage.
+    pub fn try_push(&mut self, value: bool) -> Result<()> {
+        let len = self
+            .len
+            .checked_add(1)
+            .ok_or_else(|| Error::invalid_input("native bitmap length overflow"))?;
+        self.bytes.try_resize(len.div_ceil(8), 0)?;
+        if value {
+            bit_util::set_bit(&mut self.bytes, self.len);
+        }
+        self.len = len;
+        Ok(())
+    }
+    /// Reserve storage for at least `bits` bits under the current owner.
+    pub fn try_with_capacity(bits: usize) -> Result<Self> {
+        Ok(Self {
+            bytes: BudgetedVec::try_with_capacity(bits.div_ceil(8))?,
+            len: 0,
+        })
+    }
+
+    /// Append a selected bit range, preserving Arrow's little-endian bit order.
+    pub fn try_append_packed_range(&mut self, range: Range<usize>, bytes: &[u8]) -> Result<()> {
+        let additional = range
+            .end
+            .checked_sub(range.start)
+            .ok_or_else(|| Error::invalid_input("invalid bitmap range"))?;
+        let new_len = self
+            .len
+            .checked_add(additional)
+            .ok_or_else(|| Error::invalid_input("native bitmap length overflow"))?;
+        self.bytes.try_resize(new_len.div_ceil(8), 0)?;
+        if self.len.is_multiple_of(8)
+            && range.start.is_multiple_of(8)
+            && additional.is_multiple_of(8)
+        {
+            self.bytes[self.len / 8..new_len / 8]
+                .copy_from_slice(&bytes[range.start / 8..range.end / 8]);
+        } else {
+            for (destination, source) in (self.len..new_len).zip(range) {
+                if bit_util::get_bit(bytes, source) {
+                    bit_util::set_bit(&mut self.bytes, destination);
+                }
+            }
+        }
+        self.len = new_len;
+        Ok(())
+    }
+
+    /// Append an Arrow bitmap without detaching its offset from its bit data.
+    pub fn try_append_buffer(&mut self, buffer: &BooleanBuffer) -> Result<()> {
+        self.try_append_packed_range(
+            buffer.offset()..buffer.offset() + buffer.len(),
+            buffer.values(),
+        )
+    }
+
+    /// Number of initialized bits.
+    pub fn len(&self) -> usize {
+        self.len
+    }
+
+    /// Whether no bits have been appended.
+    pub fn is_empty(&self) -> bool {
+        self.len == 0
+    }
+
+    /// Finish an Arrow bitmap while retaining the byte capacity reservation.
+    pub fn finish(self) -> BooleanBuffer {
+        BooleanBuffer::new(self.bytes.into_buffer(), 0, self.len)
+    }
+
+    /// Finish the underlying packed bytes while retaining their reservation.
+    pub fn into_buffer(self) -> Buffer {
+        self.bytes.into_buffer()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::memory::{MemoryBudget, MemoryScope};
+    use std::sync::Arc;
+
+    #[test]
+    fn unaligned_append_is_budgeted_and_preserves_bits() {
+        let owner = Arc::new(MemoryBudget::new(8).unwrap());
+        let _scope = MemoryScope::enter(Some(owner.clone()));
+        let mut builder = BudgetedBitmap::try_with_capacity(8).unwrap();
+        builder
+            .try_append_packed_range(1..7, &[0b10110110])
+            .unwrap();
+        builder
+            .try_append_packed_range(0..5, &[0b00010101])
+            .unwrap();
+        let bitmap = builder.finish();
+        let actual = bitmap.iter().collect::<Vec<_>>();
+        assert_eq!(
+            actual,
+            vec![
+                true, true, false, true, true, false, true, false, true, false, true
+            ]
+        );
+        assert_eq!(owner.used(), 4);
+        drop(bitmap);
+        assert_eq!(owner.used(), 0);
+    }
+}
