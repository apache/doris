+            entered: Barrier,
+            finish: Barrier,
+        }
+
+        impl MemoryAccountant for PendingAccountant {
+            fn try_reserve(&self, _: usize) -> Result<()> {
+                self.entered.wait();
+                self.finish.wait();
+                Err(Error::execution("controlled external denial"))
+            }
+
+            fn release(&self, _: usize) {
+                panic!("a rejected external reservation must not be released");
+            }
+        }
+
+        let accountant = Arc::new(PendingAccountant {
+            entered: Barrier::new(2),
+            finish: Barrier::new(2),
+        });
