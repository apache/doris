+use lance_core::memory::{BudgetedVec, MemoryReservation, reserve_current, retain_array_buffers};
+
+fn checked_product(left: usize, right: usize) -> Result<usize> {
+    left.checked_mul(right)
+        .ok_or_else(|| Error::invalid_input("flat FTS allocation overflow"))
+}
+fn checked_sum(left: usize, right: usize) -> Result<usize> {
+    left.checked_add(right)
+        .ok_or_else(|| Error::invalid_input("flat FTS allocation overflow"))
+}
+fn arrow_bytes(elements: usize, width: usize) -> Result<usize> {
+    Ok(checked_sum(checked_product(elements, width)?, 63)? & !63)
+}
+fn retain_flat_batch(batch: RecordBatch, memory: Option<MemoryReservation>) -> Result<RecordBatch> {
+    let Some(memory) = memory else {
+        return Ok(batch);
+    };
+    let schema = batch.schema();
+    let values: arrow_array::StructArray = batch.into();
+    let values =
+        arrow_array::StructArray::from(retain_array_buffers(memory, &[], values.to_data())?);
+    Ok(RecordBatch::try_new(schema, values.columns().to_vec())?)
+}
+fn token_indices_memory(tokens: &Tokens) -> Result<Option<MemoryReservation>> {
+    let count = tokens.len();
+    let buckets = checked_sum(checked_product(count, 8)?, 6)?
+        .checked_div(7)
+        .and_then(usize::checked_next_power_of_two)
+        .ok_or_else(|| Error::invalid_input("flat FTS token map overflow"))?
+        .max(4);
+    let mut bytes = checked_sum(
+        checked_product(buckets, std::mem::size_of::<(String, Vec<usize>)>())?,
+        checked_sum(buckets, 31)?,
+    )?;
+    bytes = checked_sum(
+        bytes,
+        checked_product(count, 3 * std::mem::size_of::<usize>())?,
+    )?;
+    for token in tokens {
+        bytes = checked_sum(bytes, token.len())?;
+    }
+    reserve_current(bytes)
+}
+fn count_output_memory(
+    rows: usize,
+    terms: usize,
+    rank: usize,
+    phrase: bool,
+) -> Result<Option<MemoryReservation>> {
+    let mut bytes = checked_product(arrow_bytes(rows, 8)?, 2)?;
+    bytes = checked_sum(bytes, checked_product(arrow_bytes(rows, 4)?, rank)?)?;
+    bytes = checked_sum(bytes, arrow_bytes(checked_product(rows, terms)?, 8)?)?;
+    if phrase {
+        bytes = checked_sum(bytes, arrow_bytes(rows.div_ceil(8), 1)?)?;
+    }
+    reserve_current(bytes)
+}
 
