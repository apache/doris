new file mode 100644
index 0000000000000000000000000000000000000000..b8c908efcee5953b18e37355c04ecddadc7eb260
--- /dev/null
+++ b/rust/lance-core/src/memory/vector.rs
@@ -0,0 +1,380 @@
+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright The Lance Authors
+
+use std::mem::{MaybeUninit, size_of};
+use std::ops::{Deref, DerefMut};
+use std::panic::RefUnwindSafe;
+use std::ptr::NonNull;
+use std::sync::Arc;
+
+use arrow_buffer::{ArrowNativeType, Buffer};
+
+use super::{MemoryError, MemoryReservation, reserve_current};
+use crate::{Error, Result};
+
+/// A fallibly allocated vector whose capacity is admitted before allocation.
+///
+/// Its accounting belongs to the submitting query and remains attached when
+/// converted to Arrow storage. Truncation releases elements, but retains the
+/// capacity charge until the storage is actually deallocated.
+#[derive(Debug)]
+pub struct BudgetedVec<T> {
+    values: Vec<T>,
+    reservation: Option<MemoryReservation>,
+}
+
+impl<T> BudgetedVec<T> {
+    /// Transfer storage and its accounting token without changing allocations.
+    /// The receiver must free the vector before releasing its reservation.
+    pub fn into_parts(self) -> (Vec<T>, Option<MemoryReservation>) {
+        (self.values, self.reservation)
+    }
+
+    /// Allocate capacity for `capacity` elements under the current owner.
+    pub fn try_with_capacity(capacity: usize) -> Result<Self> {
+        let bytes = capacity.checked_mul(size_of::<T>()).ok_or_else(|| {
+            Error::invalid_input(format!(
+                "native vector capacity overflow: capacity={capacity}, element_size={}",
+                size_of::<T>()
+            ))
+        })?;
+        let reservation = reserve_current(bytes)?;
+        let mut values = Vec::new();
+        values
+            .try_reserve_exact(capacity)
+            .map_err(|_| MemoryError::AllocationFailed { bytes })?;
+        Ok(Self {
+            values,
+            reservation,
+        })
+    }
+
+    /// Reserve room for more elements before growing storage.
+    ///
+    /// Growth admits the complete new block while the old allocation is still
+    /// live. Elements are moved only after successful allocation, and the old
+    /// capacity is released only after its storage has been physically freed.
+    pub fn try_reserve(&mut self, additional: usize) -> Result<()> {
+        let required = self
+            .values
+            .len()
+            .checked_add(additional)
+            .ok_or_else(|| Error::invalid_input("native vector length overflow"))?;
+        if required <= self.values.capacity() {
+            return Ok(());
+        }
+        let capacity = required
+            .max(
+                self.values
+                    .capacity()
+                    .checked_mul(2)
+                    .ok_or_else(|| Error::invalid_input("native vector capacity overflow"))?,
+            )
+            .max(4);
+        let bytes = capacity
+            .checked_mul(size_of::<T>())
+            .ok_or_else(|| Error::invalid_input("native vector allocation size overflow"))?;
+        let previous_bytes = self.reservation.as_ref().map(MemoryReservation::bytes);
+        let mut new_reservation = None;
+        if let Some(reservation) = self.reservation.as_mut() {
+            reservation.try_grow(bytes)?;
+        } else {
+            // A vector initialized outside a scope is existing input. A new
+            // allocation made after entering a query must still be admitted.
+            new_reservation = reserve_current(bytes)?;
+        }
+        let mut values = Vec::new();
+        if values.try_reserve_exact(capacity).is_err() {
+            if let (Some(reservation), Some(previous_bytes)) =
+                (self.reservation.as_mut(), previous_bytes)
+            {
+                reservation.shrink_to(previous_bytes)?;
+            }
+            return Err(MemoryError::AllocationFailed { bytes }.into());
+        }
+        values.append(&mut self.values);
+        let old = std::mem::replace(&mut self.values, values);
+        drop(old);
+        if let Some(reservation) = self.reservation.as_mut() {
+            reservation.shrink_to(bytes)?;
+        } else {
+            self.reservation = new_reservation;
+        }
+        Ok(())
+    }
+
+    /// Append one element, admitting any necessary growth first.
+    pub fn try_push(&mut self, value: T) -> Result<()> {
+        self.try_reserve(1)?;
+        self.values.push(value);
+        Ok(())
+    }
+
+    /// Reduce the visible length while retaining the storage reservation.
+    pub fn truncate(&mut self, len: usize) {
+        self.values.truncate(len);
+    }
+
+    /// Expose unused slots to a decoder that initializes them directly.
+    pub fn spare_capacity_mut(&mut self) -> &mut [MaybeUninit<T>] {
+        self.values.spare_capacity_mut()
+    }
+
+    /// Set the length after a decoder has initialized its output slots.
+    ///
+    /// # Safety
+    ///
+    /// `len` must not exceed capacity; all new elements must be initialized.
+    pub unsafe fn set_len(&mut self, len: usize) {
+        // SAFETY: the decoder caller upholds Vec::set_len's initialization contract.
+        unsafe { self.values.set_len(len) };
+    }
+
+    /// The number of elements whose storage is owned by this vector.
+    pub fn capacity(&self) -> usize {
+        self.values.capacity()
+    }
+
+    /// Borrow a vector for an external decoder that cannot allocate past capacity.
+    ///
+    /// # Safety
+    ///
+    /// The decoder must not increase the vector's capacity. It may initialize,
+    /// truncate, or overwrite its elements within the admitted capacity.
+    pub unsafe fn fixed_capacity_vec_mut(&mut self) -> &mut Vec<T> {
+        &mut self.values
+    }
+}
+
+impl<T: Clone> BudgetedVec<T> {
+    /// Allocate and initialize `len` elements under the current owner.
+    pub fn try_filled(len: usize, value: T) -> Result<Self> {
+        let mut vector = Self::try_with_capacity(len)?;
+        vector.values.resize(len, value);
+        Ok(vector)
+    }
+
+    /// Append a slice, admitting any necessary growth first.
+    pub fn try_extend_from_slice(&mut self, values: &[T]) -> Result<()> {
+        self.try_reserve(values.len())?;
+        self.values.extend_from_slice(values);
+        Ok(())
+    }
+
+    /// Resize the visible data, admitting growth before initialization.
+    pub fn try_resize(&mut self, len: usize, value: T) -> Result<()> {
+        if len > self.values.len() {
+            self.try_reserve(len - self.values.len())?;
+        }
+        self.values.resize(len, value);
+        Ok(())
+    }
+}
+
+impl<T: ArrowNativeType + RefUnwindSafe> BudgetedVec<T> {
+    /// Transfer the vector and its capacity reservation into shared Arrow storage.
+    pub fn into_buffer(self) -> Buffer {
+        let len = self.values.len() * size_of::<T>();
+        let pointer = NonNull::new(self.values.as_ptr() as *mut u8).unwrap_or(NonNull::dangling());
+        // SAFETY: Arrow retains this owner until its final clone, slice, or FFI
+        // export drops; the Vec and reservation are then dropped in that order.
+        unsafe { Buffer::from_custom_allocation(pointer, len, Arc::new(self)) }
+    }
+}
+
+impl<T> Deref for BudgetedVec<T> {
+    type Target = [T];
+
+    fn deref(&self) -> &Self::Target {
+        self.values.as_slice()
+    }
+}
+
+impl<T> AsRef<[T]> for BudgetedVec<T> {
+    fn as_ref(&self) -> &[T] {
+        self.values.as_slice()
+    }
+}
+
+impl<T> DerefMut for BudgetedVec<T> {
+    fn deref_mut(&mut self) -> &mut Self::Target {
+        self.values.as_mut_slice()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::memory::{MemoryBudget, MemoryScope};
+
+    #[test]
+    fn admission_precedes_allocation_and_failed_growth_preserves_data() {
+        let owner = Arc::new(MemoryBudget::new(16).unwrap());
+        let _scope = MemoryScope::enter(Some(owner.clone()));
+        let mut vector = BudgetedVec::try_filled(4, 7_u32).unwrap();
+        let error = vector.try_push(8).unwrap_err();
+        assert!(matches!(
+            MemoryError::find_in_chain(&error),
+            Some(MemoryError::LimitExceeded { requested: 32, .. })
+        ));
+        assert_eq!(&*vector, &[7; 4]);
+        assert_eq!(owner.used(), 16);
+        vector.truncate(1);
+        assert_eq!(owner.used(), 16);
+        drop(vector);
+        assert_eq!(owner.used(), 0);
+    }
+
+    #[test]
+    fn arrow_slices_retain_the_allocation_after_vector_scope_ends() {
+        let owner = Arc::new(MemoryBudget::new(16).unwrap());
+        let buffer = {
+            let _scope = MemoryScope::enter(Some(owner.clone()));
+            BudgetedVec::try_filled(4, 7_u32).unwrap().into_buffer()
+        };
+        let slice = buffer.slice_with_length(4, 4);
+        drop(buffer);
+        assert_eq!(owner.used(), 16);
+        assert_eq!(slice.as_slice(), &7_u32.to_ne_bytes());
+        drop(slice);
+        assert_eq!(owner.used(), 0);
+    }
+
+    #[test]
+    fn cancellation_rejects_growth_without_releasing_live_storage() {
+        let owner = Arc::new(MemoryBudget::new(64).unwrap());
+        let _scope = MemoryScope::enter(Some(owner.clone()));
+        let mut vector = BudgetedVec::try_filled(4, 7_u32).unwrap();
+        owner.cancel();
+        let error = vector.try_push(8).unwrap_err();
+        assert!(matches!(
+            MemoryError::find_in_chain(&error),
+            Some(MemoryError::Cancelled)
+        ));
+        assert_eq!(owner.used(), 16);
+        drop(vector);
+        assert_eq!(owner.used(), 0);
+    }
+    #[test]
+    fn growth_rejects_when_copy_peak_exceeds_limit_even_if_final_block_fits() {
+        let owner = Arc::new(MemoryBudget::new(40).unwrap());
+        let _scope = MemoryScope::enter(Some(owner.clone()));
+        let mut vector = BudgetedVec::try_filled(4, 7_u32).unwrap();
+        let error = vector.try_push(8).unwrap_err();
+        assert!(matches!(
+            MemoryError::find_in_chain(&error),
+            Some(MemoryError::LimitExceeded {
+                requested: 32,
+                used: 16,
+                limit: 40
+            })
+        ));
+        assert_eq!(&*vector, &[7; 4]);
+        assert_eq!(owner.used(), 16);
+        assert_eq!(vector.capacity(), 4);
+    }
+
+    #[test]
+    fn growth_of_existing_input_captures_the_current_allocation_owner() {
+        let mut vector = BudgetedVec::try_filled(4, 7_u32).unwrap();
+        let owner = Arc::new(MemoryBudget::new(32).unwrap());
+        let _scope = MemoryScope::enter(Some(owner.clone()));
+        vector.try_push(8).unwrap();
+        assert_eq!(owner.used(), 32);
+        assert_eq!(&*vector, &[7, 7, 7, 7, 8]);
+        drop(vector);
+        assert_eq!(owner.used(), 0);
+    }
+}
+
+impl<T> BudgetedVec<T> {
+    /// Remove the last item while retaining the allocated capacity.
+    pub fn pop(&mut self) -> Option<T> {
+        self.values.pop()
+    }
+}
+
+/// Consuming iteration retains accounting until the vector storage is freed.
+pub struct BudgetedIntoIter<T> {
+    inner: std::vec::IntoIter<T>,
+    _reservation: Option<MemoryReservation>,
+}
+impl<T> Iterator for BudgetedIntoIter<T> {
+    type Item = T;
+    fn next(&mut self) -> Option<T> {
+        self.inner.next()
+    }
+    fn size_hint(&self) -> (usize, Option<usize>) {
+        self.inner.size_hint()
+    }
+}
+impl<T> DoubleEndedIterator for BudgetedIntoIter<T> {
+    fn next_back(&mut self) -> Option<T> {
+        self.inner.next_back()
+    }
+}
+impl<T> ExactSizeIterator for BudgetedIntoIter<T> {
+    fn len(&self) -> usize {
+        self.inner.len()
+    }
+}
+impl<T> std::iter::FusedIterator for BudgetedIntoIter<T> {}
+impl<T> IntoIterator for BudgetedVec<T> {
+    type Item = T;
+    type IntoIter = BudgetedIntoIter<T>;
+    fn into_iter(self) -> Self::IntoIter {
+        let (values, reservation) = self.into_parts();
+        BudgetedIntoIter {
+            inner: values.into_iter(),
+            _reservation: reservation,
+        }
+    }
+}
+impl<'a, T> IntoIterator for &'a BudgetedVec<T> {
+    type Item = &'a T;
+    type IntoIter = std::slice::Iter<'a, T>;
+    fn into_iter(self) -> Self::IntoIter {
+        self.iter()
+    }
+}
+impl<'a, T> IntoIterator for &'a mut BudgetedVec<T> {
+    type Item = &'a mut T;
+    type IntoIter = std::slice::IterMut<'a, T>;
+    fn into_iter(self) -> Self::IntoIter {
+        self.iter_mut()
+    }
+}
+impl<T: PartialEq> PartialEq for BudgetedVec<T> {
+    fn eq(&self, other: &Self) -> bool {
+        self.as_ref() == other.as_ref()
+    }
+}
+impl<T: Eq> Eq for BudgetedVec<T> {}
+impl<T: PartialEq> PartialEq<Vec<T>> for BudgetedVec<T> {
+    fn eq(&self, other: &Vec<T>) -> bool {
+        self.as_ref() == other.as_slice()
+    }
+}
+
+#[cfg(test)]
+mod iterator_tests {
+    use super::*;
+    use crate::memory::{MemoryBudget, MemoryScope};
+    #[test]
+    fn consuming_iterator_keeps_capacity_charged_until_storage_drop() {
+        let budget = Arc::new(MemoryBudget::new(64).unwrap());
+        let vector = {
+            let _scope = MemoryScope::enter(Some(budget.clone()));
+            BudgetedVec::try_filled(4, 7_u64).unwrap()
+        };
+        let mut iter = vector.into_iter();
+        assert_eq!(iter.next(), Some(7));
+        assert_eq!(budget.used(), 32);
+        assert_eq!(iter.next_back(), Some(7));
+        assert_eq!(iter.len(), 2);
+        assert_eq!(iter.by_ref().count(), 2);
+        assert_eq!(budget.used(), 32);
+        drop(iter);
+        assert_eq!(budget.used(), 0);
+    }
+}
