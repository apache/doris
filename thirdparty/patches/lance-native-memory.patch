+use std::ops::Deref;
+use std::sync::{Arc, Mutex};
+
+use super::{BudgetedVec, MemoryReservation};
+use crate::{Error, Result};
+
+/// A metadata admission token shared by the payloads produced by one decode.
+#[derive(Debug)]
+pub struct MemoryOwner {
+    reservation: Mutex<MemoryReservation>,
+    _parent: Option<Arc<Self>>,
+}
+
+impl MemoryOwner {
+    /// Retain an admission made before the associated metadata was decoded.
+    pub fn new(reservation: MemoryReservation) -> Arc<Self> {
+        Arc::new(Self {
+            reservation: Mutex::new(reservation),
+            _parent: None,
+        })
+    }
+
+    /// Own a working copy while keeping its shared source metadata admitted.
+    pub fn new_with_parent(reservation: MemoryReservation, parent: Option<Arc<Self>>) -> Arc<Self> {
+        Arc::new(Self {
+            reservation: Mutex::new(reservation),
+            _parent: parent,
+        })
+    }
+    pub const fn allocation_bytes() -> usize {
+        std::mem::size_of::<Self>() + 2 * std::mem::size_of::<usize>()
+    }
+
+    /// Return unused admission after actual payload capacities are known.
+    pub fn shrink_to(&self, bytes: usize) -> Result<()> {
+        self.reservation
+            .lock()
+            .expect("metadata admission lock is not poisoned")
+            .shrink_to(bytes)
+    }
+}
+
+/// Accounting metadata that does not participate in payload equality.
+#[derive(Clone, Debug, Default)]
+pub struct MemoryOwnerHandle(pub Option<Arc<MemoryOwner>>);
+impl PartialEq for MemoryOwnerHandle {
+    fn eq(&self, _: &Self) -> bool {
+        true
+    }
+}
+impl Eq for MemoryOwnerHandle {}
+impl crate::deepsize::DeepSizeOf for MemoryOwnerHandle {
+    fn deep_size_of_children(&self, _: &mut crate::deepsize::Context) -> usize {
+        0
+    }
+}
+
+#[derive(Debug)]
+enum Storage<T> {
+    Owned(Vec<T>),
+    Shared(Arc<[T]>),
+}
+
+impl<T> Storage<T> {
+    fn as_slice(&self) -> &[T] {
+        match self {
+            Self::Owned(values) => values,
+            Self::Shared(values) => values,
+        }
+    }
+    fn capacity(&self) -> usize {
+        match self {
+            Self::Owned(values) => values.capacity(),
+            Self::Shared(values) => values.len(),
+        }
+    }
+}
+
+#[derive(Debug)]
+struct SliceOwner<T> {
+    // Drop storage completely (including Vec/Arc backing allocation) before any
+    // lease is released. Keeping a token inside T would release it too early.
+    storage: Storage<T>,
+    _reservation: Option<MemoryReservation>,
+    owner: Option<Arc<MemoryOwner>>,
+}
+
+/// A shared immutable slice retaining its physical storage's accounting owner.
+///
+/// Clones share this entire owner instead of extracting the inner Arc slice, so
+/// metadata cache eviction cannot release accounting of a scheduler's view.
+#[derive(Debug)]
+pub struct MemorySlice<T>(Arc<SliceOwner<T>>);
+
+impl<T> Clone for MemorySlice<T> {
+    fn clone(&self) -> Self {
+        Self(self.0.clone())
+    }
+}
+
+impl<T> MemorySlice<T> {
+    /// Transfer a fallibly allocated vector without reallocating or recharging.
+    pub fn from_budgeted_vec(vector: BudgetedVec<T>) -> Self {
+        let (values, reservation) = vector.into_parts();
+        Self(Arc::new(SliceOwner {
+            storage: Storage::Owned(values),
+            _reservation: reservation,
+            owner: None,
+        }))
+    }
+
+    /// Number of elements whose storage this owner keeps live.
+    pub fn capacity(&self) -> usize {
+        self.0.storage.capacity()
+    }
+
+    /// Storage and owner bytes retained by this slice, excluding external aliases.
+    pub fn owned_bytes(&self) -> usize {
+        self.capacity() * std::mem::size_of::<T>() + Self::owner_overhead()
+    }
+
+    /// Fixed ownership metadata allocated independently for a new shared slice.
+    pub const fn owner_overhead() -> usize {
+        std::mem::size_of::<SliceOwner<T>>() + 2 * std::mem::size_of::<usize>()
+    }
+
+    /// Borrow the initialized items.
+    pub fn as_slice(&self) -> &[T] {
+        self.0.storage.as_slice()
+    }
+
+    /// Attach pre-admitted decoded metadata before publishing any shared view.
+    pub fn retain_owner(&mut self, owner: Arc<MemoryOwner>) -> Result<()> {
+        let inner = Arc::get_mut(&mut self.0).ok_or_else(|| {
+            Error::internal("metadata owner must be attached before sharing its slice")
+        })?;
+        if let Storage::Shared(values) = &inner.storage
+            && Arc::strong_count(values) != 1
+        {
+            return Err(Error::internal(
+                "metadata Arc storage was shared before attaching its owner",
+            ));
+        }
+        if inner.owner.is_some() {
+            return Err(Error::internal(
+                "metadata slice already has an admission owner",
+            ));
+        }
+        inner.owner = Some(owner);
+        Ok(())
+    }
+
+    /// Attach an owner to interned storage before publishing the complete group.
+    ///
+    /// Every shared backing-allocation alias must receive this same owner before
+    /// any decoded metadata is exposed. Used by manifest interning, whose local
+    /// Arc cache is dropped before the completed manifest is published.
+    pub fn retain_interned_owner(&mut self, owner: Arc<MemoryOwner>) -> Result<()> {
+        let inner = Arc::get_mut(&mut self.0).ok_or_else(|| {
+            Error::internal("interned metadata slice was published before retaining its owner")
+        })?;
+        if inner.owner.is_some() {
+            return Err(Error::internal(
+                "interned metadata slice already has an owner",
+            ));
+        }
+        inner.owner = Some(owner);
+        Ok(())
+    }
+
+    /// Mutate freshly constructed metadata before its first shared publication.
+    pub fn get_mut(&mut self) -> Result<&mut [T]> {
+        let inner = Arc::get_mut(&mut self.0)
+            .ok_or_else(|| Error::internal("metadata slice is already shared"))?;
+        match &mut inner.storage {
+            Storage::Owned(values) => Ok(values),
+            Storage::Shared(values) => Arc::get_mut(values)
+                .ok_or_else(|| Error::internal("metadata Arc slice is already shared")),
+        }
+    }
+}
+
+impl<T> Deref for MemorySlice<T> {
+    type Target = [T];
+    fn deref(&self) -> &[T] {
+        self.as_slice()
+    }
+}
+impl<T> AsRef<[T]> for MemorySlice<T> {
+    fn as_ref(&self) -> &[T] {
+        self.as_slice()
+    }
+}
+impl<T> From<Vec<T>> for MemorySlice<T> {
+    fn from(values: Vec<T>) -> Self {
+        Self(Arc::new(SliceOwner {
+            storage: Storage::Owned(values),
+            _reservation: None,
+            owner: None,
+        }))
+    }
+}
+impl<T> From<Arc<[T]>> for MemorySlice<T> {
+    fn from(values: Arc<[T]>) -> Self {
+        Self(Arc::new(SliceOwner {
+            storage: Storage::Shared(values),
+            _reservation: None,
+            owner: None,
+        }))
+    }
+}
+impl<T, const N: usize> From<Arc<[T; N]>> for MemorySlice<T> {
+    fn from(values: Arc<[T; N]>) -> Self {
+        let values: Arc<[T]> = values;
+        Self::from(values)
+    }
+}
+impl<T, const N: usize> From<[T; N]> for MemorySlice<T> {
+    fn from(values: [T; N]) -> Self {
+        Self::from(Vec::from(values))
+    }
+}
+impl<T> From<Box<[T]>> for MemorySlice<T> {
+    fn from(values: Box<[T]>) -> Self {
+        Self::from(Vec::from(values))
+    }
+}
+impl<T> Default for MemorySlice<T> {
+    fn default() -> Self {
+        Self::from(Vec::new())
+    }
+}
+impl<T> FromIterator<T> for MemorySlice<T> {
+    fn from_iter<I: IntoIterator<Item = T>>(iter: I) -> Self {
+        Self::from(iter.into_iter().collect::<Vec<_>>())
+    }
+}
+impl<'a, T> IntoIterator for &'a MemorySlice<T> {
+    type Item = &'a T;
+    type IntoIter = std::slice::Iter<'a, T>;
+    fn into_iter(self) -> Self::IntoIter {
+        self.iter()
+    }
+}
+impl<T: PartialEq> PartialEq for MemorySlice<T> {
+    fn eq(&self, other: &Self) -> bool {
+        self.as_slice() == other.as_slice()
+    }
+}
+impl<T: Eq> Eq for MemorySlice<T> {}
+impl<T: std::hash::Hash> std::hash::Hash for MemorySlice<T> {
+    fn hash<H: std::hash::Hasher>(&self, state: &mut H) {
+        self.as_slice().hash(state);
+    }
+}
+
+impl crate::deepsize::DeepSizeOf for MemoryOwner {
+    fn deep_size_of_children(&self, _context: &mut crate::deepsize::Context) -> usize {
+        0
+    }
+}
+
+impl<T: crate::deepsize::DeepSizeOf> crate::deepsize::DeepSizeOf for MemorySlice<T> {
+    fn deep_size_of_children(&self, context: &mut crate::deepsize::Context) -> usize {
+        if !context.mark_seen(Arc::as_ptr(&self.0) as usize) {
+            return 0;
+        }
+        let storage = match &self.0.storage {
+            Storage::Owned(values) => values.deep_size_of_children(context),
+            Storage::Shared(values) => values.deep_size_of_children(context),
+        };
+        storage + Self::owner_overhead()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::memory::{MemoryBudget, MemoryScope};
+
+    #[test]
+    fn cache_slice_clone_keeps_real_storage_charged_until_final_view_drops() {
+        let budget = Arc::new(MemoryBudget::new(64).unwrap());
+        let slice = {
+            let _scope = MemoryScope::enter(Some(budget.clone()));
+            MemorySlice::from_budgeted_vec(BudgetedVec::try_filled(8, 7_u64).unwrap())
+        };
+        let scheduler_view = slice.clone();
+        drop(slice);
+        assert_eq!(budget.used(), 64);
+        assert_eq!(scheduler_view[7], 7);
+        drop(scheduler_view);
+        assert_eq!(budget.used(), 0);
+    }
+}
