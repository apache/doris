+impl HeapBytes for lance_core::datatypes::Field {
+    fn heap_bytes(&self) -> usize {
+        self.name.capacity()
+            + self.logical_type.allocated_bytes()
+            + self.metadata.heap_bytes()
+            + self.children.heap_bytes()
+    }
+}
+impl HeapBytes for lance_core::datatypes::Schema {
+    fn heap_bytes(&self) -> usize {
+        self.fields.heap_bytes() + self.metadata.heap_bytes()
+    }
+}
+
+impl<T: HeapBytes> HeapBytes for MemoryValue<T> {
+    fn heap_bytes(&self) -> usize {
+        self.as_ref().heap_bytes()
+    }
+}
+
+impl HeapBytes for String {
+    fn heap_bytes(&self) -> usize {
+        self.capacity()
+    }
+}
+impl HeapBytes for Bytes {
+    fn heap_bytes(&self) -> usize {
+        self.len()
+    }
+}
+impl<T: HeapBytes> HeapBytes for Box<T> {
+    fn heap_bytes(&self) -> usize {
+        size_of::<T>() + self.as_ref().heap_bytes()
+    }
+}
+impl<T: HeapBytes> HeapBytes for Option<T> {
+    fn heap_bytes(&self) -> usize {
+        self.as_ref().map(HeapBytes::heap_bytes).unwrap_or(0)
+    }
+}
+impl<T: HeapBytes> HeapBytes for Vec<T> {
+    fn heap_bytes(&self) -> usize {
+        self.capacity() * size_of::<T>() + self.iter().map(HeapBytes::heap_bytes).sum::<usize>()
+    }
+}
+impl<K: HeapBytes + Eq + Hash, V: HeapBytes> HeapBytes for HashMap<K, V> {
+    fn heap_bytes(&self) -> usize {
+        let buckets = if self.capacity() == 0 {
+            0
+        } else {
+            (self.capacity() + 1).next_power_of_two()
+        };
+        let storage = if buckets == 0 {
+            0
+        } else {
+            (buckets * size_of::<(K, V)>() + 15) / 16 * 16 + buckets + 16
+        };
+        storage
+            + self
+                .iter()
+                .map(|(key, value)| key.heap_bytes() + value.heap_bytes())
+                .sum::<usize>()
+    }
+}
+
+use lance_core::memory::protobuf::{FieldKind, WireField, WireSchema};
+
+fn add(left: usize, right: usize) -> Result<usize> {
+    left.checked_add(right)
+        .ok_or_else(|| Error::invalid_input("metadata memory size overflow"))
+}
+fn mul(left: usize, right: usize) -> Result<usize> {
+    left.checked_mul(right)
+        .ok_or_else(|| Error::invalid_input("metadata memory size overflow"))
+}
+
+enum Value<'a> {
+    Scalar,
+    Bytes(&'a [u8]),
+    Group,
+}
+fn varint(bytes: &[u8], pos: &mut usize) -> Result<u64> {
+    let mut value = 0;
+    for shift in (0..70).step_by(7) {
+        let byte = *bytes
+            .get(*pos)
+            .ok_or_else(|| Error::invalid_input("truncated protobuf varint"))?;
+        *pos += 1;
+        if shift == 63 && byte > 1 {
+            return Err(Error::invalid_input("protobuf varint overflow"));
+        }
+        value |= u64::from(byte & 0x7f) << shift;
+        if byte < 0x80 {
+            return Ok(value);
+        }
+    }
+    Err(Error::invalid_input("protobuf varint exceeds ten bytes"))
+}
+fn value<'a>(
+    bytes: &'a [u8],
+    pos: &mut usize,
+    field: u32,
+    wire: u8,
+    depth: usize,
+) -> Result<Value<'a>> {
+    match wire {
+        0 => {
+            varint(bytes, pos)?;
+            Ok(Value::Scalar)
+        }
+        1 | 5 => {
+            *pos = add(*pos, if wire == 1 { 8 } else { 4 })?;
+            if *pos > bytes.len() {
+                return Err(Error::invalid_input("truncated protobuf scalar"));
+            }
+            Ok(Value::Scalar)
+        }
+        2 => {
+            let len = usize::try_from(varint(bytes, pos)?)
+                .map_err(|_| Error::invalid_input("protobuf length overflow"))?;
+            let end = add(*pos, len)?;
+            let data = bytes
+                .get(*pos..end)
+                .ok_or_else(|| Error::invalid_input("truncated protobuf bytes"))?;
+            *pos = end;
+            Ok(Value::Bytes(data))
+        }
+        3 => {
+            if depth >= 100 {
+                return Err(Error::invalid_input("protobuf recursion limit"));
+            }
+            loop {
+                let tag = varint(bytes, pos)?;
+                let child = (tag >> 3) as u32;
+                let child_wire = (tag & 7) as u8;
+                if child_wire == 4 {
+                    if child != field {
+                        return Err(Error::invalid_input("protobuf end group mismatch"));
+                    }
+                    return Ok(Value::Group);
+                }
+                value(bytes, pos, child, child_wire, depth + 1)?;
+            }
+        }
+        _ => Err(Error::invalid_input("invalid protobuf wire type")),
+    }
+}
+
+pub(crate) fn message_peak(name: &str, bytes: &[u8]) -> Result<usize> {
+    if lance_core::memory::MemoryScope::current().is_none() {
+        return Ok(0);
+    }
+    named_peak(name, bytes)
+}
+
+/// Reserve repeated-message/byte storage before any prost decode is started.
+pub(crate) fn reserve_message(name: &str, bytes: &[u8]) -> Result<Option<MemoryReservation>> {
+    if lance_core::memory::MemoryScope::current().is_none() {
+        return Ok(None);
+    }
+    let schema = generated::schema(&name)
+        .ok_or_else(|| Error::not_supported(format!("native metadata admission for {name}")))?;
+    reserve_current(add(schema.size, schema.peak(bytes, 0)?)?)
+}
+
+pub(crate) fn shrink_message<M: HeapBytes>(
+    reservation: Option<MemoryReservation>,
+    value: &M,
+) -> Result<Option<Arc<MemoryOwner>>> {
+    reservation
+        .map(|mut reservation| {
+            reservation.shrink_to(add(size_of::<M>(), value.heap_bytes())?)?;
+            Ok(MemoryOwner::new(reservation))
+        })
+        .transpose()
+}
+
+fn named_peak(name: &str, bytes: &[u8]) -> Result<usize> {
+    let schema = generated::schema(name)
+        .ok_or_else(|| Error::not_supported(format!("native metadata schema {name}")))?;
+    add(schema.size, schema.peak(bytes, 0)?)
+}
+
+fn encoding_peak(encoding: Option<&pbfile::Encoding>, target: &str) -> Result<usize> {
+    let Some(pbfile::encoding::Location::Direct(direct)) =
+        encoding.and_then(|encoding| encoding.location.as_ref())
+    else {
+        return Ok(0);
+    };
+    let bytes = direct.encoding.as_slice();
+    let mut peak = add(bytes.len(), named_peak("google.protobuf.Any", bytes)?)?;
+    let mut position = 0;
+    let mut body = &[][..];
+    while position < bytes.len() {
+        let tag = varint(bytes, &mut position)?;
+        let number = (tag >> 3) as u32;
+        let field = value(bytes, &mut position, number, (tag & 7) as u8, 0)?;
+        if number == 2 {
+            if let Value::Bytes(bytes) = field {
+                body = bytes;
+            }
+        }
+    }
+    peak = add(peak, named_peak(target, body)?)?;
+    Ok(peak)
+}
+
+fn vector_peak<T>(count: usize) -> Result<usize> {
+    mul(mul(count, 3)?.max(4), size_of::<T>())
+}
+
+/// Admit all prost/normalization allocations before a column decoder is invoked.
+pub(crate) fn reserve_column_info(
+    metadata: &pbfile::ColumnMetadata,
+    structural: bool,
+) -> Result<Option<Arc<MemoryOwner>>> {
+    if lance_core::memory::MemoryScope::current().is_none() {
+        return Ok(None);
+    }
+    let mut peak = add(
+        size_of::<ColumnInfo>(),
+        vector_peak::<PageInfo>(metadata.pages.len())?,
+    )?;
+    peak = add(peak, MemorySlice::<PageInfo>::owner_overhead())?;
+    peak = add(
+        peak,
+        vector_peak::<(u64, u64)>(metadata.buffer_offsets.len())?,
+    )?;
+    peak = add(peak, MemorySlice::<(u64, u64)>::owner_overhead())?;
+    peak = add(
+        peak,
+        MemoryValue::<lance_encoding::format::pb::ColumnEncoding>::allocation_bytes(),
+    )?;
+    peak = add(
+        peak,
+        encoding_peak(metadata.encoding.as_ref(), "lance.encodings.ColumnEncoding")?,
+    )?;
+    for page in &metadata.pages {
+        peak = add(
+            peak,
+            if structural {
+                MemoryValue::<lance_encoding::format::pb21::PageLayout>::allocation_bytes()
+            } else {
+                MemoryValue::<lance_encoding::format::pb::ArrayEncoding>::allocation_bytes()
+            },
+        )?;
+        peak = add(peak, vector_peak::<(u64, u64)>(page.buffer_offsets.len())?)?;
+        peak = add(peak, MemorySlice::<(u64, u64)>::owner_overhead())?;
+        peak = add(
+            peak,
+            encoding_peak(
+                page.encoding.as_ref(),
+                if structural {
+                    "lance.encodings21.PageLayout"
+                } else {
+                    "lance.encodings.ArrayEncoding"
+                },
+            )?,
+        )?;
+    }
+    Ok(reserve_current(peak)?.map(MemoryOwner::new))
+}
+
+/// Retain only real payload capacities after temporary decoding buffers are gone.
+pub(crate) fn retain_column_info(
+    owner: Option<Arc<MemoryOwner>>,
+    column: &mut Arc<ColumnInfo>,
+) -> Result<()> {
+    let Some(owner) = owner else {
+        return Ok(());
+    };
+    let column = Arc::get_mut(column)
+        .ok_or_else(|| Error::internal("column metadata was shared before owner attachment"))?;
+    let mut bytes = add(size_of::<ColumnInfo>(), column.page_infos.owned_bytes())?;
+    bytes = add(bytes, column.buffer_offsets_and_sizes.owned_bytes())?;
+    bytes = add(
+        bytes,
+        MemoryValue::<lance_encoding::format::pb::ColumnEncoding>::allocation_bytes(),
+    )?;
+    bytes = add(bytes, column.encoding.heap_bytes())?;
+    for page in column.page_infos.iter() {
+        bytes = add(bytes, page.buffer_offsets_and_sizes.owned_bytes())?;
+        bytes = add(
+            bytes,
+            match &page.encoding {
+                PageEncoding::Legacy(encoding) => add(
+                    MemoryValue::<lance_encoding::format::pb::ArrayEncoding>::allocation_bytes(),
+                    encoding.heap_bytes(),
+                )?,
+                PageEncoding::Structural(encoding) => add(
+                    MemoryValue::<lance_encoding::format::pb21::PageLayout>::allocation_bytes(),
+                    encoding.heap_bytes(),
+                )?,
+            },
+        )?;
+    }
+    owner.shrink_to(bytes)?;
+    column.encoding.retain_owner(owner.clone())?;
+    for page in column.page_infos.get_mut()? {
+        match &mut page.encoding {
+            PageEncoding::Legacy(value) => value.retain_owner(owner.clone())?,
+            PageEncoding::Structural(value) => value.retain_owner(owner.clone())?,
+        }
+        page.buffer_offsets_and_sizes.retain_owner(owner.clone())?;
+    }
+    column.page_infos.retain_owner(owner.clone())?;
+    column
+        .buffer_offsets_and_sizes
+        .retain_owner(owner.clone())?;
+    column.memory_owner = Some(owner);
+    Ok(())
+}
+
+pub(crate) fn reserve_schema(bytes: &[u8]) -> Result<Option<Arc<MemoryOwner>>> {
+    if lance_core::memory::MemoryScope::current().is_none() {
+        return Ok(None);
+    }
+    let mut position = 0;
+    let mut count = 0;
+    while position < bytes.len() {
+        let tag = varint(bytes, &mut position)?;
+        let number = (tag >> 3) as u32;
+        let field = value(bytes, &mut position, number, (tag & 7) as u8, 0)?;
+        if number == 1 {
+            if let Value::Bytes(schema) = field {
+                let mut position = 0;
+                while position < schema.len() {
+                    let tag = varint(schema, &mut position)?;
+                    let number = (tag >> 3) as u32;
+                    let field = value(schema, &mut position, number, (tag & 7) as u8, 0)?;
+                    if number == 1 {
+                        if let Value::Bytes(_) = field {
+                            count = add(count, 1)?;
+                        }
+                    }
+                }
+            }
+        }
+    }
+    type Field = lance_core::datatypes::Field;
+    // Schema reconstruction keeps an arena, optional materialization slots,
+    // nested/root destination vectors, and field-id/child-index lookup storage.
+    let nodes = mul(count, add(size_of::<Field>(), size_of::<Vec<usize>>())?)?;
+    let slots = mul(count, size_of::<Option<Field>>())?;
+    let fields = mul(mul(count, 4)?, size_of::<Field>())?;
+    let indices = mul(mul(count, 6)?, size_of::<usize>())?;
+    let buckets = if count == 0 {
+        0
+    } else {
+        add(mul(count, 8)?, 6)?
+            .checked_div(7)
+            .and_then(usize::checked_next_power_of_two)
+            .ok_or_else(|| Error::invalid_input("schema field map capacity overflow"))?
+            .max(4)
+    };
+    let field_map = if buckets == 0 {
+        0
+    } else {
+        add(
+            add(mul(buckets, size_of::<(i32, Option<usize>)>())?, 15)? / 16 * 16,
+            add(buckets, 16)?,
+        )?
+    };
+    // Wire preflight accounts declared fields/bytes, not an encoded-size proxy.
+    // Raw protobuf payloads, converted strings, and lossy UTF-8 conversion scratch
+    // can coexist. Each has this independently bounded payload allowance.
+    let mut peak = mul(named_peak("lance.file.FileDescriptor", bytes)?, 3)?;
+    for bytes in [nodes, slots, fields, indices, field_map] {
+        peak = add(peak, bytes)?;
+    }
+    Ok(reserve_current(peak)?.map(MemoryOwner::new))
+}
+
+pub(crate) fn retain_schema(
+    owner: Option<Arc<MemoryOwner>>,
+    schema: &mut lance_core::datatypes::Schema,
+) -> Result<()> {
+    if let Some(owner) = owner {
+        owner.shrink_to(add(
+            size_of::<lance_core::datatypes::Schema>(),
+            schema.heap_bytes(),
+        )?)?;
+        schema.memory_owner = Some(owner);
+    }
+    Ok(())
+}
+
+/// Peak storage used while rebuilding a flat protobuf schema into its field tree.
+pub(crate) fn schema_conversion_admission(
+    fields: &[crate::format::pb::Field],
+    metadata: &HashMap<String, Vec<u8>>,
+) -> Result<usize> {
+    type Field = lance_core::datatypes::Field;
+    let count = fields.len();
+    let mut peak = mul(
+        count,
+        size_of::<Field>()
+            + size_of::<Vec<usize>>()
+            + size_of::<Option<Field>>()
+            + 4 * size_of::<Field>()
+            + 6 * size_of::<usize>(),
+    )?;
+    peak = add(peak, map_peak::<i32, Option<usize>>(count)?)?;
+    peak = add(peak, metadata_conversion(metadata, false)?)?;
+    for field in fields {
+        peak = add(peak, add(field.name.len(), field.logical_type.len())?)?;
+        peak = add(
+            peak,
+            metadata_conversion(&field.metadata, !field.extension_name.is_empty())?,
+        )?;
+        if !field.extension_name.is_empty() {
+            peak = add(
+                peak,
+                lance_arrow::ARROW_EXT_NAME_KEY.len() + field.extension_name.len(),
+            )?;
+        }
+    }
+    Ok(peak)
+}
+fn map_peak<K, V>(count: usize) -> Result<usize> {
+    if count == 0 {
+        return Ok(0);
+    }
+    let buckets = add(mul(count, 8)?, 6)?
+        .checked_div(7)
+        .and_then(usize::checked_next_power_of_two)
+        .ok_or_else(|| Error::invalid_input("metadata table capacity overflow"))?
+        .max(4);
+    mul(
+        add(
+            add(mul(buckets, size_of::<(K, V)>())?, 15)? / 16 * 16,
+            add(buckets, 16)?,
+        )?,
+        3,
+    )
+}
+fn metadata_conversion(metadata: &HashMap<String, Vec<u8>>, extension: bool) -> Result<usize> {
+    let mut peak = map_peak::<String, String>(metadata.len() + usize::from(extension))?;
+    for (key, value) in metadata {
+        peak = add(peak, add(key.len(), mul(value.len(), 6)?)?)?;
+    }
+    Ok(peak)
+}
