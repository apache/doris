+#[cfg(test)]
+mod memory_tests {
+    use super::*;
+    use crate::object_store::memory::{BudgetedObjectStore, is_memory_error};
+    use object_store::memory::InMemory;
+
+    async fn reader(bytes: usize) -> CloudObjectReader {
+        let store = Arc::new(InMemory::new());
+        let path = Path::from("stream-memory");
+        store
+            .put(&path, Bytes::from(vec![7; bytes]).into())
+            .await
+            .unwrap();
+        CloudObjectReader::new(BudgetedObjectStore::wrap(store), path, 8192, Some(bytes), 3)
+            .unwrap()
+    }
+
+    #[tokio::test]
+    async fn cloud_stream_reads_more_than_budget_with_owned_chunks() {
+        let reader = reader(8 * 8192 + 17).await;
+        let owner = Arc::new(MemoryBudget::new(2 * 8192).unwrap());
+        let future = {
+            let _scope = MemoryScope::enter(Some(owner.clone()));
+            reader.get_stream()
+        };
+        let mut stream = future.await.unwrap();
+        assert!(MemoryScope::current().is_none());
+        let foreign = Arc::new(MemoryBudget::new(1).unwrap());
+        let mut total = 0;
+        while let Some(chunk) = BudgetedFuture::new(Some(foreign.clone()), stream.next()).await {
+            let chunk = chunk.unwrap();
+            assert_eq!(owner.used(), chunk.len());
+            assert!(chunk.iter().all(|byte| *byte == 7));
+            total += chunk.len();
+            drop(chunk);
+            assert_eq!(owner.used(), 0);
+            assert_eq!(foreign.used(), 0);
+        }
+        assert_eq!(total, 8 * 8192 + 17);
+        drop(stream);
+        assert_eq!(owner.used(), 0);
+    }
+
+    #[tokio::test]
+    async fn cloud_stream_slice_outlives_stream_and_cancellation() {
+        let reader = reader(3 * 8192).await;
+        let owner = Arc::new(MemoryBudget::new(2 * 8192).unwrap());
+        let mut stream = {
+            let _scope = MemoryScope::enter(Some(owner.clone()));
+            reader.get_range_stream(4096..2 * 8192)
+        }
+        .await
+        .unwrap();
+        let chunk = stream.next().await.unwrap().unwrap();
+        let slice = chunk.slice(17..29);
+        drop(chunk);
+        owner.cancel();
+        let error = stream.next().await.unwrap().unwrap_err();
+        assert!(is_memory_error(&error));
+        drop(stream);
+        assert_eq!(owner.used(), 8192);
+        assert_eq!(&slice[..], &[7; 12]);
+        drop(slice);
+        assert_eq!(owner.used(), 0);
+    }
+
+    #[tokio::test]
+    async fn cloud_stream_rejects_before_first_chunk_and_empty_stream_allocates_nothing() {
+        let reader = reader(8192).await;
+        let owner = Arc::new(MemoryBudget::new(2 * 8192 - 1).unwrap());
+        let mut stream = {
+            let _scope = MemoryScope::enter(Some(owner.clone()));
+            reader.get_stream()
+        }
+        .await
+        .unwrap();
+        let error = stream.next().await.unwrap().unwrap_err();
+        assert!(is_memory_error(&error));
+        assert_eq!(owner.used(), 0);
+        drop(stream);
+
+        let empty = self::reader(0).await;
+        let owner = Arc::new(MemoryBudget::new(0).unwrap());
+        let mut stream = {
+            let _scope = MemoryScope::enter(Some(owner.clone()));
+            empty.get_stream()
+        }
+        .await
+        .unwrap();
+        assert!(stream.next().await.is_none());
+        assert_eq!(owner.used(), 0);
+    }
+
+    #[tokio::test]
+    async fn local_stream_keeps_its_owner_outside_the_submitting_scope() {
+        let file = tempfile::NamedTempFile::new().unwrap();
+        std::fs::write(file.path(), vec![7; 3 * 8192]).unwrap();
+        let reader = crate::local::LocalObjectReader::open_local_path(file.path(), 8192, None)
+            .await
+            .unwrap();
+        let owner = Arc::new(MemoryBudget::new(8192).unwrap());
+        let mut stream = {
+            let _scope = MemoryScope::enter(Some(owner.clone()));
+            reader.get_stream()
+        }
+        .await
+        .unwrap();
+        let chunk = stream.next().await.unwrap().unwrap();
+        let slice = chunk.slice(5..11);
+        drop(chunk);
+        assert_eq!(owner.used(), 8192);
+        // The first physical buffer is still borrowed. A second allocation
+        // must fail even though the polling thread has no active scope.
+        assert!(is_memory_error(&stream.next().await.unwrap().unwrap_err()));
+        drop((reader, stream));
+        assert_eq!(owner.used(), 8192);
+        assert_eq!(&slice[..], &[7; 6]);
+        drop(slice);
+        assert_eq!(owner.used(), 0);
+    }
+
+    #[tokio::test]
+    async fn small_reader_repeated_error_keeps_native_memory_kind() {
+        let raw = Arc::new(InMemory::new());
+        let path = Path::from("small-memory");
+        raw.put(&path, Bytes::from_static(&[7; 16]).into())
+            .await
+            .unwrap();
+        let reader = SmallReader::new(BudgetedObjectStore::wrap(raw), path, 3, 16);
+        let owner = Arc::new(MemoryBudget::new(31).unwrap());
+        for _ in 0..2 {
+            let error = BudgetedFuture::new(Some(owner.clone()), reader.get_all())
+                .await
+                .unwrap_err();
+            assert!(is_memory_error(&error), "{error:?}");
+            assert_eq!(owner.used(), 0);
+        }
+    }
