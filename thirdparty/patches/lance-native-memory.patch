+
+fn freeze_profile_origin(storage_options: &mut StorageOptions, profile_config: Option<&SdkConfig>) {
+    if uses_opendal(storage_options) || storage_options.0.contains_key(RESOLVED_PROFILE_ORIGIN) {
+        return;
+    }
+    let resolved = ResolvedS3StorageOptions::new(storage_options.as_s3_options(), profile_config);
