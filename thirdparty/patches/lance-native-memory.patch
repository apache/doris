+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright The Lance Authors
+
+//! Bridge DataFusion's fallible reservations to the native query owner.
+
+use std::fmt::{self, Display};
+use std::sync::atomic::{AtomicUsize, Ordering};
+use std::sync::{Arc, Mutex};
+
+use datafusion::execution::memory_pool::{MemoryLimit, MemoryPool, MemoryReservation};
+use datafusion_common::{DataFusionError, Result};
+use lance_core::memory::{MemoryBudget, MemoryReservation as NativeReservation};
+
+#[derive(Debug)]
+pub(crate) struct NativeMemoryPool {
+    inner: Arc<dyn MemoryPool>,
+    owner: Arc<MemoryBudget>,
+    lease: Mutex<Option<NativeReservation>>,
+    reserved: AtomicUsize,
+}
+
+impl NativeMemoryPool {
+    pub(crate) fn new(inner: Arc<dyn MemoryPool>, owner: Arc<MemoryBudget>) -> Self {
+        Self {
+            inner,
+            owner,
+            lease: Mutex::new(None),
+            reserved: AtomicUsize::new(0),
+        }
+    }
+}
+
+impl Display for NativeMemoryPool {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str(self.name())
+    }
+}
+
+impl MemoryPool for NativeMemoryPool {
+    fn name(&self) -> &str {
+        "LanceNativeMemoryPool"
+    }
+
+    fn register(&self, consumer: &datafusion::execution::memory_pool::MemoryConsumer) {
+        self.inner.register(consumer);
+    }
+    fn unregister(&self, consumer: &datafusion::execution::memory_pool::MemoryConsumer) {
+        self.inner.unregister(consumer);
+    }
+
+    fn grow(&self, _: &MemoryReservation, additional: usize) {
+        // Lance's scan/search plans use fallible growth. The only positive
+        // infallible-growth operators in pinned DataFusion are nested-loop
+        // and sort-merge joins, rejected before native plan execution.
+        assert_eq!(
+            additional, 0,
+            "native plans must use fallible DataFusion memory growth"
+        );
+    }
+
+    fn try_grow(&self, reservation: &MemoryReservation, additional: usize) -> Result<()> {
+        self.inner.try_grow(reservation, additional)?;
+        if additional == 0 {
+            return Ok(());
+        }
+        let mut lease = self
+            .lease
+            .lock()
+            .expect("native DataFusion lease lock must not be poisoned");
+        let admitted = match lease.as_mut() {
+            Some(lease) => lease.try_grow(additional),
+            None => self.owner.reserve(additional).map(|token| {
+                *lease = Some(token);
+            }),
+        };
+        if let Err(error) = admitted {
+            self.inner.shrink(reservation, additional);
+            return Err(DataFusionError::External(Box::new(error)));
+        }
+        self.reserved.fetch_add(additional, Ordering::AcqRel);
+        Ok(())
+    }
+
+    fn shrink(&self, reservation: &MemoryReservation, bytes: usize) {
+        self.inner.shrink(reservation, bytes);
+        if bytes == 0 {
+            return;
+        }
+        let mut lease = self
+            .lease
+            .lock()
+            .expect("native DataFusion lease lock must not be poisoned");
+        let token = lease
+            .as_mut()
+            .expect("DataFusion cannot release unreserved bytes");
+        let retained = token
+            .bytes()
+            .checked_sub(bytes)
+            .expect("DataFusion reservation release must not underflow");
+        token
+            .shrink_to(retained)
+            .expect("shrinking an existing reservation cannot fail");
+        self.reserved.fetch_sub(bytes, Ordering::AcqRel);
+    }
+
+    fn reserved(&self) -> usize {
+        self.reserved.load(Ordering::Acquire)
+    }
+    fn memory_limit(&self) -> MemoryLimit {
+        MemoryLimit::Finite(self.owner.limit())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use datafusion::execution::memory_pool::{GreedyMemoryPool, MemoryConsumer};
+    use lance_core::memory::MemoryError;
+
+    #[test]
+    fn query_denial_rolls_back_datafusion_and_split_releases_exactly() {
+        let owner = Arc::new(MemoryBudget::new(32).unwrap());
+        let inner = Arc::new(GreedyMemoryPool::new(1024));
+        let pool: Arc<dyn MemoryPool> =
+            Arc::new(NativeMemoryPool::new(inner.clone(), owner.clone()));
+        let reservation = MemoryConsumer::new("native-test").register(&pool);
+        reservation.try_grow(24).unwrap();
+        let error = reservation.try_grow(16).unwrap_err();
+        assert!(matches!(
+            MemoryError::find_in_chain(&error),
+            Some(MemoryError::LimitExceeded { .. })
+        ));
+        assert_eq!(
+            (owner.used(), inner.reserved(), pool.reserved()),
+            (24, 24, 24)
+        );
+        let escaped = reservation.split(8);
+        drop(reservation);
+        assert_eq!(owner.used(), 8);
+        drop(escaped);
+        assert_eq!((owner.used(), inner.reserved(), pool.reserved()), (0, 0, 0));
+    }
+    #[test]
+    fn zero_growth_does_not_allocate_and_independent_consumers_release_exactly() {
+        let owner = Arc::new(MemoryBudget::new(128).unwrap());
+        let pool: Arc<dyn MemoryPool> = Arc::new(NativeMemoryPool::new(
+            Arc::new(GreedyMemoryPool::new(128)),
+            owner.clone(),
+        ));
+        let zero = MemoryConsumer::new("zero").register(&pool);
+        for _ in 0..100_000 {
+            zero.try_grow(0).unwrap();
+        }
+        assert_eq!((owner.used(), pool.reserved()), (0, 0));
+        std::thread::scope(|threads| {
+            let pool = &pool;
+            for index in 0..8 {
+                threads.spawn(move || {
+                    let reservation =
+                        MemoryConsumer::new(format!("parallel-{index}")).register(pool);
+                    for _ in 0..100 {
+                        reservation.try_grow(8).unwrap();
+                        let split = reservation.split(4);
+                        reservation.shrink(4);
+                        drop(split);
+                    }
+                });
+            }
+        });
+        assert_eq!((owner.used(), pool.reserved()), (0, 0));
+    }
+}
+
+/// Admit DFSchema's qualifier slab and, when requested, Arrow Schema's cloned
+/// top-level metadata. FieldRef trees remain shared by Arrow's Schema::clone.
+pub fn reserve_dfschema(
+    schema: &arrow_schema::Schema,
+    clone_metadata: bool,
+) -> lance_core::Result<Option<NativeReservation>> {
+    use lance_core::memory::{MemoryScope, reserve_current};
+    use std::mem::size_of;
+    if MemoryScope::current().is_none() {
+        return Ok(None);
+    }
+    let overflow = || lance_core::Error::invalid_input("DataFusion schema allocation overflow");
+    let mut bytes = schema
+        .fields()
+        .len()
+        .checked_mul(size_of::<Option<datafusion_common::TableReference>>())
+        .and_then(|bytes| bytes.checked_add(2 * size_of::<datafusion_common::DFSchema>()))
+        .ok_or_else(overflow)?;
+    if clone_metadata && !schema.metadata().is_empty() {
+        let buckets = schema
+            .metadata()
+            .capacity()
+            .checked_add(1)
+            .and_then(usize::checked_next_power_of_two)
+            .ok_or_else(overflow)?;
+        bytes = bytes
+            .checked_add(
+                buckets
+                    .checked_mul(size_of::<(String, String)>())
+                    .and_then(|data| data.checked_add(buckets + 31))
+                    .ok_or_else(overflow)?,
+            )
+            .ok_or_else(overflow)?;
+        for (key, value) in schema.metadata() {
+            bytes = bytes
+                .checked_add(key.len())
+                .and_then(|bytes| bytes.checked_add(value.len()))
+                .ok_or_else(overflow)?;
+        }
+    }
+    reserve_current(bytes)
+}
