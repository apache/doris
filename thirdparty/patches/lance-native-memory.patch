index 0000000000000000000000000000000000000000..290d69c7496ae36b73ee2e826941f66c5d698c4c
--- /dev/null
+++ b/rust/lance-encoding/src/encodings/physical/budgeted_zstd.rs
@@ -0,0 +1,227 @@
+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright The Lance Authors
+
+//! A per-decoder C allocator; rejection is reported by zstd, without unwinding
+//! through a C callback or changing Rust's process allocator.
+
+use std::alloc::{Layout, alloc, dealloc};
+use std::ffi::{CStr, c_void};
+use std::ptr::NonNull;
+use std::sync::Arc;
+
+use lance_core::memory::{BudgetedVec, MemoryBudget, MemoryError, MemoryReservation, MemoryScope};
+use lance_core::{Error, Result};
+use zstd::zstd_safe::zstd_sys;
+
+use crate::buffer::LanceBuffer;
+
+struct Allocator {
+    owner: Option<Arc<MemoryBudget>>,
+    error: Option<Error>,
+}
+
+struct Allocation {
+    layout: Layout,
+    reservation: Option<MemoryReservation>,
+}
+
+// zstd requires malloc alignment. Cache-line alignment also accommodates the
+// prefix that retains each independent allocation's release token.
+const ALIGNMENT: usize = 64;
+const PREFIX: usize = std::mem::size_of::<Allocation>().next_multiple_of(ALIGNMENT);
+
+unsafe extern "C" fn allocate(context: *mut c_void, bytes: usize) -> *mut c_void {
+    // SAFETY: Decoder owns a stable Box<Allocator> through ZSTD_freeDCtx; zstd
+    // invokes its allocation callbacks synchronously on the decoder's thread.
+    let context = unsafe { &mut *context.cast::<Allocator>() };
+    let result = (|| -> Result<*mut c_void> {
+        let size = PREFIX
+            .checked_add(bytes)
+            .ok_or_else(|| Error::invalid_input("zstd allocation size overflow"))?;
+        let layout = Layout::from_size_align(size, ALIGNMENT)
+            .map_err(|error| Error::invalid_input(format!("invalid zstd allocation: {error}")))?;
+        let reservation = context
+            .owner
+            .as_ref()
+            .map(|owner| owner.reserve(size))
+            .transpose()?;
+        // SAFETY: layout is valid and nonempty. A null pointer is returned to
+        // zstd as an ordinary allocation failure, after rolling admission back.
+        let pointer = NonNull::new(unsafe { alloc(layout) })
+            .ok_or(MemoryError::AllocationFailed { bytes: size })?;
+        // SAFETY: PREFIX is aligned and large enough for Allocation. Both the
+        // prefix and returned payload belong to this one allocation.
+        unsafe {
+            pointer.cast::<Allocation>().as_ptr().write(Allocation {
+                layout,
+                reservation,
+            });
+            Ok(pointer.as_ptr().add(PREFIX).cast())
+        }
+    })();
+    match result {
+        Ok(pointer) => pointer,
+        Err(error) => {
+            context.error = Some(error);
+            std::ptr::null_mut()
+        }
+    }
+}
+
+unsafe extern "C" fn free(_context: *mut c_void, pointer: *mut c_void) {
+    if pointer.is_null() {
+        return;
+    }
+    // SAFETY: zstd only passes allocations made by allocate. Reading the prefix
+    // moves its reservation out before the underlying storage is deallocated.
+    let (base, allocation) = unsafe {
+        let base = pointer.cast::<u8>().sub(PREFIX);
+        (base, base.cast::<Allocation>().read())
+    };
+    // SAFETY: allocation records the exact original layout.
+    unsafe { dealloc(base, allocation.layout) };
+    // Keep admission through the physical free, then return it to its owner.
+    drop(allocation.reservation);
+}
+
+struct Decoder {
+    decoder: NonNull<zstd_sys::ZSTD_DCtx>,
+    allocator: Box<Allocator>,
+}
+
+impl Decoder {
+    fn new() -> Result<Self> {
+        let mut allocator = Box::new(Allocator {
+            owner: MemoryScope::current(),
+            error: None,
+        });
+        let callbacks = zstd_sys::ZSTD_customMem {
+            customAlloc: Some(allocate),
+            customFree: Some(free),
+            opaque: allocator.as_mut() as *mut Allocator as *mut c_void,
+        };
+        // SAFETY: callbacks satisfy zstd's malloc/free contract and allocator's
+        // Box remains stable until after ZSTD_freeDCtx.
+        let decoder = unsafe { zstd_sys::ZSTD_createDCtx_advanced(callbacks) };
+        let decoder = NonNull::new(decoder).ok_or_else(|| {
+            allocator
+                .error
+                .take()
+                .unwrap_or_else(|| MemoryError::AllocationFailed { bytes: 0 }.into())
+        })?;
+        Ok(Self { decoder, allocator })
+    }
+
+    fn check(&mut self, result: usize) -> Result<usize> {
+        if let Some(error) = self.allocator.error.take() {
+            return Err(error);
+        }
+        // SAFETY: zstd's error helpers accept any returned size_t code.
+        if unsafe { zstd_sys::ZSTD_isError(result) } != 0 {
+            let message = unsafe { CStr::from_ptr(zstd_sys::ZSTD_getErrorName(result)) };
+            return Err(Error::io(format!(
+                "zstd decompression failed: {}",
+                message.to_string_lossy()
+            )));
+        }
+        Ok(result)
+    }
+}
+
+impl Drop for Decoder {
+    fn drop(&mut self) {
+        // SAFETY: this uniquely owned decoder is freed once, while allocator
+        // still exists and can release all context and window allocations.
+        unsafe { zstd_sys::ZSTD_freeDCtx(self.decoder.as_ptr()) };
+    }
+}
+
+pub(super) fn decompress(input: &[u8], length_prefix: Option<usize>) -> Result<LanceBuffer> {
+    if input.is_empty() && length_prefix.is_none() {
+        return Ok(LanceBuffer::empty());
+    }
+    let mut decoder = Decoder::new()?;
+    if let Some(len) = length_prefix {
+        let mut output = BudgetedVec::try_filled(len, 0_u8)?;
+        // SAFETY: both buffers remain valid throughout the synchronous call;
+        // zstd is passed the admitted output capacity and cannot grow it.
+        let written = unsafe {
+            zstd_sys::ZSTD_decompressDCtx(
+                decoder.decoder.as_ptr(),
+                output.as_mut_ptr().cast(),
+                output.len(),
+                input.as_ptr().cast(),
+                input.len(),
+            )
+        };
+        let written = decoder.check(written)?;
+        output.truncate(written);
+        return Ok(LanceBuffer::from_budgeted_vec(output));
+    }
+
+    let mut output = BudgetedVec::try_with_capacity(0)?;
+    let mut input = zstd_sys::ZSTD_inBuffer {
+        src: input.as_ptr().cast(),
+        size: input.len(),
+        pos: 0,
+    };
+    let mut remaining = 1;
+    while input.pos < input.size || remaining != 0 {
+        // Scratch space is on the existing execution stack. Decoder-owned
+        // heap windows and output capacity are independently budgeted.
+        let mut scratch = [0_u8; 64 * 1024];
+        let mut buffer = zstd_sys::ZSTD_outBuffer {
+            dst: scratch.as_mut_ptr().cast(),
+            size: scratch.len(),
+            pos: 0,
+        };
+        let prior_input = input.pos;
+        // SAFETY: zstd only borrows these valid input/output buffers for this
+        // call, and updates their positions within their declared capacities.
+        let status = unsafe {
+            zstd_sys::ZSTD_decompressStream(decoder.decoder.as_ptr(), &mut buffer, &mut input)
+        };
+        remaining = decoder.check(status)?;
+        output.try_extend_from_slice(&scratch[..buffer.pos])?;
+        if remaining != 0 && input.pos == prior_input && buffer.pos == 0 {
+            return Err(Error::io("truncated zstd stream"));
+        }
+    }
+    Ok(LanceBuffer::from_budgeted_vec(output))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn decoder_workspace_is_rejected_and_released_before_output() {
+        let compressed = zstd::bulk::compress(&[7; 64 * 1024], 1).unwrap();
+        let owner = Arc::new(MemoryBudget::new(1).unwrap());
+        let _scope = MemoryScope::enter(Some(owner.clone()));
+        let error = decompress(&compressed, Some(64 * 1024)).unwrap_err();
+        assert!(matches!(
+            MemoryError::find_in_chain(&error),
+            Some(MemoryError::LimitExceeded { .. })
+        ));
+        assert_eq!(owner.used(), 0);
+    }
+
+    #[test]
+    fn decoder_window_and_output_have_distinct_lifetimes() {
+        let input = vec![7; 64 * 1024];
+        let compressed = zstd::bulk::compress(&input, 1).unwrap();
+        let owner = Arc::new(MemoryBudget::new(4 * 1024 * 1024).unwrap());
+        let output = {
+            let _scope = MemoryScope::enter(Some(owner.clone()));
+            decompress(&compressed, None).unwrap()
+        };
+        assert_eq!(output.as_ref(), input);
+        assert_eq!(owner.used(), input.len());
+        let slice = output.slice_with_length(0, 1);
+        drop(output);
+        assert_eq!(owner.used(), input.len());
+        drop(slice);
+        assert_eq!(owner.used(), 0);
+    }
+}
