+#[cfg(test)]
+mod schema_memory_tests {
+    use super::*;
+    use lance_core::memory::{MemoryBudget, MemoryError, MemoryScope};
+    fn schema() -> Schema {
+        Schema::try_from(&ArrowSchema::new(vec![ArrowField::new(
+            "metadata".repeat(128),
+            DataType::Int64,
+            true,
+        )]))
+        .unwrap()
+    }
+    #[test]
+    fn decode_schema_rejection_precedes_stream_or_iterator_construction() {
+        let schema = schema();
+        let budget = Arc::new(MemoryBudget::new(64).unwrap());
+        let _scope = MemoryScope::enter(Some(budget.clone()));
+        let (_, rx) = mpsc::unbounded_channel();
+        let error = create_decode_stream(&schema, 1, 1, true, false, false, rx, None)
+            .err()
+            .unwrap();
+        assert!(MemoryError::find_in_chain(&error).is_some());
+        let error = create_decode_iterator(&schema, 1, 1, false, false, VecDeque::new())
+            .err()
+            .unwrap();
+        assert!(MemoryError::find_in_chain(&error).is_some());
+        assert_eq!(budget.used(), 0);
+    }
+    #[test]
+    fn decode_stream_and_iterator_retain_schema_until_drop() {
+        let schema = schema();
+        let budget = Arc::new(MemoryBudget::new(1 << 20).unwrap());
+        let (stream, iterator) = {
+            let _scope = MemoryScope::enter(Some(budget.clone()));
+            let (_, rx) = mpsc::unbounded_channel();
+            (
+                create_decode_stream(&schema, 1, 1, true, false, false, rx, None).unwrap(),
+                create_decode_iterator(&schema, 1, 1, false, false, VecDeque::new()).unwrap(),
+            )
+        };
+        let used = budget.used();
+        assert!(used > 0);
+        drop(stream);
+        assert!(budget.used() > 0 && budget.used() < used);
+        drop(iterator);
+        assert_eq!(budget.used(), 0);
+    }
+}
