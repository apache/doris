+#[cfg(test)]
+mod tests {
+    use super::*;
+    use lance_core::memory::{MemoryBudget, MemoryError, MemoryScope};
+    use lance_encoding::format::{pb, pb21};
+    use prost::Message;
+
+    fn direct<M: prost::Message + prost::Name>(message: &M) -> pbfile::Encoding {
+        pbfile::Encoding {
+            location: Some(pbfile::encoding::Location::Direct(pbfile::DirectEncoding {
+                encoding: prost_types::Any::from_msg(message).unwrap().encode_to_vec(),
+            })),
+        }
+    }
+
+    fn column() -> pbfile::ColumnMetadata {
+        let layout = pb21::PageLayout {
+            layout: Some(pb21::page_layout::Layout::ConstantLayout(
+                pb21::ConstantLayout {
+                    layers: vec![0; 1024],
+                    ..Default::default()
+                },
+            )),
+        };
+        pbfile::ColumnMetadata {
+            encoding: Some(direct(&pb::ColumnEncoding {
+                column_encoding: Some(pb::column_encoding::ColumnEncoding::Values(())),
+            })),
+            pages: vec![pbfile::column_metadata::Page {
+                buffer_offsets: vec![0, 64],
+                buffer_sizes: vec![16, 32],
+                length: 3,
+                encoding: Some(direct(&layout)),
+                priority: 0,
+            }],
+            buffer_offsets: vec![128],
+            buffer_sizes: vec![16],
+        }
+    }
+
+    #[test]
+    fn protobuf_repeated_fields_are_rejected_before_decode() {
+        let metadata = pbfile::ColumnMetadata {
+            pages: vec![Default::default(); 2048],
+            ..Default::default()
+        };
+        let bytes = metadata.encode_to_vec();
+        let budget = Arc::new(MemoryBudget::new(64).unwrap());
+        let _scope = MemoryScope::enter(Some(budget.clone()));
+        let error = reserve_message("lance.file.v2.ColumnMetadata", &bytes).unwrap_err();
+        assert!(MemoryError::find_in_chain(&error).is_some());
+        assert_eq!(budget.used(), 0);
+    }
+
+    #[test]
+    fn normalized_page_and_tuple_views_keep_the_decode_owner() {
+        let metadata = column();
+        let budget = Arc::new(MemoryBudget::new(1 << 20).unwrap());
+        let column = {
+            let _scope = MemoryScope::enter(Some(budget.clone()));
+            crate::versions::decode_column_metadata(
+                crate::version::ConcreteFileVersion::V2_2,
+                std::slice::from_ref(&metadata),
+            )
+            .unwrap()[0]
+                .clone()
+        };
+        let pages = column.page_infos.clone();
+        let tuples = pages[0].buffer_offsets_and_sizes.clone();
+        let resident = budget.used();
+        assert!(resident >= 1024 * size_of::<i32>());
+        drop(column);
+        assert_eq!(budget.used(), resident);
+        drop(pages);
+        assert_eq!(budget.used(), resident);
+        assert_eq!(tuples.as_slice(), &[(0, 16), (64, 32)]);
+        drop(tuples);
+        assert_eq!(budget.used(), 0);
+    }
+
+    #[test]
+    fn raw_protobuf_owner_survives_independent_metadata_slice() {
+        let source = column().encode_to_vec();
+        let budget = Arc::new(MemoryBudget::new(1 << 20).unwrap());
+        let mut slice = {
+            let _scope = MemoryScope::enter(Some(budget.clone()));
+            let admission = reserve_message("lance.file.v2.ColumnMetadata", &source).unwrap();
+            let decoded = pbfile::ColumnMetadata::decode(source.as_slice()).unwrap();
+            let owner = shrink_message(admission, &decoded).unwrap().unwrap();
+            let mut slice = MemorySlice::from(vec![decoded]);
+            slice.retain_owner(owner).unwrap();
+            slice
+        };
+        let view = slice.clone();
+        slice = MemorySlice::default();
+        assert!(budget.used() > 0);
+        assert_eq!(view[0].pages.len(), 1);
+        drop(view);
+        assert_eq!(budget.used(), 0);
+        drop(slice);
+    }
+}
