+                .unwrap()
+                .with_accountant(accountant.clone()),
+        );
+        let reservation = budget.reserve(16).unwrap();
+        let error = budget.reserve(1).unwrap_err();
+        assert_eq!(
+            memory_error(&error),
+            &MemoryError::LimitExceeded {
+                requested: 1,
+                used: 16,
+                limit: 16,
+            }
+        );
+        assert!(error.to_string().contains("requested=1, used=16, limit=16"));
+        assert_eq!(budget.used(), 16);
+        assert_eq!(accountant.calls.load(Ordering::Relaxed), 1);
+        drop(reservation);
+        assert_eq!(budget.used(), 0);
+        assert_eq!(accountant.used.load(Ordering::Acquire), 0);
+    }
+
+    #[test]
