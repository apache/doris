diff --git a/tools/generate-metadata-memory.py b/tools/generate-metadata-memory.py
new file mode 100755
index 0000000000000000000000000000000000000000..a3e7e765ba7815ae6d2927c1e6a5b7a19537195b
--- /dev/null
+++ b/tools/generate-metadata-memory.py
@@ -0,0 +1,108 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright The Lance Authors
+"""Regenerate protobuf memory descriptors from this repository's pinned protos.
+
+Requires Python protobuf 6.31.1, protoc, and rustfmt; see metadata-memory-generation.md.
+"""
+import argparse
+import os
+from pathlib import Path
+import re
+import subprocess
+import tempfile
+
+from google.protobuf import descriptor_pb2 as d
+
+parser = argparse.ArgumentParser(description=__doc__)
+parser.add_argument("--kind", choices=["file", "table"], required=True)
+parser.add_argument("--protoc", default=os.environ.get("PROTOC", "protoc"))
+parser.add_argument("--include", default=os.environ.get("PROTOC_INCLUDE"))
+parser.add_argument("--rustfmt", default=os.environ.get("RUSTFMT", "rustfmt"))
+args = parser.parse_args()
+root = Path(__file__).resolve().parents[1]
+proto_root = root / "protos"
+if args.kind == "file":
+    inputs = ["file.proto", "file2.proto", "encodings_v2_0.proto", "encodings_v2_1.proto"]
+else:
+    inputs = ["table.proto", "transaction.proto", "rowids.proto"]
+prefix = {
+    "lance.file": "crate::format::pb" if args.kind == "file" else "lance_file::format::pb",
+    "lance.file.v2": "crate::format::pbfile",
+    "lance.encodings": "lance_encoding::format::pb",
+    "lance.encodings21": "lance_encoding::format::pb21",
+    "lance.table": "crate::format::pb",
+    "google.protobuf": "prost_types",
+}
+working = root / "target" / "metadata-memory-generator"
+working.mkdir(parents=True, exist_ok=True)
+with tempfile.TemporaryDirectory(dir=working) as directory:
+    descriptor = Path(directory) / "descriptors.pb"
+    command = [args.protoc, "--include_imports", "--descriptor_set_out=" + str(descriptor), "-I", str(proto_root)]
+    if args.include:
+        command.extend(["-I", args.include])
+    subprocess.run(command + [str(proto_root / name) for name in inputs], check=True)
+    files = d.FileDescriptorSet.FromString(descriptor.read_bytes()).file
+
+def words(s):
+ parts=re.findall('[A-Z]+(?=[A-Z][a-z]|[0-9]|$)|[A-Z]?[a-z]+|[0-9]+',s)
+ merged=[]
+ for part in parts:
+  if part.isdigit() and merged and merged[-1] in ('U','I','F'):merged[-1]+=part
+  else:merged.append(part)
+ return merged
+
+def snake(s): return '_'.join(w.lower() for w in words(s))
+def pascal(s): return ''.join(w.title() for w in words(s))
+def ident(s): return 'r#'+s if s in {'type','match','ref','in','enum','struct','fn','pub','impl','self','move','use','where'} else s
+nodes={}
+def walk(f,m,parents):
+ full='.'+f.package+'.'+'.'.join(parents+[m.name]); path=prefix[f.package]+'::'+'::'.join([snake(x) for x in parents]+[pascal(m.name)])
+ nodes[full]=(f,m,path)
+ for child in m.nested_type: walk(f,child,parents+[m.name])
+for f in files:
+ for m in f.message_type:walk(f,m,[])
+def label(full):return 'S_'+re.sub('[^a-zA-Z0-9]','_',full).upper()
+def size_type(field):
+ t=field.type
+ if t==d.FieldDescriptorProto.TYPE_MESSAGE:return nodes[field.type_name][2]
+ return {d.FieldDescriptorProto.TYPE_DOUBLE:'f64',d.FieldDescriptorProto.TYPE_FLOAT:'f32',d.FieldDescriptorProto.TYPE_INT64:'i64',d.FieldDescriptorProto.TYPE_UINT64:'u64',d.FieldDescriptorProto.TYPE_INT32:'i32',d.FieldDescriptorProto.TYPE_FIXED64:'u64',d.FieldDescriptorProto.TYPE_FIXED32:'u32',d.FieldDescriptorProto.TYPE_BOOL:'bool',d.FieldDescriptorProto.TYPE_STRING:'String',d.FieldDescriptorProto.TYPE_BYTES:'Vec<u8>',d.FieldDescriptorProto.TYPE_UINT32:'u32',d.FieldDescriptorProto.TYPE_ENUM:'i32',d.FieldDescriptorProto.TYPE_SFIXED32:'i32',d.FieldDescriptorProto.TYPE_SFIXED64:'i64',d.FieldDescriptorProto.TYPE_SINT32:'i32',d.FieldDescriptorProto.TYPE_SINT64:'i64'}[t]
+lines=['// SPDX-License-Identifier: Apache-2.0','// SPDX-FileCopyrightText: Copyright The Lance Authors','','// Generated from the pinned file/encoding protobuf descriptors. Each wire field','// has a declared native element size; raw bytes are never treated as message nodes.','use super::{FieldKind, HeapBytes, WireField, WireSchema};','use std::mem::size_of;','']
+for full,(f,m,path) in nodes.items():
+ empty=full=='.google.protobuf.Empty'
+ if m.options.map_entry:
+  size='size_of::<('+','.join(size_type(x) for x in m.field)+')>()'
+ else:size='0' if empty else 'size_of::<'+path+'>()'
+ lines += ['pub(super) static '+label(full)+': WireSchema = WireSchema {','    size: '+size+',','    fields: &[']
+ for field in m.field:
+  repeat=field.label==d.FieldDescriptorProto.LABEL_REPEATED
+  if field.type==d.FieldDescriptorProto.TYPE_MESSAGE:
+   child=nodes[field.type_name][1]
+   kind=('Map' if child.options.map_entry else 'Message')+'(&'+label(field.type_name)+')'
+  elif field.type in (d.FieldDescriptorProto.TYPE_STRING,d.FieldDescriptorProto.TYPE_BYTES):kind='Bytes { width: size_of::<'+size_type(field)+'>() }'
+  else:
+   wire=1 if field.type in (d.FieldDescriptorProto.TYPE_DOUBLE,d.FieldDescriptorProto.TYPE_FIXED64,d.FieldDescriptorProto.TYPE_SFIXED64) else 5 if field.type in (d.FieldDescriptorProto.TYPE_FLOAT,d.FieldDescriptorProto.TYPE_FIXED32,d.FieldDescriptorProto.TYPE_SFIXED32) else 0
+   kind='Scalar { width: size_of::<'+size_type(field)+'>(), wire: '+str(wire)+' }'
+  lines.append('        WireField { number: '+str(field.number)+', repeated: '+str(repeat).lower()+', kind: FieldKind::'+kind+' },')
+ lines += ['    ],','};','']
+ if empty or m.options.map_entry:continue
+ # Only true oneofs (synthetic proto3 optional groups use Option fields).
+ true_groups={field.oneof_index for field in m.field if field.HasField('oneof_index') and not field.proto3_optional}
+ normal=[ident(snake(field.name))+'.heap_bytes()' for field in m.field if not(field.HasField('oneof_index') and not field.proto3_optional)]
+ normal += [ident(snake(m.oneof_decl[i].name))+'.heap_bytes()' for i in sorted(true_groups)]
+ terms=['self.'+x for x in normal]
+ lines += ['impl HeapBytes for '+path+' {','    fn heap_bytes(&self) -> usize {','        '+(' + '.join(terms) if terms else '0'),'    }','}','']
+ for group in sorted(true_groups):
+  mod=path.rsplit('::',1)[0]+'::'+snake(m.name)+'::'+pascal(m.oneof_decl[group].name)
+  lines += ['impl HeapBytes for '+mod+' {','    fn heap_bytes(&self) -> usize {','        match self {']
+  for field in m.field:
+   if field.HasField('oneof_index') and field.oneof_index==group and not field.proto3_optional:
+    lines.append('            Self::'+pascal(field.name)+'(value) => value.heap_bytes(),')
+  lines += ['        }','    }','}','']
+lines += ['pub(super) fn schema(name: &str) -> Option<&\'static WireSchema> {','    match name {']
+for full in nodes:lines.append('        "'+full[1:]+'" => Some(&'+label(full)+'),')
+lines += ['        _ => None,','    }','}']
+out = root / "rust" / ("lance-" + args.kind) / "src" / "memory_generated.rs"
+out.write_text("\n".join(lines) + "\n")
+subprocess.run([args.rustfmt, "--edition", "2024", str(out)], check=True)
+print(f"{len(nodes)} message schemas written to {out.relative_to(root)}")
diff --git a/tools/metadata-memory-generation.md b/tools/metadata-memory-generation.md
new file mode 100644
index 0000000000000000000000000000000000000000..10f772eef6b182a4c76b51160cb1aa8ab69ab2e0
--- /dev/null
+++ b/tools/metadata-memory-generation.md
@@ -0,0 +1,26 @@
+The committed `rust/lance-{file,table}/src/memory_generated.rs` files describe the
+protobuf messages in this pinned Lance tree. Building Lance does not require
+Python or regenerate these maintenance outputs.
+
+Install Python `protobuf==6.31.1` in a local virtual environment. Set `PROTOC` to
+the protobuf compiler and `PROTOC_INCLUDE` to its well-known protobuf includes,
+then run from the Lance repository root:
+
+```sh
+python tools/generate-metadata-memory.py --kind file
+python tools/generate-metadata-memory.py --kind table
+```
+
+The generator reads checked-in `protos/` with `--include_imports`. File generation
+uses `file.proto`, `file2.proto`, `encodings_v2_0.proto`, and `encodings_v2_1.proto`.
+Table generation uses `table.proto`, `transaction.proto`, and `rowids.proto`.
+Imported descriptors are included. It invokes `rustfmt` with edition 2024; set
+`RUSTFMT` to select that executable. Descriptor scratch is created under this
+repository's `target/metadata-memory-generator/` and removed after generation.
+
+Native message and element widths remain Rust `size_of::<T>()` expressions.
+The runtime wire walk allocates no count vector. Generated heap visitors use
+actual decoded capacities. When updating the Lance pin, regenerate both files,
+review new fields/variants, and rerun core/file/table memory tests. Review the
+separate protobuf-to-native normalization bounds in each `memory.rs` too; the
+generator does not infer those conversion allocations.
