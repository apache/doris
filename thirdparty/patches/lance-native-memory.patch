new file mode 100644
index 0000000000000000000000000000000000000000..b3eaae6a7995f1c99ce8a34d43a69a2beb861a39
--- /dev/null
+++ b/rust/lance-core/src/memory/context.rs
@@ -0,0 +1,314 @@
+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright The Lance Authors
+
+use std::cell::RefCell;
+use std::future::Future;
+use std::marker::PhantomData;
+use std::pin::Pin;
+use std::rc::Rc;
+use std::sync::Arc;
+use std::task::{Context, Poll};
+
+use futures::Stream;
+use pin_project::pin_project;
+use tokio::task::JoinHandle;
+
+use super::MemoryBudget;
+use arrow_select::memory::{KernelMemoryHooks, KernelMemoryScope};
+
+thread_local! {
+    static CURRENT: RefCell<Option<Arc<MemoryBudget>>> = const { RefCell::new(None) };
+}
+
+/// A synchronous allocation scope, restored on return or unwind.
+///
+/// A scope must never cross an await or move to a different thread. Async work
+/// instead owns its budget in [`BudgetedFuture`] or [`BudgetedStream`], which
+/// enter a fresh scope only while polling. Spawn helpers capture that ownership
+/// before dispatch, so child tasks do not depend on a submitting thread's TLS.
+pub struct MemoryScope {
+    previous: Option<Arc<MemoryBudget>>,
+    _arrow_scope: KernelMemoryScope,
+    thread_bound: PhantomData<Rc<()>>,
+}
+
+impl MemoryScope {
+    /// Enter a known owner, or explicitly suspend accounting with `None`.
+    pub fn enter(budget: Option<Arc<MemoryBudget>>) -> Self {
+        let hooks = budget.as_ref().map(|_| KernelMemoryHooks {
+            take: super::take,
+            filter: super::filter,
+            concat: super::concat,
+            interleave: super::interleave,
+        });
+        Self {
+            previous: CURRENT.with(|current| current.replace(budget)),
+            _arrow_scope: KernelMemoryScope::enter(hooks),
+            thread_bound: PhantomData,
+        }
+    }
+
+    /// Clone the current owner for a child task or allocation.
+    pub fn current() -> Option<Arc<MemoryBudget>> {
+        CURRENT.with_borrow(Clone::clone)
+    }
+}
+
+impl Drop for MemoryScope {
+    fn drop(&mut self) {
+        CURRENT.with(|current| current.replace(self.previous.take()));
+    }
+}
+
+/// A future carrying its allocation owner across suspension and worker changes.
+#[pin_project]
+pub struct BudgetedFuture<F> {
+    #[pin]
+    future: F,
+    budget: Option<Arc<MemoryBudget>>,
+}
+
+impl<F> BudgetedFuture<F> {
+    /// Capture the submitting scope before a future can be dispatched elsewhere.
+    pub fn capture(future: F) -> Self {
+        Self::new(MemoryScope::current(), future)
+    }
+
+    /// Bind work to an explicit query or process owner.
+    pub fn new(budget: Option<Arc<MemoryBudget>>, future: F) -> Self {
+        Self { future, budget }
+    }
+}
+
+impl<F: Future> Future for BudgetedFuture<F> {
+    type Output = F::Output;
+
+    fn poll(self: Pin<&mut Self>, context: &mut Context<'_>) -> Poll<Self::Output> {
+        let this = self.project();
+        let _scope = MemoryScope::enter(this.budget.clone());
+        this.future.poll(context)
+    }
+}
+
+/// A stream retaining one owner through all polls, including EOF and errors.
+#[pin_project]
+pub struct BudgetedStream<S> {
+    #[pin]
+    stream: S,
+    budget: Option<Arc<MemoryBudget>>,
+}
+
+impl<S> BudgetedStream<S> {
+    /// Bind every poll to an explicit query or process owner.
+    pub fn new(budget: Option<Arc<MemoryBudget>>, stream: S) -> Self {
+        Self { stream, budget }
+    }
+}
+
+impl<S: Stream> Stream for BudgetedStream<S> {
+    type Item = S::Item;
+
+    fn poll_next(self: Pin<&mut Self>, context: &mut Context<'_>) -> Poll<Option<Self::Item>> {
+        let this = self.project();
+        let _scope = MemoryScope::enter(this.budget.clone());
+        this.stream.poll_next(context)
+    }
+
+    fn size_hint(&self) -> (usize, Option<usize>) {
+        self.stream.size_hint()
+    }
+}
+
+/// Spawn an async descendant with an owned copy of its submitting budget.
+pub fn spawn<F>(future: F) -> JoinHandle<F::Output>
+where
+    F: Future + Send + 'static,
+    F::Output: Send + 'static,
+{
+    tokio::spawn(BudgetedFuture::capture(future))
+}
+
+/// Dispatch blocking I/O while preserving the owner on the receiving thread.
+pub fn spawn_blocking<F, R>(function: F) -> JoinHandle<R>
+where
+    F: FnOnce() -> R + Send + 'static,
+    R: Send + 'static,
+{
+    let budget = MemoryScope::current();
+    tokio::task::spawn_blocking(move || {
+        let _scope = MemoryScope::enter(budget);
+        function()
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::Result;
+    use futures::StreamExt;
+
+    #[test]
+    fn nested_scope_and_unwind_restore_the_previous_owner() {
+        let first = Arc::new(MemoryBudget::new(8).unwrap());
+        let second = Arc::new(MemoryBudget::new(16).unwrap());
+        assert!(MemoryScope::current().is_none());
+        let first_scope = MemoryScope::enter(Some(first.clone()));
+        let failure = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+            let _second_scope = MemoryScope::enter(Some(second.clone()));
+            assert!(Arc::ptr_eq(&MemoryScope::current().unwrap(), &second));
+            panic!("controlled scope unwind");
+        }));
+        assert!(failure.is_err());
+        assert!(Arc::ptr_eq(&MemoryScope::current().unwrap(), &first));
+        drop(first_scope);
+        assert!(MemoryScope::current().is_none());
+    }
+
+    #[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+    async fn descendants_and_blocking_workers_keep_their_owner() {
+        let budget = Arc::new(MemoryBudget::new(8).unwrap());
+        let reservation = BudgetedFuture::new(Some(budget.clone()), async {
+            let expected = budget.clone();
+            spawn(async move {
+                tokio::task::yield_now().await;
+                assert!(Arc::ptr_eq(&MemoryScope::current().unwrap(), &expected));
+                let nested = expected.clone();
+                spawn_blocking(move || {
+                    assert!(Arc::ptr_eq(&MemoryScope::current().unwrap(), &nested));
+                    MemoryScope::current().unwrap().reserve(8)
+                })
+                .await
+                .unwrap()
+            })
+            .await
+            .unwrap()
+        })
+        .await
+        .unwrap();
+        drop(reservation);
+        assert_eq!(budget.used(), 0);
+        assert!(MemoryScope::current().is_none());
+    }
+
+    #[tokio::test]
+    async fn pending_poll_does_not_leave_ownership_on_the_polling_thread() {
+        let budget = Arc::new(MemoryBudget::new(8).unwrap());
+        let future = BudgetedFuture::new(Some(budget.clone()), async {
+            assert!(Arc::ptr_eq(&MemoryScope::current().unwrap(), &budget));
+            futures::future::pending::<()>().await;
+        });
+        let mut future = Box::pin(future);
+        assert!(futures::poll!(&mut future).is_pending());
+        assert!(MemoryScope::current().is_none());
+        drop(future);
+        assert!(MemoryScope::current().is_none());
+    }
+
+    #[tokio::test]
+    async fn simultaneous_query_streams_do_not_share_scope() {
+        let first = Arc::new(MemoryBudget::new(8).unwrap());
+        let second = Arc::new(MemoryBudget::new(16).unwrap());
+        let stream = |budget: Arc<MemoryBudget>| {
+            let expected = budget.clone();
+            BudgetedStream::new(
+                Some(budget),
+                futures::stream::once(async move {
+                    tokio::task::yield_now().await;
+                    assert!(Arc::ptr_eq(&MemoryScope::current().unwrap(), &expected));
+                    MemoryScope::current().unwrap().reserve(8)
+                }),
+            )
+        };
+        let (a, b) = futures::join!(
+            stream(first.clone()).collect::<Vec<_>>(),
+            stream(second.clone()).collect::<Vec<_>>()
+        );
+        assert_eq!(first.used(), 8);
+        assert_eq!(second.used(), 8);
+        assert!(MemoryScope::current().is_none());
+        drop((a, b));
+        assert_eq!(first.used(), 0);
+        assert_eq!(second.used(), 0);
+    }
+
+    #[tokio::test]
+    async fn scoped_cpu_work_retains_owned_reservation() -> Result<()> {
+        let budget = Arc::new(MemoryBudget::new(8)?);
+        let reservation = BudgetedFuture::new(Some(budget.clone()), async {
+            crate::utils::tokio::spawn_cpu(|| {
+                let owner = MemoryScope::current().expect("CPU task inherits budget");
+                owner.reserve(8)
+            })
+            .await
+        })
+        .await?;
+        drop(reservation);
+        assert_eq!(budget.used(), 0);
+        Ok(())
+    }
+    #[test]
+    fn arrow_hooks_restore_after_nested_suspension_and_unwind() {
+        let input = arrow_array::UInt32Array::from(vec![7; 64]);
+        let indices = arrow_array::UInt32Array::from(vec![0]);
+        let owner = Arc::new(MemoryBudget::new(1).unwrap());
+        let scope = MemoryScope::enter(Some(owner.clone()));
+        let error = arrow_select::take::take(&input, &indices, None).unwrap_err();
+        assert!(super::super::MemoryError::find_in_chain(&error).is_some());
+        let failure = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+            let _unscoped = MemoryScope::enter(None);
+            assert!(arrow_select::take::take(&input, &indices, None).is_ok());
+            panic!("controlled hook restoration unwind");
+        }));
+        assert!(failure.is_err());
+        assert!(arrow_select::take::take(&input, &indices, None).is_err());
+        drop(scope);
+        assert!(arrow_select::take::take(&input, &indices, None).is_ok());
+        assert_eq!(owner.used(), 0);
+    }
+
+    #[test]
+    fn arrow_concat_suspends_delegation_only_inside_the_admitted_kernel() {
+        use arrow_array::Array;
+        let left = arrow_array::UInt32Array::from(vec![7; 64]);
+        let right = arrow_array::UInt32Array::from(vec![8; 64]);
+        let owner = Arc::new(MemoryBudget::new(4096).unwrap());
+        let output = {
+            let _scope = MemoryScope::enter(Some(owner.clone()));
+            arrow_select::concat::concat(&[&left, &right]).unwrap()
+        };
+        assert_eq!(output.len(), 128);
+        assert_eq!(owner.used(), 512);
+        drop(output);
+        assert_eq!(owner.used(), 0);
+        assert!(arrow_select::concat::concat(&[&left, &right]).is_ok());
+    }
+
+    #[test]
+    fn optimized_filter_predicates_use_the_fallible_scoped_path() {
+        let input = arrow_array::UInt32Array::from(vec![7; 64]);
+        let predicate = arrow_array::BooleanArray::from(
+            (0..64)
+                .map(|index| {
+                    if index % 3 == 0 {
+                        None
+                    } else {
+                        Some(index % 2 == 0)
+                    }
+                })
+                .collect::<Vec<_>>(),
+        );
+        let expected = predicate
+            .iter()
+            .filter(|value| *value == Some(true))
+            .count();
+        let owner = Arc::new(MemoryBudget::new(1).unwrap());
+        let _scope = MemoryScope::enter(Some(owner.clone()));
+        let predicate = arrow_select::filter::FilterBuilder::new(&predicate)
+            .optimize()
+            .build();
+        assert_eq!(predicate.count(), expected);
+        let error = predicate.filter(&input).unwrap_err();
+        assert!(super::super::MemoryError::find_in_chain(&error).is_some());
+        assert_eq!(owner.used(), 0);
+    }
+}
