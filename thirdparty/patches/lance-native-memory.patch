+struct DictionaryWriter(BudgetedVec<u8>);
+impl std::io::Write for DictionaryWriter {
+    fn write(&mut self, bytes: &[u8]) -> std::io::Result<usize> {
+        let required = self
+            .0
+            .len()
+            .checked_add(bytes.len())
+            .ok_or_else(|| std::io::Error::other("dictionary byte size overflow"))?;
+        if required > self.0.capacity() {
+            let capacity = self
+                .0
+                .capacity()
+                .max(64)
+                .checked_mul(2)
+                .map(|capacity| capacity.max(required))
+                .ok_or_else(|| std::io::Error::other("dictionary capacity overflow"))?;
+            self.0
+                .try_reserve(capacity - self.0.len())
+                .map_err(std::io::Error::other)?;
+        }
+        self.0
+            .try_extend_from_slice(bytes)
+            .map_err(std::io::Error::other)?;
+        Ok(bytes.len())
+    }
+    fn flush(&mut self) -> std::io::Result<()> {
+        Ok(())
+    }
+}
+
+#[derive(Debug)]
+struct DictionaryBuffer(arrow::buffer::Buffer);
+impl AsRef<[u8]> for DictionaryBuffer {
+    fn as_ref(&self) -> &[u8] {
+        self.0.as_slice()
+    }
+}
+
+// The pinned FST builder retains one unfinished node per byte of its longest
+// key. Each node has at most 256 byte-labelled transitions. Three stack-sized
+// payloads cover Vec growth while the old allocation is still live; four more
+// nodes cover the two-entry registry and its replacement clone.
+fn dictionary_scratch(
+    max_key_bytes: usize,
+) -> Result<Option<lance_core::memory::MemoryReservation>> {
+    let node_bytes = 256_usize
+        .checked_mul(std::mem::size_of::<fst::raw::Transition>())
+        .and_then(|transitions| transitions.checked_add(128))
+        .ok_or_else(|| Error::invalid_input("FST builder node size overflow"))?;
+    let bytes = max_key_bytes
+        .checked_add(64)
+        .and_then(|nodes| nodes.checked_mul(3))
+        .and_then(|nodes| nodes.checked_add(4))
+        .and_then(|nodes| nodes.checked_mul(node_bytes))
+        .ok_or_else(|| Error::invalid_input("FST builder scratch size overflow"))?;
+    lance_core::memory::reserve_current(bytes)
+}
