+
+    #[derive(Debug)]
+    struct Accountant {
+        used: AtomicUsize,
+        limit: usize,
+        calls: AtomicUsize,
+        releases: AtomicUsize,
+    }
+
+    impl Accountant {
+        fn new(limit: usize) -> Arc<Self> {
+            Arc::new(Self {
+                used: AtomicUsize::new(0),
+                limit,
+                calls: AtomicUsize::new(0),
+                releases: AtomicUsize::new(0),
+            })
+        }
+    }
+
+    impl MemoryAccountant for Accountant {
+        fn try_reserve(&self, bytes: usize) -> Result<()> {
+            self.calls.fetch_add(1, Ordering::Relaxed);
+            self.used
+                .fetch_update(Ordering::AcqRel, Ordering::Acquire, |used| {
+                    (bytes <= self.limit - used).then_some(used + bytes)
+                })
+                .map(|_| ())
+                .map_err(|used| {
+                    MemoryError::LimitExceeded {
+                        requested: bytes,
+                        used,
+                        limit: self.limit,
+                    }
+                    .into()
+                })
+        }
+
+        fn release(&self, bytes: usize) {
+            self.releases.fetch_add(1, Ordering::Relaxed);
+            assert!(self.used.fetch_sub(bytes, Ordering::AcqRel) >= bytes);
+        }
+    }
+
+    fn memory_error(error: &Error) -> &MemoryError {
+        match error {
+            Error::External { source } => source.downcast_ref::<MemoryError>().unwrap(),
+            error => panic!("expected a structured memory error, got {error:?}"),
+        }
+    }
+
