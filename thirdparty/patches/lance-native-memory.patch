+++ b/rust/lance-core/src/memory/value.rs
@@ -0,0 +1,143 @@
+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright The Lance Authors
+
+use super::{MemoryOwner, MemoryReservation, reserve_current};
+use crate::{Error, Result};
+use std::ops::Deref;
+use std::sync::Arc;
+
+#[derive(Debug)]
+enum Storage<T> {
+    Owned(T),
+    Projected {
+        parent: MemoryValue<T>,
+        select: fn(&T) -> &T,
+    },
+}
+#[derive(Debug)]
+struct ValueOwner<T> {
+    value: Storage<T>,
+    owner: Option<Arc<MemoryOwner>>,
+    _reservation: Option<MemoryReservation>,
+}
+
+/// Immutable decoded metadata whose clones share payload and accounting.
+#[derive(Debug)]
+pub struct MemoryValue<T>(Arc<ValueOwner<T>>);
+
+impl<T> Clone for MemoryValue<T> {
+    fn clone(&self) -> Self {
+        Self(self.0.clone())
+    }
+}
+impl<T> From<T> for MemoryValue<T> {
+    fn from(value: T) -> Self {
+        Self(Arc::new(ValueOwner {
+            value: Storage::Owned(value),
+            owner: None,
+            _reservation: None,
+        }))
+    }
+}
+impl<T> MemoryValue<T> {
+    /// Storage used by the value and its ownership wrapper, excluding children.
+    pub const fn allocation_bytes() -> usize {
+        std::mem::size_of::<ValueOwner<T>>() + 2 * std::mem::size_of::<usize>()
+    }
+    /// Create a shared view of a nested message without cloning its heap.
+    pub fn project(&self, select: fn(&T) -> &T) -> Result<Self> {
+        let reservation = reserve_current(Self::allocation_bytes())?;
+        Ok(Self(Arc::new(ValueOwner {
+            value: Storage::Projected {
+                parent: self.clone(),
+                select,
+            },
+            owner: None,
+            _reservation: reservation,
+        })))
+    }
+    /// Attach an admission before any metadata view is published.
+    pub fn retain_owner(&mut self, owner: Arc<MemoryOwner>) -> Result<()> {
+        let value = Arc::get_mut(&mut self.0).ok_or_else(|| {
+            Error::internal("metadata value was shared before retaining its owner")
+        })?;
+        if value.owner.is_some() {
+            return Err(Error::internal("metadata value already has an owner"));
+        }
+        value.owner = Some(owner);
+        Ok(())
+    }
+}
+impl<T> AsRef<T> for MemoryValue<T> {
+    fn as_ref(&self) -> &T {
+        match &self.0.value {
+            Storage::Owned(value) => value,
+            Storage::Projected { parent, select } => select(parent.as_ref()),
+        }
+    }
+}
+impl<T> Deref for MemoryValue<T> {
+    type Target = T;
+    fn deref(&self) -> &T {
+        self.as_ref()
+    }
+}
+impl<T: PartialEq> PartialEq for MemoryValue<T> {
+    fn eq(&self, other: &Self) -> bool {
+        self.as_ref() == other.as_ref()
+    }
+}
+impl<T: Eq> Eq for MemoryValue<T> {}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::memory::{MemoryBudget, MemoryScope};
+    #[test]
+    fn decoded_payload_and_owner_outlive_cache_entry() {
+        let budget = Arc::new(MemoryBudget::new(128).unwrap());
+        let mut value = MemoryValue::from(vec![7_u8; 64]);
+        let owner = {
+            let _scope = MemoryScope::enter(Some(budget.clone()));
+            MemoryOwner::new(budget.reserve(64).unwrap())
+        };
+        value.retain_owner(owner).unwrap();
+        let scheduler_value = value.clone();
+        assert!(std::ptr::eq(
+            value.as_ref().as_ptr(),
+            scheduler_value.as_ref().as_ptr()
+        ));
+        drop(value);
+        assert_eq!(budget.used(), 64);
+        assert_eq!(scheduler_value.len(), 64);
+        drop(scheduler_value);
+        assert_eq!(budget.used(), 0);
+    }
+}
+
+#[cfg(test)]
+mod projection_tests {
+    use super::*;
+    use crate::memory::{MemoryBudget, MemoryScope};
+
+    #[test]
+    fn projected_view_shares_payload_and_retains_both_owners() {
+        let budget = Arc::new(MemoryBudget::new(1 << 20).unwrap());
+        let mut parent = MemoryValue::from(vec![3_u8; 64]);
+        parent
+            .retain_owner(MemoryOwner::new(budget.reserve(64).unwrap()))
+            .unwrap();
+        let view = {
+            let _scope = MemoryScope::enter(Some(budget.clone()));
+            parent.project(|value| value).unwrap()
+        };
+        assert_eq!(parent.as_ref().as_ptr(), view.as_ref().as_ptr());
+        let resident = 64 + MemoryValue::<Vec<u8>>::allocation_bytes();
+        assert_eq!(budget.used(), resident);
+        drop(parent);
+        assert_eq!(budget.used(), resident);
+        assert_eq!(view[63], 3);
+        drop(view);
+        assert_eq!(budget.used(), 0);
+    }
+}
