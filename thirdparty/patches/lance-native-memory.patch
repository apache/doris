+impl Fragment {
+    /// Heap bytes copied by Fragment::clone; shared field lists/bitmaps/row ids
+    /// keep their original owners and require no payload copy.
+    pub fn clone_admission_bytes(&self) -> Result<usize> {
+        let add = |a: usize, b: usize| {
+            a.checked_add(b)
+                .ok_or_else(|| Error::invalid_input("fragment clone admission overflow"))
+        };
+        let mul = |a: usize, b: usize| {
+            a.checked_mul(b)
+                .ok_or_else(|| Error::invalid_input("fragment clone admission overflow"))
+        };
+        let mut bytes = mul(self.files.len(), std::mem::size_of::<DataFile>())?;
+        bytes = add(
+            bytes,
+            mul(self.overlays.len(), std::mem::size_of::<DataOverlayFile>())?,
+        )?;
+        for file in &self.files {
+            bytes = add(bytes, file.path.len())?;
+        }
+        for overlay in &self.overlays {
+            bytes = add(bytes, overlay.data_file.path.len())?;
+            if let super::overlay::OverlayCoverage::PerField(bitmaps) = &overlay.coverage {
+                bytes = add(
+                    bytes,
+                    mul(
+                        bitmaps.len(),
+                        std::mem::size_of::<Arc<roaring::RoaringBitmap>>(),
+                    )?,
+                )?;
+            }
+        }
+        add(bytes, lance_core::memory::MemoryOwner::allocation_bytes())
+    }
+
+    /// Fallible working copy for query plan construction.
+    pub fn try_clone(&self) -> Result<Self> {
+        let reservation = lance_core::memory::reserve_current(self.clone_admission_bytes()?)?;
+        let mut fragment = self.clone();
+        if let Some(reservation) = reservation {
+            fragment.memory_owner =
+                MemoryOwnerHandle(Some(lance_core::memory::MemoryOwner::new_with_parent(
+                    reservation,
+                    self.memory_owner.0.clone(),
+                )));
+        }
+        Ok(fragment)
+    }
+}
