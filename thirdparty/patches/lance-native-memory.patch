+// Result-returning file-open boundaries admit schema working storage before
+// projection/Clone. Field traversal itself uses stack scratch only.
+fn field_tree_shape(fields: &[lance_core::datatypes::Field]) -> (usize, usize, usize) {
+    let mut count = 0;
+    let mut depth = 0;
+    let mut blobs = 0;
+    for field in fields {
+        let (children, child_depth, child_blobs) = field_tree_shape(&field.children);
+        count += 1 + children;
+        depth = depth.max(1 + child_depth);
+        blobs += usize::from(field.is_blob_v2()) + child_blobs;
+    }
+    (count, depth, blobs)
+}
+fn admitted_schema_copy(
+    source: &Schema,
+    copies: usize,
+    extra: usize,
+    build: impl FnOnce() -> Result<Schema>,
+) -> Result<Schema> {
+    let bytes = lance_core::memory::schema_clone_admission_bytes(source)?
+        .checked_mul(copies)
+        .and_then(|bytes| bytes.checked_add(extra))
+        .ok_or_else(|| Error::invalid_input("file schema admission overflow"))?;
+    let reservation = lance_core::memory::reserve_current(bytes)?;
+    let mut output = build()?;
+    output.memory_owner = reservation.map(lance_core::memory::MemoryOwner::new);
+    Ok(output)
+}
+pub(crate) fn projection_copy_allowances(source: &Schema) -> usize {
+    // Three Core working-storage/Vec-move allowances; intersection also parses
+    // both schemas' Arrow types at each live recursive field depth.
+    let (_, depth, _) = field_tree_shape(&source.fields);
+    3 + 2 * depth
+}
