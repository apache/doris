+//! Explicit budgets for native allocations shared by asynchronous work.
+//!
+//! A reservation owns its budget and can move between tasks. Buffer reservations
+//! follow Arrow's allocation owner through clones, slices, and exports. These
+//! primitives account only allocations made through them; installing a budget
+//! does not intercept the system allocator or bound an existing scanner.
+
+use std::alloc::{Layout, alloc_zeroed, dealloc};
+use std::fmt;
+use std::ptr::NonNull;
+use std::sync::Arc;
+use std::sync::atomic::{AtomicUsize, Ordering};
+
+use arrow_buffer::{Buffer, alloc::ALIGNMENT};
+
+use crate::{Error, Result};
+
+mod arrow;
+mod bitmap;
+mod context;
+pub mod protobuf;
+mod schema;
+mod selection;
+mod slice;
+pub use schema::{
+    field_clone_admission_bytes, reserve_schema_clone, schema_clone_admission_bytes,
+    try_clone_schema,
+};
+mod retained_stream;
+mod value;
+pub use retained_stream::RetainedMemoryStream;
+mod vector;
+pub use arrow::{
+    allocate_current_buffer, concat, concat_admission_bytes, retain_array_buffers, try_null_array,
+};
+pub use bitmap::BudgetedBitmap;
+pub use selection::{
+    filter, filter_array_with_budget, filter_record_batch, filter_record_batch_with_budget,
+    interleave, interleave_with_budget, take, take_array_with_budget, take_record_batch,
+    take_record_batch_with_budget,
+};
+pub use slice::{MemoryOwner, MemoryOwnerHandle, MemorySlice};
+pub use value::MemoryValue;
+mod owner;
+pub use context::{BudgetedFuture, BudgetedStream, MemoryScope, spawn, spawn_blocking};
+pub use owner::TransferableAccountant;
+pub use vector::{BudgetedIntoIter, BudgetedVec};
+
+const CANCELLED: usize = 1 << (usize::BITS - 1);
+const MAX_BYTES: usize = CANCELLED - 1;
+
+/// External accounting for a budget, such as an embedding query or task group.
+///
+/// Implementations must be thread-safe and must not unwind or re-enter the
+/// budget. A failed reservation must leave accounting unchanged. Release cannot
+/// fail and may run on the task that destroys the last exported Arrow buffer.
+/// Implementations must not block a CPU worker waiting for other query work.
+pub trait MemoryAccountant: fmt::Debug + Send + Sync + std::panic::RefUnwindSafe {
+    /// Charge additional bytes before their storage is allocated.
+    fn try_reserve(&self, bytes: usize) -> Result<()>;
+
+    /// Return exactly bytes previously accepted by `try_reserve`.
+    fn release(&self, bytes: usize);
+}
+
+/// Structured native budget failures retained as an [`Error::External`] source.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum MemoryError {
+    /// A reservation would exceed the budget, including concurrent reservations.
+    LimitExceeded {
+        /// Additional bytes requested by the caller.
+        requested: usize,
+        /// Bytes already reserved when the request was rejected.
+        used: usize,
+        /// Maximum live reserved bytes.
+        limit: usize,
+    },
+    /// The budget no longer accepts reservations; existing owners remain valid.
+    Cancelled,
+    /// The system allocator could not provide storage after budget admission.
+    AllocationFailed {
+        /// Storage size requested from the system allocator.
+        bytes: usize,
+    },
+    /// The embedding rejected allocation for a non-limit, non-cancellation reason.
+    ExternalCallbackFailed {
+        /// The exact nonzero host callback status.
+        code: i32,
+        /// Allocation size submitted to the callback.
+        bytes: usize,
+    },
+}
+
+impl fmt::Display for MemoryError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::LimitExceeded {
+                requested,
+                used,
+                limit,
+            } => write!(
+                f,
+                "native memory budget exceeded: requested={requested}, used={used}, limit={limit}"
+            ),
+            Self::Cancelled => f.write_str("native memory budget is cancelled"),
+            Self::AllocationFailed { bytes } => {
+                write!(f, "native buffer allocation failed: bytes={bytes}")
+            }
+            Self::ExternalCallbackFailed { code, bytes } => {
+                write!(
+                    f,
+                    "host memory reservation callback failed: status={code}, bytes={bytes}"
+                )
+            }
+        }
+    }
+}
+
+impl std::error::Error for MemoryError {}
+
+impl MemoryError {
+    /// Find a native admission failure through nested Arrow, I/O, and query errors.
+    pub fn find_in_chain<'a>(error: &'a (dyn std::error::Error + 'static)) -> Option<&'a Self> {
+        let mut source = Some(error);
+        while let Some(error) = source {
+            if let Some(memory) = error.downcast_ref::<Self>() {
+                return Some(memory);
+            }
+            // Snafu's transparent External variant forwards source() to the
+            // inner error's source, skipping the leaf MemoryError itself.
+            if let Some(external) = error
+                .downcast_ref::<Error>()
+                .and_then(Error::external_source)
+                && let Some(memory) = Self::find_in_chain(external.as_ref())
+            {
+                return Some(memory);
+            }
+            // Custom I/O errors also forward source() to the payload's source,
+            // which can skip a transparent core error and its memory leaf.
+            if let Some(payload) = error
+                .downcast_ref::<std::io::Error>()
+                .and_then(std::io::Error::get_ref)
+                && let Some(memory) = Self::find_in_chain(payload)
+            {
+                return Some(memory);
+            }
+            source = error.source();
+        }
+        None
+    }
+}
+
+/// Reserve storage for the currently executing query before allocating it.
+///
+/// Outside an embedding scope this returns `None` and preserves Lance's default
+/// allocation behavior. The returned token must follow the allocation owner.
+pub fn reserve_current(bytes: usize) -> Result<Option<MemoryReservation>> {
+    MemoryScope::current()
+        .map(|budget| budget.reserve(bytes))
+        .transpose()
+}
+
+impl From<MemoryError> for Error {
+    fn from(error: MemoryError) -> Self {
+        Self::external(Box::new(error))
+    }
+}
+
+/// A finite, shared budget with cooperative cancellation and optional accounting.
+///
+/// The byte counter includes pending external reservations. Cancellation and
+/// local admission use one atomic state: after cancellation, no later admission
+/// succeeds. Cancellation does not release memory still owned by running tasks
+/// or exported arrays. Reservations admitted before cancellation may finish.
+///
+/// ```
+/// use std::sync::Arc;
+/// use lance_core::memory::MemoryBudget;
+/// # fn example() -> lance_core::Result<()> {
+/// let budget = Arc::new(MemoryBudget::new(1024)?);
+/// let reservation = budget.reserve(512)?;
+/// assert_eq!(budget.used(), 512);
+/// drop(reservation);
+/// assert_eq!(budget.used(), 0);
+/// # Ok(())
+/// # }
+/// ```
+#[derive(Debug)]
+pub struct MemoryBudget {
+    limit: usize,
+    // The high bit closes admission without losing the live byte count.
+    state: AtomicUsize,
+    accountant: Option<Arc<dyn MemoryAccountant>>,
+}
+
+impl MemoryBudget {
+    /// Create a budget with a byte limit between zero and `isize::MAX`.
+    pub fn new(limit: usize) -> Result<Self> {
+        if limit > MAX_BYTES {
+            return Err(Error::invalid_input(format!(
+                "native memory budget limit must not exceed {MAX_BYTES}, got {limit}"
+            )));
+        }
+        Ok(Self {
+            limit,
+            state: AtomicUsize::new(0),
+            accountant: None,
+        })
+    }
+
+    /// Also charge admitted bytes to an external owner, retained by this budget.
+    pub fn with_accountant(mut self, accountant: Arc<dyn MemoryAccountant>) -> Self {
+        self.accountant = Some(accountant);
+        self
+    }
+
+    /// Maximum simultaneous reserved bytes, shared by every clone of the `Arc`.
+    pub fn limit(&self) -> usize {
+        self.limit
+    }
+
+    /// Live bytes, including requests awaiting the external accountant.
+    pub fn used(&self) -> usize {
+        self.state.load(Ordering::Acquire) & MAX_BYTES
+    }
+
+    /// Stop new admission while retaining the charges of existing owners.
+    pub fn cancel(&self) {
+        self.state.fetch_or(CANCELLED, Ordering::AcqRel);
+    }
+
+    /// Whether new reservations will be rejected because of cancellation.
+    pub fn is_cancelled(&self) -> bool {
+        self.state.load(Ordering::Acquire) & CANCELLED != 0
+    }
+
+    /// Reserve bytes before allocating them, returning an owned release token.
+    ///
+    /// Failure leaves local and external accounting unchanged. Zero-byte
+    /// reservations consult cancellation but do not call the accountant.
+    pub fn reserve(self: &Arc<Self>, bytes: usize) -> Result<MemoryReservation> {
+        self.try_reserve_bytes(bytes)?;
+        Ok(MemoryReservation {
+            budget: self.clone(),
+            bytes,
+        })
+    }
+
+    fn try_reserve_bytes(&self, bytes: usize) -> Result<()> {
+        let mut state = self.state.load(Ordering::Acquire);
+        loop {
+            if state & CANCELLED != 0 {
+                return Err(MemoryError::Cancelled.into());
+            }
+            if bytes > self.limit - state {
+                return Err(MemoryError::LimitExceeded {
+                    requested: bytes,
+                    used: state,
+                    limit: self.limit,
+                }
+                .into());
+            }
+            match self.state.compare_exchange_weak(
+                state,
+                state + bytes,
+                Ordering::AcqRel,
+                Ordering::Acquire,
+            ) {
+                Ok(_) => break,
+                Err(current) => state = current,
+            }
+        }
+
+        let mut rollback = LocalReservation {
+            budget: self,
+            bytes,
+        };
+        if bytes != 0
+            && let Some(accountant) = &self.accountant
+        {
+            accountant.try_reserve(bytes)?;
+        }
+        rollback.bytes = 0;
+        Ok(())
+    }
+
+    /// Allocate aligned, zeroed byte storage after reserving its full size.
+    ///
+    /// `initialize` can fill the storage or return an error; on error or unwind,
+    /// both storage and reservation are released. The resulting immutable Arrow
+    /// buffer carries the reservation until its final allocation owner is gone.
+    /// The budget covers the byte storage, excluding allocator/control metadata.
+    ///
+    /// ```
+    /// use std::sync::Arc;
+    /// use lance_core::memory::MemoryBudget;
+    /// # fn example() -> lance_core::Result<()> {
+    /// let budget = Arc::new(MemoryBudget::new(64)?);
+    /// let buffer = budget.allocate_buffer(64, |bytes| {
+    ///     bytes.fill(42);
+    ///     Ok(())
+    /// })?;
+    /// assert_eq!(buffer.as_slice(), &[42; 64]);
+    /// # Ok(())
+    /// # }
+    /// ```
+    pub fn allocate_buffer(
+        self: &Arc<Self>,
+        bytes: usize,
+        initialize: impl FnOnce(&mut [u8]) -> Result<()>,
+    ) -> Result<Buffer> {
+        let layout = Layout::from_size_align(bytes, ALIGNMENT).map_err(|error| {
+            Error::invalid_input(format!(
+                "invalid native buffer layout: bytes={bytes}, alignment={ALIGNMENT}: {error}"
+            ))
+        })?;
+        let reservation = self.reserve(bytes)?;
+        if bytes == 0 {
+            initialize(&mut [])?;
+            // Arrow 58.3 uses an ALIGNMENT-aligned dangling pointer for this
+            // zero-capacity buffer and performs no payload allocation. An
+            // empty Vec<u8> instead dangles at 1, which fails typed Arrow
+            // validation even when the primitive child has no values.
+            return Ok(arrow_buffer::MutableBuffer::new(0).into());
+        }
+        // SAFETY: layout is valid and nonzero. A null allocation is a fallible
+        // error, and zeroing initializes every byte exposed to initialize.
+        let pointer = NonNull::new(unsafe { alloc_zeroed(layout) })
+            .ok_or(MemoryError::AllocationFailed { bytes })?;
+        let owner = BudgetAllocation {
+            pointer,
+            layout,
+            reservation,
+        };
+        // SAFETY: owner uniquely owns layout.size() initialized bytes until the
+        // resulting immutable Arrow buffer starts sharing that ownership.
+        initialize(unsafe { std::slice::from_raw_parts_mut(pointer.as_ptr(), bytes) })?;
+        // SAFETY: owner frees the same allocation only after Arrow's final
+        // shared owner drops; its reservation is released after deallocation.
+        Ok(unsafe { Buffer::from_custom_allocation(pointer, bytes, Arc::new(owner)) })
+    }
+
+    fn release_local(&self, bytes: usize) {
+        let previous = self.state.fetch_sub(bytes, Ordering::AcqRel);
+        debug_assert!(
+            previous & MAX_BYTES >= bytes,
+            "unbalanced native memory release"
+        );
+    }
+
+    fn release(&self, bytes: usize) {
+        if bytes == 0 {
+            return;
+        }
+        if let Some(accountant) = &self.accountant {
+            accountant.release(bytes);
+        }
+        self.release_local(bytes);
+    }
+}
+
+struct LocalReservation<'a> {
+    budget: &'a MemoryBudget,
+    bytes: usize,
+}
+
+impl Drop for LocalReservation<'_> {
+    fn drop(&mut self) {
+        if self.bytes != 0 {
+            self.budget.release_local(self.bytes);
+        }
+    }
+}
+
+/// An owned reservation whose destruction releases its remaining bytes once.
+///
+/// Move the token into the task or storage that owns the allocation. A split
+/// transfers ownership without changing accounting; it does not reserve twice.
+#[derive(Debug)]
+#[must_use = "retain the reservation until its allocation is released"]
+pub struct MemoryReservation {
+    budget: Arc<MemoryBudget>,
+    bytes: usize,
+}
+
+impl MemoryReservation {
+    /// Number of bytes this token will release.
+    pub fn bytes(&self) -> usize {
+        self.bytes
+    }
+
+    /// Move a completed read into a shared byte owner, retaining its reservation.
+    ///
+    /// The caller must reserve before starting the read. Unused admission is
+    /// returned after completion; clones and slices release the remaining bytes
+    /// only after the last shared owner is dropped.
+    pub fn into_bytes(mut self, bytes: bytes::Bytes) -> Result<bytes::Bytes> {
+        self.shrink_to(bytes.len())?;
+        Ok(bytes::Bytes::from_owner(ReservedBytes {
+            bytes,
+            reservation: self,
+        }))
+    }
+
+    /// Reserve additional bytes before growing the allocation.
+    pub fn try_grow(&mut self, additional: usize) -> Result<()> {
+        let total = self.bytes.checked_add(additional).ok_or_else(|| {
+            Error::invalid_input(format!(
+                "native reservation size overflow: current={}, additional={additional}",
+                self.bytes
+            ))
+        })?;
+        self.budget.try_reserve_bytes(additional)?;
+        self.bytes = total;
+        Ok(())
+    }
+
+    /// Release bytes after shrinking an allocation, retaining `bytes` in this token.
+    pub fn shrink_to(&mut self, bytes: usize) -> Result<()> {
+        if bytes > self.bytes {
+            return Err(Error::invalid_input(format!(
+                "cannot shrink native reservation from {} to {bytes}",
+                self.bytes
+            )));
+        }
+        self.budget.release(self.bytes - bytes);
+        self.bytes = bytes;
+        Ok(())
+    }
+
+    /// Transfer `bytes` to another owner without allocating or charging again.
+    pub fn split_off(&mut self, bytes: usize) -> Result<Self> {
+        if bytes > self.bytes {
+            return Err(Error::invalid_input(format!(
+                "cannot split {bytes} bytes from native reservation of {} bytes",
+                self.bytes
+            )));
+        }
+        self.bytes -= bytes;
+        Ok(Self {
+            budget: self.budget.clone(),
+            bytes,
+        })
+    }
+}
+
+struct ReservedBytes {
+    bytes: bytes::Bytes,
+    reservation: MemoryReservation,
+}
+
+impl AsRef<[u8]> for ReservedBytes {
+    fn as_ref(&self) -> &[u8] {
+        debug_assert_eq!(self.bytes.len(), self.reservation.bytes());
+        self.bytes.as_ref()
+    }
+}
+
+impl Drop for MemoryReservation {
+    fn drop(&mut self) {
+        self.budget.release(self.bytes);
+    }
+}
+
+struct BudgetAllocation {
+    pointer: NonNull<u8>,
+    layout: Layout,
+    reservation: MemoryReservation,
+}
+
+// SAFETY: the storage is shared only as immutable Arrow buffers, and its owner
+// is destroyed once. The reservation and external accountant are Send + Sync.
+unsafe impl Send for BudgetAllocation {}
+unsafe impl Sync for BudgetAllocation {}
+
+impl Drop for BudgetAllocation {
+    fn drop(&mut self) {
+        // SAFETY: this owner allocated pointer with the same nonzero layout and
+        // Arrow drops it only after the final buffer reference is released.
+        unsafe { dealloc(self.pointer.as_ptr(), self.layout) };
+        // Keep the reservation alive through deallocation. Its field destructor
+        // then releases accounting after the bytes no longer exist.
+        debug_assert_eq!(self.reservation.bytes(), self.layout.size());
+    }
+}
+
