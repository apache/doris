+#[cfg(test)]
+mod memory_tests {
+    use super::*;
+    use crate::scalar::inverted::InvertedIndexParams;
+    use lance_core::memory::MemoryBudget;
+
+    #[test]
+    fn default_query_tokens_keep_real_storage_after_tokenizer_drop() {
+        let budget = Arc::new(MemoryBudget::new(1 << 24).unwrap());
+        let scope = MemoryScope::enter(Some(budget.clone()));
+        let mut tokenizer = InvertedIndexParams::default().build().unwrap();
+        let tokens = try_collect_query_tokens("running cats running", &mut tokenizer).unwrap();
+        assert_eq!(
+            (&tokens)
+                .into_iter()
+                .map(String::as_str)
+                .collect::<Vec<_>>(),
+            vec!["run", "cat", "run"]
+        );
+        let all = budget.used();
+        drop(tokenizer);
+        assert!(budget.used() > 0 && budget.used() < all);
+        let copy = tokens.try_clone().unwrap();
+        drop(tokens);
+        drop(scope);
+        assert!(budget.used() > 0);
+        drop(copy);
+        assert_eq!(budget.used(), 0);
+    }
+
+    #[test]
+    fn large_query_is_rejected_before_the_token_stream_copies_text() {
+        let text = "x".repeat(1 << 20);
+        let mut tokenizer = InvertedIndexParams::default().build().unwrap();
+        let budget = Arc::new(MemoryBudget::new(8192).unwrap());
+        let _scope = MemoryScope::enter(Some(budget.clone()));
+        let error = match try_collect_query_tokens(&text, &mut tokenizer) {
+            Ok(_) => panic!("large query unexpectedly admitted"),
+            Err(error) => error,
+        };
+        assert!(matches!(
+            MemoryError::find_in_chain(&error),
+            Some(MemoryError::LimitExceeded { .. })
+        ));
+        drop(tokenizer);
+        assert_eq!(budget.used(), 0);
+    }
+
+    #[test]
+    fn budgeted_non_english_stemming_returns_explicit_unsupported_error() {
+        let mut params = InvertedIndexParams::default();
+        params.language = lance_tokenizer::Language::French;
+        let mut tokenizer = params.build().unwrap();
+        let budget = Arc::new(MemoryBudget::new(1 << 24).unwrap());
+        let _scope = MemoryScope::enter(Some(budget.clone()));
+        let error = match try_collect_query_tokens("bonjour", &mut tokenizer) {
+            Ok(_) => panic!("unsupported stemmer unexpectedly used"),
+            Err(error) => error,
+        };
+        assert!(error.to_string().contains("English stemmer"));
+        assert_eq!(budget.used(), 0);
+    }
+}
