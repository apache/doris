@@ -0,0 +1,386 @@
+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright The Lance Authors
+
+use std::ops::Range;
+use std::sync::Arc;
+
+use bytes::Bytes;
+use futures::{FutureExt, StreamExt, future::BoxFuture, stream::BoxStream};
+use lance_core::memory::{MemoryError, MemoryReservation, MemoryScope};
+use object_store::path::Path;
+use object_store::{
+    CopyOptions, GetOptions, GetRange, GetResult, GetResultPayload, ListResult, MultipartUpload,
+    ObjectMeta, ObjectStoreExt, PutMultipartOptions, PutOptions, PutPayload, PutResult,
+    RenameOptions, Result as OSResult,
+};
+
+fn memory_error(error: lance_core::Error) -> object_store::Error {
+    object_store::Error::Generic {
+        store: "lance_native_memory",
+        source: Box::new(error),
+    }
+}
+
+pub(crate) fn is_memory_error(error: &object_store::Error) -> bool {
+    MemoryError::find_in_chain(error).is_some()
+}
+
+#[derive(Clone, Debug)]
+struct BudgetedRead;
+
+/// Mark a response whose complete body already retains its allocation owners.
+///
+/// Cache wrappers use this only after their single returned chunk owns either
+/// process cache storage or an admitted query assembly. Collecting it must not
+/// attach a second query charge to a borrowed process-owned cache block.
+pub fn mark_read_accounted(result: &mut GetResult) {
+    result.extensions.insert(BudgetedRead);
+}
+
+fn reserve_read(bytes: usize) -> OSResult<Option<MemoryReservation>> {
+    MemoryScope::current()
+        .map(|budget| {
+            // SDK range reads can retain input chunks while assembling their final
+            // body. Admit both bodies before polling, then retain only the result.
+            let peak = bytes.checked_mul(2).ok_or_else(|| {
+                lance_core::Error::invalid_input(format!(
+                    "read reservation overflow: bytes={bytes}"
+                ))
+            })?;
+            budget.reserve(peak)
+        })
+        .transpose()
+        .map_err(memory_error)
+}
+
+pub(crate) fn retain_read(bytes: Bytes, reservation: Option<MemoryReservation>) -> OSResult<Bytes> {
+    match reservation {
+        Some(reservation) => reservation.into_bytes(bytes).map_err(memory_error),
+        None => Ok(bytes),
+    }
+}
+
+/// Exact storage admission for local reads without an SDK assembly buffer.
+pub(crate) fn reserve_local_read(bytes: usize) -> OSResult<Option<MemoryReservation>> {
+    MemoryScope::current()
+        .map(|budget| budget.reserve(bytes))
+        .transpose()
+        .map_err(memory_error)
+}
+
+/// Keep an admitted read alive until the physical operation completes, even if
+/// its consuming stream is dropped. In particular, an io_uring actor may still
+/// own its buffer after the receiver of its completion has gone away.
+pub(crate) fn owned_read(
+    reservation: Option<MemoryReservation>,
+    future: BoxFuture<'static, OSResult<Bytes>>,
+) -> BoxFuture<'static, OSResult<Bytes>> {
+    if reservation.is_none() {
+        return future;
+    }
+    let task = lance_core::memory::spawn(async move { retain_read(future.await?, reservation) });
+    async move {
+        task.await
+            .map_err(|error| memory_error(lance_core::Error::wrapped(Box::new(error))))?
+    }
+    .boxed()
+}
+
+/// Consume an eager SDK body with admission before its stream is collected.
+pub(crate) async fn read_body(result: GetResult) -> OSResult<Bytes> {
+    if result.extensions.get::<BudgetedRead>().is_some() {
+        return result.bytes().await;
+    }
+    let size = usize::try_from(result.range.end - result.range.start).map_err(|_| {
+        memory_error(lance_core::Error::invalid_input(
+            "read body exceeds usize::MAX",
+        ))
+    })?;
+    let reservation = reserve_read(size)?;
+    owned_read(reservation, async move { result.bytes().await }.boxed()).await
+}
+
+/// Place below data-cache wrappers: cached owners keep process accounting and
+/// cold storage reads capture the scope active when the request is made.
+#[derive(Debug)]
+pub(crate) struct BudgetedObjectStore {
+    target: Arc<dyn object_store::ObjectStore>,
+}
+
+impl BudgetedObjectStore {
+    pub(crate) fn wrap(
+        target: Arc<dyn object_store::ObjectStore>,
+    ) -> Arc<dyn object_store::ObjectStore> {
+        Arc::new(Self { target })
+    }
+}
+
+impl std::fmt::Display for BudgetedObjectStore {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        write!(f, "BudgetedObjectStore({})", self.target)
+    }
+}
+
+#[async_trait::async_trait]
+#[deny(clippy::missing_trait_methods)]
+impl object_store::ObjectStore for BudgetedObjectStore {
+    async fn put_opts(
+        &self,
+        location: &Path,
+        bytes: PutPayload,
+        options: PutOptions,
+    ) -> OSResult<PutResult> {
+        self.target.put_opts(location, bytes, options).await
+    }
+
+    async fn put_multipart_opts(
+        &self,
+        location: &Path,
+        options: PutMultipartOptions,
+    ) -> OSResult<Box<dyn MultipartUpload>> {
+        self.target.put_multipart_opts(location, options).await
+    }
+
+    async fn get_opts(&self, location: &Path, mut options: GetOptions) -> OSResult<GetResult> {
+        if options.head || MemoryScope::current().is_none() {
+            return self.target.get_opts(location, options).await;
+        }
+        // Bound an open-ended request before a backend can allocate its body.
+        // Lance objects are immutable, but pin the physical range as well so a
+        // concurrently extended object cannot exceed this admission.
+        let range = match &options.range {
+            Some(GetRange::Bounded(range)) => range.clone(),
+            requested => {
+                let mut head = options.clone();
+                head.head = true;
+                head.range = None;
+                let size = self.target.get_opts(location, head).await?.meta.size;
+                match requested {
+                    Some(range) => {
+                        range
+                            .as_range(size)
+                            .map_err(|error| object_store::Error::Generic {
+                                store: "lance_native_memory",
+                                source: Box::new(error),
+                            })?
+                    }
+                    None => 0..size,
+                }
+            }
+        };
+        let size = range
+            .end
+            .checked_sub(range.start)
+            .and_then(|size| usize::try_from(size).ok())
+            .ok_or_else(|| {
+                memory_error(lance_core::Error::invalid_input(format!(
+                    "invalid read range: {range:?}"
+                )))
+            })?;
+        let reservation = reserve_read(size)?;
+        // An empty object has no valid HTTP Range header.
+        if size != 0 {
+            options.range = Some(GetRange::Bounded(range));
+        }
+        let target = self.target.clone();
+        let location = location.clone();
+        let (sender, receiver) = tokio::sync::oneshot::channel();
+        let body = owned_read(
+            reservation,
+            async move {
+                let result = target.get_opts(&location, options).await?;
+                let meta = result.meta.clone();
+                let range = result.range.clone();
+                let attributes = result.attributes.clone();
+                let extensions = result.extensions.clone();
+                let bytes = result.bytes().await?;
+                let _ = sender.send((meta, range, attributes, extensions));
+                Ok(bytes)
+            }
+            .boxed(),
+        )
+        .await?;
+        let (meta, range, attributes, mut extensions) = receiver
+            .await
+            .map_err(|error| memory_error(lance_core::Error::wrapped(Box::new(error))))?;
+        extensions.insert(BudgetedRead);
+        // A single retained chunk lets ObjectStoreExt::get_range/bytes avoid
+        // copying into an owner that would discard its reservation.
+        Ok(GetResult {
+            payload: GetResultPayload::Stream(
+                futures::stream::once(async move { Ok(body) }).boxed(),
+            ),
+            meta,
+            range,
+            attributes,
+            extensions,
+        })
+    }
+
+    async fn get_ranges(&self, location: &Path, ranges: &[Range<u64>]) -> OSResult<Vec<Bytes>> {
+        if MemoryScope::current().is_none() {
+            return self.target.get_ranges(location, ranges).await;
+        }
+        let reservations: Vec<_> = ranges
+            .iter()
+            .map(|range| {
+                let bytes = range
+                    .end
+                    .checked_sub(range.start)
+                    .and_then(|size| usize::try_from(size).ok())
+                    .ok_or_else(|| {
+                        memory_error(lance_core::Error::invalid_input(format!(
+                            "invalid read range: {range:?}"
+                        )))
+                    })?;
+                reserve_read(bytes)
+            })
+            .collect::<OSResult<_>>()?;
+        // Use exact physical ranges so a second SDK coalescing pass cannot add
+        // unreserved gaps between the ranges already coalesced by Lance.
+        futures::future::try_join_all(ranges.iter().zip(reservations).map(
+            |(range, reservation)| {
+                let target = self.target.clone();
+                let location = location.clone();
+                let range = range.clone();
+                owned_read(
+                    reservation,
+                    async move { target.get_range(&location, range).await }.boxed(),
+                )
+            },
+        ))
+        .await
+    }
+
+    fn delete_stream(
+        &self,
+        locations: BoxStream<'static, OSResult<Path>>,
+    ) -> BoxStream<'static, OSResult<Path>> {
+        self.target.delete_stream(locations)
+    }
+
+    fn list(&self, prefix: Option<&Path>) -> BoxStream<'static, OSResult<ObjectMeta>> {
+        self.target.list(prefix)
+    }
+
+    fn list_with_offset(
+        &self,
+        prefix: Option<&Path>,
+        offset: &Path,
+    ) -> BoxStream<'static, OSResult<ObjectMeta>> {
+        self.target.list_with_offset(prefix, offset)
+    }
+
+    async fn list_with_delimiter(&self, prefix: Option<&Path>) -> OSResult<ListResult> {
+        self.target.list_with_delimiter(prefix).await
+    }
+
+    async fn copy_opts(&self, from: &Path, to: &Path, options: CopyOptions) -> OSResult<()> {
+        self.target.copy_opts(from, to, options).await
+    }
+
+    async fn rename_opts(&self, from: &Path, to: &Path, options: RenameOptions) -> OSResult<()> {
+        self.target.rename_opts(from, to, options).await
+    }
+}
