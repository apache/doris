+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright The Lance Authors
+
+//! Admission for protobuf metadata before prost allocates repeated fields.
+
+use std::collections::HashMap;
+use std::hash::Hash;
+use std::mem::size_of;
+
+use bytes::Bytes;
+use lance_core::memory::{MemoryOwner, MemorySlice, MemoryValue};
+use lance_core::memory::{MemoryReservation, reserve_current};
+use lance_core::{Error, Result};
+use std::sync::Arc;
+
+#[path = "memory_generated.rs"]
+mod generated;
+
+pub(crate) trait HeapBytes {
+    fn heap_bytes(&self) -> usize;
+}
+
+macro_rules! scalar {
+    ($($type:ty),*) => { $(impl HeapBytes for $type { fn heap_bytes(&self) -> usize { 0 } })* };
+}
+scalar!((), bool, u8, u32, u64, i32, i64, f32, f64);
+
+impl HeapBytes for lance_core::datatypes::Field {
+    fn heap_bytes(&self) -> usize {
+        self.name.capacity()
+            + self.logical_type.allocated_bytes()
+            + self.metadata.heap_bytes()
+            + self.children.heap_bytes()
+    }
+}
+impl HeapBytes for lance_core::datatypes::Schema {
+    fn heap_bytes(&self) -> usize {
+        self.fields.heap_bytes() + self.metadata.heap_bytes()
+    }
+}
+
+impl<T: HeapBytes> HeapBytes for MemoryValue<T> {
+    fn heap_bytes(&self) -> usize {
+        self.as_ref().heap_bytes()
+    }
+}
+
+impl HeapBytes for String {
+    fn heap_bytes(&self) -> usize {
+        self.capacity()
+    }
+}
+impl HeapBytes for Bytes {
+    fn heap_bytes(&self) -> usize {
+        self.len()
+    }
+}
+impl<T: HeapBytes> HeapBytes for Box<T> {
+    fn heap_bytes(&self) -> usize {
+        size_of::<T>() + self.as_ref().heap_bytes()
+    }
+}
+impl<T: HeapBytes> HeapBytes for Option<T> {
+    fn heap_bytes(&self) -> usize {
+        self.as_ref().map(HeapBytes::heap_bytes).unwrap_or(0)
+    }
+}
+impl<T: HeapBytes> HeapBytes for Vec<T> {
+    fn heap_bytes(&self) -> usize {
+        self.capacity() * size_of::<T>() + self.iter().map(HeapBytes::heap_bytes).sum::<usize>()
+    }
+}
+impl<K: HeapBytes + Eq + Hash, V: HeapBytes> HeapBytes for HashMap<K, V> {
+    fn heap_bytes(&self) -> usize {
+        let buckets = if self.capacity() == 0 {
+            0
+        } else {
+            (self.capacity() + 1).next_power_of_two()
+        };
+        let storage = if buckets == 0 {
+            0
+        } else {
+            (buckets * size_of::<(K, V)>() + 15) / 16 * 16 + buckets + 16
+        };
+        storage
+            + self
+                .iter()
+                .map(|(key, value)| key.heap_bytes() + value.heap_bytes())
+                .sum::<usize>()
+    }
+}
+
+use lance_core::memory::protobuf::{FieldKind, WireField, WireSchema};
+
+fn add(left: usize, right: usize) -> Result<usize> {
+    left.checked_add(right)
+        .ok_or_else(|| Error::invalid_input("metadata memory size overflow"))
+}
+fn mul(left: usize, right: usize) -> Result<usize> {
+    left.checked_mul(right)
+        .ok_or_else(|| Error::invalid_input("metadata memory size overflow"))
+}
+
+use crate::format::{DataFile, Fragment, Manifest, pb};
+use lance_core::memory::MemoryOwnerHandle;
+
+pub(crate) fn reserve_manifest<'a>(
+    chunks: impl Iterator<Item = &'a Bytes> + Clone,
+) -> Result<Option<MemoryReservation>> {
+    if lance_core::memory::MemoryScope::current().is_none() {
+        return Ok(None);
+    }
+    let schema = generated::schema("lance.table.Manifest").expect("pinned manifest descriptor");
+    reserve_current(add(schema.size, schema.peak_chunks(chunks)?)?)
+}
+fn table_peak<K, V>(count: usize) -> Result<usize> {
+    if count == 0 {
+        return Ok(0);
+    }
+    let buckets = add(mul(count, 8)?, 6)?
+        .checked_div(7)
+        .and_then(usize::checked_next_power_of_two)
+        .ok_or_else(|| Error::invalid_input("manifest interner size overflow"))?
+        .max(4);
+    mul(
+        add(
+            add(mul(buckets, size_of::<(K, V)>())?, 15)? / 16 * 16,
+            add(buckets, 16)?,
+        )?,
+        3,
+    )
+}
+
+/// Admit normalization allocations before consuming protobuf; moved protobuf
+/// strings/maps remain covered after their original parse token is released.
+pub(crate) fn reserve_conversion(proto: &pb::Manifest) -> Result<Option<MemoryReservation>> {
+    if lance_core::memory::MemoryScope::current().is_none() {
+        return Ok(None);
+    }
+    let mut peak = add(size_of::<Manifest>(), proto.heap_bytes())?;
+    peak = add(
+        peak,
+        lance_file::datatypes::schema_conversion_admission_bytes(
+            &proto.fields,
+            &proto.schema_metadata,
+        )?,
+    )?;
+    peak = add(
+        peak,
+        mul(mul(proto.fragments.len().max(4), 3)?, size_of::<Fragment>())?,
+    )?;
+    peak = add(
+        peak,
+        mul(
+            mul(add(proto.fragments.len(), 1)?.max(4), 3)?,
+            size_of::<usize>(),
+        )?,
+    )?;
+    let mut data_files = 0;
+    let mut version_metadata = 0;
+    for fragment in &proto.fragments {
+        data_files = add(data_files, fragment.files.len())?;
+        peak = add(
+            peak,
+            mul(mul(fragment.files.len().max(4), 3)?, size_of::<DataFile>())?,
+        )?;
+        for file in &fragment.files {
+            peak = add(peak, data_file_conversion(file)?)?;
+        }
+        peak = add(
+            peak,
+            mul(
+                mul(fragment.overlays.len().max(4), 3)?,
+                size_of::<crate::format::overlay::DataOverlayFile>(),
+            )?,
+        )?;
+        for overlay in &fragment.overlays {
+            if let Some(file) = &overlay.data_file {
+                peak = add(peak, data_file_conversion(file)?)?;
+            }
+            if let Some(coverage) = &overlay.coverage {
+                match coverage {
+                    pb::data_overlay_file::Coverage::SharedOffsetBitmap(bytes) => {
+                        peak = add(peak, roaring_decode_admission(bytes)?)?
+                    }
+                    pb::data_overlay_file::Coverage::FieldCoverage(bitmaps) => {
+                        peak = add(
+                            peak,
+                            mul(
+                                mul(bitmaps.offset_bitmaps.len().max(4), 3)?,
+                                size_of::<Arc<roaring::RoaringBitmap>>(),
+                            )?,
+                        )?;
+                        for bytes in &bitmaps.offset_bitmaps {
+                            peak = add(peak, roaring_decode_admission(bytes)?)?;
+                        }
+                    }
+                }
+            }
+        }
+        if let Some(pb::data_fragment::LastUpdatedAtVersionSequence::InlineLastUpdatedAtVersions(
+            bytes,
+        )) = &fragment.last_updated_at_version_sequence
+        {
+            peak = add(peak, bytes.len() + 2 * size_of::<usize>())?;
+            version_metadata += 1;
+        }
+        if let Some(pb::data_fragment::CreatedAtVersionSequence::InlineCreatedAtVersions(bytes)) =
+            &fragment.created_at_version_sequence
+        {
+            peak = add(peak, bytes.len() + 2 * size_of::<usize>())?;
+            version_metadata += 1;
+        }
+    }
+    // Small interner Vec storage (up to 32 Arc entries) may coexist with the
+    // upgraded HashMap. Three tables bound old/new rehash storage.
+    for count in [data_files, data_files, version_metadata] {
+        peak = add(peak, mul(32, size_of::<Arc<[u8]>>())?)?;
+        peak = add(peak, table_peak::<Arc<[u8]>, ()>(count)?)?;
+    }
+    peak = add(
+        peak,
+        table_peak::<u32, crate::format::BasePath>(proto.base_paths.len())?,
+    )?;
+    for path in &proto.base_paths {
+        peak = add(
+            peak,
+            path.path.len() + path.name.as_ref().map(String::len).unwrap_or(0),
+        )?;
+    }
+    reserve_current(peak)
+}
+fn data_file_conversion(file: &pb::DataFile) -> Result<usize> {
+    let fields = mul(
+        add(file.fields.len(), file.column_indices.len())?,
+        size_of::<i32>(),
+    )?;
+    add(
+        fields,
+        4 * size_of::<usize>() + 2 * MemorySlice::<i32>::owner_overhead(),
+    )
+}
+pub(crate) fn retain_manifest(
+    reservation: Option<MemoryReservation>,
+    manifest: &mut Manifest,
+) -> Result<()> {
+    let Some(reservation) = reservation else {
+        return Ok(());
+    };
+    let owner = MemoryOwner::new(reservation);
+    manifest.memory_owner = MemoryOwnerHandle(Some(owner.clone()));
+    manifest.schema.memory_owner = Some(owner.clone());
+    let fragments = Arc::get_mut(&mut manifest.fragments)
+        .ok_or_else(|| Error::internal("manifest shared before metadata owner attachment"))?;
+    for fragment in fragments {
+        fragment.memory_owner = MemoryOwnerHandle(Some(owner.clone()));
+        for file in &mut fragment.files {
+            retain_file(file, &owner)?;
+        }
+        for overlay in &mut fragment.overlays {
+            retain_file(&mut overlay.data_file, &owner)?;
+        }
+    }
+    Ok(())
+}
+fn retain_file(file: &mut DataFile, owner: &Arc<MemoryOwner>) -> Result<()> {
+    file.fields.retain_interned_owner(owner.clone())?;
+    file.column_indices.retain_interned_owner(owner.clone())?;
+    file.memory_owner = MemoryOwnerHandle(Some(owner.clone()));
+    Ok(())
+}
+
+/// Roaring 0.11.4 deserialize layout admission. Reads only fixed wire headers;
+/// run containers retain intervals, array containers retain u16 values, bitmap
+/// containers allocate exactly 1024 u64 words. No encoded-size proxy is used.
+fn roaring_decode_admission(bytes: &[u8]) -> Result<usize> {
+    fn take<'a>(bytes: &'a [u8], pos: &mut usize, len: usize) -> Result<&'a [u8]> {
+        let end = add(*pos, len)?;
+        let value = bytes
+            .get(*pos..end)
+            .ok_or_else(|| Error::invalid_input("truncated overlay Roaring bitmap"))?;
+        *pos = end;
+        Ok(value)
+    }
+    fn u16_at(bytes: &[u8], pos: &mut usize) -> Result<u16> {
+        Ok(u16::from_le_bytes(take(bytes, pos, 2)?.try_into().unwrap()))
+    }
+    fn u32_at(bytes: &[u8], pos: &mut usize) -> Result<u32> {
+        Ok(u32::from_le_bytes(take(bytes, pos, 4)?.try_into().unwrap()))
+    }
+    let mut pos = 0;
+    let cookie = u32_at(bytes, &mut pos)?;
+    let (count, has_runs, has_offsets) = if cookie == 12346 {
+        (u32_at(bytes, &mut pos)? as usize, false, true)
+    } else if cookie as u16 == 12347 {
+        let count = ((cookie >> 16) + 1) as usize;
+        (count, true, count >= 4)
+    } else {
+        return Err(Error::invalid_input("invalid overlay Roaring cookie"));
+    };
+    if count > 65536 {
+        return Err(Error::invalid_input(
+            "overlay Roaring container count exceeds u16 key space",
+        ));
+    }
+    let run_bytes = if has_runs { count.div_ceil(8) } else { 0 };
+    let runs = take(bytes, &mut pos, run_bytes)?;
+    let description_bytes = mul(count, 4)?;
+    let descriptions = take(bytes, &mut pos, description_bytes)?;
+    let offset_bytes = if has_offsets { mul(count, 4)? } else { 0 };
+    take(bytes, &mut pos, offset_bytes)?;
+    // Sum every possible store variant's fields, tag, key and per-field
+    // alignment. This bounds the private Container layout without hardcoding
+    // a platform size or relying on an inaccessible Rust enum representation.
+    let alignment = std::mem::align_of::<u64>().max(std::mem::align_of::<usize>());
+    let container = size_of::<Vec<u16>>()
+        + size_of::<Vec<[u16; 2]>>()
+        + size_of::<Box<[u64; 1024]>>()
+        + 2 * size_of::<u64>()
+        + size_of::<u16>()
+        + size_of::<usize>()
+        + 7 * alignment;
+    let mut peak = add(
+        size_of::<roaring::RoaringBitmap>() + 2 * size_of::<usize>(),
+        mul(count, container)?,
+    )?;
+    peak = add(peak, add(add(run_bytes, description_bytes)?, offset_bytes)?)?;
+    for index in 0..count {
+        let cardinality = usize::from(u16::from_le_bytes(
+            descriptions[index * 4 + 2..index * 4 + 4]
+                .try_into()
+                .unwrap(),
+        )) + 1;
+        let payload = if has_runs && runs[index / 8] & (1 << (index % 8)) != 0 {
+            let count = usize::from(u16_at(bytes, &mut pos)?);
+            if count == 0 {
+                return Err(Error::invalid_input(
+                    "overlay Roaring run container has zero runs",
+                ));
+            }
+            take(bytes, &mut pos, mul(count, 4)?)?;
+            // Source run pairs plus old/new collect storage (at most 3n),
+            // including the first Vec capacity of four interval slots.
+            mul(mul(count, 4)?.max(5), size_of::<[u16; 2]>())?
+        } else if cardinality <= 4096 {
+            let len = mul(cardinality, size_of::<u16>())?;
+            take(bytes, &mut pos, len)?;
+            len
+        } else {
+            let len = size_of::<[u64; 1024]>();
+            take(bytes, &mut pos, len)?;
+            len
+        };
+        peak = add(peak, payload)?;
+    }
+    Ok(peak)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use lance_core::memory::{MemoryBudget, MemoryError, MemoryScope};
+    use prost::Message;
+    fn proto() -> pb::Manifest {
+        pb::Manifest {
+            fragments: vec![pb::DataFragment {
+                id: 0,
+                files: vec![pb::DataFile {
+                    path: "data.lance".into(),
+                    fields: (0..2048).collect(),
+                    column_indices: (0..2048).collect(),
+                    file_major_version: 2,
+                    file_minor_version: 2,
+                    ..Default::default()
+                }],
+                physical_rows: 10,
+                ..Default::default()
+            }],
+            version: 1,
+            ..Default::default()
+        }
+    }
+    #[test]
+    fn chunked_manifest_admission_precedes_prost_allocation() {
+        let wire = Bytes::from(proto().encode_to_vec());
+        let split = wire.len() / 2;
+        let chunks = [wire.slice(..split), wire.slice(split..)];
+        let budget = Arc::new(MemoryBudget::new(64).unwrap());
+        let _scope = MemoryScope::enter(Some(budget.clone()));
+        let error = reserve_manifest(chunks.iter()).unwrap_err();
+        assert!(MemoryError::find_in_chain(&error).is_some());
+        assert_eq!(budget.used(), 0);
+    }
+    #[test]
+    fn data_file_field_alias_retains_manifest_admission() {
+        let proto = proto();
+        let budget = Arc::new(MemoryBudget::new(1 << 24).unwrap());
+        let manifest = {
+            let _scope = MemoryScope::enter(Some(budget.clone()));
+            let reservation = reserve_conversion(&proto).unwrap();
+            let mut manifest = Manifest::try_from(proto).unwrap();
+            retain_manifest(reservation, &mut manifest).unwrap();
+            manifest
+        };
+        let fragments = manifest.fragments.clone();
+        let fields = fragments[0].files[0].fields.clone();
+        let resident = budget.used();
+        assert!(resident >= fields.len() * size_of::<i32>());
+        drop(manifest);
+        drop(fragments);
+        assert_eq!(budget.used(), resident);
+        assert_eq!(fields[2047], 2047);
+        drop(fields);
+        assert_eq!(budget.used(), 0);
+    }
+}
+#[cfg(test)]
+mod working_copy_tests {
+    use super::*;
+    use lance_core::memory::{MemoryBudget, MemoryError, MemoryScope};
+    #[test]
+    fn fragment_clone_is_admitted_and_retains_its_new_payload() {
+        let fragment = Fragment::new(0).with_file(
+            "file".repeat(1024),
+            vec![1],
+            vec![0],
+            lance_file::version::ConcreteFileVersion::V2_2,
+            None,
+        );
+        let denied = Arc::new(MemoryBudget::new(64).unwrap());
+        {
+            let _scope = MemoryScope::enter(Some(denied.clone()));
+            let error = fragment.try_clone().unwrap_err();
+            assert!(MemoryError::find_in_chain(&error).is_some());
+        }
+        assert_eq!(denied.used(), 0);
+        let budget = Arc::new(MemoryBudget::new(1 << 20).unwrap());
+        let copied = {
+            let _scope = MemoryScope::enter(Some(budget.clone()));
+            fragment.try_clone().unwrap()
+        };
+        assert_ne!(
+            fragment.files[0].path.as_ptr(),
+            copied.files[0].path.as_ptr()
+        );
+        assert_eq!(
+            fragment.files[0].fields.as_ptr(),
+            copied.files[0].fields.as_ptr()
+        );
+        assert_eq!(budget.used(), fragment.clone_admission_bytes().unwrap());
+        drop(copied);
+        assert_eq!(budget.used(), 0);
+    }
+}
+
+#[cfg(test)]
+mod roaring_tests {
+    use super::*;
+    use lance_core::memory::{MemoryBudget, MemoryError, MemoryScope};
+    #[test]
+    fn sparse_many_container_overlay_is_admitted_before_deserialize() {
+        let bitmap = roaring::RoaringBitmap::from_iter((0..256).map(|i| i << 16));
+        let mut wire = Vec::new();
+        bitmap.serialize_into(&mut wire).unwrap();
+        let admission = roaring_decode_admission(&wire).unwrap();
+        assert!(admission > wire.len());
+        let budget = Arc::new(MemoryBudget::new(wire.len()).unwrap());
+        let _scope = MemoryScope::enter(Some(budget.clone()));
+        let error = reserve_current(admission).unwrap_err();
+        assert!(MemoryError::find_in_chain(&error).is_some());
+        assert_eq!(budget.used(), 0);
+    }
+    #[test]
+    fn run_container_pairs_and_collect_peak_are_counted() {
+        // One run-format container: bit 0 selects a run, key 0/cardinality 3,
+        // one interval containing the inclusive values 0..=2. No offsets below 4 containers.
+        let wire = [
+            12347_u32.to_le_bytes().as_slice(),
+            &[1],
+            &[0, 0, 2, 0],
+            &[1, 0, 0, 0, 2, 0],
+        ]
+        .concat();
+        let admission = roaring_decode_admission(&wire).unwrap();
+        assert!(admission >= 5 * size_of::<[u16; 2]>());
+        assert_eq!(
+            roaring::RoaringBitmap::deserialize_from(wire.as_slice())
+                .unwrap()
+                .len(),
+            3
+        );
+    }
+    #[test]
+    fn invalid_container_count_is_rejected_without_heap_decode() {
+        let wire = [12346_u32.to_le_bytes(), u32::MAX.to_le_bytes()].concat();
+        assert!(roaring_decode_admission(&wire).is_err());
+        assert!(roaring_decode_admission(&[0, 0, 0]).is_err());
+    }
+}
