+async fn check_native_memory_uring_reader(current_thread: bool) -> Result<()> {
+    use lance_core::memory::{MemoryBudget, MemoryError, MemoryScope};
+    use std::sync::Arc;
+
+    let (file, expected) = create_test_file(16384)?;
+    let path = object_store::path::Path::from_filesystem_path(file.path())?;
+    let tracker = Arc::new(crate::utils::tracking_store::IOTracker::default());
+    let reader = if current_thread {
+        super::UringCurrentThreadReader::open(&path, 4096, Some(16384), tracker).await?
+    } else {
+        super::UringReader::open(&path, 4096, Some(16384), tracker).await?
+    };
+    let denied = Arc::new(MemoryBudget::new(4095)?);
+    let future = {
+        let _scope = MemoryScope::enter(Some(denied.clone()));
+        reader.get_range(4096..8192)
+    };
+    let error = future.await.unwrap_err();
+    assert!(MemoryError::find_in_chain(&error).is_some(), "{error:?}");
+    assert_eq!(denied.used(), 0);
+
+    let owner = Arc::new(MemoryBudget::new(4096)?);
+    let future = {
+        let _scope = MemoryScope::enter(Some(owner.clone()));
+        reader.get_range(4096..8192)
+    };
+    let bytes = future.await?;
+    assert_eq!(bytes.as_ref(), &expected[4096..8192]);
+    let slice = bytes.slice(3..19);
+    drop((bytes, reader));
+    owner.cancel();
+    assert_eq!(owner.used(), 4096);
+    assert_eq!(slice.as_ref(), &expected[4099..4115]);
+    drop(slice);
+    assert_eq!(owner.used(), 0);
+    Ok(())
+}
