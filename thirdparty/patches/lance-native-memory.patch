+#[cfg(test)]
+mod native_memory_tests {
+    use super::*;
+    use lance_core::memory::{MemoryBudget, MemoryError, MemoryScope};
+
+    #[test]
+    fn native_memory_dense_count_matrix_rejects_before_builder_allocation() {
+        let owner = Arc::new(MemoryBudget::new(8192).unwrap());
+        let _scope = MemoryScope::enter(Some(owner.clone()));
+        let error = count_output_memory(1024, 64, 0, false).unwrap_err();
+        assert!(matches!(
+            MemoryError::find_in_chain(&error),
+            Some(MemoryError::LimitExceeded { .. })
+        ));
+        assert_eq!(owner.used(), 0);
+    }
+
+    #[test]
+    fn native_memory_dense_count_matrix_owner_follows_arrow_slices() {
+        let owner = Arc::new(MemoryBudget::new(1 << 20).unwrap());
+        let scope = MemoryScope::enter(Some(owner.clone()));
+        let memory = count_output_memory(16, 3, 0, false).unwrap();
+        let mut rows = UInt64Builder::with_capacity(16);
+        let mut lengths = UInt64Builder::with_capacity(16);
+        let mut counts =
+            FixedSizeListBuilder::with_capacity(UInt64Builder::with_capacity(48), 3, 16);
+        for row in 0..16 {
+            rows.append_value(row);
+            lengths.append_value(1);
+            for _ in 0..3 {
+                counts.values().append_value(1);
+            }
+            counts.append(true);
+        }
+        let batch = RecordBatch::try_from_iter([
+            ("row", Arc::new(rows.finish()) as ArrayRef),
+            ("length", Arc::new(lengths.finish()) as ArrayRef),
+            ("counts", Arc::new(counts.finish()) as ArrayRef),
+        ])
+        .unwrap();
+        let owned = retain_flat_batch(batch, memory).unwrap();
+        let slice = owned.slice(1, 2);
+        drop(scope);
+        drop(owned);
+        assert!(owner.used() >= (16 + 16 + 48) * 8);
+        drop(slice);
+        assert_eq!(owner.used(), 0);
+    }
+}
