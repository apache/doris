@@ -0,0 +1,787 @@
+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright The Lance Authors
+
+use std::collections::{HashMap, HashSet};
+use std::ptr::NonNull;
+use std::sync::Arc;
+
+use arrow_array::{Array, ArrayRef, make_array};
+use arrow_buffer::{BooleanBuffer, Buffer, NullBuffer};
+use arrow_data::ArrayData;
+use arrow_schema::ArrowError;
+use arrow_schema::{DataType, UnionMode};
+
+use super::{BudgetedVec, MAX_BYTES, MemoryBudget, MemoryReservation, MemoryScope};
+use crate::{Error, Result};
+
+/// Allocate cache-line-aligned storage under the current owner before initializing.
+pub fn allocate_current_buffer(
+    bytes: usize,
+    initialize: impl FnOnce(&mut [u8]) -> Result<()>,
+) -> Result<Buffer> {
+    let owner = match MemoryScope::current() {
+        Some(owner) => owner,
+        None => Arc::new(MemoryBudget::new(MAX_BYTES)?),
+    };
+    owner.allocate_buffer(bytes, initialize)
+}
+
+fn zeroed(bytes: usize) -> Result<Buffer> {
+    allocate_current_buffer(bytes, |_| Ok(()))
+}
+
+fn multiply(left: usize, right: usize) -> Result<usize> {
+    left.checked_mul(right)
+        .ok_or_else(|| Error::invalid_input("null array buffer size overflow"))
+}
+
+fn add(left: usize, right: usize) -> Result<usize> {
+    left.checked_add(right)
+        .ok_or_else(|| Error::invalid_input("Arrow kernel admission size overflow"))
+}
+
+fn aligned(bytes: usize) -> Result<usize> {
+    Ok(add(bytes, 63)? & !63)
+}
+
+fn growth_peak(initial: usize, required: usize) -> Result<usize> {
+    let initial = aligned(initial)?;
+    let required = aligned(required)?;
+    if initial >= required {
+        Ok(initial)
+    } else {
+        // MutableBuffer doubles capacity when a preallocation is insufficient.
+        // During realloc both old (< required) and new (< 2 * required) blocks
+        // can coexist. Reserve that peak, including cache-line rounding.
+        multiply(required, 3)
+    }
+}
+
+fn selected_byte_size(inputs: &[ArrayData], large: bool) -> Result<usize> {
+    inputs.iter().try_fold(0_usize, |total, input| {
+        let length = if large {
+            let offsets = input.buffer::<i64>(0);
+            usize::try_from(offsets[input.len()] - offsets[0])
+                .map_err(|_| Error::invalid_input("invalid concat byte offsets"))?
+        } else {
+            let offsets = input.buffer::<i32>(0);
+            usize::try_from(offsets[input.len()] - offsets[0])
+                .map_err(|_| Error::invalid_input("invalid concat byte offsets"))?
+        };
+        add(total, length)
+    })
+}
+
+fn selected_list_children(inputs: &[ArrayData], large: bool) -> Result<Vec<ArrayData>> {
+    inputs
+        .iter()
+        .map(|input| {
+            let (start, end) = if large {
+                let offsets = input.buffer::<i64>(0);
+                (offsets[0], offsets[input.len()])
+            } else {
+                let offsets = input.buffer::<i32>(0);
+                (i64::from(offsets[0]), i64::from(offsets[input.len()]))
+            };
+            let start = usize::try_from(start)
+                .map_err(|_| Error::invalid_input("negative concat list offset"))?;
+            let end = usize::try_from(end)
+                .map_err(|_| Error::invalid_input("negative concat list offset"))?;
+            Ok(input.child_data()[0].slice(start, end - start))
+        })
+        .collect()
+}
+
+// MutableArrayData propagates its initial capacity to children. A Map's entry
+// count and a fixed-list Struct child's string bytes can exceed this initial
+// estimate, so their generic fallback needs reallocation peaks recursively.
+fn mutable_concat_admission(inputs: &[ArrayData], capacity: usize) -> Result<usize> {
+    let first = inputs
+        .first()
+        .ok_or_else(|| Error::invalid_input("concat requires input arrays"))?;
+    if inputs
+        .iter()
+        .any(|input| input.data_type() != first.data_type())
+    {
+        return Err(Error::invalid_input(
+            "concat inputs have different data types",
+        ));
+    }
+    let rows = inputs
+        .iter()
+        .try_fold(0_usize, |rows, input| add(rows, input.len()))?;
+    let mut bytes = growth_peak(capacity.div_ceil(8), rows.div_ceil(8))?;
+    if let Some(width) = first.data_type().primitive_width() {
+        return add(
+            bytes,
+            growth_peak(multiply(capacity, width)?, multiply(rows, width)?)?,
+        );
+    }
+    match first.data_type() {
+        DataType::Null => return Ok(0),
+        DataType::Boolean => {
+            bytes = add(bytes, growth_peak(capacity.div_ceil(8), rows.div_ceil(8))?)?
+        }
+        DataType::Utf8 | DataType::Binary | DataType::LargeUtf8 | DataType::LargeBinary => {
+            let large = matches!(
+                first.data_type(),
+                DataType::LargeUtf8 | DataType::LargeBinary
+            );
+            let width = if large { 8 } else { 4 };
+            bytes = add(
+                bytes,
+                growth_peak(
+                    multiply(add(capacity, 1)?, width)?,
+                    multiply(add(rows, 1)?, width)?,
+                )?,
+            )?;
+            bytes = add(
+                bytes,
+                growth_peak(capacity, selected_byte_size(inputs, large)?)?,
+            )?;
+        }
+        DataType::Utf8View | DataType::BinaryView => {
+            bytes = add(
+                bytes,
+                growth_peak(multiply(capacity, 16)?, multiply(rows, 16)?)?,
+            )?
+        }
+        DataType::FixedSizeBinary(width) => {
+            let width = usize::try_from(*width)
+                .map_err(|_| Error::invalid_input("negative fixed binary width"))?;
+            bytes = add(
+                bytes,
+                growth_peak(multiply(capacity, width)?, multiply(rows, width)?)?,
+            )?;
+        }
+        DataType::FixedSizeList(_, dimension) => {
+            let dimension = usize::try_from(*dimension)
+                .map_err(|_| Error::invalid_input("negative fixed list dimension"))?;
+            let children = inputs
+                .iter()
+                .map(|input| {
+                    Ok(input.child_data()[0].slice(
+                        multiply(input.offset(), dimension)?,
+                        multiply(input.len(), dimension)?,
+                    ))
+                })
+                .collect::<Result<Vec<_>>>()?;
+            bytes = add(
+                bytes,
+                mutable_concat_admission(&children, multiply(capacity, dimension)?)?,
+            )?;
+        }
+        DataType::Struct(fields) => {
+            for column in 0..fields.len() {
+                let children = inputs
+                    .iter()
+                    .map(|input| input.child_data()[column].clone())
+                    .collect::<Vec<_>>();
+                bytes = add(bytes, mutable_concat_admission(&children, capacity)?)?;
+            }
+        }
+        DataType::List(_) | DataType::LargeList(_) | DataType::Map(_, _) => {
+            let large = matches!(first.data_type(), DataType::LargeList(_));
+            let width = if large { 8 } else { 4 };
+            bytes = add(
+                bytes,
+                growth_peak(
+                    multiply(add(capacity, 1)?, width)?,
+                    multiply(add(rows, 1)?, width)?,
+                )?,
+            )?;
+            bytes = add(
+                bytes,
+                mutable_concat_admission(&selected_list_children(inputs, large)?, capacity)?,
+            )?;
+        }
+        other => {
+            return Err(Error::not_supported(format!(
+                "budgeted Arrow mutable concat admission for {other}"
+            )));
+        }
+    }
+    Ok(bytes)
+}
+
+/// Upper bound for Arrow 58.3 concat's data-buffer allocations and reallocations.
+///
+/// Builders for primitive, Boolean, byte, and fixed-list arrays preallocate the
+/// complete output. List offset collection starts with an iterator lower bound;
+/// Rust's Vec doubles capacity, so simultaneous old and new storage is less than
+/// three complete offset buffers. Struct/list children are concatenated
+/// recursively. Control objects and array-reference vectors are excluded.
+pub fn concat_admission_bytes(inputs: &[ArrayData]) -> Result<usize> {
+    if inputs.len() == 1 {
+        return Ok(0);
+    }
+    let first = inputs
+        .first()
+        .ok_or_else(|| Error::invalid_input("concat requires input arrays"))?;
+    let rows = inputs
+        .iter()
+        .try_fold(0_usize, |rows, input| add(rows, input.len()))?;
+    let mut bytes = aligned(rows.div_ceil(8))?;
+    if let Some(width) = first.data_type().primitive_width() {
+        return add(bytes, aligned(multiply(rows, width)?)?);
+    }
+    match first.data_type() {
+        DataType::Null => return Ok(0),
+        DataType::Boolean => bytes = add(bytes, aligned(rows.div_ceil(8))?)?,
+        DataType::Utf8 | DataType::Binary | DataType::LargeUtf8 | DataType::LargeBinary => {
+            let large = matches!(
+                first.data_type(),
+                DataType::LargeUtf8 | DataType::LargeBinary
+            );
+            let width = if large { 8 } else { 4 };
+            bytes = add(bytes, aligned(multiply(add(rows, 1)?, width)?)?)?;
+            let values = inputs.iter().try_fold(0_usize, |total, input| {
+                let length = if large {
+                    let offsets = input.buffer::<i64>(0);
+                    usize::try_from(offsets[input.len()] - offsets[0])
+                        .map_err(|_| Error::invalid_input("invalid concat byte offsets"))?
+                } else {
+                    let offsets = input.buffer::<i32>(0);
+                    usize::try_from(offsets[input.len()] - offsets[0])
+                        .map_err(|_| Error::invalid_input("invalid concat byte offsets"))?
+                };
+                add(total, length)
+            })?;
+            bytes = add(bytes, aligned(values)?)?;
+        }
+        DataType::Utf8View | DataType::BinaryView => {
+            bytes = add(bytes, aligned(multiply(rows, 16)?)?)?
+        }
+        DataType::FixedSizeBinary(width) => {
+            let width = usize::try_from(*width)
+                .map_err(|_| Error::invalid_input("negative fixed binary width"))?;
+            bytes = add(bytes, aligned(multiply(rows, width)?)?)?;
+        }
+        DataType::FixedSizeList(_, _) | DataType::Map(_, _) => {
+            return mutable_concat_admission(inputs, rows);
+        }
+        DataType::Struct(fields) => {
+            for column in 0..fields.len() {
+                let children = inputs
+                    .iter()
+                    .map(|input| input.child_data()[column].clone())
+                    .collect::<Vec<_>>();
+                bytes = add(bytes, concat_admission_bytes(&children)?)?;
+            }
+        }
+        DataType::List(_) | DataType::LargeList(_) => {
+            let large = matches!(first.data_type(), DataType::LargeList(_));
+            let width = if large { 8 } else { 4 };
+            bytes = add(
+                bytes,
+                aligned(multiply(multiply(add(rows, 1)?, width)?, 3)?)?,
+            )?;
+            let children = inputs
+                .iter()
+                .map(|input| {
+                    let (start, end) = if large {
+                        let offsets = input.buffer::<i64>(0);
+                        (offsets[0], offsets[input.len()])
+                    } else {
+                        let offsets = input.buffer::<i32>(0);
+                        (i64::from(offsets[0]), i64::from(offsets[input.len()]))
+                    };
+                    let start = usize::try_from(start)
+                        .map_err(|_| Error::invalid_input("negative concat list offset"))?;
+                    let end = usize::try_from(end)
+                        .map_err(|_| Error::invalid_input("negative concat list offset"))?;
+                    Ok(input.child_data()[0].slice(start, end - start))
+                })
+                .collect::<Result<Vec<_>>>()?;
+            bytes = add(bytes, concat_admission_bytes(&children)?)?;
+        }
+        other => {
+            return Err(Error::not_supported(format!(
+                "budgeted Arrow concat admission for {other}"
+            )));
+        }
+    }
+    Ok(bytes)
+}
+
+#[derive(Debug)]
+struct RetainedBuffer {
+    // Field order keeps accounting until the original Arrow owner is released.
+    buffer: Buffer,
+    reservation: MemoryReservation,
+}
+
+fn collect_input_allocations(data: &ArrayData, allocations: &mut HashSet<usize>) {
+    for buffer in data
+        .buffers()
+        .iter()
+        .chain(data.nulls().map(|nulls| nulls.buffer()))
+    {
+        allocations.insert(buffer.data_ptr().as_ptr() as usize);
+    }
+    for child in data.child_data() {
+        collect_input_allocations(child, allocations);
+    }
+}
+
+fn retain_buffer(
+    buffer: &Buffer,
+    reservation: &mut MemoryReservation,
+    inputs: &HashSet<usize>,
+    owners: &mut HashMap<usize, Arc<RetainedBuffer>>,
+) -> Result<Buffer> {
+    let allocation = buffer.data_ptr().as_ptr() as usize;
+    if buffer.capacity() == 0 || inputs.contains(&allocation) {
+        return Ok(buffer.clone());
+    }
+    let owner = match owners.get(&allocation) {
+        Some(owner) => owner.clone(),
+        None => {
+            // The caller reserved a proven kernel peak before invoking Arrow.
+            // This check catches an incorrect bound; it never adds accounting
+            // after a kernel allocation or allows the result to escape unowned.
+            let lease = reservation.split_off(buffer.capacity()).map_err(|error| {
+                Error::internal(format!(
+                    "Arrow kernel exceeded its admitted buffer bound: {error}"
+                ))
+            })?;
+            let owner = Arc::new(RetainedBuffer {
+                buffer: buffer.clone(),
+                reservation: lease,
+            });
+            owners.insert(allocation, owner.clone());
+            owner
+        }
+    };
+    debug_assert!(owner.reservation.bytes() >= buffer.capacity());
+    debug_assert_eq!(owner.buffer.data_ptr(), buffer.data_ptr());
+    let pointer = NonNull::new(buffer.as_ptr() as *mut u8).unwrap_or(NonNull::dangling());
+    // SAFETY: owner retains the complete original allocation and its lease.
+    // The new buffer exposes precisely the same validated slice as the original.
+    Ok(unsafe { Buffer::from_custom_allocation(pointer, buffer.len(), owner) })
+}
+
+fn retain_data(
+    data: ArrayData,
+    reservation: &mut MemoryReservation,
+    inputs: &HashSet<usize>,
+    owners: &mut HashMap<usize, Arc<RetainedBuffer>>,
+) -> Result<ArrayData> {
+    let buffers = data
+        .buffers()
+        .iter()
+        .map(|buffer| retain_buffer(buffer, reservation, inputs, owners))
+        .collect::<Result<Vec<_>>>()?;
+    let children = data
+        .child_data()
+        .iter()
+        .cloned()
+        .map(|child| retain_data(child, reservation, inputs, owners))
+        .collect::<Result<Vec<_>>>()?;
+    let nulls = data
+        .nulls()
+        .map(|nulls| {
+            let buffer = retain_buffer(nulls.buffer(), reservation, inputs, owners)?;
+            let bitmap = BooleanBuffer::new(buffer, nulls.offset(), nulls.len());
+            // SAFETY: this replaces storage ownership without changing bitmap bits,
+            // offset, or length, so the original validated null count is preserved.
+            Ok::<_, Error>(unsafe { NullBuffer::new_unchecked(bitmap, nulls.null_count()) })
+        })
+        .transpose()?;
+    Ok(data
+        .into_builder()
+        .buffers(buffers)
+        .child_data(children)
+        .nulls(nulls)
+        .build()?)
+}
+
+/// Attach previously admitted kernel storage to every newly allocated Arrow owner.
+///
+/// The caller must reserve a proven upper bound for output and temporary kernel
+/// storage **before** invoking the kernel. Input allocations shared by its result
+/// retain their existing owners; repeated slices of a new allocation are charged
+/// once. Admission left after attaching the result is released only when the
+/// completed kernel and its temporary buffers are gone.
+pub fn retain_array_buffers(
+    mut reservation: MemoryReservation,
+    inputs: &[ArrayData],
+    output: ArrayData,
+) -> Result<ArrayData> {
+    let mut input_allocations = HashSet::new();
+    for input in inputs {
+        collect_input_allocations(input, &mut input_allocations);
+    }
+    retain_data(
+        output,
+        &mut reservation,
+        &input_allocations,
+        &mut HashMap::new(),
+    )
+}
+
+/// Arrow-compatible concat with pre-admitted kernel storage and retained owners.
+pub fn concat(arrays: &[&dyn Array]) -> std::result::Result<ArrayRef, ArrowError> {
+    let Some(owner) = MemoryScope::current() else {
+        return arrow_select::concat::concat(arrays);
+    };
+    let inputs = arrays
+        .iter()
+        .map(|array| array.to_data())
+        .collect::<Vec<_>>();
+    let reservation = owner.reserve(concat_admission_bytes(&inputs)?)?;
+    let _kernel_scope = arrow_select::memory::KernelMemoryScope::enter(None);
+    let output = arrow_select::concat::concat(arrays)?;
+    Ok(make_array(retain_array_buffers(
+        reservation,
+        &inputs,
+        output.to_data(),
+    )?))
+}
+
+/// Construct Arrow's null-array layout with admission before every data buffer.
+///
+/// The storage retains its reservation through Arrow clones, slices, and C Data
+/// exports. Nested arrays admit their own buffers; failure releases everything
+/// already constructed without changing the caller's existing arrays.
+pub fn try_null_array(data_type: &DataType, len: usize) -> Result<ArrayData> {
+    let bit_len = len.div_ceil(8);
+    let offsets_len = len
+        .checked_add(1)
+        .ok_or_else(|| Error::invalid_input("null array offset count overflow"))?;
+    let (buffers, children, has_nulls) = match data_type.primitive_width() {
+        Some(width) => (vec![zeroed(multiply(width, len)?)?], vec![], true),
+        None => match data_type {
+            DataType::Null => (vec![], vec![], false),
+            DataType::Boolean => (vec![zeroed(bit_len)?], vec![], true),
+            DataType::Binary | DataType::Utf8 => (
+                vec![zeroed(multiply(offsets_len, 4)?)?, zeroed(0)?],
+                vec![],
+                true,
+            ),
+            DataType::BinaryView | DataType::Utf8View => {
+                (vec![zeroed(multiply(len, 16)?)?], vec![], true)
+            }
+            DataType::LargeBinary | DataType::LargeUtf8 => (
+                vec![zeroed(multiply(offsets_len, 8)?)?, zeroed(0)?],
+                vec![],
+                true,
+            ),
+            DataType::FixedSizeBinary(width) => {
+                let width = usize::try_from(*width)
+                    .map_err(|_| Error::invalid_input("negative fixed binary width"))?;
+                (vec![zeroed(multiply(width, len)?)?], vec![], true)
+            }
+            DataType::List(field) | DataType::Map(field, _) => (
+                vec![zeroed(multiply(offsets_len, 4)?)?],
+                vec![try_null_array(field.data_type(), 0)?],
+                true,
+            ),
+            DataType::LargeList(field) => (
+                vec![zeroed(multiply(offsets_len, 8)?)?],
+                vec![try_null_array(field.data_type(), 0)?],
+                true,
+            ),
+            DataType::ListView(field) => (
+                vec![zeroed(multiply(len, 4)?)?, zeroed(multiply(len, 4)?)?],
+                vec![try_null_array(field.data_type(), 0)?],
+                true,
+            ),
+            DataType::LargeListView(field) => (
+                vec![zeroed(multiply(len, 8)?)?, zeroed(multiply(len, 8)?)?],
+                vec![try_null_array(field.data_type(), 0)?],
+                true,
+            ),
+            DataType::FixedSizeList(field, dimension) => {
+                let dimension = usize::try_from(*dimension)
+                    .map_err(|_| Error::invalid_input("negative fixed list dimension"))?;
+                (
+                    vec![],
+                    vec![try_null_array(
+                        field.data_type(),
+                        multiply(dimension, len)?,
+                    )?],
+                    true,
+                )
+            }
+            DataType::Struct(fields) => (
+                vec![],
+                fields
+                    .iter()
+                    .map(|field| try_null_array(field.data_type(), len))
+                    .collect::<Result<Vec<_>>>()?,
+                true,
+            ),
+            DataType::Dictionary(key, value) => {
+                let width = key
+                    .primitive_width()
+                    .ok_or_else(|| Error::invalid_input("dictionary key has no primitive width"))?;
+                (
+                    vec![zeroed(multiply(width, len)?)?],
+                    vec![try_null_array(value, 0)?],
+                    true,
+                )
+            }
+            DataType::Union(fields, mode) => {
+                let (id, _) = fields
+                    .iter()
+                    .next()
+                    .ok_or_else(|| Error::invalid_input("null union requires a child"))?;
+                let ids = BudgetedVec::try_filled(len, id)?.into_buffer();
+                let buffers = match mode {
+                    UnionMode::Sparse => vec![ids],
+                    UnionMode::Dense => {
+                        let end = i32::try_from(len)
+                            .map_err(|_| Error::invalid_input("dense union length exceeds i32"))?;
+                        let mut offsets = BudgetedVec::try_with_capacity(len)?;
+                        for offset in 0..end {
+                            offsets.try_push(offset)?;
+                        }
+                        vec![ids, offsets.into_buffer()]
+                    }
+                };
+                let children = fields
+                    .iter()
+                    .enumerate()
+                    .map(|(index, (_, field))| {
+                        try_null_array(
+                            field.data_type(),
+                            if index == 0 || *mode == UnionMode::Sparse {
+                                len
+                            } else {
+                                0
+                            },
+                        )
+                    })
+                    .collect::<Result<Vec<_>>>()?;
+                (buffers, children, false)
+            }
+            DataType::RunEndEncoded(run_ends, values) => {
+                if len == 0 {
+                    (
+                        vec![],
+                        vec![
+                            try_null_array(run_ends.data_type(), 0)?,
+                            try_null_array(values.data_type(), 0)?,
+                        ],
+                        false,
+                    )
+                } else {
+                    let run = match run_ends.data_type() {
+                        DataType::Int16 => BudgetedVec::try_filled(
+                            1,
+                            i16::try_from(len)
+                                .map_err(|_| Error::invalid_input("run end exceeds i16"))?,
+                        )?
+                        .into_buffer(),
+                        DataType::Int32 => BudgetedVec::try_filled(
+                            1,
+                            i32::try_from(len)
+                                .map_err(|_| Error::invalid_input("run end exceeds i32"))?,
+                        )?
+                        .into_buffer(),
+                        DataType::Int64 => BudgetedVec::try_filled(
+                            1,
+                            i64::try_from(len)
+                                .map_err(|_| Error::invalid_input("run end exceeds i64"))?,
+                        )?
+                        .into_buffer(),
+                        other => {
+                            return Err(Error::invalid_input(format!(
+                                "invalid run end data type: {other}"
+                            )));
+                        }
+                    };
+                    let runs = ArrayData::builder(run_ends.data_type().clone())
+                        .len(1)
+                        .buffers(vec![run])
+                        .build()?;
+                    (
+                        vec![],
+                        vec![runs, try_null_array(values.data_type(), 1)?],
+                        false,
+                    )
+                }
+            }
+            other => return Err(Error::not_supported(format!("null array type {other}"))),
+        },
+    };
+    let nulls = if has_nulls {
+        Some(NullBuffer::new(BooleanBuffer::new(
+            zeroed(bit_len)?,
+            0,
+            len,
+        )))
+    } else {
+        None
+    };
+    Ok(ArrayData::builder(data_type.clone())
+        .len(len)
+        .buffers(buffers)
+        .child_data(children)
+        .nulls(nulls)
+        .build()?)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::memory::MemoryError;
+    use arrow_schema::Field;
+
+    #[test]
+    fn nested_null_buffers_follow_arrow_layout_and_budget() {
+        let data_type = DataType::Struct(
+            vec![
+                Field::new(
+                    "vector",
+                    DataType::FixedSizeList(
+                        Arc::new(Field::new("item", DataType::Float32, true)),
+                        8,
+                    ),
+                    true,
+                ),
+                Field::new("text", DataType::Utf8, true),
+            ]
+            .into(),
+        );
+        let owner = Arc::new(MemoryBudget::new(4096).unwrap());
+        let actual = {
+            let _scope = MemoryScope::enter(Some(owner.clone()));
+            try_null_array(&data_type, 16).unwrap()
+        };
+        assert_eq!(actual, ArrayData::new_null(&data_type, 16));
+        assert!(owner.used() > 512);
+        drop(actual);
+        assert_eq!(owner.used(), 0);
+    }
+
+    #[test]
+    fn empty_primitive_null_arrays_are_aligned_with_a_zero_budget() {
+        let owner = Arc::new(MemoryBudget::new(0).unwrap());
+        let _scope = MemoryScope::enter(Some(owner.clone()));
+        for data_type in [
+            DataType::Int32,
+            DataType::Float64,
+            DataType::Decimal128(38, 0),
+            DataType::Decimal256(76, 0),
+        ] {
+            let data = try_null_array(&data_type, 0).unwrap();
+            data.validate_full().unwrap();
+            assert_eq!(data.buffers()[0].capacity(), 0);
+            assert_eq!(
+                data.buffers()[0].as_ptr() as usize % arrow_buffer::alloc::ALIGNMENT,
+                0
+            );
+            assert_eq!(owner.used(), 0);
+        }
+    }
+
+    #[test]
+    fn null_list_and_dictionary_keep_empty_primitive_children_aligned() {
+        let owner = Arc::new(MemoryBudget::new(32).unwrap());
+        let (list, dictionary) = {
+            let _scope = MemoryScope::enter(Some(owner.clone()));
+            (
+                try_null_array(
+                    &DataType::List(Arc::new(Field::new("item", DataType::Int32, true))),
+                    3,
+                )
+                .unwrap(),
+                try_null_array(
+                    &DataType::Dictionary(Box::new(DataType::Int8), Box::new(DataType::Float64)),
+                    3,
+                )
+                .unwrap(),
+            )
+        };
+        for data in [&list, &dictionary] {
+            data.validate_full().unwrap();
+            let child = &data.child_data()[0];
+            assert_eq!(child.len(), 0);
+            assert_eq!(child.buffers()[0].capacity(), 0);
+            assert_eq!(
+                child.buffers()[0].as_ptr() as usize % arrow_buffer::alloc::ALIGNMENT,
+                0
+            );
+        }
+        // List offsets + validity, and dictionary keys + validity; empty
+        // child data and child validity buffers allocate no payload bytes.
+        assert_eq!(owner.used(), 16 + 1 + 3 + 1);
+        drop((list, dictionary));
+        assert_eq!(owner.used(), 0);
+    }
+
+    #[test]
+    fn null_values_reject_before_a_large_data_buffer_is_constructed() {
+        let owner = Arc::new(MemoryBudget::new(128).unwrap());
+        let _scope = MemoryScope::enter(Some(owner.clone()));
+        let error = try_null_array(&DataType::Float64, 1024).unwrap_err();
+        assert!(matches!(
+            MemoryError::find_in_chain(&error),
+            Some(MemoryError::LimitExceeded {
+                requested: 8192,
+                ..
+            })
+        ));
+        assert_eq!(owner.used(), 0);
+    }
+    #[test]
+    fn kernel_output_slices_share_one_capacity_reservation() {
+        let owner = Arc::new(MemoryBudget::new(32).unwrap());
+        let reservation = owner.reserve(32).unwrap();
+        let buffer = Buffer::from_vec(vec![7_i32; 8]);
+        let left = ArrayData::builder(DataType::Int32)
+            .len(4)
+            .buffers(vec![buffer.slice_with_length(0, 16)])
+            .build()
+            .unwrap();
+        let right = ArrayData::builder(DataType::Int32)
+            .len(4)
+            .buffers(vec![buffer.slice_with_length(16, 16)])
+            .build()
+            .unwrap();
+        drop(buffer);
+        let data_type = DataType::Struct(
+            vec![
+                Field::new("a", DataType::Int32, false),
+                Field::new("b", DataType::Int32, false),
+            ]
+            .into(),
+        );
+        let output = ArrayData::builder(data_type)
+            .len(4)
+            .child_data(vec![left, right])
+            .build()
+            .unwrap();
+        let retained = retain_array_buffers(reservation, &[], output).unwrap();
+        assert_eq!(owner.used(), 32);
+        let escaped = retained.child_data()[1].buffers()[0].slice_with_length(0, 4);
+        drop(retained);
+        assert_eq!(owner.used(), 32);
+        drop(escaped);
+        assert_eq!(owner.used(), 0);
+    }
+
+    #[test]
+    fn kernel_reused_input_allocation_is_not_charged_twice() {
+        let source = ArrayData::builder(DataType::Int32)
+            .len(4)
+            .buffers(vec![Buffer::from_vec(vec![7_i32; 4])])
+            .build()
+            .unwrap();
+        let owner = Arc::new(MemoryBudget::new(64).unwrap());
+        let reservation = owner.reserve(64).unwrap();
+        let retained = retain_array_buffers(
+            reservation,
+            std::slice::from_ref(&source),
+            source.slice(1, 2),
+        )
+        .unwrap();
+        assert_eq!(owner.used(), 0);
+        assert_eq!(
+            retained.buffers()[0].data_ptr(),
+            source.buffers()[0].data_ptr()
+        );
+    }
+}
