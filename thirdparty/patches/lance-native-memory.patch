@@ -0,0 +1,130 @@
+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright The Lance Authors
+
+use std::sync::{Arc, Mutex};
+
+use super::{MemoryAccountant, MemoryBudget, MemoryReservation};
+use crate::Result;
+
+/// An allocation owner's accounting that can move from a query to a cache.
+///
+/// A loader first admits actual payload allocations through its query. When the
+/// completed entry is accepted into a shared cache, transferring this accountant
+/// reserves its live bytes in the process budget before releasing the query.
+/// Every outstanding Arrow or byte owner retains its child budget, so eviction
+/// cannot release storage still held by an active reader.
+#[derive(Debug)]
+pub struct TransferableAccountant {
+    // The lock only serializes byte accounting and the ownership exchange; no
+    // I/O, query work, or cache operations may execute while it is held.
+    parent: Mutex<MemoryReservation>,
+}
+
+impl TransferableAccountant {
+    /// Start a loader owned by `parent`; cancellation is checked immediately.
+    pub fn new(parent: &Arc<MemoryBudget>) -> Result<Arc<Self>> {
+        Ok(Arc::new(Self {
+            parent: Mutex::new(parent.reserve(0)?),
+        }))
+    }
+
+    /// Atomically move all live payload bytes after destination admission.
+    ///
+    /// Failure retains the original owner and leaves both counters unchanged.
+    /// Concurrent frees and new reservations are serialized with the transfer.
+    pub fn transfer_to(&self, parent: &Arc<MemoryBudget>) -> Result<()> {
+        let mut current = self.parent.lock().expect("accounting lock is not poisoned");
+        let replacement = parent.reserve(current.bytes())?;
+        *current = replacement;
+        Ok(())
+    }
+}
+
+impl MemoryAccountant for TransferableAccountant {
+    fn try_reserve(&self, bytes: usize) -> Result<()> {
+        self.parent
+            .lock()
+            .expect("accounting lock is not poisoned")
+            .try_grow(bytes)
+    }
+
+    fn release(&self, bytes: usize) {
+        let mut current = self.parent.lock().expect("accounting lock is not poisoned");
+        let remaining = current
+            .bytes()
+            .checked_sub(bytes)
+            .expect("balanced cache payload release");
+        current
+            .shrink_to(remaining)
+            .expect("shrinking reservation cannot fail");
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::memory::MemoryError;
+
+    #[test]
+    fn completed_payload_transfers_then_outlives_cache_owner() {
+        let query = Arc::new(MemoryBudget::new(64).unwrap());
+        let process = Arc::new(MemoryBudget::new(64).unwrap());
+        let accountant = TransferableAccountant::new(&query).unwrap();
+        let child = Arc::new(
+            MemoryBudget::new(64)
+                .unwrap()
+                .with_accountant(accountant.clone()),
+        );
+        let payload = child.allocate_buffer(64, |_| Ok(())).unwrap();
+        assert_eq!(query.used(), 64);
+        accountant.transfer_to(&process).unwrap();
+        assert_eq!(query.used(), 0);
+        assert_eq!(process.used(), 64);
+        drop((accountant, child));
+        assert_eq!(process.used(), 64);
+        drop(payload);
+        assert_eq!(process.used(), 0);
+    }
+
+    #[test]
+    fn failed_transfer_retains_query_ownership() {
+        let query = Arc::new(MemoryBudget::new(64).unwrap());
+        let process = Arc::new(MemoryBudget::new(32).unwrap());
+        let accountant = TransferableAccountant::new(&query).unwrap();
+        let child = Arc::new(
+            MemoryBudget::new(64)
+                .unwrap()
+                .with_accountant(accountant.clone()),
+        );
+        let payload = child.allocate_buffer(64, |_| Ok(())).unwrap();
+        let error = accountant.transfer_to(&process).unwrap_err();
+        assert!(matches!(
+            MemoryError::find_in_chain(&error),
+            Some(MemoryError::LimitExceeded { .. })
+        ));
+        assert_eq!(query.used(), 64);
+        assert_eq!(process.used(), 0);
+        drop(payload);
+        assert_eq!(query.used(), 0);
+    }
+
+    #[test]
+    fn concurrent_transfer_and_release_do_not_lose_or_duplicate_bytes() {
+        let query = Arc::new(MemoryBudget::new(64).unwrap());
+        let process = Arc::new(MemoryBudget::new(64).unwrap());
+        let accountant = TransferableAccountant::new(&query).unwrap();
+        let child = Arc::new(
+            MemoryBudget::new(64)
+                .unwrap()
+                .with_accountant(accountant.clone()),
+        );
+        let reservation = child.reserve(64).unwrap();
+        std::thread::scope(|scope| {
+            scope.spawn(|| accountant.transfer_to(&process).unwrap());
+            scope.spawn(|| drop(reservation));
+        });
+        assert_eq!(query.used(), 0);
+        assert_eq!(process.used(), 0);
+        assert_eq!(child.used(), 0);
+    }
+}
