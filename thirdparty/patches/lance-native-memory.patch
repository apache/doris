diff --git a/rust/lance-index/src/budgeted_heap.rs b/rust/lance-index/src/budgeted_heap.rs
new file mode 100644
index 0000000000000000000000000000000000000000..2c58b64b41a40a41a13eec2c6d0e9307a33ca357
--- /dev/null
+++ b/rust/lance-index/src/budgeted_heap.rs
@@ -0,0 +1,138 @@
+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright The Lance Authors
+
+//! Fallible search containers retaining their physical storage admission.
+use lance_core::Result;
+use lance_core::memory::BudgetedVec;
+
+#[derive(Debug)]
+pub struct BudgetedHeap<T> {
+    values: BudgetedVec<T>,
+}
+impl<T: Ord> BudgetedHeap<T> {
+    pub fn new() -> Result<Self> {
+        Ok(Self {
+            values: BudgetedVec::try_with_capacity(0)?,
+        })
+    }
+    pub fn len(&self) -> usize {
+        self.values.len()
+    }
+    pub fn is_empty(&self) -> bool {
+        self.values.is_empty()
+    }
+    pub fn peek(&self) -> Option<&T> {
+        self.values.first()
+    }
+    pub fn try_push(&mut self, value: T) -> Result<()> {
+        self.values.try_push(value)?;
+        let mut child = self.len() - 1;
+        while child > 0 {
+            let parent = (child - 1) / 2;
+            if self.values[parent] >= self.values[child] {
+                break;
+            }
+            self.values.swap(parent, child);
+            child = parent;
+        }
+        Ok(())
+    }
+    pub fn pop(&mut self) -> Option<T> {
+        let last = self.values.pop()?;
+        if self.values.is_empty() {
+            return Some(last);
+        }
+        let first = std::mem::replace(&mut self.values[0], last);
+        let mut parent = 0;
+        loop {
+            let left = 2 * parent + 1;
+            if left >= self.len() {
+                break;
+            }
+            let right = left + 1;
+            let child = if right < self.len() && self.values[right] > self.values[left] {
+                right
+            } else {
+                left
+            };
+            if self.values[parent] >= self.values[child] {
+                break;
+            }
+            self.values.swap(parent, child);
+            parent = child;
+        }
+        Some(first)
+    }
+    pub fn into_sorted_vec(mut self) -> BudgetedVec<T> {
+        self.values.sort_unstable();
+        self.values
+    }
+}
+pub fn try_collect<T>(values: impl IntoIterator<Item = T>) -> Result<BudgetedVec<T>> {
+    let values = values.into_iter();
+    let mut result = BudgetedVec::try_with_capacity(values.size_hint().0)?;
+    for value in values {
+        result.try_push(value)?;
+    }
+    Ok(result)
+}
+pub fn try_collect_results<T>(
+    values: impl IntoIterator<Item = Result<T>>,
+) -> Result<BudgetedVec<T>> {
+    let values = values.into_iter();
+    let mut result = BudgetedVec::try_with_capacity(values.size_hint().0)?;
+    for value in values {
+        result.try_push(value?)?;
+    }
+    Ok(result)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use lance_core::memory::{MemoryBudget, MemoryError, MemoryScope};
+    use std::sync::Arc;
+
+    #[test]
+    fn native_memory_heap_growth_rejects_before_replacing_live_storage() {
+        let owner = Arc::new(MemoryBudget::new(40).unwrap());
+        let _scope = MemoryScope::enter(Some(owner.clone()));
+        let mut heap = BudgetedHeap::new().unwrap();
+        for value in 0..4_u64 {
+            heap.try_push(value).unwrap();
+        }
+        assert_eq!(owner.used(), 32);
+        let error = heap.try_push(4).unwrap_err();
+        assert!(matches!(
+            MemoryError::find_in_chain(&error),
+            Some(MemoryError::LimitExceeded { .. })
+        ));
+        assert_eq!(
+            (heap.len(), *heap.peek().unwrap(), owner.used()),
+            (4, 3, 32)
+        );
+        drop(heap);
+        assert_eq!(owner.used(), 0);
+    }
+
+    #[test]
+    fn native_memory_sorted_heap_and_consuming_iterator_retain_capacity() {
+        let owner = Arc::new(MemoryBudget::new(96).unwrap());
+        let scope = MemoryScope::enter(Some(owner.clone()));
+        let mut heap = BudgetedHeap::new().unwrap();
+        for value in [3_u64, 1, 5, 2, 4] {
+            heap.try_push(value).unwrap();
+        }
+        assert_eq!(heap.pop(), Some(5));
+        let values = heap.into_sorted_vec();
+        assert_eq!(values.as_ref(), &[1, 2, 3, 4]);
+        let mut values = values.into_iter();
+        drop(scope);
+        assert_eq!(owner.used(), 64);
+        assert_eq!(values.next(), Some(1));
+        assert_eq!(values.next_back(), Some(4));
+        assert_eq!(owner.used(), 64);
+        drop(values);
+        assert_eq!(owner.used(), 0);
+    }
+}
