+    void PrepareParquetFileWithRowGroups(const std::string& file_path,
+                                         const std::vector<int32_t>& row_group_sizes) {
+        auto schema_pair = PrepareArrowSchema();
+        const auto& arrow_schema = schema_pair.first;
+        const auto& struct_type = schema_pair.second;
+        int32_t total_rows = 0;
+        for (int32_t row_group_size : row_group_sizes) {
+            total_rows += row_group_size;
+        }
+        auto struct_array =
+            std::static_pointer_cast<arrow::StructArray>(PrepareArray(struct_type, total_rows));
+
+        auto sink_result = arrow::io::FileOutputStream::Open(file_path);
+        ASSERT_TRUE(sink_result.ok()) << sink_result.status().ToString();
+        auto sink = std::move(sink_result).ValueOrDie();
+        auto writer_result =
+            ::parquet::arrow::FileWriter::Open(*arrow_schema, arrow_pool_.get(), sink);
+        ASSERT_TRUE(writer_result.ok()) << writer_result.status().ToString();
+        auto writer = std::move(writer_result).ValueOrDie();
+        int64_t offset = 0;
+        for (int32_t row_group_size : row_group_sizes) {
+#if ARROW_VERSION_MAJOR >= 24
+            ASSERT_TRUE(writer->NewRowGroup().ok());
+#else
+            ASSERT_TRUE(writer->NewRowGroup(row_group_size).ok());
+#endif
+            for (int i = 0; i < struct_array->num_fields(); ++i) {
+                ASSERT_TRUE(
+                    writer->WriteColumnChunk(*struct_array->field(i)->Slice(offset, row_group_size))
+                        .ok());
+            }
+            offset += row_group_size;
+        }
+        ASSERT_TRUE(writer->Close().ok());
+        ASSERT_TRUE(sink->Close().ok());
+    }
+
