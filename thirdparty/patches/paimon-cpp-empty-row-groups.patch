+TEST_F(FileReaderWrapperTest, EmptyRowGroups) {
+    std::string file_path = PathUtil::JoinPath(dir_->Str(), "empty_row_groups.parquet");
+    PrepareParquetFileWithRowGroups(file_path, {0, 10, 0, 10, 0});
+    ASSERT_OK_AND_ASSIGN(auto reader_wrapper, PrepareReaderWrapper(file_path));
+    std::vector<std::pair<uint64_t, uint64_t>> expected_all_row_group_ranges = {
+        {0, 0}, {0, 10}, {10, 10}, {10, 20}, {20, 20}};
+    ASSERT_EQ(expected_all_row_group_ranges, reader_wrapper->GetAllRowGroupRanges());
+
+    ASSERT_OK_AND_ASSIGN(auto record_batch, reader_wrapper->Next());
+    ASSERT_EQ(10, record_batch->num_rows());
+    ASSERT_EQ(10, reader_wrapper->GetNextRowToRead());
+    ASSERT_OK_AND_ASSIGN(record_batch, reader_wrapper->Next());
+    ASSERT_EQ(10, record_batch->num_rows());
+    ASSERT_EQ(20, reader_wrapper->GetNextRowToRead());
+    ASSERT_OK_AND_ASSIGN(record_batch, reader_wrapper->Next());
+    ASSERT_FALSE(record_batch);
+
+    ASSERT_OK(reader_wrapper->PrepareForReading(/*row_group_indices=*/{0, 1, 2, 3, 4},
+                                                /*column_indices=*/{}));
+    ASSERT_OK_AND_ASSIGN(record_batch, reader_wrapper->Next());
+    ASSERT_EQ(10, record_batch->num_rows());
+    ASSERT_EQ(0, record_batch->num_columns());
+    ASSERT_OK(reader_wrapper->SeekToRow(10));
+    ASSERT_OK_AND_ASSIGN(record_batch, reader_wrapper->Next());
+    ASSERT_EQ(10, record_batch->num_rows());
+    ASSERT_EQ(10, reader_wrapper->GetPreviousBatchFirstRowNumber());
+}
