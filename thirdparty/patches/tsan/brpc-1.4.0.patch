@@ -70,3 +70,14 @@
     static ContextualStack* get_stack(void (*entry)(intptr_t)) {
-        return butil::get_object<Wrapper>(entry);
+        ContextualStack* stack = butil::get_object<Wrapper>(entry);
+#if defined(BRPC_TSAN_FIBERS)
+        if (stack != NULL && stack->context != NULL) {
+            // A new fiber must enter at task_runner. A recycled fcontext
+            // would resume frames belonging to the destroyed fiber.
+            stack->context = bthread_make_fcontext(stack->storage.bottom,
+                                                   stack->storage.stacksize,
+                                                   entry);
+            stack->tsan_fiber = __tsan_create_fiber(0);
+        }
+#endif
+        return stack;
     }
@@ -74,2 +85,7 @@
     static void return_stack(ContextualStack* sc) {
+#if defined(BRPC_TSAN_FIBERS)
+        if (sc->context != NULL) {
+            __tsan_destroy_fiber(sc->tsan_fiber);
+        }
+#endif
         butil::return_object(static_cast<Wrapper*>(sc));
@@ -87,2 +103,5 @@
         s->storage.zeroize();
+#if defined(BRPC_TSAN_FIBERS)
+        s->tsan_fiber = __tsan_get_current_fiber();
+#endif
         return s;
@@ -131,3 +150,12 @@
 inline void jump_stack(ContextualStack* from, ContextualStack* to) {
+#if defined(BRPC_TSAN_FIBERS)
+    bthread_fcontext_t* saved_context = &from->context;
+    bthread_fcontext_t next_context = to->context;
+    // The destination takes over the current worker, including its pending
+    // scheduler cleanup, only after the source stops executing on it.
+    __tsan_switch_to_fiber(to->tsan_fiber, 0);
+    bthread_jump_fcontext(saved_context, next_context, 0);
+#else
     bthread_jump_fcontext(&from->context, to->context, 0/*not skip remained*/);
+#endif
 }
