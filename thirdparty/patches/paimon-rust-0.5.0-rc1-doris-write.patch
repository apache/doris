+/// Encode a range using Java's serializeList protocol, without host-engine framing.
+/// Uses the upstream Java v14 serializer. Oversized output returns
+/// ResourceExhausted without modifying the messages, allowing smaller chunks.
+///
+/// # Safety
+/// `messages` must be a valid standard message handle. `output` must point to
+/// writable storage. Release successful output with paimon_bytes_free.
+#[no_mangle]
+pub unsafe extern "C" fn paimon_commit_messages_serialize_java(
+    messages: *const paimon_commit_messages,
+    version: i32,
+    offset: usize,
+    count: usize,
+    max_bytes: usize,
+    output: *mut paimon_bytes,
+) -> *mut paimon_error {
+    if let Err(error) = check_non_null(messages, "messages") {
+        return error;
+    }
+    if let Err(error) = check_non_null(output, "output") {
+        return error;
+    }
+    *output = paimon_bytes::new(Vec::new());
+    if version != paimon::table::COMMIT_MESSAGE_SERIALIZER_VERSION {
+        return paimon_error::new(
+            PaimonErrorCode::Unsupported,
+            "Unsupported Java commit version".into(),
+        );
+    }
+    let state = &*((*messages).inner as *const CommitMessagesState);
+    let selected = match offset
+        .checked_add(count)
+        .and_then(|end| state.messages.get(offset..end))
+    {
+        Some(selected) => selected,
+        None => return invalid_input("Invalid commit message range"),
+    };
+    let encode = || -> paimon::Result<Vec<u8>> {
+        let count = i32::try_from(count).map_err(|_| paimon::Error::DataInvalid {
+            message: "Too many commit messages".into(),
+            source: None,
+        })?;
+        if max_bytes < 4 {
+            return Err(paimon::Error::ResourceExhausted {
+                message: "Commit list output limit is smaller than its header".into(),
+            });
+        }
+        let mut bytes = count.to_be_bytes().to_vec();
+        for message in selected {
+            let encoded = message.serialize_with_limit(max_bytes - bytes.len())?;
+            bytes.extend_from_slice(&encoded);
+        }
+        Ok(bytes)
+    };
+    match encode() {
+        Ok(bytes) => {
+            *output = paimon_bytes::new(bytes);
+            ptr::null_mut()
+        }
+        Err(error) => paimon_error::from_paimon(error),
+    }
+}
