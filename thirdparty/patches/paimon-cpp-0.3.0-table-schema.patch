Based on official paimon-cpp v0.3.0. Allow callers to supply a complete TableSchema
and obtain its Arrow C Data schema without loading schema metadata. Callers that
do not supply a schema retain the SDK's default latest-schema behavior.

diff --git a/include/paimon/schema/schema.h b/include/paimon/schema/schema.h
--- a/include/paimon/schema/schema.h
+++ b/include/paimon/schema/schema.h
@@ -70,6 +70,9 @@
  public:
     ~DataSchema() override = default;
 
+    /// Parse a complete table schema without loading catalog or filesystem metadata.
+    static Result<std::shared_ptr<DataSchema>> FromJson(const std::string& json);
+
     /// Get the unique identifier of this table schema.
     /// @return The schema id
     virtual int64_t Id() const = 0;
