+#pragma once
+
+#include <algorithm>
+#include <cstddef>
+#include <limits>
+
+#include "Exception.hh"
+
+namespace avro {
+
+class GenericDatum;
+
+using AllocationCheck = void (*)(void*, size_t);
+using AllocationCheckpoint = void (*)(void*, const GenericDatum&, bool);
+struct AllocationHook {
+    AllocationCheck check = nullptr;
+    void* context = nullptr;
+    AllocationCheckpoint checkpoint = nullptr;
+};
+inline thread_local AllocationHook allocationHook;
+
+// The embedding reader owns reservations. Scoped TLS keeps independent scans and writers isolated.
+class AllocationCheckScope {
+    AllocationHook previous_;
+public:
+    AllocationCheckScope(AllocationCheck check, void* context, AllocationCheckpoint checkpoint = nullptr) : previous_(allocationHook) {
+        allocationHook = {check, context, checkpoint};
+    }
+    ~AllocationCheckScope() { allocationHook = previous_; }
+    AllocationCheckScope(const AllocationCheckScope&) = delete;
+    AllocationCheckScope& operator=(const AllocationCheckScope&) = delete;
+};
+
+inline size_t checkedCount(size_t current, size_t added) {
+    if (added > std::numeric_limits<size_t>::max() - current)
+        throw Exception("Avro collection count overflows");
+    return current + added;
+}
+
+inline size_t checkedGrowth(size_t capacity, size_t count, size_t itemSize = 1) {
+    if (count > std::numeric_limits<size_t>::max() / itemSize / 2)
+        throw Exception("Avro allocation size overflows");
+    if (count > capacity && allocationHook.check != nullptr) {
+        // libstdc++/libc++ may double capacity. The reader already accounts the old allocation;
+        // reserve the new-capacity bound as well to cover a temporary old-plus-new peak.
+        const size_t grown = capacity > std::numeric_limits<size_t>::max() / 2
+                               ? count : std::max(count, capacity * 2);
+        allocationHook.check(allocationHook.context, grown * itemSize);
+    }
+    return count;
+}
+
+inline void allocationCheckpoint(const GenericDatum& datum, bool before) {
+    if (allocationHook.checkpoint != nullptr)
+        allocationHook.checkpoint(allocationHook.context, datum, before);
+}
+
+} // namespace avro
