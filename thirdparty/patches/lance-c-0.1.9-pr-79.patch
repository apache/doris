+                Some(""),
+                Some("other"),
+                Some("needle"),
+                Some("other"),
+                Some(""),
+                None,
+            ]));
+            let (_tmp, uri, uuids) =
+                create_scalar_segment_fixture_from_key(kind, stable, None, &[&[0, 1]], key);
