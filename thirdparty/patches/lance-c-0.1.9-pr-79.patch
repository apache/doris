+                }
+                ids.sort_unstable();
+                assert_eq!(
+                    ids,
+                    vec![2, 3],
+                    "ordinary scans can still read tombstoned rows"
+                );
+            }
+            lance_scanner_close(scanner);
+        }
+        lance_dataset_close(ds);
+    }
