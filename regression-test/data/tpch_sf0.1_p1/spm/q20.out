-- !spm_bind_sql --
SELECT\n  s_name,\n  s_address\nFROM\n  supplier, nation\nWHERE\n  s_suppkey IN (\n    SELECT ps_suppkey\n    FROM\n      partsupp\n    WHERE\n      ps_partkey IN (\n        SELECT p_partkey\n        FROM\n          part\n        WHERE\n          p_name LIKE 'forest%'\n      )\n      AND ps_availqty > (\n        SELECT 0.5 * sum(l_quantity)\n        FROM\n          lineitem\n        WHERE\n          l_partkey = ps_partkey\n          AND l_suppkey = ps_suppkey\n          AND l_shipdate >= date('1994-01-01')\n          AND l_shipdate < date('1994-01-01') + interval '1' YEAR\n)\n)\nAND s_nationkey = n_nationkey\nAND n_name = 'CANADA'\nORDER BY s_name

-- !spm_bind_digest --
SELECT s_name, s_address FROM internal.regression_test_tpch_sf0_1_p1.supplier CROSS_JOIN internal.regression_test_tpch_sf0_1_p1.nation WHERE (s_suppkey IN (SELECT ps_suppkey FROM internal.regression_test_tpch_sf0_1_p1.partsupp WHERE (ps_partkey IN (SELECT p_partkey FROM internal.regression_test_tpch_sf0_1_p1.part WHERE p_name like ?) AND ps_availqty > (SELECT ? * SUM(l_quantity) FROM internal.regression_test_tpch_sf0_1_p1.lineitem WHERE (l_partkey = ps_partkey AND l_suppkey = ps_suppkey AND l_shipdate >= DATE(?) AND l_shipdate < DATE_ADD(DATE(?), INTERVAL ? YEAR))))) AND s_nationkey = n_nationkey AND n_name = ?) ORDER BY s_name ASC NULLS FIRST

-- !spm_plan_sql --
SELECT S_NAME AS s_name, S_ADDRESS AS s_address FROM (SELECT S_NAME, S_ADDRESS FROM (SELECT * FROM (SELECT PS_SUPPKEY FROM (SELECT * FROM (SELECT * FROM (SELECT L_PARTKEY, L_SUPPKEY, sum(L_QUANTITY) AS c_1 FROM (SELECT L_PARTKEY, L_SUPPKEY, L_QUANTITY FROM (SELECT * FROM internal.regression_test_tpch_sf0_1_p1.lineitem WHERE ((L_SHIPDATE >= date(_spm_const_var(2))) AND (L_SHIPDATE < years_add(date(_spm_const_var(2)), _spm_const_var(3))))) t_0) t_1 GROUP BY L_PARTKEY, L_SUPPKEY) t_2 RIGHT OUTER JOIN[SHUFFLE] (SELECT * FROM (SELECT PS_PARTKEY, PS_SUPPKEY, PS_AVAILQTY FROM internal.regression_test_tpch_sf0_1_p1.partsupp) t_3 LEFT SEMI JOIN[BROADCAST] (SELECT P_PARTKEY FROM (SELECT * FROM internal.regression_test_tpch_sf0_1_p1.part WHERE P_NAME LIKE _spm_const_var(1)) t_4) t_5 ON (PS_PARTKEY = P_PARTKEY)) t_6 ON (L_PARTKEY = PS_PARTKEY) AND (L_SUPPKEY = PS_SUPPKEY)) t_7 WHERE (PS_AVAILQTY > (_spm_const_var(4) * c_1))) t_8) t_9 RIGHT SEMI JOIN[SHUFFLE] (SELECT S_SUPPKEY, S_NAME, S_ADDRESS FROM (SELECT * FROM (SELECT S_SUPPKEY, S_NAME, S_ADDRESS, S_NATIONKEY FROM internal.regression_test_tpch_sf0_1_p1.supplier) t_10 INNER JOIN[BROADCAST] (SELECT N_NATIONKEY FROM (SELECT * FROM internal.regression_test_tpch_sf0_1_p1.nation WHERE (N_NAME = _spm_const_var(5))) t_11) t_12 ON (S_NATIONKEY = N_NATIONKEY)) t_13) t_14 ON (S_SUPPKEY = PS_SUPPKEY)) t_15 ORDER BY S_NAME ASC NULLS FIRST) t_16 ORDER BY S_NAME ASC NULLS FIRST

