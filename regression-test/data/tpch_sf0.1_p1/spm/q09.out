-- This file is automatically generated. You should know what you did if you want to edit this
-- !spm_bind_sql --
SELECT\n  nation,\n  o_year,\n  sum(amount) AS sum_profit\nFROM (\n       SELECT\n         n_name                                                          AS nation,\n         extract(YEAR FROM o_orderdate)                                  AS o_year,\n         l_extendedprice * (1 - l_discount) - ps_supplycost * l_quantity AS amount\n       FROM\n         part,\n         supplier,\n         lineitem,\n         partsupp,\n         orders,\n         nation\n       WHERE\n         s_suppkey = l_suppkey\n         AND ps_suppkey = l_suppkey\n         AND ps_partkey = l_partkey\n         AND p_partkey = l_partkey\n         AND o_orderkey = l_orderkey\n         AND s_nationkey = n_nationkey\n         AND p_name LIKE '%green%'\n     ) AS profit\nGROUP BY\n  nation,\n  o_year\nORDER BY\n  nation,\n  o_year DESC

-- !spm_bind_digest --
SELECT nation, o_year, SUM(amount) AS sum_profit FROM (SELECT n_name AS nation, YEAR(o_orderdate) AS o_year, l_extendedprice * ? - l_discount - ps_supplycost * l_quantity AS amount FROM internal.regression_test_tpch_sf0_1_p1.part CROSS_JOIN internal.regression_test_tpch_sf0_1_p1.supplier CROSS_JOIN internal.regression_test_tpch_sf0_1_p1.lineitem CROSS_JOIN internal.regression_test_tpch_sf0_1_p1.partsupp CROSS_JOIN internal.regression_test_tpch_sf0_1_p1.orders CROSS_JOIN internal.regression_test_tpch_sf0_1_p1.nation WHERE (s_suppkey = l_suppkey AND ps_suppkey = l_suppkey AND ps_partkey = l_partkey AND p_partkey = l_partkey AND o_orderkey = l_orderkey AND s_nationkey = n_nationkey AND p_name like ?)) AS profit GROUP BY nation, o_year ORDER BY nation ASC NULLS FIRST, o_year DESC

-- !spm_plan_sql --
SELECT N_NAME AS nation, o_year, sum_profit FROM (SELECT N_NAME, o_year, sum(amount) AS sum_profit FROM (SELECT N_NAME, year(O_ORDERDATE) AS o_year, ((L_EXTENDEDPRICE * (_spm_const_var(2) - L_DISCOUNT)) - (PS_SUPPLYCOST * L_QUANTITY)) AS amount FROM (SELECT * FROM (SELECT L_PARTKEY, L_SUPPKEY, L_QUANTITY, L_EXTENDEDPRICE, L_DISCOUNT, O_ORDERDATE, N_NAME FROM (SELECT * FROM (SELECT L_PARTKEY, L_SUPPKEY, L_QUANTITY, L_EXTENDEDPRICE, L_DISCOUNT, O_ORDERDATE FROM (SELECT * FROM (SELECT L_ORDERKEY, L_PARTKEY, L_SUPPKEY, L_QUANTITY, L_EXTENDEDPRICE, L_DISCOUNT FROM (SELECT * FROM (SELECT L_ORDERKEY, L_PARTKEY, L_SUPPKEY, L_QUANTITY, L_EXTENDEDPRICE, L_DISCOUNT FROM internal.regression_test_tpch_sf0_1_p1.lineitem) t_0 INNER JOIN[BROADCAST] (SELECT P_PARTKEY FROM (SELECT * FROM internal.regression_test_tpch_sf0_1_p1.part WHERE P_NAME LIKE _spm_const_var(1)) t_1) t_2 ON (P_PARTKEY = L_PARTKEY)) t_3) t_4 INNER JOIN[SHUFFLE] (SELECT O_ORDERKEY, O_ORDERDATE FROM internal.regression_test_tpch_sf0_1_p1.orders) t_5 ON (O_ORDERKEY = L_ORDERKEY)) t_6) t_7 INNER JOIN[SHUFFLE] (SELECT S_SUPPKEY, N_NAME FROM (SELECT * FROM (SELECT S_SUPPKEY, S_NATIONKEY FROM internal.regression_test_tpch_sf0_1_p1.supplier) t_8 INNER JOIN[BROADCAST] (SELECT N_NATIONKEY, N_NAME FROM internal.regression_test_tpch_sf0_1_p1.nation) t_9 ON (S_NATIONKEY = N_NATIONKEY)) t_10) t_11 ON (S_SUPPKEY = L_SUPPKEY)) t_12) t_13 INNER JOIN[SHUFFLE] (SELECT PS_PARTKEY, PS_SUPPKEY, PS_SUPPLYCOST FROM internal.regression_test_tpch_sf0_1_p1.partsupp) t_14 ON (PS_SUPPKEY = L_SUPPKEY) AND (PS_PARTKEY = L_PARTKEY)) t_15) t_16 GROUP BY N_NAME, o_year ORDER BY N_NAME ASC NULLS FIRST, o_year DESC NULLS LAST) t_17 ORDER BY N_NAME ASC NULLS FIRST, o_year DESC NULLS LAST

