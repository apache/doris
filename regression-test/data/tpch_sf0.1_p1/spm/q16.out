-- !spm_bind_sql --
SELECT\n  p_brand,\n  p_type,\n  p_size,\n  count(DISTINCT ps_suppkey) AS supplier_cnt\nFROM\n  partsupp,\n  part\nWHERE\n  p_partkey = ps_partkey\n  AND p_brand <> 'Brand#45'\n  AND p_type NOT LIKE 'MEDIUM POLISHED%'\n  AND p_size IN (49, 14, 23, 45, 19, 3, 36, 9)\n  AND ps_suppkey NOT IN (\n    SELECT s_suppkey\n    FROM\n      supplier\n    WHERE\n      s_comment LIKE '%Customer%Complaints%'\n  )\nGROUP BY\n  p_brand,\n  p_type,\n  p_size\nORDER BY\n  supplier_cnt DESC,\n  p_brand,\n  p_type,\n  p_size

-- !spm_bind_digest --
SELECT p_brand, p_type, p_size, COUNT(distinct ps_suppkey) AS supplier_cnt FROM internal.regression_test_tpch_sf0_1_p1.partsupp CROSS_JOIN internal.regression_test_tpch_sf0_1_p1.part WHERE (p_partkey = ps_partkey AND NOT p_brand = ? AND NOT p_type like ? AND p_size IN (?) AND NOT ps_suppkey NOT IN (SELECT s_suppkey FROM internal.regression_test_tpch_sf0_1_p1.supplier WHERE s_comment like ?)) GROUP BY p_brand, p_type, p_size ORDER BY supplier_cnt DESC, p_brand ASC NULLS FIRST, p_type ASC NULLS FIRST, p_size ASC NULLS FIRST

-- !spm_plan_sql --
SELECT P_BRAND AS p_brand, P_TYPE AS p_type, P_SIZE AS p_size, supplier_cnt FROM (SELECT P_BRAND, P_TYPE, P_SIZE, count(PS_SUPPKEY) AS supplier_cnt FROM (SELECT P_BRAND, P_TYPE, P_SIZE, PS_SUPPKEY FROM (SELECT * FROM (SELECT PS_SUPPKEY, P_BRAND, P_TYPE, P_SIZE FROM (SELECT * FROM (SELECT PS_PARTKEY, PS_SUPPKEY FROM internal.regression_test_tpch_sf0_1_p1.partsupp) t_0 INNER JOIN[BROADCAST] (SELECT P_PARTKEY, P_BRAND, P_TYPE, P_SIZE FROM (SELECT * FROM internal.regression_test_tpch_sf0_1_p1.part WHERE (NOT ((P_BRAND = _spm_const_var(1))) AND NOT (P_TYPE LIKE _spm_const_var(2)) AND P_SIZE IN (_spm_const_list(3)))) t_1) t_2 ON (P_PARTKEY = PS_PARTKEY)) t_3) t_4 LEFT ANTI JOIN[BROADCAST] (SELECT S_SUPPKEY FROM (SELECT * FROM internal.regression_test_tpch_sf0_1_p1.supplier WHERE S_COMMENT LIKE _spm_const_var(4)) t_5) t_6 ON (PS_SUPPKEY = S_SUPPKEY)) t_7 GROUP BY P_BRAND, P_TYPE, P_SIZE, PS_SUPPKEY) t_8 GROUP BY P_BRAND, P_TYPE, P_SIZE ORDER BY supplier_cnt DESC NULLS LAST, P_BRAND ASC NULLS FIRST, P_TYPE ASC NULLS FIRST, P_SIZE ASC NULLS FIRST) t_9 ORDER BY supplier_cnt DESC NULLS LAST, P_BRAND ASC NULLS FIRST, P_TYPE ASC NULLS FIRST, P_SIZE ASC NULLS FIRST

