-- This file is automatically generated. You should know what you did if you want to edit this
-- !spm_bind_sql --
SELECT\n  c_custkey,\n  c_name,\n  sum(l_extendedprice * (1 - l_discount)) AS revenue,\n  c_acctbal,\n  n_name,\n  c_address,\n  c_phone,\n  c_comment\nFROM\n  customer,\n  orders,\n  lineitem,\n  nation\nWHERE\n  c_custkey = o_custkey\n  AND l_orderkey = o_orderkey\n  AND o_orderdate >= DATE '1993-10-01'\n  AND o_orderdate < DATE '1993-10-01' + INTERVAL '3' MONTH\n  AND l_returnflag = 'R'\n  AND c_nationkey = n_nationkey\nGROUP BY\n  c_custkey,\n  c_name,\n  c_acctbal,\n  c_phone,\n  n_name,\n  c_address,\n  c_comment\nORDER BY\n  revenue DESC\nLIMIT 20

-- !spm_bind_digest --
SELECT c_custkey, c_name, SUM(l_extendedprice * ? - l_discount) AS revenue, c_acctbal, n_name, c_address, c_phone, c_comment FROM customer CROSS_JOIN orders CROSS_JOIN lineitem CROSS_JOIN nation WHERE (c_custkey = o_custkey AND l_orderkey = o_orderkey AND o_orderdate >= ? AND o_orderdate < DATE_ADD(?, INTERVAL ? MONTH) AND l_returnflag = ? AND c_nationkey = n_nationkey) GROUP BY c_custkey, c_name, c_acctbal, c_phone, n_name, c_address, c_comment ORDER BY revenue DESC LIMIT ? 

-- !spm_plan_sql --
SELECT C_CUSTKEY AS c_custkey, C_NAME AS c_name, revenue, C_ACCTBAL AS c_acctbal, N_NAME AS n_name, C_ADDRESS AS c_address, C_PHONE AS c_phone, C_COMMENT AS c_comment FROM (SELECT C_CUSTKEY, C_NAME, C_ACCTBAL, C_PHONE, N_NAME, C_ADDRESS, C_COMMENT, sum(c_1) AS revenue FROM (SELECT C_CUSTKEY, C_NAME, C_ADDRESS, N_NAME, C_PHONE, C_ACCTBAL, c_1, C_COMMENT FROM (SELECT * FROM (SELECT C_CUSTKEY, C_NAME, C_ADDRESS, C_NATIONKEY, C_PHONE, C_ACCTBAL, c_1, C_COMMENT FROM (SELECT * FROM (SELECT c_1, O_CUSTKEY FROM (SELECT * FROM (SELECT L_ORDERKEY, sum((L_EXTENDEDPRICE * (_spm_const_var(5) - L_DISCOUNT))) AS c_1 FROM (SELECT L_ORDERKEY, L_EXTENDEDPRICE, L_DISCOUNT FROM (SELECT * FROM internal.regression_test_tpch_sf0_1_p1.lineitem WHERE (L_RETURNFLAG = _spm_const_var(4))) t_0) t_1 GROUP BY L_ORDERKEY) t_2 INNER JOIN[SHUFFLE] (SELECT O_ORDERKEY, O_CUSTKEY FROM (SELECT * FROM internal.regression_test_tpch_sf0_1_p1.orders WHERE ((O_ORDERDATE >= _spm_const_var(1)) AND (O_ORDERDATE < months_add(_spm_const_var(2), _spm_const_var(3))))) t_3) t_4 ON (L_ORDERKEY = O_ORDERKEY)) t_5) t_6 INNER JOIN[SHUFFLE] (SELECT C_CUSTKEY, C_NAME, C_ADDRESS, C_NATIONKEY, C_PHONE, C_ACCTBAL, C_COMMENT FROM internal.regression_test_tpch_sf0_1_p1.customer) t_7 ON (C_CUSTKEY = O_CUSTKEY)) t_8) t_9 INNER JOIN[BROADCAST] (SELECT N_NATIONKEY, N_NAME FROM internal.regression_test_tpch_sf0_1_p1.nation) t_10 ON (C_NATIONKEY = N_NATIONKEY)) t_11) t_12 GROUP BY C_CUSTKEY, C_NAME, C_ACCTBAL, C_PHONE, N_NAME, C_ADDRESS, C_COMMENT ORDER BY revenue DESC LIMIT 20) t_14

