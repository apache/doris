t_tpcds_sf1_p1.date_dim CROSS_JOIN internal.regression_test_tpcds_sf1_p1.web_site CROSS_JOIN internal.regression_test_tpcds_sf1_p1.item CROSS_JOIN internal.regression_test_tpcds_sf1_p1.promotion WHERE (ws_sold_date_sk = d_date_sk AND  AND ws_web_site_sk = web_site_sk AND ws_item_sk = i_item_sk AND i_current_price > ? AND ws_promo_sk = p_promo_sk AND p_channel_tv = ?) GROUP BY web_site_id) AS wsr\nSELECT channel, id, SUM(sales) AS sales, SUM(returns) AS returns, SUM(profit) AS profit FROM (((SELECT ?, CONCAT(?, store_id) AS id, sales, returns, profit FROM ssr) UNION ALL (SELECT ?, CONCAT(?, catalog_page_id) AS id, sales, returns, profit FROM csr)) UNION ALL (SELECT ?, CONCAT(?, web_site_id) AS id, sales, returns, profit FROM wsr)) AS x GROUP BY GROUPING SETS ((channel,id), (channel), ()) ORDER BY channel ASC NULLS FIRST, id ASC NULLS FIRST LIMIT ? 

