WITH\n(SELECT SUBSTR(i_item_desc, ?, ?) AS itemdesc, i_item_sk AS item_sk, d_date AS solddate, count(*) AS cnt FROM internal.regression_test_tpcds_sf1_p1.store_sales CROSS_JOIN internal.regression_test_tpcds_sf1_p1.date_dim CROSS_JOIN internal.regression_test_tpcds_sf1_p1.item WHERE (ss_sold_date_sk = d_date_sk AND ss_item_sk = i_item_sk AND d_year IN (?, ? + ?, ? + ?, ? + ?)) GROUP BY SUBSTR(i_item_desc, ?, ?), i_item_sk, d_date HAVING count(*) > ?) AS frequent_ss_items, (SELECT MAX(csales) AS tpcds_cmax FROM (SELECT c_customer_sk, SUM(ss_quantity * ss_sales_price) AS csales FROM internal.regression_test_tpcds_sf1_p1.store_sales CROSS_JOIN internal.regression_test_tpcds_sf1_p1.customer CROSS_JOIN internal.regression_test_tpcds_sf1_p1.date_dim WHERE (ss_customer_sk = c_customer_sk AND ss_sold_date_sk = d_date_sk AND d_year IN (?, ? + ?, ? + ?, ? + ?)) GROUP BY c_customer_sk) AS x) AS max_store_sales, (SELECT c_customer_sk, SUM(ss_quantity * ss_sales_price) AS ssales FROM internal.regression_test_tpcds_sf1_p1.store_sales CROSS_JOIN internal.regression_test_tpcds_sf1_p1.customer WHERE ss_customer_sk = c_customer_sk GROUP BY c_customer_sk HAVING SUM(ss_quantity * ss_sales_price) > ? / cast(? as DECIMALV3(5, 2)) * (SELECT * FROM max_store_sales)) AS best_ss_customer\nSELECT SUM(sales) FROM ((SELECT cs_quantity * cs_list_price AS sales FROM internal.regression_test_tpcds_sf1_p1.catalog_sales CROSS_JOIN internal.regression_test_tpcds_sf1_p1.date_dim WHERE (d_year = ? AND d_moy = ? AND cs_sold_date_sk = d_date_sk AND cs_item_sk IN (SELECT item_sk FROM frequent_ss_items) AND cs_bill_customer_sk IN (SELECT c_customer_sk FROM best_ss_customer))) UNION ALL (SELECT ws_quantity * ws_list_price AS sales FROM internal.regression_test_tpcds_sf1_p1.web_sales CROSS_JOIN internal.regression_test_tpcds_sf1_p1.date_dim WHERE (d_year = ? AND d_moy = ? AND ws_sold_date_sk = d_date_sk AND ws_item_sk IN (SELECT item_sk FROM frequent_ss_items) AND ws_bill_customer_sk IN (SELECT c_customer_sk FROM best_ss_customer)))) AS y LIMIT ? 

