e FROM ss LEFT_OUTER_JOIN ws ON ws_sold_year = ss_sold_year AND ws_item_sk = ss_item_sk AND ws_customer_sk = ss_customer_sk LEFT_OUTER_JOIN cs ON cs_sold_year = ss_sold_year AND cs_item_sk = cs_item_sk AND cs_customer_sk = ss_customer_sk WHERE (COALESCE(ws_qty, ?) > ? AND COALESCE(cs_qty, ?) > ? AND ss_sold_year = ?) ORDER BY ss_sold_year ASC NULLS FIRST, ss_item_sk ASC NULLS FIRST, ss_customer_sk ASC NULLS FIRST, ss_qty DESC, ss_wc DESC, ss_sp DESC, other_chan_qty ASC NULLS FIRST, other_chan_wholesale_cost ASC NULLS FIRST, other_chan_sales_price ASC NULLS FIRST, ROUND(cast(ss_qty as DECIMALV3(10, 2)) / COALESCE(ws_qty + cs_qty, ?), ?) ASC NULLS FIRST LIMIT ? 

