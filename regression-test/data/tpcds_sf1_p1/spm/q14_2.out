ntity * ss_list_price) AS sales, count(*) AS number_sales FROM store_sales CROSS_JOIN item CROSS_JOIN date_dim WHERE (ss_item_sk IN (SELECT ss_item_sk FROM cross_items) AND ss_item_sk = i_item_sk AND ss_sold_date_sk = d_date_sk AND d_week_seq = (SELECT d_week_seq FROM date_dim WHERE (d_year = ? AND d_moy = ? AND d_dom = ?))) GROUP BY i_brand_id, i_class_id, i_category_id HAVING SUM(ss_quantity * ss_list_price) > (SELECT average_sales FROM avg_sales)) AS last_year WHERE (this_year.i_brand_id = last_year.i_brand_id AND this_year.i_class_id = last_year.i_class_id AND this_year.i_category_id = last_year.i_category_id) ORDER BY this_year.channel ASC NULLS FIRST, this_year.i_brand_id ASC NULLS FIRST, this_year.i_class_id ASC NULLS FIRST, this_year.i_category_id ASC NULLS FIRST LIMIT ? 

