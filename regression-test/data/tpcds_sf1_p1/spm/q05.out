AS date_sk, ws_ext_sales_price AS sales_price, ws_net_profit AS profit, cast(? as DECIMALV3(7, 2)) AS return_amt, cast(? as DECIMALV3(7, 2)) AS net_loss FROM internal.regression_test_tpcds_sf1_p1.web_sales) UNION ALL (SELECT ws_web_site_sk AS wsr_web_site_sk, wr_returned_date_sk AS date_sk, cast(? as DECIMALV3(7, 2)) AS sales_price, cast(? as DECIMALV3(7, 2)) AS profit, wr_return_amt AS return_amt, wr_net_loss AS net_loss FROM internal.regression_test_tpcds_sf1_p1.web_returns LEFT_OUTER_JOIN internal.regression_test_tpcds_sf1_p1.web_sales ON wr_item_sk = ws_item_sk AND wr_order_number = ws_order_number)) AS salesreturns CROSS_JOIN internal.regression_test_tpcds_sf1_p1.date_dim CROSS_JOIN internal.regression_test_tpcds_sf1_p1.web_site WHERE (date_sk = d_date_sk AND  AND wsr_web_site_sk = web_site_sk) GROUP BY web_site_id) AS wsr\nSELECT channel, id, SUM(sales) AS sales, SUM(returns) AS returns, SUM(profit) AS profit FROM (((SELECT ?, CONCAT(?, s_store_id) AS id, sales, returns, profit - profit_loss AS profit FROM ssr) UNION ALL (SELECT ?, CONCAT(?, cp_catalog_page_id) AS id, sales, returns, profit - profit_loss AS profit FROM csr)) UNION ALL (SELECT ?, CONCAT(?, web_site_id) AS id, sales, returns, profit - profit_loss AS profit FROM wsr)) AS x GROUP BY GROUPING SETS ((channel,id), (channel), ()) ORDER BY channel ASC NULLS FIRST, id ASC NULLS FIRST LIMIT ? 

