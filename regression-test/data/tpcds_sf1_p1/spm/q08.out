SELECT s_store_name, SUM(ss_net_profit) FROM store_sales CROSS_JOIN date_dim CROSS_JOIN store CROSS_JOIN (SELECT ca_zip FROM ((SELECT SUBSTR(ca_zip, ?, ?) AS ca_zip FROM customer_address WHERE SUBSTR(ca_zip, ?, ?) IN (?)) INTERSECT DISTINCT (SELECT ca_zip FROM (SELECT SUBSTR(ca_zip, ?, ?) AS ca_zip, count(*) AS cnt FROM customer_address CROSS_JOIN customer WHERE (ca_address_sk = c_current_addr_sk AND c_preferred_cust_flag = ?) GROUP BY ca_zip HAVING count(*) > ?) AS a1)) AS a2) AS v1 WHERE (ss_store_sk = s_store_sk AND ss_sold_date_sk = d_date_sk AND d_qoy = ? AND d_year = ? AND SUBSTR(s_zip, ?, ?) = SUBSTR(v1.ca_zip, ?, ?)) GROUP BY s_store_name ORDER BY s_store_name ASC NULLS FIRST LIMIT ? 

