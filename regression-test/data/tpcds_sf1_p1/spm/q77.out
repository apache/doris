WITH\n(SELECT s_store_sk, SUM(ss_ext_sales_price) AS sales, SUM(ss_net_profit) AS profit FROM store_sales CROSS_JOIN date_dim CROSS_JOIN store WHERE (ss_sold_date_sk = d_date_sk AND  AND ss_store_sk = s_store_sk) GROUP BY s_store_sk) AS ss, (SELECT s_store_sk, SUM(sr_return_amt) AS returns, SUM(sr_net_loss) AS profit_loss FROM store_returns CROSS_JOIN date_dim CROSS_JOIN store WHERE (sr_returned_date_sk = d_date_sk AND  AND sr_store_sk = s_store_sk) GROUP BY s_store_sk) AS sr, (SELECT cs_call_center_sk, SUM(cs_ext_sales_price) AS sales, SUM(cs_net_profit) AS profit FROM catalog_sales CROSS_JOIN date_dim WHERE (cs_sold_date_sk = d_date_sk AND ) GROUP BY cs_call_center_sk) AS cs, (SELECT cr_call_center_sk, SUM(cr_return_amount) AS returns, SUM(cr_net_loss) AS profit_loss FROM catalog_returns CROSS_JOIN date_dim WHERE (cr_returned_date_sk = d_date_sk AND ) GROUP BY cr_call_center_sk) AS cr, (SELECT wp_web_page_sk, SUM(ws_ext_sales_price) AS sales, SUM(ws_net_profit) AS profit FROM web_sales CROSS_JOIN date_dim CROSS_JOIN web_page WHERE (ws_sold_date_sk = d_date_sk AND  AND ws_web_page_sk = wp_web_page_sk) GROUP BY wp_web_page_sk) AS ws, (SELECT wp_web_page_sk, SUM(wr_return_amt) AS returns, SUM(wr_net_loss) AS profit_loss FROM web_returns CROSS_JOIN date_dim CROSS_JOIN web_page WHERE (wr_returned_date_sk = d_date_sk AND  AND wr_web_page_sk = wp_web_page_sk) GROUP BY wp_web_page_sk) AS wr\nSELECT channel, id, SUM(sales) AS sales, SUM(returns) AS returns, SUM(profit) AS profit FROM (((SELECT ?, ss.s_store_sk AS id, sales, COALESCE(returns, ?) AS returns, profit - COALESCE(profit_loss, ?) AS profit FROM ss LEFT_OUTER_JOIN sr ON ss.s_store_sk = sr.s_store_sk) UNION ALL (SELECT ?, cs_call_center_sk AS id, sales, returns, profit - profit_loss AS profit FROM cs CROSS_JOIN cr)) UNION ALL (SELECT ?, ws.wp_web_page_sk AS id, sales, COALESCE(returns, ?) AS returns, profit - COALESCE(profit_loss, ?) AS profit FROM ws LEFT_OUTER_JOIN wr ON ws.wp_web_page_sk = wr.wp_web_page_sk)) AS x GROUP BY GROUPING SETS ((channel,id), (channel), ()) ORDER BY channel ASC NULLS FIRST, id ASC NULLS FIRST, sales ASC NULLS FIRST LIMIT ? 

