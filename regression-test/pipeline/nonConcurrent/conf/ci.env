# The separate lane owns these suites; the orchestrator supplies concurrency.
CI_TEST_GROUPS=nonConcurrent
CI_RUN_NON_CONCURRENT=true
CI_TEST_TIMEOUT_SECONDS=5400
# The 4.1 suite needs the already-established longer test-stage budget.
if [[ ${CI_BRANCH:?CI_BRANCH must identify the tested target branch} == branch-4.1 ]]; then
    CI_TEST_TIMEOUT_SECONDS=6600
fi
# Twice recent execution time, rounded up to a half hour.
CI_EXECUTION_TIMEOUT_MIN=210
