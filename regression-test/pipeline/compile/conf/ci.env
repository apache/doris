# Preserve the coverage compiler settings used by the community build.
# Build type remains owned by build.sh; this does not claim sanitizer coverage.
DORIS_TOOLCHAIN=clang
DORIS_BUILD_PYTHON_VERSION=python3
EXTRA_CXX_FLAGS=-O1
ENABLE_PCH=OFF
CLOUD_MODE=1
# Rootless extraction must not restore archived file owners.
TAR_OPTIONS=--no-same-owner
# Leave room for a source rebuild of third-party dependencies.
CI_EXECUTION_TIMEOUT_MIN=240
