# Master covers the Arrow Flight SQL group in addition to ordinary P0 cases.
CI_TEST_GROUPS=p0
if [[ ${CI_BRANCH:?CI_BRANCH must identify the tested target branch} == master ]]; then
    CI_TEST_GROUPS=p0,arrow_flight_sql
fi
# Non-concurrent suites have their own lane.
CI_RUN_NON_CONCURRENT=false
# Preserve the test-stage budget and the reviewed total execution budget.
CI_TEST_TIMEOUT_SECONDS=5400
CI_EXECUTION_TIMEOUT_MIN=180
