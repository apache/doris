# Match the upstream container-overflow setting and retain leak detection.
CI_CLOUDUT_ASAN_OPTIONS=detect_container_overflow=0:detect_leaks=1
# The embedded HDFS JVM runs interpreted without a shared archive under ASAN.
CI_CLOUDUT_LIBHDFS_OPTS='-Xint -Xshare:off'
# This older runtime needs the source-owned FDB entropy compatibility symbol.
CI_FDB_ENTROPY_COMPAT_IMAGE=apache/doris@sha256:7d62fdaafe18985f11601ed349ce4b0d59389a7d62d8b40a06a228228222a21d
# Twice recent execution time, rounded up to a half hour; test guard unchanged.
CI_EXECUTION_TIMEOUT_MIN=60
CI_TEST_TIMEOUT_SECONDS=7200

# Preserve the existing ASAN/coverage build toolchain and optimization settings.
# run-cloud-ut.sh continues to select the build type.
DORIS_TOOLCHAIN=clang
DORIS_BUILD_PYTHON_VERSION=python3
EXTRA_CXX_FLAGS=-O1
ENABLE_PCH=OFF
# Rootless extraction must not restore archived file owners.
TAR_OPTIONS=--no-same-owner
