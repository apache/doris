# Preserve ASAN coverage; do not hide an assertion failure with a GTest filter.
DORIS_TOOLCHAIN=clang
DORIS_BUILD_PYTHON_VERSION=python3
ENABLE_PCH=OFF
BUILD_TYPE_UT=ASAN
BEUT_FILTER='*'
# Rootless extraction must not restore archived file owners.
TAR_OPTIONS=--no-same-owner
# Third-party rebuilds need the existing six-hour build budget.
CI_EXECUTION_TIMEOUT_MIN=360
CI_TEST_TIMEOUT_SECONDS=7200
