# The Surefire exclusion file is reviewed beside this policy, not generated by CI.
FEUT_EXCLUDES_FILE=regression-test/pipeline/feut/conf/excluded-tests.txt
# Twice recent execution time, rounded up to a half hour.
CI_EXECUTION_TIMEOUT_MIN=240

# Preserve the compiler selection used by the source FE test runner.
DORIS_TOOLCHAIN=clang
DORIS_BUILD_PYTHON_VERSION=python3
# Keep the established tiered-JIT policy; CPU allocation stays with CI.
FEUT_TEST_JVM_OPTIONS='-XX:TieredStopAtLevel=1'
# The master runner appends these options after its default Surefire heap.
if [[ ${CI_BRANCH:?CI_BRANCH must identify the tested target branch} == master ]]; then
    FEUT_TEST_JVM_OPTIONS="-Xmx4g $FEUT_TEST_JVM_OPTIONS"
fi
