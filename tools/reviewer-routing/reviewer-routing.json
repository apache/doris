        "^fe/[^/]+/src/main/(?:java|antlr4)/org/apache/doris/(?:analysis/)?(?:Search|search/)",
        "^fe/fe-core/src/main/java/org/apache/doris/(?:indexpolicy/|nereids/trees/expressions/.*(?:Search|Match|BM25)|analysis/.*(?:Search|Match|InvertedIndex))"
      ],
      "reviewers": ["eldenmoon", "csun5285", "airborne12", "yiguolei", "gavinchou", "924060929", "zclllyybb", "hello-stephen", "morrySnow", "HappenLee"]
    },
