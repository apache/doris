<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.apache.doris</groupId>
        <artifactId>fe-connector</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>fe-connector-hudi</artifactId>
    <packaging>jar</packaging>
    <name>Doris FE Connector - Hudi</name>
    <description>
        Hudi connector plugin for Doris FE.
        Provides metadata operations (list databases, list tables, get schema)
        for Hudi tables via HMS discovery and HoodieTableMetaClient.
        Uses fe-connector-hms for HMS client operations and hudi-common
        for reading Hudi table metadata and Avro schema.
        Scan planning and incremental query support remain in fe-core temporarily.
    </description>

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>fe-connector-spi</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- For @ConnectorProperty + ConnectorPropertiesUtils (typed-holder binding; D-004). -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>fe-foundation</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Thrift types for constructing TTableFormatFileDesc in populateRangeParams -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>fe-thrift</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Shared HMS client library for table discovery -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>fe-connector-hms</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Supplies the plugin-side HMS Kerberos parser (HmsMetaStoreProperties.kerberos() via
             MetaStoreProviders.bindForType("hms")) + transitively fe-kerberos, for
             HudiConnector.buildPluginAuthenticator; bundled child-first by plugin-zip.xml's runtime
             dependencySet. -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>fe-connector-metastore-hms</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Hudi SDK for MetaClient and Avro schema -->
        <dependency>
            <groupId>org.apache.hudi</groupId>
            <artifactId>hudi-common</artifactId>
            <version>${hudi.version}</version>
            <exclusions>
                <!-- rocksdbjni (54MB, ~1/4 of the plugin) is only used by Hudi's OPT-IN
                     RocksDbBasedFileSystemView and RocksDbDiskMap. This connector builds an in-memory
                     file-system view (HudiScanPlanProvider ->
                     FileSystemViewManager.createInMemoryFileSystemView) and never selects the RocksDB
                     view; the metadata-table external spillable map defaults to BITCASK (pure-Java), not
                     ROCKSDB. The createInMemory path has no static reference to the RocksDB classes, so
                     there is no class-init hazard — the jar is dead weight on the FE metadata read path. -->
                <exclusion>
                    <groupId>org.rocksdb</groupId>
                    <artifactId>rocksdbjni</artifactId>
                </exclusion>
                <!-- hudi-common pulls hbase-server for the HFile-format metadata-table reader, which
                     transitively drags the HBase RegionServer web-UI stack (hbase-http ->
                     hbase-shaded-jetty/jersey, ~5.7MB) and the Hadoop YARN + MapReduce + HDFS-daemon job
                     stack (hadoop-mapreduce-client-core -> yarn-api/common/client + jline; hadoop-hdfs the
                     NameNode/DataNode server jar -> leveldbjni; hadoop-distcp), ~26MB total. The FE metadata
                     read path (timeline + HFile MDT via createInMemoryFileSystemView) never submits a
                     YARN/MR job, starts a RegionServer, or serves the HBase info UI, so strip the
                     job/server/UI infra while KEEPING the HFile reader core (hbase-server + hbase-common +
                     hbase-client + hbase-protocol*). hadoop-hdfs-CLIENT (needed for hdfs:// warehouses)
                     previously arrived under the excluded mapreduce subtree, so it is re-declared directly
                     below. Mirrors the same trims fe-connector-hms-hive-shade already applies to hive. -->
                <exclusion>
                    <groupId>org.apache.hadoop</groupId>
                    <artifactId>hadoop-mapreduce-client-core</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.apache.hadoop</groupId>
                    <artifactId>hadoop-hdfs</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.apache.hadoop</groupId>
                    <artifactId>hadoop-distcp</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.apache.hbase</groupId>
                    <artifactId>hbase-http</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- HadoopStorageConfiguration for building MetaClient -->
        <dependency>
            <groupId>org.apache.hudi</groupId>
            <artifactId>hudi-hadoop-mr</artifactId>
        </dependency>

        <!-- PARENT-FIRST NOTE, read before the hadoop comments below. org.apache.hadoop. is in
             ConnectorPluginManager.CONNECTOR_PARENT_FIRST_PREFIXES (added for the credential-aware
             FileSystem cache: the kernel's Doris-patched org.apache.hadoop.fs.FileSystem keys
             FileSystem.CACHE on doris.fs.cache.key.<scheme>, and a child-loaded vanilla copy would
             silently ignore it), so the FE kernel's class wins for everything under that namespace.
             It is a delegation ORDER, not an exclusion — whatever the kernel lacks still falls back to
             the jars declared here, which is how org.apache.hadoop.hbase.* and org.apache.hadoop.hive.*
             keep coming from the plugin. Two consequences for the comments that follow: the cross-loader
             cast/LinkageError failures they record are HISTORY (FileSystem, Configuration and the FS
             impls now come from one and the same loader), and the dependencies nevertheless stay,
             because they remain this plugin's own compile/runtime closure, they are what the fallback
             resolves against, and the intended end state — see that constant's javadoc — is an FE kernel
             with no hadoop classes at all, where child-first resumes and self-containment is
             load-bearing again. Every hadoop-namespace artifact declared here resolves to the same GAV
             as the kernel's, which is what makes the shadowing a no-op. The same applies to the
             META-INF/services/org.apache.hadoop.fs.FileSystem registrations these jars carry:
             hadoop-deps' DORIS-PATCH binds FileSystem.loadFileSystems' ServiceLoader to
             FileSystem.class's own (kernel) loader, so discovery runs off the kernel's service files;
             the plugin's entries are a subset of those, and the schemes this plugin routes are pinned
             through fs.<scheme>.impl anyway. Non-hadoop namespaces (software.amazon.awssdk and
             org.apache.parquet in particular) are NOT parent-first. -->

        <!-- hadoop-hdfs-client supplies org.apache.hadoop.hdfs.DistributedFileSystem + its
             META-INF/services/org.apache.hadoop.fs.FileSystem 'hdfs' registration, needed whenever the
             connector opens an hdfs:// table base path to read the .hoodie timeline
             (HudiScanPlanProvider.buildMetaClient -> HoodieTableMetaClient.getStorage -> FileSystem.get).
             It previously arrived transitively via hudi-common -> hbase-server ->
             hadoop-mapreduce-client-core, which is excluded above to drop the YARN/MR job stack, so
             re-declare it directly. Same self-contained child-first reasoning as hadoop-aws below and as
             fe-connector-iceberg/paimon: runtime scope (DistributedFileSystem is loaded reflectively via
             the Hadoop FileSystem SPI, not referenced at compile time), version pinned to ${hadoop.version}
             (NOT in fe/pom.xml dependencyManagement), and hadoop-common excluded so the plugin keeps the
             SINGLE hadoop-common copy that fe-connector-hms already contributes (no cross-loader
             FileSystem/Configuration split). -->
        <dependency>
            <groupId>org.apache.hadoop</groupId>
            <artifactId>hadoop-hdfs-client</artifactId>
            <version>${hadoop.version}</version>
            <scope>runtime</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.apache.hadoop</groupId>
                    <artifactId>hadoop-common</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- parquet-hadoop supplies org.apache.parquet.hadoop.ParquetFileReader and parquet-avro supplies
             org.apache.parquet.avro.AvroSchemaConverter for hudi's FE-side schema read: TableSchemaResolver
             reads a data file's parquet footer to resolve the table Avro schema
             (ParquetUtils.readAvroSchema -> readSchema -> ParquetFileReader.readFooter(Configuration, Path),
             then converts the parquet MessageType to Avro). hudi-common bundles NO parquet, and no other
             jar in this plugin (the fe-connector-hms-hive-shade slim shade carries none either) provides an
             un-relocated org.apache.parquet.hadoop.* — so the
             un-relocated ParquetFileReader would otherwise resolve from the parent 'app' loader while
             ParquetUtils and Configuration came from the child (org.apache.hadoop was child-first then, from
             the bundled hadoop-common; it is parent-first now — see the PARENT-FIRST NOTE above, which
             removes the Configuration half of this split) — readFooter's Configuration parameter then split
             across two loaders and the JVM threw a LinkageError (loader constraint violation on
             org.apache.hadoop.conf.Configuration).
             Co-locating parquet child-first here — the SAME FIX-PAIMON-HADOOP-CLASSLOADER pattern as hadoop-aws
             below — keeps ParquetFileReader + Configuration in one loader. parquet-hadoop pulls its
             parquet-column/common/encoding/format-structures/jackson siblings transitively; versions are
             BOM-managed (${parquet.version}). -->
        <dependency>
            <groupId>org.apache.parquet</groupId>
            <artifactId>parquet-hadoop</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.parquet</groupId>
            <artifactId>parquet-avro</artifactId>
        </dependency>

        <!-- The hadoop class parquet-hadoop extends, and the second half of the LinkageError the block
             above set out to prevent. ParquetReadOptions.Builder's constructor reads
             ParquetInputFormat's defaults, and org.apache.parquet.hadoop.ParquetInputFormat is an
             org.apache.hadoop.mapreduce.lib.input.FileInputFormat - a class that lives in
             hadoop-mapreduce-client-core, excluded from hudi-common above to drop the YARN/MR job stack.
             Bundling parquet child-first without it left ParquetInputFormat in the child loader and its
             superclass in the parent 'app' loader (fe-core ships mapreduce-client-core), which splits
             org.apache.hadoop.fs.Path across the two loaders in the inherited
             isSplitable(JobContext, Path) signature:

               LinkageError: loader constraint violation for class
               org.apache.parquet.hadoop.ParquetInputFormat ... have different Class objects for the
               type org.apache.hadoop.fs.Path used in the signature

             It is thrown from TableSchemaResolver's parquet-footer read, i.e. on the FIRST schema
             resolution of any hudi table, so no hudi table could be read at all. Same shape as the
             paimon BE plugin's missing FileInputFormat, one loader further along.

             Re-declared like hadoop-hdfs-client above rather than by dropping the hudi-common
             exclusion: only the class hierarchy is wanted and it is entirely inside this one jar,
             while the artifact drags a job client behind it - YARN and its jersey/guice/jaxb web
             stack, netty-all, a second slf4j binding. hadoop-common is excluded so the plugin keeps
             the SINGLE copy fe-connector-hms contributes; hadoop-hdfs-client because hdfs:// arrives
             through its own declaration above and nowhere else. -->
        <dependency>
            <groupId>org.apache.hadoop</groupId>
            <artifactId>hadoop-mapreduce-client-core</artifactId>
            <version>${hadoop.version}</version>
            <scope>runtime</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.apache.hadoop</groupId>
                    <artifactId>hadoop-common</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.apache.hadoop</groupId>
                    <artifactId>hadoop-hdfs-client</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.apache.hadoop</groupId>
                    <artifactId>hadoop-yarn-client</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.apache.hadoop</groupId>
                    <artifactId>hadoop-yarn-common</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-reload4j</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.google.inject.extensions</groupId>
                    <artifactId>guice-servlet</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>io.netty</groupId>
                    <artifactId>netty-all</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- hadoop-aws supplies org.apache.hadoop.fs.s3a.S3AFileSystem for s3a:// warehouses. Unlike hive
             (whose FE metadata path is HMS-thrift-only and never opens an s3a:// FileSystem), the hudi
             connector opens the table base path on the FE to read the .hoodie timeline
             (HudiScanPlanProvider.buildMetaClient -> HoodieTableMetaClient.getStorage -> FileSystem.get). The
             base org.apache.hadoop.fs.FileSystem comes from hadoop-common (bundled transitively via hudi
             above); the plugin ran child-first then (org.apache.hadoop was not yet in ChildFirstClassLoader's
             parent-first allowlist — see the PARENT-FIRST NOTE above),
             so bundling hadoop-common WITHOUT hadoop-aws left FileSystem in the child
             loader while S3AFileSystem resolved from the parent 'app' loader (fe-core's own hadoop-aws) —
             FileSystem.createFileSystem's cast then threw "S3AFileSystem cannot be cast to FileSystem" (the
             SAME FIX-PAIMON-HADOOP-CLASSLOADER split iceberg/paimon already carry). Co-locating S3AFileSystem
             in the child loader here makes the cast succeed. Version + the monolithic
             software.amazon.awssdk:bundle exclusion are inherited from fe/pom.xml dependencyManagement; the
             AWS SDK v2 modules S3A needs at runtime are bundled child-first below. -->
        <dependency>
            <groupId>org.apache.hadoop</groupId>
            <artifactId>hadoop-aws</artifactId>
        </dependency>

        <!-- AWS SDK v2 for the child-bundled hadoop-aws S3AFileSystem (mirrors fe-connector-paimon/iceberg,
             RC-3). Without it the plugin bundles S3AFileSystem child-first but NO SDK: its
             ExecutionAttribute static registers against the single PARENT-loaded sdk-core, colliding with
             fe-core's S3A in ExecutionAttribute.ensureUnique() -> ExceptionInInitializerError that permanently
             poisons S3 for the whole FE JVM. The 's3' module's compile closure brings sdk-core (the
             load-bearing ExecutionAttribute) + aws-core + auth + regions; apache-client is added explicitly
             because hadoop-aws 3.4.2 wires ApacheHttpClient and it is only test-scoped in s3's closure;
             s3-transfer-manager carries the software/amazon/awssdk/services/s3/execution.interceptors SPI
             resource that must resolve child-first. Versions are BOM-managed (awssdk ${awssdk.version}).
             software.amazon.awssdk MUST stay child-first (NOT in the parent-first allowlist). -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>apache-client</artifactId>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3-transfer-manager</artifactId>
        </dependency>

        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>doris-fe-connector-hudi</finalName>
        <plugins>
            <!-- The other half of the hierarchy hadoop-mapreduce-client-core above completes.
                 hudi-hadoop-mr's org.apache.hudi.hadoop.HoodieParquetInputFormatBase extends hive's
                 org.apache.hadoop.hive.ql.io.parquet.MapredParquetInputFormat, which extends
                 org.apache.hadoop.mapred.FileInputFormat - the OLD mapred API, in the same jar as the
                 new one. So bundling mapreduce-client-core child-first moves mapred.FileInputFormat
                 into the child while MapredParquetInputFormat stays in the parent (hive-exec is
                 fe-core's; the slim fe-connector-hms-hive-shade is metastore + common + storage-api and
                 carries no ql/io/parquet), splitting the subclass from the superclass the incremental
                 read path declares:

                   VerifyError: Bad return type ... HoodieInputFormatUtils.getInputFormat ...
                   'HoodieParquetRealtimeInputFormat' is not assignable to
                   'org/apache/hadoop/mapred/FileInputFormat' (from method signature)

                 Unpacked rather than declared as a dependency because only this one package is wanted:
                 the whole hive-exec:core jar in lib/ would put every hive ql class child-first, shadowing
                 the slim shade the other connectors share. 156 classes, ~230KB, landing in this module's
                 own jar - which the assembly already ships into lib/. Same unpack-a-subset shape as
                 be-java-extensions/hive-apache-shade. -->
            <plugin>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>unpack-hive-parquet-serde</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>unpack</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>org.apache.hive</groupId>
                                    <artifactId>hive-exec</artifactId>
                                    <version>${hive.version}</version>
                                    <classifier>core</classifier>
                                    <type>jar</type>
                                    <includes>org/apache/hadoop/hive/ql/io/parquet/**</includes>
                                    <outputDirectory>${project.build.outputDirectory}</outputDirectory>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-assembly-plugin</artifactId>
                <configuration>
                    <appendAssemblyId>false</appendAssemblyId>
                    <descriptors>
                        <descriptor>src/main/assembly/plugin-zip.xml</descriptor>
                    </descriptors>
                </configuration>
                <executions>
                    <execution>
                        <id>make-assembly</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
