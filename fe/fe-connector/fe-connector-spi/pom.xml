<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.apache.doris</groupId>
        <artifactId>fe-connector</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>fe-connector-spi</artifactId>
    <packaging>jar</packaging>
    <name>Doris FE Connector SPI</name>
    <description>
        The whole Doris FE connector plugin contract, in both directions.

        What a connector implements and the engine consumes: ConnectorProvider (the
        ServiceLoader entry point), Connector, the ConnectorMetadata sub-interfaces,
        the scan / write / procedure providers, opaque handle types, pushdown and ddl
        value objects, and the capability enums.

        What the engine implements and a connector consumes: ConnectorContext,
        ConnectorStorageContext, ConnectorSession, ConnectorConf, ConnectorBrokerAddress.

        The two directions live in one module on purpose — the boundary is bidirectional
        (ConnectorProvider.create takes a ConnectorContext; ConnectorContext hands back a
        Connector), so splitting by "who implements" would be circular. Trino does the
        same with trino-spi. Design rules for the whole surface are documented in this
        module's org.apache.doris.connector.spi package-info.

        The fe-thrift dependency (provided scope) allows connectors to construct typed
        thrift payloads for the FE-BE protocol. At runtime the Thrift classes are supplied
        by the parent classloader (fe-core).
    </description>

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>fe-thrift</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>fe-extension-spi</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- fe-filesystem-api: the connector storage contract (StorageProperties) that fe-core binds
             and hands down via ConnectorContext.getStorageProperties(). This is the load-bearing
             "fe-connector depends ONLY on fe-filesystem-api" edge (Doris-internal API, no third-party). -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>fe-filesystem-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>doris-fe-connector-spi</finalName>
        <resources>
            <!-- Default resource root, restated because declaring <resources> replaces the default. -->
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!--
              Kept apart from src/main/resources so that ${...} substitution applies ONLY to the
              plugin API version file and can never rewrite a service descriptor by accident.
            -->
            <resource>
                <directory>src/main/resources-filtered</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <!-- This module is compiled into fe-core, not deployed as a plugin. -->
                    <execution>
                        <id>copy-plugin-deps</id>
                        <phase>none</phase>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
