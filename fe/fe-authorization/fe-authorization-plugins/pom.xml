<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.apache.doris</groupId>
        <version>${revision}</version>
        <artifactId>fe-authorization</artifactId>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>fe-authorization-plugins</artifactId>
    <packaging>pom</packaging>
    <name>Doris FE Authorization Plugins</name>
    <description>Authorization sources shipped with Doris, each installed from its own plugin directory.</description>

    <!--
      One Ranger service type is one authorization source, and DirectoryPluginRuntimeManager admits exactly
      one factory per plugin directory - two service descriptors under one directory is a load failure, not a
      pair of sources. Hence a module per source plus a common module for what they share: the common module
      deliberately declares NO service descriptor, so it can sit in both plugins' lib/ without either
      directory appearing to publish two sources.
    -->
    <modules>
        <module>fe-authorization-plugin-ranger-common</module>
        <module>fe-authorization-plugin-ranger-doris</module>
        <module>fe-authorization-plugin-ranger-hive</module>
    </modules>
</project>
