<!--
  Plugin zip layout expected by DirectoryPluginRuntimeManager:
    <finalName>.jar   (this module's jar, at the root - the only place scanned for the service
                       descriptor naming the one factory this directory publishes)
    lib/
      *.jar           (everything else it needs at runtime, direct and transitive)

  ranger-common lands in lib/ rather than at the root on purpose: root jars are what the loader
  scans, and a second root jar would be a second place a service descriptor could come from.

  fe-authorization-api and fe-authorization-spi are <scope>provided</scope> and so are absent here.
  They are loaded parent-first from the FE, which is what makes the decision types the plugin returns
  the same classes the engine asked for.

  Ranger and its hadoop closure ARE bundled, so this plugin does not depend on what the host happens
  to carry in fe/lib. That costs disk twice over (the two Ranger plugins bundle it separately) and is
  the deliberate trade: a plugin whose dependencies come half from the host is a plugin whose
  behaviour changes when the host is upgraded.
-->
<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.2.0
              https://maven.apache.org/xsd/assembly-2.2.0.xsd">
    <id>plugin</id>
    <formats>
        <format>zip</format>
    </formats>
    <includeBaseDirectory>false</includeBaseDirectory>

    <!-- The plugin jar at the root of the zip (service-discovery target) -->
    <files>
        <file>
            <source>${project.build.directory}/${project.build.finalName}.jar</source>
            <outputDirectory>/</outputDirectory>
        </file>
    </files>

    <dependencySets>
        <dependencySet>
            <outputDirectory>/lib</outputDirectory>
            <useProjectArtifact>false</useProjectArtifact>
            <scope>runtime</scope>
            <excludes>
                <!-- Logging is the host's; a second implementation here fights it -->
                <exclude>org.apache.logging.log4j:*</exclude>
                <exclude>org.slf4j:*</exclude>
            </excludes>
        </dependencySet>
    </dependencySets>
</assembly>
