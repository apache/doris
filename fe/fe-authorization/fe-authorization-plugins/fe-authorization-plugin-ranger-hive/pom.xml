<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.apache.doris</groupId>
        <version>${revision}</version>
        <artifactId>fe-authorization-plugins</artifactId>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>fe-authorization-plugin-ranger-hive</artifactId>
    <packaging>jar</packaging>
    <name>Doris FE Authorization Plugin - Ranger Hive</name>
    <description>Authorizes one external catalog against a Ranger service of type hive. Selected in that
        catalog's properties (access_controller.class).
    </description>

    <dependencies>
        <dependency>
            <groupId>org.apache.doris</groupId>
            <artifactId>fe-authorization-plugin-ranger-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- On the FE's classpath and loaded parent-first; see the ranger-common pom. -->
        <dependency>
            <groupId>org.apache.doris</groupId>
            <artifactId>fe-authorization-spi</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.doris</groupId>
            <artifactId>fe-authorization-api</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.apache.ranger</groupId>
            <artifactId>ranger-plugins-common</artifactId>
        </dependency>
        <!--
          The audit configuration this plugin builds is a hadoop Configuration, which the Ranger audit API
          takes. Declared rather than left to arrive through ranger-plugins-common, so that the version this
          module compiles against is the one fe/pom.xml manages.
        -->
        <dependency>
            <groupId>org.apache.hadoop</groupId>
            <artifactId>hadoop-client-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- mockConstruction needs the inline mock maker; mockito 4 does not enable it by default. -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-inline</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
