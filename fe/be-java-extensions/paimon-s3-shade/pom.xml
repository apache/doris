<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>be-java-extensions</artifactId>
        <groupId>org.apache.doris</groupId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>paimon-s3-shade</artifactId>
    <packaging>jar</packaging>
    <name>Doris BE Java Extensions - Paimon S3 Shade</name>
    <description>
        Repackages Paimon's self-contained S3 FileIO plugin without the outer multi-release
        entries that leak out of its embedded plugin runtime.
    </description>

    <dependencies>
        <!--
          paimon-s3 is an outer loader plus a complete child-first runtime under
          paimon-plugin-s3/. Its build also copies that runtime's META-INF/versions tree to the
          OUTER jar. Those outer entries include an older Bouncy Castle overlay and therefore
          override parts of hadoop-common's bcprov-jdk18on when both jars share the scanner
          classloader. Keep the embedded runtime byte-for-byte, but remove the accidental outer
          overlay. Optional plus wildcard exclusions ensure consumers get only this corrected jar,
          never the source artifact or another transitive copy.
        -->
        <dependency>
            <groupId>org.apache.paimon</groupId>
            <artifactId>paimon-s3</artifactId>
            <optional>true</optional>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <build>
        <finalName>paimon-s3-shade</finalName>
        <directory>${project.basedir}/target/</directory>
        <plugins>
            <!-- Incremental builds must not retain entries from a previously unpacked version. -->
            <plugin>
                <artifactId>maven-clean-plugin</artifactId>
                <executions>
                    <execution>
                        <id>empty-classes-before-unpack</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                        <configuration>
                            <excludeDefaultDirectories>true</excludeDefaultDirectories>
                            <filesets>
                                <fileset>
                                    <directory>${project.build.outputDirectory}</directory>
                                </fileset>
                            </filesets>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>unpack-paimon-s3</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>unpack</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>org.apache.paimon</groupId>
                                    <artifactId>paimon-s3</artifactId>
                                    <version>${paimon.version}</version>
                                    <overWrite>true</overWrite>
                                    <outputDirectory>${project.build.outputDirectory}</outputDirectory>
                                    <!-- This matches only the outer overlay. The embedded
                                         paimon-plugin-s3/META-INF/versions/** tree is preserved. -->
                                    <excludes>META-INF/maven/**,META-INF/versions/**</excludes>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
