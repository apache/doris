<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <parent>
        <artifactId>be-java-extensions</artifactId>
        <groupId>org.apache.doris</groupId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>
    <artifactId>iceberg-metadata-scanner</artifactId>
    <name>Doris BE iceberg Plugin</name>
    <description>
        Reads Iceberg metadata tables ($snapshots, $files, $manifests, ...). FE plans the scan and
        Java-serializes each iceberg FileScanTask to this plugin, which deserializes it and
        materializes its rows - so the plugin carries a full iceberg runtime, not just an API.
    </description>

    <properties>
        <doris.home>${basedir}/../../</doris.home>
        <fe_ut_parallel>1</fe_ut_parallel>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.apache.doris</groupId>
            <artifactId>jni-spi</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <!--
          The kerberos machinery FE and BE share: a scan carries the catalog's hadoop.* options and
          runs under the same UGI doAs wrapper FE used to plan it.
        -->
        <dependency>
            <groupId>org.apache.doris</groupId>
            <artifactId>fe-kerberos</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.apache.iceberg</groupId>
            <artifactId>iceberg-core</artifactId>
            <version>${iceberg.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.iceberg</groupId>
            <artifactId>iceberg-aws</artifactId>
            <version>${iceberg.version}</version>
        </dependency>
        <!--
          iceberg-aws declares no AWS SDK dependency of its own (they are compileOnly upstream), so
          every client a deserialized FileIO reaches has to be named here.

          This is the FileIO half of the SDK, not the whole of it: BE deserializes a scan task and
          the FileIO inside it, and never builds a catalog - the catalog clients the shared preload
          layer also carried (glue, dynamodb, s3tables) belong to FE. Verified by loading
          S3FileIO.initialize() + S3FileIOAwsClientFactories against this closure with glue and
          dynamodb removed. kms cannot be dropped the same way even though nothing here encrypts:
          AwsClientFactories' static initializer resolves kms.model.EncryptionAlgorithmSpec, so
          without it the S3 path dies in <clinit>. auth is named for the same reason it is named
          nowhere else - iceberg-aws reads the catalog's credentials through it, and nothing in
          iceberg-aws's own pom says so.
        -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>sts</artifactId>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>kms</artifactId>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>sdk-core</artifactId>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>auth</artifactId>
        </dependency>
        <!--
          Hadoop: a task's FileIO is whatever the table was created with, and for every non-S3
          catalog that is HadoopFileIO (directly or behind ResolvingFileIO). It used to be provided
          because the scanner could see lib/hadoop_hdfs on BE's system classpath; a plugin sees no
          system classpath at all, so it brings its own.

          reload4j is excluded because it is a logging implementation - see the logging note below.
          Nothing here calls log4j 1.x: the only two hadoop-common classes that mention
          org.apache.log4j are LogLevel$Servlet and StringUtils$1 (the daemon startup/shutdown
          banner), neither of which a scan reaches. Dropping it also lets commons-logging - which
          httpclient does use on the S3 path - fall through its discovery order to Jdk14Logger, so
          it too ends up in jni.log with no bridge artifact involved.
        -->
        <dependency>
            <groupId>org.apache.hadoop</groupId>
            <artifactId>hadoop-common</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>ch.qos.reload4j</groupId>
                    <artifactId>reload4j</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!--
          The filesystem implementations themselves. hadoop-common registers only file, har, http
          and viewfs; every other scheme's FileSystem lives in its own artifact, and until this
          module became a plugin those artifacts arrived from BE's system classpath - lib/hadoop_hdfs
          (hdfs, obs, azure) and the shared preload jar (s3a). A plugin sees no system classpath at
          all, so without them a scan of a table on HDFS fails with "No FileSystem for scheme: hdfs".
          Which class serves which scheme is FE's decision and is asserted in IcebergPluginTest.

          Two absences are deliberate. hadoop-cos is on that shared classpath today but nothing
          reaches it: FE points fs.cosn.impl at S3AFileSystem, and no code in the tree names
          org.apache.hadoop.fs.CosFileSystem. And oss:// is served by JindoFS, which is not a maven
          artifact - build.sh copies it into this directory when it was packaged.
        -->
        <dependency>
            <groupId>org.apache.hadoop</groupId>
            <artifactId>hadoop-hdfs-client</artifactId>
            <version>${hadoop.version}</version>
            <scope>runtime</scope>
            <!-- Keep the plugin's single hadoop-common (declared above): two copies would put
                 FileSystem in one and DistributedFileSystem's superclass in the other. -->
            <exclusions>
                <exclusion>
                    <groupId>org.apache.hadoop</groupId>
                    <artifactId>hadoop-common</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.apache.hadoop</groupId>
            <artifactId>hadoop-aws</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!--
          For hadoop-aws, not for iceberg: S3AFileSystem's own methods reference
          software.amazon.awssdk.transfer.s3, so loading the class fails without this even though
          nothing here uses the transfer manager. It is the only piece of the AWS SDK named for a
          reason other than iceberg's FileIO - which is why it sits here rather than up there with
          s3/sts/kms.
        -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3-transfer-manager</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.hadoop</groupId>
            <artifactId>hadoop-azure</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- A fat jar: it self-contains the esdk-obs SDK, so OBS needs nothing else. -->
        <dependency>
            <groupId>com.huaweicloud</groupId>
            <artifactId>hadoop-huaweicloud</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          Logging: this plugin and the libraries inside it must reach the one file BE's plugin
          runtime configures - log/jni.log, written through java.util.logging. So the plugin speaks
          slf4j and deploys slf4j-jdk14.

          The three log4j artifacts are narrowed to test because the fe parent pom declares them
          compile on EVERY module: log4j-core is a second logging implementation writing wherever
          its own configuration says (nowhere, since BE's log4j2 config is not on a plugin's
          classpath), log4j-slf4j2-impl would route slf4j into it, and log4j-1.2-api is not the pure
          facade its name suggests - its org.apache.log4j.Logger resolves log4j-core classes.
          Maven cannot drop an inherited dependency, only narrow its scope.

          log4j-to-slf4j is the bridge for the one log4j2 caller in this closure: fe-kerberos, whose
          UGI login and ticket-renewal messages are the ones an operator goes looking for. Without
          it log4j-api finds no provider and falls back to writing on stderr.
        -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-jdk14</artifactId>
            <version>${slf4j.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-to-slf4j</artifactId>
            <version>${log4j2.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-slf4j2-impl</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-1.2-api</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!--
      com.huaweicloud:hadoop-huaweicloud is not published to Maven Central, and a module does not
      inherit repositories from its parent here. hadoop-deps and the two FE modules that use the
      same artifact each declare this the same way.
    -->
    <repositories>
        <repository>
            <id>huawei-obs-sdk</id>
            <url>https://repo.huaweicloud.com/repository/maven/huaweicloudsdk/</url>
        </repository>
    </repositories>

    <build>
        <finalName>iceberg-metadata-scanner</finalName>
        <directory>${project.basedir}/target/</directory>
        <plugins>
            <!--
              A plugin is a directory of jars, not one jar with everything shaded into it. Its own
              jar is built by the parent's jar plugin; its runtime closure lands beside it here.
              `provided` dependencies are excluded by scope, which is what keeps the SPI out.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-plugin-dependencies</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/lib</outputDirectory>
                            <includeScope>runtime</includeScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
