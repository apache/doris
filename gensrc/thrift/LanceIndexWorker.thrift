namespace cpp doris
namespace java org.apache.doris.thrift

// Internal pipe protocol of the isolated Lance index worker. BE-only: these
// structs NEVER appear on the FE-BE wire. They travel only inside the
// supervisor-worker stdin/stdout pipe of one backend process, whose worker is
// always exec'd from /proc/self/exe, so both frame endpoints are by
// construction the same build and this file carries no rolling-upgrade
// compatibility obligations. The FE-facing contract is lance_index_mutate in
// BackendService.thrift (TLanceIndexMutationRequest/Result); the worker service
// translates between the two at the exec boundary and the two vocabularies are
// deliberately independent: the mirror below is explicit per field, never a
// thrift include, so the wire contract can evolve without dragging the pipe
// protocol along and vice versa.
//
// Credential discipline: storage_options ride ONLY inside the dispatch frame
// below. No field of these structs - and no frame byte - is ever written to a
// log, a metric, or an error message; diagnostics leaving the worker are
// bounded static categories.

// Internal supervisor-worker pipe protocol handshake, never an RPC surface.
// The isolated worker emits exactly one of these frames on its stdout pipe
// before any result frame, carrying its self-observed confinement facts (own
// cgroup path and limits, own rlimits). The supervisor never trusts the
// reported values: it compares them against its own cgroup write/read-back
// and kills the worker on a mismatch. protocol_magic/protocol_version pin the
// frame layout.
struct TLanceIndexWorkerHandshake {
    1: required i64 protocol_magic
    2: required i32 protocol_version
    3: required string cgroup_path
    4: required i64 memory_max_bytes
    5: required i64 pids_max
    6: required i64 rlimit_as_bytes
    7: required i64 rlimit_cpu_seconds
    8: required i64 rlimit_nofile
    9: required i64 rlimit_core
}

// Mutation intent, mirroring BackendService.TLanceIndexMutationType. Values are
// identical so the service's translation is a value-preserving map, but the
// vocabularies stay independently owned: the internal one changes only with
// this pipe protocol, never implicitly with the wire enum.
enum TLanceIndexWorkerMutationType {
    CREATE = 1,
    REPLACE = 2,
    DROP = 3
}

// One dispatch handed to the isolated worker on its stdin pipe as a single
// length-prefixed thrift-compact frame. Fields 1-15 mirror the semantic field
// surface of BackendService.TLanceIndexMutationRequest (same ids, same names,
// same meanings; see that struct for the authoritative per-field contracts).
// Fields 16+ are internal-only: facts the worker cannot read anywhere else,
// because the worker subprocess intentionally starts before any BE config,
// logging, or global state exists.
struct TLanceIndexWorkerDispatch {
    // Identity of the dispatch, generated by the FE before its single send;
    // echoed into the internal result envelope only for pipe-frame matching.
    1: required string invocation_id
    // Process epoch of the executing backend, carried for staleness reasoning.
    2: required i64 be_process_epoch
    // Absolute wall-clock (epoch milliseconds) request deadline from the wire
    // request. Informational only: the worker performs no deadline logic of
    // its own and the current worker does not read the value - the
    // supervisor's kill ladder is the enforcing deadline.
    3: required i64 deadline_ms
    4: required TLanceIndexWorkerMutationType mutation_type
    // Normalized logical index name, not the raw statement display name.
    5: required string index_name
    6: required string column_name
    // Resolved logical index algorithm family of the admitted definition.
    7: required string index_type
    // Index properties as validated by admission, JSON-encoded map.
    8: optional string properties_json
    // Statement IF flags; honored against the pinned version below.
    9: optional bool if_not_exists
    10: optional bool if_exists
    // Dataset locator of the admitted table.
    11: required string dataset_uri
    // Dataset version pinned by admission; the worker opens exactly this
    // version, never storage-latest (latest is observed read-only, for
    // diagnostics only).
    12: required i64 admitted_dataset_version
    // JSON of schema contract v1 for CREATE/REPLACE; unset for DROP.
    13: optional string schema_contract_json
    // Lance-native storage options (provider credentials included). They exist
    // only inside this frame: never persisted, never logged, never echoed in
    // any result, diagnostic, or metric, on either side of the pipe.
    14: optional map<string, string> storage_options
    // Original SQL display spelling for a newly created logical index; used
    // verbatim by REPLACE-missing-name-new-create.
    15: optional string index_display_name
    // Admitted bounds snapshot, recorded by the FE at admission time from the
    // effective config and injected here by the service from the same values
    // it admitted - the worker runs without BE config and can read them only
    // from this frame, which is exactly why bounds live on the internal frame
    // and not on the wire request. A worker must reject a dispatch whose
    // bounds are missing or non-positive rather than judge against any
    // hard-coded fallback.
    16: optional i32 max_num_partitions
    17: optional i32 max_num_sub_vectors
    // Names-only snapshot of the armed worker debug points (the fixed
    // allowlist), taken per launch by the service: armed-then-dispatched
    // semantics. Only the names cross the exec boundary - an operator's
    // expire_ms/execute_limit/params never do; the worker re-registers each
    // name as an unarmed-forever point and consumes it at its defined phase.
    18: optional list<string> debug_points
    // The kill deadline this invocation's supervisor computed once from the
    // unified budget formula (the request deadline minus the skew-margin,
    // termination-grace, and reap-bound reservation terms), as an absolute
    // epoch-millisecond timestamp. Informational only: the worker performs
    // no deadline logic of its own and the current worker does not read the
    // value. The supervisor's monotonic watch is the enforcing deadline, and
    // no worker may ever turn this field into a self-termination trigger.
    19: optional i64 worker_deadline_ms
}

// Worker-defined pre-invocation rejection codes: the negative band of
// TLanceIndexWorkerResult.lance_error_code, deliberately isolated from the
// non-negative native Lance error code space the worker passes through
// verbatim after the mutating native call. Every value below proves the
// invocation made no change: the rejection happened before any mutating
// native call. The FE-facing band contract is documented on
// TLanceIndexMutationResult.lance_error_code; the service copies these values
// into that field unchanged under phase PRE_INVOCATION_REJECTED.
//
// The IF-condition no-ops (CREATE with if_not_exists hitting an existing
// index, DROP with if_exists finding none) are NOT rejection codes: they
// complete as phase NATIVE_RETURN with code 0 (LANCE_OK) and a static
// no-op message category - an authoritative success, never a negative code.
//
// Codes -1..-4 carry over the closed dispatcher series vocabulary; -5 is new
// for the physical-snapshot name resolution that series never performed.
const i32 LANCE_WORKER_REJECTED_STALE_ADMISSION = -1;
// An admitted schema contract the worker cannot honor: absent, empty, or
// unparsable on a build; outside the supported contract v1 matrix; mismatching
// the contract recomputed from the pinned snapshot; or (the parameter-replay
// rail, mirroring the FE admission check) a build shape outside the product
// matrix, e.g. num_sub_vectors not dividing the admitted dimension.
const i32 LANCE_WORKER_REJECTED_UNSUPPORTED_SCHEMA_CONTRACT = -2;
// Reserved: lance-c currently produces no typed credential-expiry evidence,
// so no worker path yields this code today; the value is held to keep the
// band stable if it ever does.
const i32 LANCE_WORKER_REJECTED_CREDENTIAL_EXPIRED = -3;
// A dispatch the worker refused for its own bounded resource and frame-shape
// rules that carry no schema statement: storage-option bounds, malformed
// internal frame fields (including a missing or non-positive admitted bounds
// snapshot, fields 16/17 - a DROP carries no schema contract at all, so this
// is the bounds rail's category for every mutation type), or the
// physical-list processing bounds.
const i32 LANCE_WORKER_REJECTED_RESOURCE_REJECTED = -4;
// The admitted snapshot's physical index list did not resolve the normalized
// index name the way the mutation requires: absent where absence is an error
// (no matching IF flag), or not uniquely (ambiguous stored spellings) - for
// DROP, and for REPLACE when no display-name fallback field is set.
const i32 LANCE_WORKER_REJECTED_INDEX_UNRESOLVED = -5;

// Phase of the worker execution that produced the result frame. The worker
// itself only ever produces the two values below. The third wire phase,
// INDETERMINATE_AFTER_LAUNCH (BackendService.TLanceIndexWorkerPhase = 3), is
// synthesized by the in-BE handler when NO trusted result frame exists (worker
// lost, torn frame, protocol ambiguity) and is therefore deliberately absent
// here: a value this enum cannot express can never ride a result frame.
enum TLanceIndexWorkerResultPhase {
    // The worker refused the invocation before any mutating native call:
    // lance_error_code is one of the LANCE_WORKER_REJECTED_* band above.
    PRE_INVOCATION_REJECTED = 1,
    // lance_error_code is the raw native Lance error code of the single
    // mutating invocation, passed through verbatim (0 = LANCE_OK).
    NATIVE_RETURN = 2
}

// The single result frame the worker writes to its stdout pipe after its
// handshake frame, when - and only when - a complete trusted answer exists. A
// worker that exits without writing this frame has no trusted answer, and the
// handler synthesizes the indeterminate phase instead of guessing.
struct TLanceIndexWorkerResult {
    // Where the typed code came from; decides which band lance_error_code
    // belongs to. The phase is read before the code, exactly as on the wire.
    1: required TLanceIndexWorkerResultPhase phase
    // Negative: one of the LANCE_WORKER_REJECTED_* constants (phase must be
    // PRE_INVOCATION_REJECTED). Non-negative: a native Lance error code
    // passthrough (phase must be NATIVE_RETURN). The code is consumed BEFORE
    // the message; the message never participates in classification.
    2: required i32 lance_error_code
    // Bounded sanitized static category for humans. Never provider text,
    // never a storage-option key or value, never parsed by any consumer.
    3: optional string message
    // Diagnostic: set only for a PRE_INVOCATION_REJECTED result whose
    // read-only latest observation saw the dataset's latest version above the
    // admitted one - evidence of externally advanced metadata. Never set
    // otherwise; the handler forwards it to the wire result's
    // observed_latest_version field.
    4: optional i64 observed_latest_version
}
